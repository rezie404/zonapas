preserve"/></w:r></w:p><w:p><w:pPr><w:spacing w:before="240" w:after="20" w:line="276" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">LAPORAN</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">TENTANG</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">DATA REKAPITULASI PUBLIKASI MEDIA SOSIAL DAN MEDIA MASSA</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">UNIT PELAKSANA TEKNIS PEMASYARAKATAN DI LINGKUNGAN</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">KANTOR WILAYAH DIREKTORAT JENDERAL PEMASYARAKATAN BENGKULU</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">PERIODE {{PERIODE_HURUF_BESAR}}</w:t></w:r></w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before="240" w:after="80" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="0A1F44"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">A. PENDAHULUAN</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="auto"/><w:ind w:left="284" w:firstLine="425"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Dalam rangka mendukung keterbukaan informasi publik serta penyebarluasan informasi mengenai pelaksanaan tugas dan fungsi pemasyarakatan kepada masyarakat, diperlukan publikasi yang informatif, aktual, dan berkesinambungan melalui media sosial maupun media massa. Sehubungan dengan hal tersebut, Kantor Wilayah Direktorat Jenderal Pemasyarakatan Bengkulu melaksanakan pendataan dan rekapitulasi terhadap hasil rilis dan publikasi yang dilakukan oleh Kantor Wilayah dan seluruh Unit Pelaksana Teknis Pemasyarakatan di lingkungan Kantor Wilayah Direktorat Jenderal Pemasyarakatan Bengkulu selama periode pelaporan.</w:t></w:r></w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before="160" w:after="0" w:line="276" w:lineRule="auto"/><w:ind w:left="284"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">1. Umum</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="auto"/><w:ind w:left="567" w:firstLine="426"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Publikasi merupakan salah satu instrumen strategis dalam membangun kepercayaan publik terhadap kinerja Pemasyarakatan. Melalui publikasi yang cepat, akurat, dan humanis, masyarakat dapat mengetahui secara langsung berbagai kegiatan pembinaan, pelayanan, pengamanan, serta kisah inspiratif Warga Binaan di seluruh Unit Pelaksana Teknis (UPT) Pemasyarakatan di lingkungan Kantor Wilayah Direktorat Jenderal Pemasyarakatan Bengkulu.</w:t></w:r></w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before="160" w:after="0" w:line="276" w:lineRule="auto"/><w:ind w:left="284"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">2. Maksud dan Tujuan</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="60" w:line="276" w:lineRule="auto"/><w:ind w:left="567" w:firstLine="426"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Penyusunan Laporan ini dimaksudkan sebagai bentuk keterbukaan informasi publik dan akuntabilitas kinerja instansi/organisasi dalam menyebarluaskan capaian program, kebijakan, serta aktivitas strategis yang telah dilaksanakan kepada pemangku kepentingan (stakeholders) dan masyarakat luas. Adapun tujuan dari penyusunan dan penerbitan Laporan Publikasi ini adalah:</w:t></w:r></w:p><w:p><w:pPr><w:tabs><w:tab w:val="left" w:pos="851"/></w:tabs><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:ind w:left="851" w:hanging="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">1.</w:t></w:r><w:r><w:tab/></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Menyajikan gambaran secara objektif, sistematis, dan transparan mengenai hasil pelaksanaan tugas, fungsi, serta program kerja.</w:t></w:r></w:p><w:p><w:pPr><w:tabs><w:tab w:val="left" w:pos="851"/></w:tabs><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:ind w:left="851" w:hanging="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">2.</w:t></w:r><w:r><w:tab/></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Menjadi sarana evaluasi dan bentuk pertanggungjawaban publik atas penggunaan sumber daya dan pelaksanaan kebijakan organisasi.</w:t></w:r></w:p><w:p><w:pPr><w:tabs><w:tab w:val="left" w:pos="851"/></w:tabs><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:ind w:left="851" w:hanging="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">3.</w:t></w:r><w:r><w:tab/></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Memperkuat komunikasi publik guna membangun pemahaman, dukungan, serta kepercayaan masyarakat terhadap instansi/organisasi.</w:t></w:r></w:p><w:p><w:pPr><w:tabs><w:tab w:val="left" w:pos="851"/></w:tabs><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:ind w:left="851" w:hanging="284"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">4.</w:t></w:r><w:r><w:tab/></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Bahan Evaluasi dan Pengambilan Kebijakan: Menyediakan data serta dokumen rujukan bagi perbaikan pelaksanaan program dan perumusan strategi pada periode berikutnya.</w:t></w:r></w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before="160" w:after="60" w:line="276" w:lineRule="auto"/><w:ind w:left="284"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">3. Ruang Lingkup</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="60" w:line="276" w:lineRule="auto"/><w:ind w:left="567" w:firstLine="426"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Ruang lingkup laporan ini meliputi pendataan, rekapitulasi, dan rincian hasil rilis serta publikasi media sosial dan media massa yang dilaksanakan oleh Kantor Wilayah dan Unit Pelaksana Teknis Pemasyarakatan di lingkungan Kantor Wilayah Direktorat Jenderal Pemasyarakatan Bengkulu pada</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="20" w:line="276" w:lineRule="auto"/><w:ind w:left="720"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">• Periode</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:tab/><w:t xml:space="preserve">: {{PERIODE_PANJANG}} ({{JUMLAH_HARI}} hari)</w:t></w:r></w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before="240" w:after="80" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="0A1F44"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">B. KEGIATAN YANG DILAKSANAKAN</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="auto"/><w:ind w:left="284" w:firstLine="425"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Kegiatan yang dilaksanakan berupa pengumpulan, pendataan, dan rekapitulasi hasil rilis serta publikasi yang dilakukan oleh Kantor Wilayah dan Unit Pelaksana Teknis Pemasyarakatan di lingkungan Kantor Wilayah Direktorat Jenderal Pemasyarakatan Bengkulu melalui media sosial dan media massa selama periode pelaporan.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="auto"/><w:ind w:left="284" w:firstLine="425"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Pendataan dilakukan terhadap sembilan satuan kerja, yang terdiri atas Kantor Wilayah Direktorat Jenderal Pemasyarakatan Bengkulu, Lapas Kelas IIA Bengkulu, Lapas Kelas IIA Curup, Lapas Kelas IIB Arga Makmur, Lapas Perempuan Kelas IIB Bengkulu, Bapas Kelas I Bengkulu, LPKA Kelas II Bengkulu, Rutan Kelas IIB Bengkulu, dan Rutan Kelas IIB Manna.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="auto"/><w:ind w:left="284" w:firstLine="425"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">Selanjutnya, dilakukan penghitungan jumlah publikasi pada masing-masing tanggal dan masing-masing satuan kerja sebagai bahan dokumentasi, pemantauan, dan evaluasi hasil publikasi selama periode pelaporan.</w:t></w:r></w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before="240" w:after="80" w:line="276" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="0A1F44"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">C. HASIL YANG DICAPAI</w:t></w:r></w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before="80" w:after="60" w:line="276" w:lineRule="auto"/><w:ind w:left="142"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">1. Rekapitulasi Publikasi</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="60" w:line="276" w:lineRule="auto"/><w:ind w:firstLine="567"/><w:jc w:val="both"/></w:pPr><w: