---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PasmanChat from '../components/PasmanChat.astro';
import InstallApp from '../components/InstallApp.astro';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.name,
  description = SITE.description,
  image = '/images/cover-default.svg',
  type = 'website',
  canonical,
  jsonLd,
} = Astro.props;

const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
const pageUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = image.startsWith('http') ? image : new URL(image, SITE.url).toString();
const ld = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE.name,
        url: SITE.url,
        description: SITE.description,
        inLanguage: 'id-ID',
      },
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
        logo: `${SITE.url}/favicon.png`,
        email: SITE.email,
      },
    ];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Lora:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&family=Open+Sans:wght@400;600;700;800&family=Bellota:wght@400;700&family=Charm:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <meta name="theme-color" content="#05152E" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('zonapas-theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>
    <script is:inline>
      // Terapkan font pilihan pembaca sedini mungkin (hindari kedip font).
      try {
        var f = localStorage.getItem('zonapas-font');
        if (f && ['roboto', 'lora', 'quicksand', 'open-sans', 'bellota', 'charm'].indexOf(f) !== -1) {
          document.documentElement.setAttribute('data-font', f);
        }
      } catch (e) {}
    </script>
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class="bg-white text-slate-900 antialiased dark:bg-[#0F172A] dark:text-slate-100">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <PasmanChat />
    <InstallApp />
    {/*
      Tombol "Kembali ke atas" (semua halaman). Diposisikan di atas tombol
      PasBot (kanan bawah, 64px + jarak 16px) dan di atas banner install
      aplikasi — sebelumnya tombol ini hanya ada di halaman artikel dengan
      posisi bottom-5 sehingga tertutup tombol PasBot.
    */}
    <button
      type="button"
      data-ke-atas
      class="fixed bottom-24 right-5 z-50 hidden h-11 w-11 items-center justify-center rounded-full bg-[#0A2540] text-white shadow-lg hover:bg-[#14365c] dark:bg-white dark:text-[#0A2540]"
      aria-label="Kembali ke atas"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
    </button>
    <script is:inline>
      // Tombol "Kembali ke atas": muncul setelah menggulir 600px.
      (function () {
        var tombol = document.querySelector('[data-ke-atas]');
        if (!tombol) return;
        function perbarui() {
          var tampil = window.scrollY > 600;
          tombol.classList.toggle('hidden', !tampil);
          tombol.classList.toggle('flex', tampil);
        }
        window.addEventListener('scroll', perbarui, { passive: true });
        tombol.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
        perbarui();
      })();
    </script>
    <script is:inline>
      // Toggle mode gelap/terang
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-theme-toggle]');
        if (!btn) return;
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('zonapas-theme', isDark ? 'dark' : 'light'); } catch (err) {}
        document.querySelectorAll('[data-theme-toggle] .theme-icon-moon').forEach((el) => el.classList.toggle('hidden', isDark));
        document.querySelectorAll('[data-theme-toggle] .theme-icon-sun').forEach((el) => el.classList.toggle('hidden', !isDark));
      });
      // Sinkronkan ikon tombol dengan tema AWAL (D2): tema tersimpan
      // diterapkan di <head>, sebelum tombol ada — tanpa ini, mode gelap
      // yang tersimpan tetap menampilkan ikon bulan (seolah-olah situs
      // masih terang) sampai tombol diklik sekali.
      (function () {
        var gelap = document.documentElement.classList.contains('dark');
        document.querySelectorAll('[data-theme-toggle] .theme-icon-moon').forEach((el) => el.classList.toggle('hidden', gelap));
        document.querySelectorAll('[data-theme-toggle] .theme-icon-sun').forEach((el) => el.classList.toggle('hidden', !gelap));
      })();
      // Menu mobile
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-menu-toggle]');
        if (!btn) return;
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
      });
      // Animasi muncul perlahan: kartu berita yang masuk ke layar
      // perlahan terlihat (tanpa JS, kartu tetap terlihat normal).
      try {
        var kartuReveal = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          kartuReveal.forEach((el) => el.classList.add('terlihat'));
        } else if (kartuReveal.length) {
          document.documentElement.classList.add('js-reveal');
          var pengamat = new IntersectionObserver((masukan) => {
            masukan.forEach((m) => {
              if (m.isIntersecting) { m.target.classList.add('terlihat'); pengamat.unobserve(m.target); }
            });
          }, { threshold: 0.1 });
          kartuReveal.forEach((el) => pengamat.observe(el));
        }
      } catch (e) {}
    </script>
    <script is:inline>
      // Ganti font pembaca (Roboto, Lora, Quicksand, Open Sans, Bellota,
      // Charm). Pilihan disimpan di localStorage dan berlaku di semua
      // halaman; semua <select data-font-select> selalu disinkronkan.
      (function () {
        var VALID = ['roboto', 'lora', 'quicksand', 'open-sans', 'bellota', 'charm'];
        function terapkanFont(nilai) {
          if (nilai && VALID.indexOf(nilai) !== -1) {
            document.documentElement.setAttribute('data-font', nilai);
            try { localStorage.setItem('zonapas-font', nilai); } catch (e) {}
          } else {
            document.documentElement.removeAttribute('data-font');
            try { localStorage.removeItem('zonapas-font'); } catch (e) {}
          }
          document.querySelectorAll('[data-font-select]').forEach(function (el) { el.value = nilai || ''; });
        }
        document.addEventListener('change', function (e) {
          var sel = e.target && e.target.closest ? e.target.closest('[data-font-select]') : null;
          if (!sel) return;
          terapkanFont(sel.value);
        });
        try {
          var awal = document.documentElement.getAttribute('data-font') || '';
          document.querySelectorAll('[data-font-select]').forEach(function (el) { el.value = awal; });
        } catch (e) {}
        window.__terapkanFontZonaPas = terapkanFont;
      })();
    </script>
    <script is:inline>
      // Daftarkan service worker (PWA/TWA). Gagal daftar = halaman tetap jalan normal.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
