---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const wa = `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const x = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const tg = `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
---

<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Bagikan artikel">
  <span class="mr-1 text-sm font-bold text-slate-600 dark:text-slate-300">Bagikan:</span>
  <a href={wa} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-full bg-[#25D366] px-3 py-1.5 text-xs font-bold text-white hover:opacity-90" aria-label="Bagikan ke WhatsApp">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5.1-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.6.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.3-.4 0-.5.2-.8l.4-.5c.1-.2.1-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.9 2.9 4.5 4 .6.3 1.1.4 1.5.6.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3z"/></svg>
    WhatsApp
  </a>
  <a href={fb} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-full bg-[#1877F2] px-3 py-1.5 text-xs font-bold text-white hover:opacity-90" aria-label="Bagikan ke Facebook">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8v3h2.5v7h3z"/></svg>
    Facebook
  </a>
  <a href={x} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-full bg-black px-3 py-1.5 text-xs font-bold text-white hover:opacity-90 dark:bg-white dark:text-black" aria-label="Bagikan ke X">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.7 3H21l-7.3 8.3L22.2 21h-6.7l-5.2-6.3L4.3 21H1l7.8-8.9L1.5 3h6.9l4.7 5.7L17.7 3zm-1.2 16h1.9L6.9 4.9H4.9L16.5 19z"/></svg>
    X
  </a>
  <a href={tg} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-full bg-[#229ED9] px-3 py-1.5 text-xs font-bold text-white hover:opacity-90" aria-label="Bagikan ke Telegram">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.6l-3.1 14.7c-.2 1-.8 1.3-1.7.8l-4.6-3.4-2.2 2.1c-.2.2-.4.4-.9.4l.3-4.6L18.1 8c.4-.3-.1-.5-.6-.2L7.2 14.1 2.7 12.7c-1-.3-1-1 .2-1.4l17.6-6.8c.8-.3 1.5.2 1.4 1.1z"/></svg>
    Telegram
  </a>
  <button
    type="button"
    data-share-instagram
    data-url={url}
    class="flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-bold text-white hover:opacity-90"
    style="background:linear-gradient(45deg,#f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%)"
    aria-label="Bagikan ke Instagram"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
    <span data-ig-label>Instagram</span>
  </button>
  <button
    type="button"
    data-copy-link={url}
    class="flex items-center gap-1.5 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
    aria-label="Salin tautan artikel"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" /></svg>
    <span data-copy-label>Salin Link</span>
  </button>
</div>

<script is:inline>
  // Komponen ini dipakai dua kali per halaman artikel (atas + bawah), jadi
  // skrip ini ikut tampil dua kali — ikat listener hanya sekali.
  if (!window.__zonapasShareBound) {
    window.__zonapasShareBound = true;
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-share-instagram]');
    if (!btn) return;
    const link = btn.getAttribute('data-url') || location.href;
    const label = btn.querySelector('[data-ig-label]');
    // Instagram tidak punya tautan berbagi seperti WA/FB/X, dan Bos Besar minta
    // tautan saja tanpa gambar: salin tautan artikel, lalu buka kamera Story
    // Instagram langsung (tautan ditempel sebagai stiker tautan di Story).
    // Bila aplikasi tidak terbuka, buka Instagram web sebagai cadangan.
    try {
      await navigator.clipboard.writeText(link);
    } catch (err) {
      const ta = document.createElement('textarea');
      ta.value = link; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (e2) {}
      document.body.removeChild(ta);
    }
    if (label) { label.textContent = 'Tautan disalin!'; setTimeout(() => { label.textContent = 'Instagram'; }, 3000); }
    const ifr = document.createElement('iframe');
    ifr.style.display = 'none';
    ifr.src = 'instagram://story-camera';
    document.body.appendChild(ifr);
    setTimeout(() => {
      if (ifr.parentNode) ifr.parentNode.removeChild(ifr);
      if (!document.hidden) window.open('https://www.instagram.com/', '_blank', 'noopener');
    }, 2000);
  });
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-copy-link]');
    if (!btn) return;
    const link = btn.getAttribute('data-copy-link');
    try {
      await navigator.clipboard.writeText(link);
      const label = btn.querySelector('[data-copy-label]');
      if (label) { label.textContent = 'Tersalin!'; setTimeout(() => { label.textContent = 'Salin Link'; }, 2000); }
    } catch (err) {
      const ta = document.createElement('textarea');
      ta.value = link; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (e2) {}
      document.body.removeChild(ta);
      const label = btn.querySelector('[data-copy-label]');
      if (label) { label.textContent = 'Tersalin!'; setTimeout(() => { label.textContent = 'Salin Link'; }, 2000); }
    }
  });
  }
</script>
