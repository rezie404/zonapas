---
import { CATEGORIES, SITE } from '../data/site';
---

<footer class="mt-12 border-t-4 border-[#D9232E] bg-[#0A2540] text-slate-300">
  <div class="mx-auto max-w-[1200px] px-4 py-10">
    <div class="mb-8 rounded-xl border border-white/15 bg-white/5 p-5">
      <h2 class="text-base font-black text-white">Berlangganan Berita ZonaPas</h2>
      <p class="mt-1 text-sm text-slate-300">Artikel terbaru langsung ke email Anda.</p>
      <form id="form-langganan" class="mt-4 flex flex-col gap-2 sm:flex-row">
        <label for="email-langganan" class="sr-only">Alamat email</label>
        <input id="email-langganan" name="email" type="email" required placeholder="alamat@email.com" class="w-full flex-1 rounded-lg bg-white px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400" />
        <button type="submit" class="rounded-lg bg-[#FACC15] px-5 py-2.5 text-sm font-bold text-[#0A2540] hover:bg-[#fde047]">Berlangganan</button>
      </form>
      <p data-status-langganan class="mt-2 text-sm text-slate-300" role="status"></p>
    </div>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2" aria-label="ZonaPas — Beranda">
          <img src="/images/logo-zonapas-nama-v2.png" alt="Logo ZonaPas" width="720" height="153" class="h-10 w-auto rounded-md bg-white px-2 py-1" />
        </a>
        <p class="mt-3 text-sm leading-relaxed text-slate-400">
          {SITE.tagline}. Portal berita pemasyarakatan — pembinaan, pengamanan, pelayanan, integrasi dan remisi, serta kegiatan UPT Pemasyarakatan di lingkungan Kanwil Ditjenpas Bengkulu.
        </p>
        <p class="mt-3 text-sm italic text-slate-400">
          Moto Ditjenpas: &ldquo;Griya Winaya Janma Wimarga Laksa Dharmmesti&rdquo;
        </p>
        <p class="mt-3 text-sm text-slate-400">Email redaksi: {SITE.email}</p>
        <p class="mt-2 text-sm">
          <a href="https://ditjenpas.go.id" target="_blank" rel="noopener" class="font-bold text-white hover:underline">Situs resmi Ditjenpas &rarr;</a>
        </p>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Kategori</h3>
        <ul class="mt-3 grid grid-cols-2 gap-2 text-sm">
          {CATEGORIES.filter((cat) => cat.slug !== 'profil-upt' && cat.slug !== 'kegiatan-upt').map((cat) => (
            <li><a href={`/${cat.slug}/`} class="hover:text-white">{cat.name}</a></li>
          ))}
          <li><a href="/upt/" class="hover:text-white">Berita UPT</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Tentang Kami</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/tentang/" class="hover:text-white">Tentang ZonaPas</a></li>
          <li><a href="/redaksi/" class="hover:text-white">Redaksi</a></li>
          <li><a href="/pedoman-media-siber/" class="hover:text-white">Pedoman Media Siber</a></li>
          <li><a href="/kebijakan-privasi/" class="hover:text-white">Kebijakan Privasi</a></li>
          <li><a href="/kontak/" class="hover:text-white">Kontak</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Layanan</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/info-iklan/" class="hover:text-white">Info Iklan</a></li>
          <li><a href="/cari/" class="hover:text-white">Pencarian Berita</a></li>
          <li><a href="/masuk/" class="hover:text-white">Masuk</a></li>
          <li><a href="/rss.xml" class="hover:text-white">RSS Feed</a></li>
          <li><a href="/sitemap.xml" class="hover:text-white">Peta Situs</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-5 text-xs text-slate-400 sm:flex-row">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. Hak cipta dilindungi undang-undang.</p>
      <p>Portal berita berbahasa Indonesia.</p>
    </div>
  </div>
</footer>

<script is:inline>
  // Formulir langganan email berita (footer, semua halaman).
  (function () {
    var form = document.getElementById('form-langganan');
    if (!form) return;
    var status = form.parentElement.querySelector('[data-status-langganan]');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = form.email.value.trim();
      if (!email) return;
      status.textContent = 'Mendaftar…';
      try {
        var r = await fetch('https://zonapas.web.id/redaksi/api/langganan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email }),
        });
        var d = await r.json().catch(function () { return {}; });
        if (r.ok && d.ok) {
          status.textContent = 'Cek email Anda untuk konfirmasi langganan.';
          form.reset();
        } else {
          status.textContent = (d && d.error) || 'Gagal mendaftar. Coba lagi sebentar lagi.';
        }
      } catch (err) {
        status.textContent = 'Tidak bisa terhubung ke server. Coba lagi sebentar lagi.';
      }
    });
  })();
</script>
