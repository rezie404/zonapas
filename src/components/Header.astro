---
import { CATEGORIES, SITE } from '../data/site';

const currentPath = Astro.url.pathname;
const isMasukPage = currentPath === '/masuk' || currentPath === '/masuk/';
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-[#0F172A]/95">
  <div class="mx-auto max-w-[1200px] px-4">
    <div class="flex h-16 items-center justify-between gap-3">
      <a href="/" class="flex items-center gap-2.5" aria-label="ZonaPas — Beranda">
        <span class="leading-none">
          <img src="/images/logo-zonapas-nama-v2.png" alt="Logo ZonaPas" width="720" height="153" class="h-11 w-auto shrink-0 rounded-lg dark:bg-white dark:px-2 dark:py-0.5" />
          <span class="mt-1 hidden text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 sm:block dark:text-slate-400">Melihat Pemasyarakatan Lebih Dekat</span>
        </span>
      </a>

      <div class="flex items-center gap-1 sm:gap-2">
        <a
          href="/cari/"
          class="flex h-10 items-center gap-2 rounded-full border border-slate-200 px-3 text-sm text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
          aria-label="Cari berita"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" /></svg>
          <span class="hidden md:inline">Cari berita…</span>
        </a>
        {!isMasukPage && (
          <div class="relative" data-menu-profil-wadah>
            <a
              href="/masuk/"
              data-header-masuk
              class="flex h-10 items-center rounded-full bg-[#0A2540] px-4 text-sm font-bold text-white hover:bg-[#14365c] dark:bg-white dark:text-[#0A2540] dark:hover:bg-slate-200"
            >
              Masuk
            </a>
            <!-- Lencana notifikasi antrean (Nov 2026): jumlah berita yang
                 menunggu persetujuan, tampil di sudut tombol profil untuk
                 Penyunting/Administrator. Disembunyikan bila 0 / bukan
                 penyetuju. Diisi lewat cekLoginHeader di bawah. -->
            <span data-header-lencana class="absolute -right-1.5 -top-1.5 z-10 hidden min-w-[20px] items-center justify-center rounded-full bg-[#D9232E] px-1.5 py-0.5 text-[11px] font-bold leading-none text-white" aria-label="Antrean persetujuan menunggu">0</span>
            <div
              data-menu-profil
              class="absolute right-0 top-full z-50 mt-2 hidden w-56 rounded-xl border border-slate-200 bg-white py-1 shadow-lg dark:border-slate-700 dark:bg-slate-900"
              role="menu"
              aria-label="Menu profil"
            >
              <div class="border-b border-slate-200 px-4 py-2 dark:border-slate-700">
                <p data-menu-nama class="truncate text-sm font-bold text-slate-800 dark:text-slate-100"></p>
                <p data-menu-email class="truncate text-xs text-slate-500 dark:text-slate-400"></p>
              </div>
              <a data-menu-kelola href="/portal/" class="block px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800" role="menuitem">Portal Redaksi</a>
              <a data-menu-ajukan href="/ajukan-penulis/" class="block px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800" role="menuitem">Ajukan Jadi Penulis</a>
              <button type="button" data-menu-keluar class="block w-full px-4 py-2 text-left text-sm font-bold text-[#D9232E] hover:bg-slate-100 dark:hover:bg-slate-800" role="menuitem">Keluar</button>
            </div>
          </div>
        )}
        <button
          type="button"
          data-theme-toggle
          class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
          aria-label="Ganti mode gelap atau terang"
        >
          <span class="theme-icon-moon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" /></svg>
          </span>
          <span class="theme-icon-sun hidden">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.71-.71M6.34 6.34l-.71-.71m12.02 0l-.71.71M6.34 17.66l-.71.71M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          </span>
        </button>
        <button
          type="button"
          data-menu-toggle
          class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:bg-slate-100 lg:hidden dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
          aria-label="Buka menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>
    </div>

    <nav class="hidden items-center gap-1 overflow-x-auto pb-2 lg:flex" aria-label="Kategori berita">
      <a href="/" class={`whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-bold ${currentPath === '/' ? 'bg-[#0A2540] text-white' : 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800'}`}>Beranda</a>
      {CATEGORIES.filter((cat) => cat.slug !== 'profil-upt' && cat.slug !== 'kegiatan-upt').map((cat) => (
        <a
          href={`/${cat.slug}/`}
          class={`whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-semibold ${currentPath.startsWith(`/${cat.slug}/`) ? 'bg-[#0A2540] text-white' : 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800'}`}
        >
          {cat.name}
        </a>
      ))}
      <a
        href="/upt/"
        class={`whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-semibold ${currentPath.startsWith('/upt/') ? 'bg-[#0A2540] text-white' : 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800'}`}
      >
        Berita UPT
      </a>
    </nav>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-4 py-3 lg:hidden dark:border-slate-800 dark:bg-[#0F172A]">
    <nav class="grid grid-cols-2 gap-1" aria-label="Menu kategori">
      <a href="/" class="rounded-lg px-3 py-2 text-sm font-bold hover:bg-slate-100 dark:hover:bg-slate-800">Beranda</a>
      {CATEGORIES.filter((cat) => cat.slug !== 'profil-upt' && cat.slug !== 'kegiatan-upt').map((cat) => (
        <a href={`/${cat.slug}/`} class="rounded-lg px-3 py-2 text-sm font-semibold hover:bg-slate-100 dark:hover:bg-slate-800">{cat.name}</a>
      ))}
      <a href="/upt/" class="rounded-lg px-3 py-2 text-sm font-semibold hover:bg-slate-100 dark:hover:bg-slate-800">Berita UPT</a>
      {!isMasukPage && (
        <a href="/masuk/" data-header-masuk class="rounded-lg bg-[#0A2540] px-3 py-2 text-sm font-bold text-white hover:bg-[#14365c] dark:bg-white dark:text-[#0A2540]">Masuk</a>
      )}
    </nav>
  </div>
</header>

<script is:inline>
  // Status login + logout paksa setelah 10 menit tanpa aktivitas.
  // - Tampilan: tombol "Masuk" di header berubah jadi nama depan pengguna
  //   saat sudah login (kecuali di /portal/, yang diurus halaman
  //   itu sendiri: tombolnya jadi "Keluar").
  // - Idle: aktivitas terakhir dicatat di localStorage (dibagi semua tab)
  //   dan disentuh ke server max 1x/2 menit; bila 10 menit tidak ada
  //   aktivitas di tab mana pun, sesi dipaksa keluar ke /masuk/?alasan=idle.
  (function () {
    var IDLE_MS = 10 * 60 * 1000;
    var TOUCH_MS = 2 * 60 * 1000;
    var KUNCI = 'zonapas-aktivitas-terakhir';
    var diKelola = window.location.pathname.replace(/\/$/, '') === '/portal';
    var sedangMasuk = false;
    var terakhirSentuh = 0;
    var sudahKeluar = false;

    function namaDepan(nama) {
      var s = String(nama || '').trim();
      return s ? s.split(/\s+/)[0] : 'Akun';
    }
    function perbaruiHeader(user) {
      var tautan = document.querySelectorAll('[data-header-masuk]');
      if (!tautan.length) return;
      var tujuan = (user.role === 'pembaca') ? '/' : '/portal/';
      tautan.forEach(function (el) {
        el.textContent = namaDepan(user.name || user.email);
        el.setAttribute('href', tujuan);
      });
    }
    // Keluar manual dari menu profil — langkahnya sama persis dengan tombol
    // Keluar di Kelola Berita (POST /redaksi/logout, hapus token + kunci
    // aktivitas, kembali ke /masuk/).
    async function keluarManual(e) {
      if (e) e.preventDefault();
      try { await fetch('/redaksi/logout', { method: 'POST', credentials: 'same-origin' }); } catch (err) {}
      try { sessionStorage.removeItem('zonapas-kelola-token'); } catch (err) {}
      try { localStorage.removeItem(KUNCI); } catch (err) {}
      window.location.href = '/masuk/';
    }
    // Menu profil: ketuk nama di header → muncul nama + email akun, tautan
    // Kelola Berita (hanya Redaksi), dan tombol Keluar.
    var menuTerpasang = false;
    function pasangMenuProfil(user) {
      var wadah = document.querySelector('[data-menu-profil-wadah]');
      if (!wadah) return;
      var tombol = wadah.querySelector('[data-header-masuk]');
      var menu = wadah.querySelector('[data-menu-profil]');
      if (!tombol || !menu) return;
      var nama = menu.querySelector('[data-menu-nama]');
      var email = menu.querySelector('[data-menu-email]');
      var namaTampil = user.name || user.email || 'Akun';
      var emailTampil = user.email || '';
      // Sesi GitHub memakai identitas sintetis ("Rezie" / "github:rezie404");
      // di menu profil tampilkan identitas asli administrator.
      if (user.source === 'github' && user.email === 'github:rezie404') {
        namaTampil = 'Rezie Novian Putra';
        emailTampil = 'rezienovian@gmail.com';
      }
      if (nama) nama.textContent = namaTampil;
      if (email) email.textContent = emailTampil;
      var kelola = menu.querySelector('[data-menu-kelola]');
      var ajukan = menu.querySelector('[data-menu-ajukan]');
      if (user.role === 'pembaca') {
        if (kelola) kelola.style.display = 'none';
        if (ajukan) ajukan.style.display = '';
      } else {
        // Tautan ajukan hanya untuk Pembaca; Redaksi sudah punya peran.
        if (ajukan) ajukan.style.display = 'none';
        if (kelola) kelola.style.display = '';
      }
      // Pasang listener sekali saja — pemanggilan ulang hanya menyegarkan
      // nama/email dan visibilitas tautan di atas.
      if (menuTerpasang) return;
      menuTerpasang = true;
      var terbuka = false;
      function aturMenu(buka) {
        terbuka = buka;
        menu.classList.toggle('hidden', !buka);
        tombol.setAttribute('aria-expanded', buka ? 'true' : 'false');
      }
      tombol.setAttribute('aria-haspopup', 'true');
      tombol.setAttribute('aria-expanded', 'false');
      tombol.addEventListener('click', function (e) {
        e.preventDefault();
        aturMenu(!terbuka);
      });
      var btnKeluar = menu.querySelector('[data-menu-keluar]');
      if (btnKeluar) btnKeluar.addEventListener('click', keluarManual);
      document.addEventListener('click', function (e) {
        if (terbuka && !wadah.contains(e.target)) aturMenu(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && terbuka) aturMenu(false);
      });
    }
    function catatAktivitas() {
      if (!sedangMasuk) return;
      try { localStorage.setItem(KUNCI, String(Date.now())); } catch (e) {}
      var kini = Date.now();
      if (kini - terakhirSentuh < TOUCH_MS) return;
      terakhirSentuh = kini;
      // Sentuh server supaya last_seen_at ikut diperbarui.
      fetch('/redaksi/api/me', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).catch(function () {});
    }
    function cekIdle() {
      if (!sedangMasuk || sudahKeluar) return;
      var terakhir = 0;
      try { terakhir = parseInt(localStorage.getItem(KUNCI) || '0', 10) || 0; } catch (e) {}
      if (terakhir && Date.now() - terakhir > IDLE_MS) paksaKeluar();
    }
    async function paksaKeluar() {
      if (sudahKeluar) return;
      sudahKeluar = true;
      try { await fetch('/redaksi/logout', { method: 'POST', credentials: 'same-origin' }); } catch (e) {}
      try { sessionStorage.removeItem('zonapas-kelola-token'); } catch (e) {}
      try { localStorage.removeItem(KUNCI); } catch (e) {}
      window.location.href = '/masuk/?alasan=idle';
    }
    ['click', 'keydown', 'touchstart'].forEach(function (ev) {
      window.addEventListener(ev, catatAktivitas, { passive: true });
    });
    window.addEventListener('scroll', catatAktivitas, { passive: true });
    var terakhirMouse = 0;
    window.addEventListener('mousemove', function () {
      var kini = Date.now();
      if (kini - terakhirMouse < 5000) return;
      terakhirMouse = kini;
      catatAktivitas();
    }, { passive: true });
    setInterval(cekIdle, 30000);

    // Lencana notifikasi antrean (Nov 2026): untuk Penyunting dan
    // Administrator — jumlah berita berstatus "menunggu" persetujuan.
    // Diambil dari /redaksi/api/antrean (sama seperti halaman Antrean)
    // lalu ditampilkan di sudut tombol profil di header. Bila 0, lencana
    // disembunyikan. Penulis/Pembaca tidak mendapat lencana ini.
    function perbaruiLencanaAntrean(user) {
      var lencana = document.querySelector('[data-header-lencana]');
      if (!lencana) return;
      if (user.role !== 'admin' && user.role !== 'penyunting') {
        lencana.classList.add('hidden');
        return;
      }
      var token = ambilTokenGithub();
      var headers = {};
      if (token) headers['X-GitHub-Token'] = token;
      fetch('/redaksi/api/antrean', { credentials: 'same-origin', headers: headers })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          var n = 0;
          if (d && d.ok && Array.isArray(d.articles)) {
            n = d.articles.filter(function (a) { return a.status === 'menunggu'; }).length;
          }
          lencana.textContent = String(n);
          lencana.classList.toggle('hidden', n === 0);
          lencana.setAttribute('aria-label', n > 0 ? (n + ' antrean persetujuan menunggu') : 'Tidak ada antrean persetujuan');
        })
        .catch(function () { lencana.classList.add('hidden'); });
    }
    // Cek login header dengan auth yang SAMA seperti kelola-umum.js: cookie
    // + token GitHub dari sessionStorage bila ada. Tanpa token, sesi yang
    // hanya hidup lewat token (cookie kedaluwarsa/belum ditukar) membuat
    // header tetap "Masuk" padahal halaman sudah login.
    function ambilTokenGithub() {
      try { return sessionStorage.getItem('zonapas-kelola-token') || ''; } catch (e) { return ''; }
    }
    function cekLoginHeader() {
      var token = ambilTokenGithub();
      var headers = { 'Content-Type': 'application/json' };
      var body = {};
      if (token) { headers['X-GitHub-Token'] = token; body.github_token = token; }
      return fetch('/redaksi/api/me', { method: 'POST', credentials: 'same-origin', headers: headers, body: JSON.stringify(body) })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok && d.user) {
            sedangMasuk = true;
            if (!diKelola) { perbaruiHeader(d.user); pasangMenuProfil(d.user); perbaruiLencanaAntrean(d.user); }
            catatAktivitas();
            cekIdle();
            return true;
          }
          return false;
        })
        .catch(function () { return false; });
    }
    // Dipanggil kelola-umum.js setelah login berhasil di halaman Portal,
    // supaya header ikut berubah tanpa menunggu muat ulang.
    window.__segarkanHeaderLogin = function () { if (!diKelola) cekLoginHeader(); };
    cekLoginHeader().then(function (ok) {
      // Bila cookie belum ada saat header dicek (kelola-umum.js baru menukar
      // token jadi cookie sesaat setelahnya), coba sekali lagi.
      if (!ok) setTimeout(cekLoginHeader, 2000);
    });
  })();
</script>
