---
import type { CollectionEntry } from 'astro:content';
import { categoryByName, formatDateShort, thumbCover, fokusWajah } from '../data/site';

interface Props {
  entry: CollectionEntry<'berita'>;
  size?: 'small' | 'medium' | 'large';
  showCategory?: boolean;
}

const { entry, size = 'medium', showCategory = true } = Astro.props;
const { title, summary, category, image, imageCaption, publishDate, source } = entry.data;
const cat = categoryByName(category);
const url = `/berita/${entry.id.replace(/\.md$/, '')}/`;
// Titik fokus wajah (object-position) supaya jendela 16:9 kartu
// menampilkan wajah orang terdepan — foto tidak di-crop, hanya
// jendela tampilannya yang digeser ke wajah.
const fokus = fokusWajah(image);

// Kutipan narasi: teks polos dari awal badan artikel (baris gambar dibuang,
// format Markdown/HTML dilucuti). Kartu menampilkan 4 baris pertama saja;
// ringkasan frontmatter tidak lagi dipakai di kartu (tetap dipakai meta
// description, JSON-LD, dan RSS — diisi otomatis dari narasi saat simpan).
function teksNarasi(body: string) {
  return (body || '')
    .split('\n')
    .filter((baris) => !/^\s*!\[.*?\]\(.*?\)\s*$/.test(baris))
    .join('\n')
    .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`#>|]/g, '')
    .replace(/<[^>]*>/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}
const narasi = teksNarasi(entry.body) || summary;
---

{size === 'small' ? (
  <a href={url} data-reveal class="group flex gap-3 py-3 transition-transform duration-200 hover:-translate-y-0.5">
    <span class="block aspect-video w-28 shrink-0 overflow-hidden rounded-lg">
      <img src={thumbCover(image, 320)} data-asli={image} alt={imageCaption} loading="lazy" width="320" height="180" class="h-full w-full object-cover" style={`object-position:${fokus.x}% ${fokus.y}%`} onerror="if(this.dataset.fb){this.onerror=null;this.src='/images/cover-default.svg';}else{this.dataset.fb='1';this.src=this.dataset.asli;}" />
    </span>
    <span>
      {showCategory && cat && <span class="text-xs font-bold uppercase tracking-wide" style={`color:${cat.color}`}>{cat.name}</span>}
      {source === 'contoh' && <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-900/50 dark:text-amber-200">Artikel Contoh</span>}
      <span class="mt-0.5 block text-sm font-bold leading-snug group-hover:text-[#D9232E] group-hover:underline">{title}</span>
      <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">{formatDateShort(publishDate)}</span>
    </span>
  </a>
) : size === 'large' ? (
  <a href={url} data-reveal class="group relative block overflow-hidden rounded-2xl">
    <img src={image} alt={imageCaption} loading="eager" width="1200" height="675" class="h-auto w-full transition-transform duration-300 group-hover:scale-105" onerror="this.onerror=null;this.src='/images/cover-default.svg'" />
    <span class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></span>
    <span class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
      {showCategory && cat && <span class="inline-block rounded bg-[#D9232E] px-2 py-1 text-xs font-bold uppercase tracking-wide text-white">{cat.name}</span>}
      {source === 'contoh' && <span class="ml-2 inline-block rounded bg-amber-400 px-2 py-1 text-xs font-bold uppercase tracking-wide text-amber-950">Artikel Contoh</span>}
      <span class="mt-2 block text-xl font-extrabold leading-tight text-white sm:text-3xl">{title}</span>
      <span class="mt-2 hidden text-justify text-sm text-slate-200 line-clamp-4 sm:line-clamp-4">{narasi}</span>
      <span class="mt-2 hidden text-sm font-bold text-white group-hover:underline sm:block">Lanjutkan membaca →</span>
      <span class="mt-2 block text-xs text-slate-300">{formatDateShort(publishDate)}</span>
    </span>
  </a>
) : (
  <a href={url} data-reveal class="group block overflow-hidden rounded-xl border border-slate-200 bg-white transition-all hover:-translate-y-1 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
    <span class="block aspect-video w-full overflow-hidden">
      <img src={thumbCover(image, 640)} data-asli={image} alt={imageCaption} loading="lazy" width="640" height="360" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" style={`object-position:${fokus.x}% ${fokus.y}%`} onerror="if(this.dataset.fb){this.onerror=null;this.src='/images/cover-default.svg';}else{this.dataset.fb='1';this.src=this.dataset.asli;}" />
    </span>
    <span class="block p-4">
      {showCategory && cat && <span class="text-xs font-bold uppercase tracking-wide" style={`color:${cat.color}`}>{cat.name}</span>}
      {source === 'contoh' && <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-900/50 dark:text-amber-200">Artikel Contoh</span>}
      <span class="mt-1 block text-base font-bold leading-snug group-hover:text-[#D9232E]">{title}</span>
      <span class="mt-2 text-justify text-sm text-slate-600 line-clamp-4 dark:text-slate-400">{narasi}</span>
      <span class="mt-2 block text-sm font-bold text-[#D9232E] group-hover:underline">Lanjutkan membaca →</span>
      <span class="mt-3 block text-xs text-slate-500 dark:text-slate-400">{formatDateShort(publishDate)}</span>
    </span>
  </a>
)}
