---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Masuk" description="Masuk ke ZonaPas — dengan GitHub atau Google. Keduanya membawa Anda ke Portal Redaksi.">
  <div class="mx-auto max-w-[900px] px-4 pt-6 pb-6">
    <a href="/" class="text-sm font-bold text-slate-500 hover:text-[#0A2540] dark:text-slate-400 dark:hover:text-white">&larr; Kembali ke Beranda</a>
    <div class="mt-6 text-center">
      <h1 class="text-3xl font-black text-[#0A2540] sm:text-4xl dark:text-white">Masuk</h1>
      <div class="mx-auto mt-3 h-1.5 w-16 rounded-full bg-[#FACC15]"></div>
      <p class="mx-auto mt-4 max-w-[560px] text-[17px] leading-relaxed text-slate-600 dark:text-slate-300">
        Pilih cara masuk. Aksesnya mengikuti peran akun Anda — Redaksi masuk ke Portal Redaksi, Pembaca kembali ke artikel yang sedang dibaca.
      </p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <div
        class="flex flex-col rounded-2xl border-2 border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#0A2540] text-[#FACC15]">
          <svg viewBox="0 0 16 16" class="h-6 w-6 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
        </span>
        <h2 class="mt-4 text-xl font-black text-[#0A2540] dark:text-white">Masuk dengan GitHub</h2>
        <p class="mt-2 flex-1 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
          Khusus Administrator. Penyunting dan Penulis masuk lewat Google + undangan.
        </p>
        <button
          id="btn-login-github"
          type="button"
          class="mt-4 inline-flex items-center justify-center gap-2 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]"
        >
          <svg viewBox="0 0 16 16" class="h-5 w-5 shrink-0 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
          Masuk dengan GitHub
        </button>
        <p class="mt-2 text-center text-xs font-bold text-[#0A2540] dark:text-[#FACC15]">Khusus Administrator</p>
        <p id="login-status" class="mt-3 hidden text-xs font-medium" role="status"></p>
        <!-- Fallback bila popup diblokir: tautan ini membuka alur OAuth di tab
             baru. Sengaja TANPA rel="noopener" supaya window.opener tetap ada
             dan Worker OAuth bisa mengirim token kembali ke halaman ini. -->
        <p id="login-fallback" class="mt-3 hidden text-xs text-slate-500 dark:text-slate-400">
          Popup diblokir?
          <a href="https://oauth.zonapas.web.id/auth" target="_blank" class="font-bold text-[#0A2540] underline dark:text-white">Buka login GitHub di tab baru</a>
          — setelah otorisasi, kembali ke tab ini.
        </p>
      </div>

      <div
        class="flex flex-col rounded-2xl border-2 border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900"
      >
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#0A2540] text-[#FACC15]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </span>
        <h2 class="mt-4 text-xl font-black text-[#0A2540] dark:text-white">Masuk dengan Google</h2>
        <p class="mt-2 flex-1 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300">
          Untuk akun Redaksi (Administrator, Penyunting, Penulis). Penyunting dan Penulis masuk lewat undangan dari Administrator. Pembaca juga masuk lewat Google — tanpa undangan — untuk menyukai dan mengomentari artikel.
        </p>
        <a
          id="tautan-login-google"
          href="/redaksi/auth/google"
          class="mt-4 inline-flex items-center justify-center gap-2 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" aria-hidden="true"><path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z" /><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z" /><path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z" /><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z" /></svg>
          Masuk dengan Google
        </a>
        <p id="catatan-google" class="mt-3 text-xs text-slate-500 dark:text-slate-400">
          Anda akan diarahkan ke Google, lalu kembali ke Portal Redaksi.
        </p>
      </div>
    </div>

    <p class="mt-8 text-center text-sm text-slate-500 dark:text-slate-400">
      Belum punya akses? Silakan hubungi kami melalui halaman <a href="/kontak/" class="font-bold text-[#0A2540] hover:underline dark:text-white">Kontak</a>.
    </p>
  </div>

  <script>
    // Tujuan kembali untuk Pembaca (?next=/berita/...): diteruskan ke alur
    // Google supaya setelah login Pembaca kembali ke artikel yang dibaca.
    // Hanya jalur relatif di situs sendiri yang diteruskan.
    try {
      const params = new URLSearchParams(location.search);
      const next = params.get('next') || '';
      const tautan = document.getElementById('tautan-login-google');
      const catatan = document.getElementById('catatan-google');
      if (next && next.charAt(0) === '/' && next.charAt(1) !== '/' && next.indexOf('\\') === -1 && tautan) {
        tautan.href = '/redaksi/auth/google?next=' + encodeURIComponent(next);
        if (catatan) catatan.textContent = 'Anda akan diarahkan ke Google, lalu kembali ke artikel yang Anda baca.';
      }
      // Datang dari logout paksa karena 10 menit tanpa aktivitas.
      if (params.get('alasan') === 'idle') {
        const statusEl = document.getElementById('login-status');
        if (statusEl) {
          statusEl.textContent = 'Sesi Anda berakhir karena tidak ada aktivitas selama 10 menit. Silakan masuk lagi.';
          statusEl.classList.remove('hidden');
          statusEl.style.color = '#B91C1C';
        }
      }
    } catch (e) {}

    // Login GitHub dari /masuk/: popup OAuth yang sama seperti di
    // /portal/. Dibuka dari klik (gesture) supaya tidak diblokir
    // browser. Setelah sukses, token disimpan lalu pindah ke /portal/.
    const OAUTH_AUTH_URL = 'https://oauth.zonapas.web.id/auth';
    const OAUTH_ORIGIN = 'https://oauth.zonapas.web.id';
    let popup = null;
    let popupTimer = null;
    const statusEl = document.getElementById('login-status');

    function setStatusMasuk(msg, ok) {
      if (!statusEl) return;
      statusEl.textContent = msg;
      statusEl.classList.remove('hidden');
      statusEl.style.color = ok ? '#047857' : '#B91C1C';
    }

    window.addEventListener('message', (event) => {
      if (event.origin !== OAUTH_ORIGIN) return;
      if (event.data === 'authorizing:github') {
        // Echo ke pengirim (popup, atau tab baru bila login dibuka lewat
        // tautan fallback). Worker menunggu echo ini.
        const target = (popup && !popup.closed) ? popup : (event.source || null);
        if (target) target.postMessage('authorizing:github', OAUTH_ORIGIN);
        return;
      }
      if (typeof event.data === 'string' && event.data.indexOf('authorization:github:success:') === 0) {
        try {
          const payload = JSON.parse(event.data.slice('authorization:github:success:'.length));
          try { sessionStorage.setItem('zonapas-kelola-token', payload.token); } catch (e) {}
          if (popupTimer) { clearInterval(popupTimer); popupTimer = null; }
          if (popup && !popup.closed) popup.close();
          window.location.href = '/portal/';
        } catch (err) {
          setStatusMasuk('Login gagal: ' + err.message, false);
        }
      }
    });

    const btnGithub = document.getElementById('btn-login-github');
    if (btnGithub) btnGithub.addEventListener('click', () => {
      const labelHtml = btnGithub.innerHTML;
      btnGithub.disabled = true;
      btnGithub.textContent = 'Menghubungkan…';
      const restoreBtn = () => { btnGithub.disabled = false; btnGithub.innerHTML = labelHtml; };
      if (popupTimer) { clearInterval(popupTimer); popupTimer = null; }
      popup = window.open(OAUTH_AUTH_URL, 'zonapas-github-login', 'width=640,height=720,popup=1');
      if (!popup) {
        restoreBtn();
        const fb = document.getElementById('login-fallback');
        if (fb) fb.classList.remove('hidden');
        setStatusMasuk('Popup diblokir browser. Izinkan popup untuk situs ini lalu coba lagi, atau buka login GitHub di tab baru lewat tautan di bawah tombol.', false);
        return;
      }
      setStatusMasuk('Jendela login GitHub dibuka. Selesaikan otorisasi di jendela tersebut…', true);
      popupTimer = setInterval(() => {
        if (popup && popup.closed) {
          clearInterval(popupTimer);
          popupTimer = null;
          let adaToken = false;
          try { adaToken = !!sessionStorage.getItem('zonapas-kelola-token'); } catch (e) {}
          if (!adaToken) {
            restoreBtn();
            setStatusMasuk('Jendela login ditutup sebelum selesai. Klik "Masuk dengan GitHub" untuk mencoba lagi.', false);
          }
        }
      }, 500);
    });
  </script>
</BaseLayout>
