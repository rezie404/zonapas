---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../../data/site';
import { AUTHORS } from '../../../data/authors';

const categoryColors = Object.fromEntries(CATEGORIES.map((c) => [c.name, c.color]));
// Peran/bio penulis untuk pratinjau tampilan terbit (modal mata).
const authorInfoMap = Object.fromEntries(Object.values(AUTHORS).map((a) => [a.name, { role: a.role, bio: a.bio }]));
---

<BaseLayout
  title="Edit Berita"
  description="Daftar berita ZonaPas yang sudah publish — ubah atau hapus."
>
  <!-- Data pulau JSON: HARUS memakai set:html — Astro tidak mengevaluasi
       ekspresi {…} di dalam tag <script>, jadi penulisan {JSON.stringify(…)}
       akan tercetak mentah dan JSON.parse di script utama akan gagal. -->
  <script type="application/json" id="kelola-data" set:html={JSON.stringify({ categoryColors, authors: authorInfoMap })} />

  <div class="mx-auto max-w-[1200px] px-4 py-6">
    <div class="border-b-2 border-[#0A2540] pb-4 dark:border-white">
      <h1 class="text-2xl font-black uppercase tracking-tight sm:text-3xl">Edit Berita</h1>
      <div class="mt-2 h-1.5 w-20 rounded bg-[#FACC15]" aria-hidden="true"></div>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Daftar berita yang sudah publish di ZonaPas. Administrator dapat mengubah atau menghapus berita; tayangan dihitung dari statistik pembaca.
      </p>
    </div>

    <!-- Status -->
    <div id="status" class="mt-4 hidden rounded-lg px-4 py-3 text-sm font-medium" role="status"></div>

    <!-- Login -->
    <section id="login-box" class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
      <img src="/images/logo-zonapas.png" alt="Logo ZonaPas" class="mx-auto h-16 w-16 rounded-full object-cover" width="64" height="64" />
      <h2 class="mt-3 text-lg font-bold">Masuk untuk mengelola berita</h2>
      <p class="mx-auto mt-1 max-w-md text-sm text-slate-600 dark:text-slate-400">
        Masuk dengan GitHub (khusus Administrator) atau dengan akun Google Redaksi Anda.
        Akses dan tombol yang tampil mengikuti peran akun Anda.
      </p>
      <button
        id="btn-login"
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
        Masuk dengan GitHub
      </button>
      <a
        href="/redaksi/auth/google"
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-[#0A2540] hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-800"
      >
        Masuk dengan Google
      </a>
      <!-- Fallback bila popup diblokir: tautan ini membuka alur OAuth di tab
           baru. Sengaja TANPA rel="noopener" supaya window.opener tetap ada
           dan Worker OAuth bisa mengirim token kembali ke halaman ini. -->
      <p id="login-fallback" class="mt-3 hidden text-xs text-slate-500 dark:text-slate-400">
        Popup diblokir?
        <a href="https://oauth.zonapas.web.id/auth" target="_blank" class="font-bold text-[#0A2540] underline dark:text-white">Buka login GitHub di tab baru</a>
        — setelah otorisasi, kembali ke tab ini.
      </p>
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
        Belum bisa masuk? CMS Decap di <a href="/admin/" class="font-bold text-[#0A2540] underline dark:text-white">/admin/</a> tetap tersedia sebagai cadangan.
      </p>
    </section>


    <!-- Akses ditolak (akun tanpa binding peran) -->
    <section id="akses-ditolak" class="mt-6 hidden rounded-2xl border border-red-300 bg-red-50 p-6 text-center dark:border-red-900 dark:bg-red-900/20">
      <h2 class="text-lg font-bold text-red-900 dark:text-red-100">Akun ini belum punya akses</h2>
      <p id="akses-ditolak-pesan" class="mx-auto mt-1 max-w-md text-sm text-red-800 dark:text-red-200">Akun ini belum punya akses — hubungi Administrator untuk meminta akses Kelola Berita.</p>
      <button id="btn-akses-keluar" type="button" class="mt-4 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800">Keluar &amp; Coba Akun Lain</button>
    </section>


    <!-- Aplikasi (setelah login) -->
    <div id="app" class="hidden">
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span id="user-chip" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-bold dark:bg-slate-800">
          <img id="user-avatar" alt="" class="h-6 w-6 rounded-full" width="24" height="24" />
          <span id="user-name"></span>
        </span>
        <span class="flex-1"></span>
        <a href="/portal/kelola-berita/" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">← Kembali ke Kelola Berita</a>
        <button id="btn-refresh" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Muat Ulang Daftar</button>
        <button id="btn-keluar" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Keluar</button>
      </div>
      <!-- Dua kartu: Edit Artikel & Edit Video (Nov 2026). Ketuk kartu
           untuk beralih daftar; Edit Video khusus Administrator. -->
      <div class="mt-6 grid gap-4 sm:grid-cols-2" role="tablist" aria-label="Pilih yang diedit">
        <button type="button" id="kartu-edit-artikel" data-tab-edit="artikel" role="tab" aria-selected="true" class="group block overflow-hidden rounded-2xl border-2 border-[#0A2540] bg-white text-left transition hover:-translate-y-0.5 hover:shadow-lg dark:border-white dark:bg-slate-900">
          <span class="block h-1.5 bg-[#FACC15]" aria-hidden="true"></span>
          <span class="block p-5">
            <span class="text-4xl" aria-hidden="true">📝</span>
            <span class="mt-3 block text-lg font-black uppercase tracking-tight">Edit Artikel</span>
            <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">Ubah atau hapus artikel berita yang sudah publish di ZonaPas.</span>
            <span class="mt-4 block text-sm font-bold text-[#0A2540] dark:text-white">Edit Artikel →</span>
          </span>
        </button>
        <button type="button" id="kartu-edit-video" data-tab-edit="video" role="tab" aria-selected="false" class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white text-left transition hover:-translate-y-0.5 hover:border-[#0A2540] hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:border-white">
          <span class="block h-1.5 bg-[#D9232E]" aria-hidden="true"></span>
          <span class="block p-5">
            <span class="text-4xl" aria-hidden="true">🎬</span>
            <span class="mt-3 block text-lg font-black uppercase tracking-tight">Edit Video</span>
            <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">Ubah judul, deskripsi, dan sampul video ZonaPasTV yang sudah tayang.</span>
            <span class="mt-4 block text-sm font-bold text-[#0A2540] dark:text-white">Edit Video →</span>
          </span>
        </button>
      </div>

      <!-- Tab Artikel (isi lama halaman Edit Berita) -->
      <div id="tab-artikel">
      <!-- Pencarian & filter -->
      <div class="mt-4 flex flex-wrap gap-3">
        <input id="q" type="search" placeholder="Cari judul, ringkasan, atau kategori…" class="min-w-[220px] flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" />
        <select id="filter-category" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
          <option value="">Semua kategori</option>
          {CATEGORIES.map((c) => <option value={c.name}>{c.name}</option>)}
        </select>
        <span id="count" class="self-center text-sm text-slate-500 dark:text-slate-400"></span>
      </div>

      <!-- Pilihan Redaksi -->
      <section class="pt-8" aria-label="Pilihan Redaksi">
        <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
          <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Pilihan Redaksi</h2>
        </div>
        <div id="featured-list"><p class="text-sm text-slate-500">Memuat…</p></div>
      </section>

      <!-- Berita Terkini -->
      <section class="pt-8" aria-label="Berita Terkini">
        <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
          <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Berita Terkini</h2>
        </div>
        <div id="latest-list" class="divide-y divide-slate-200 dark:divide-slate-800"><p class="py-3 text-sm text-slate-500">Memuat…</p></div>
      </section>

      <!-- Terpopuler Minggu Ini -->
      <section id="terpopuler-section" class="hidden pt-8" aria-label="Terpopuler Minggu Ini">
        <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
          <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Terpopuler Minggu Ini</h2>
        </div>
        <div id="terpopuler-list" class="divide-y divide-slate-200 dark:divide-slate-800"><p class="py-3 text-sm text-slate-500">Memuat…</p></div>
      </section>
      </div><!-- /tab-artikel -->

      <!-- Tab Video: daftar + formulir edit video ZonaPasTV -->
      <div id="tab-video" class="hidden">
        <section class="pt-8" aria-label="Edit Video ZonaPasTV">
          <div class="mb-4 flex items-center justify-between border-b-2 border-[#D9232E] pb-2">
            <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Edit Video ZonaPasTV</h2>
            <button id="btn-video-refresh" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Muat Ulang</button>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-400">Ubah judul, deskripsi, dan sampul video yang sudah tayang. Sampul dipilih dari scene otomatis YouTube (video sudah di YouTube, jadi frame tidak bisa ditangkap langsung seperti saat unggah baru). Video di YouTube tidak ikut berubah — yang diubah hanya data di situs ZonaPas.</p>
          <div id="video-edit-list" class="mt-4 divide-y divide-slate-200 dark:divide-slate-800"><p class="py-3 text-sm text-slate-500">Memuat…</p></div>
        </section>

        <!-- Formulir edit video (muncul saat tombol Edit diketuk) -->
        <section id="form-edit-video" class="mt-6 hidden rounded-xl border border-slate-200 p-4 dark:border-slate-800" aria-label="Formulir edit video">
          <h3 class="text-lg font-black">Edit Video</h3>
          <p id="edit-video-nama" class="mt-1 text-sm text-slate-500 dark:text-slate-400"></p>
          <div class="mt-3">
            <label for="ev-judul" class="mb-1 block text-sm font-bold">Judul Video *</label>
            <input id="ev-judul" required maxlength="100" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" />
            <p class="mt-1 text-xs text-slate-500">Judul otomatis diubah ke format kapital tiap kata saat disimpan (singkatan resmi seperti UPT, LPKA, dan BIMTEK tetap kapital semua). Maksimal 100 karakter. <span id="ev-judul-hitung" class="font-bold">0/100 karakter</span></p>
          </div>
          <div class="mt-3">
            <label for="ev-deskripsi" class="mb-1 block text-sm font-bold">Deskripsi (opsional)</label>
            <textarea id="ev-deskripsi" rows="2" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900"></textarea>
          </div>
          <div class="mt-3">
            <p class="mb-1 text-sm font-bold">Foto Sampul Video</p>
            <p class="mb-2 text-xs text-slate-500">Pilih satu scene dari video sebagai sampul. Scene diambil dari gambar mini otomatis YouTube untuk video ini.</p>
            <div id="ev-sampul-pilihan" class="grid grid-cols-2 gap-3 sm:grid-cols-4"></div>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <button id="btn-ev-simpan" type="button" class="rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">Simpan Perubahan</button>
            <button id="btn-ev-batal" type="button" class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Batal</button>
          </div>
        </section>
      </div><!-- /tab-video -->
    </div>
  </div>

  <script is:inline src="/kelola-umum.js?v=8"></script>
  <script>


    // ---------- Ubah & Hapus (event delegation) ----------
    document.addEventListener('click', async (e) => {
      const editBtn = e.target.closest('[data-edit]');
      const delBtn = e.target.closest('[data-delete]');
            if (editBtn) {
        window.location.href = '/portal/kelola-berita/tulis-artikel/?edit=' + encodeURIComponent(editBtn.getAttribute('data-edit'));
        return;
      }
      if (delBtn) {
        if (peran !== 'admin') return;
        const a = articles.find((x) => x.slug === delBtn.getAttribute('data-delete'));
        if (!a) return;
        if (!confirm('Hapus berita "' + (a.data.title || a.slug) + '"? Tindakan ini tidak bisa dibatalkan.')) return;
        try {
          await gh('/contents/' + a.path, {
            method: 'DELETE',
            body: JSON.stringify({ message: 'Hapus berita: ' + (a.data.title || a.slug), sha: a.sha, branch: 'main' }),
          });
          showStatus('Berita "' + (a.data.title || a.slug) + '" dihapus. Situs diperbarui setelah rebuild sekitar 1–2 menit.', true);
          await loadArticles();
        } catch (err) {
          showStatus('Gagal menghapus: ' + err.message, false);
        }
      }
    });



    on('q', 'input', renderLists);

    on('filter-category', 'change', renderLists);

    on('btn-refresh', 'click', () => {
      if (tabEditAktif === 'video') {
        showStatus('Memuat ulang daftar video…', true);
        muatVideoEdit().catch((err) => showStatus('Gagal memuat daftar video: ' + err.message, false));
        return;
      }
      showStatus('Memuat ulang daftar berita…', true);
      loadArticles().catch((err) => showStatus('Gagal memuat daftar berita: ' + err.message, false));
    });


    // ---------- Edit Video ZonaPasTV (Nov 2026) ----------
    // Dua kartu di atas halaman ini: Edit Artikel (daftar artikel, isi
    // lama) dan Edit Video (daftar video + formulir edit). Video hanya
    // untuk Administrator (sama seperti halaman unggah video).
    let tabEditAktif = 'artikel';
    let videoEditTerpilih = null;
    let editVideoSampul = '';

    function pilihTabEdit(jenis) {
      tabEditAktif = jenis;
      const tabA = $('tab-artikel'); if (tabA) tabA.classList.toggle('hidden', jenis !== 'artikel');
      const tabV = $('tab-video'); if (tabV) tabV.classList.toggle('hidden', jenis !== 'video');
      const kA = $('kartu-edit-artikel'); const kV = $('kartu-edit-video');
      if (kA) {
        kA.setAttribute('aria-selected', jenis === 'artikel' ? 'true' : 'false');
        kA.classList.toggle('border-2', jenis === 'artikel');
        kA.classList.toggle('border-[#0A2540]', jenis === 'artikel');
        kA.classList.toggle('dark:border-white', jenis === 'artikel');
        kA.classList.toggle('border', jenis !== 'artikel');
        kA.classList.toggle('border-slate-200', jenis !== 'artikel');
        kA.classList.toggle('dark:border-slate-800', jenis !== 'artikel');
      }
      if (kV) {
        kV.setAttribute('aria-selected', jenis === 'video' ? 'true' : 'false');
        kV.classList.toggle('border-2', jenis === 'video');
        kV.classList.toggle('border-[#0A2540]', jenis === 'video');
        kV.classList.toggle('dark:border-white', jenis === 'video');
        kV.classList.toggle('border', jenis !== 'video');
        kV.classList.toggle('border-slate-200', jenis !== 'video');
        kV.classList.toggle('dark:border-slate-800', jenis !== 'video');
      }
      if (jenis === 'video' && peran === 'admin' && !videos.length) {
        muatVideoEdit().catch((err) => showStatus('Gagal memuat daftar video: ' + err.message, false));
      }
    }

    on('kartu-edit-artikel', 'click', () => pilihTabEdit('artikel'));
    on('kartu-edit-video', 'click', () => pilihTabEdit('video'));

    // ID YouTube + gambar mini (salinan dari halaman unggah video).
    function idYoutubeEdit(tautan) {
      const t = String(tautan || '').trim();
      const m = t.match(/(?:v=|youtu\.be\/|shorts\/|embed\/|live\/)([A-Za-z0-9_-]{11})/) || t.match(/^([A-Za-z0-9_-]{11})$/);
      return m ? m[1] : '';
    }
    function thumbYoutubeEdit(id) { return 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg'; }

    function buildVideoMarkdownEdit(d) {
      const q = (v) => JSON.stringify(String(v ?? ''));
      const lines = [
        '---',
        'title: ' + q(d.title),
        'description: ' + q(d.description),
        'video: ' + q(d.video),
      ];
      if (d.poster) lines.push('poster: ' + q(d.poster));
      lines.push('publishDate: ' + d.publishDate, 'author: ' + q(d.author), '---', '');
      return lines.join('\n');
    }

    async function muatVideoEdit() {
      let list;
      try {
        list = await gh('/contents/src/content/video?ref=main');
      } catch (e) {
        if (e && e.status === 404) { videos = []; renderVideoEditList(); return; }
        throw e;
      }
      const files = (Array.isArray(list) ? list : []).filter((f) => f.type === 'file' && f.name.endsWith('.md'));
      const loaded = [];
      for (const f of files) {
        try {
          const file = await gh('/contents/src/content/video/' + encodeURIComponent(f.name) + '?ref=main');
          const text = b64decodeUnicode(file.content || '');
          const parsed = parseFrontmatter(text);
          const slug = f.name.replace(/\.md$/, '');
          loaded.push({ slug, path: f.path, sha: file.sha, data: parsed.data });
        } catch (e) {
          console.warn('Gagal memuat video ' + f.name, e);
        }
      }
      loaded.sort((a, b) => String(b.data.publishDate || '').localeCompare(String(a.data.publishDate || '')));
      videos = loaded;
      renderVideoEditList();
    }

    function renderVideoEditList() {
      const el = $('video-edit-list');
      if (!el) return;
      if (!videos.length) {
        el.innerHTML = '<p class="py-3 text-sm text-slate-500">Belum ada video di ZonaPasTV.</p>';
        return;
      }
      el.innerHTML = videos.map((v) => {
        const d = v.data;
        const idYt = idYoutubeEdit(d.video);
        const thumb = d.poster
          ? '<img src="' + esc(d.poster) + '" alt="" loading="lazy" class="h-auto w-28 shrink-0 rounded-lg" />'
          : idYt
            ? '<img src="' + thumbYoutubeEdit(idYt) + '" alt="" loading="lazy" class="h-auto w-28 shrink-0 rounded-lg" />'
            : '<span class="flex h-16 w-28 shrink-0 items-center justify-center rounded-lg bg-[#0A2540] text-2xl text-white">▶</span>';
        return '<article class="flex gap-3 py-4">' + thumb +
          '<div class="min-w-0 flex-1">' +
          '<span class="block text-sm font-bold leading-snug">' + esc(d.title || '(tanpa judul)') + '</span>' +
          '<span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">' + esc(formatDateShort(d.publishDate || '')) + ' · ' + esc(d.video || '') + '</span>' +
          (d.poster ? '<span class="mt-1 inline-block rounded-full bg-[#0A2540] px-2 py-0.5 text-[11px] font-bold text-white">Sampul khusus</span>' : '') +
          '<div class="mt-2 flex gap-2"><button type="button" data-video-edit="' + esc(v.slug) + '" class="rounded-md bg-[#0A2540] px-2.5 py-1 text-xs font-bold text-white hover:bg-[#123a66]">Edit</button></div>' +
          '</div></article>';
      }).join('');
    }

    // Pilihan sampul: gambar mini default YouTube + 3 scene otomatis
    // YouTube (1/2/3.jpg = frame dari bagian berbeda video). Bila video
    // sudah punya sampul frame (repo), tampilkan sebagai pilihan pertama
    // supaya bisa dipertahankan.
    function renderPilihanSampul(v) {
      const wadah = $('ev-sampul-pilihan');
      if (!wadah) return;
      const d = v.data;
      const idYt = idYoutubeEdit(d.video);
      const pilihan = [];
      if (d.poster && String(d.poster).indexOf('/images/sampul-video-') === 0) {
        pilihan.push({ nilai: d.poster, gambar: d.poster, label: 'Sampul saat ini' });
      }
      pilihan.push({ nilai: '', gambar: idYt ? thumbYoutubeEdit(idYt) : '', label: 'Mini YouTube (default)' });
      if (idYt) {
        pilihan.push({ nilai: 'https://i.ytimg.com/vi/' + idYt + '/1.jpg', gambar: 'https://i.ytimg.com/vi/' + idYt + '/1.jpg', label: 'Scene 1' });
        pilihan.push({ nilai: 'https://i.ytimg.com/vi/' + idYt + '/2.jpg', gambar: 'https://i.ytimg.com/vi/' + idYt + '/2.jpg', label: 'Scene 2' });
        pilihan.push({ nilai: 'https://i.ytimg.com/vi/' + idYt + '/3.jpg', gambar: 'https://i.ytimg.com/vi/' + idYt + '/3.jpg', label: 'Scene 3' });
      }
      // Nilai awal = poster yang tersimpan (bila cocok dengan salah satu
      // pilihan), bila tidak cocok (poster lama berupa URL lain) tetap
      // tawarkan pilihan default.
      editVideoSampul = pilihan.some((p) => p.nilai === (d.poster || '')) ? (d.poster || '') : '';
      wadah.innerHTML = pilihan.map((p) => {
        const aktif = p.nilai === editVideoSampul;
        return '<button type="button" data-sampul-pilih="' + esc(p.nilai) + '" aria-pressed="' + (aktif ? 'true' : 'false') + '" class="overflow-hidden rounded-xl border-2 text-left ' + (aktif ? 'border-[#0A2540] dark:border-white' : 'border-slate-200 dark:border-slate-800') + '">' +
          (p.gambar ? '<img src="' + esc(p.gambar) + '" alt="" loading="lazy" class="aspect-video w-full object-cover" />' : '<span class="flex aspect-video w-full items-center justify-center bg-slate-100 text-xs text-slate-500 dark:bg-slate-800">Tidak ada gambar</span>') +
          '<span class="block px-2 py-1.5 text-xs font-bold">' + esc(p.label) + '</span></button>';
      }).join('');
    }

    function bukaEditVideo(slug) {
      if (peran !== 'admin') return;
      const v = videos.find((x) => x.slug === slug);
      if (!v) return;
      videoEditTerpilih = v;
      const d = v.data;
      const judulEl = $('ev-judul'); if (judulEl) judulEl.value = d.title || '';
      const hitung = $('ev-judul-hitung'); if (hitung) hitung.textContent = String((d.title || '').length) + '/100 karakter';
      const desEl = $('ev-deskripsi'); if (desEl) desEl.value = d.description || '';
      const nama = $('edit-video-nama'); if (nama) nama.textContent = 'Mengedit: ' + (d.title || slug) + ' · ' + formatDateShort(d.publishDate || '');
      renderPilihanSampul(v);
      const form = $('form-edit-video'); if (form) form.classList.remove('hidden');
      if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function tutupEditVideo() {
      videoEditTerpilih = null;
      editVideoSampul = '';
      const form = $('form-edit-video'); if (form) form.classList.add('hidden');
    }

    on('ev-judul', 'input', () => { const el = $('ev-judul-hitung'); if (el) el.textContent = String(($('ev-judul').value || '').length) + '/100 karakter'; });
    on('btn-ev-batal', 'click', tutupEditVideo);
    on('btn-video-refresh', 'click', () => {
      showStatus('Memuat ulang daftar video…', true);
      muatVideoEdit().catch((err) => showStatus('Gagal memuat daftar video: ' + err.message, false));
    });

    document.addEventListener('click', async (e) => {
      const pilihSampul = e.target.closest('[data-sampul-pilih]');
      if (pilihSampul) {
        editVideoSampul = pilihSampul.getAttribute('data-sampul-pilih') || '';
        if (videoEditTerpilih) renderPilihanSampul(videoEditTerpilih);
        return;
      }
      const editVideoBtn = e.target.closest('[data-video-edit]');
      if (editVideoBtn) {
        bukaEditVideo(editVideoBtn.getAttribute('data-video-edit'));
        return;
      }
    });

    on('btn-ev-simpan', 'click', async () => {
      if (peran !== 'admin') return;
      const v = videoEditTerpilih;
      if (!v) return;
      const btn = $('btn-ev-simpan');
      const judul = normalisasiJudul($('ev-judul').value);
      if (judul.length > 100) { showStatus('Judul video maksimal 100 karakter untuk YouTube. Judul saat ini ' + judul.length + ' karakter — persingkat dulu.', false); return; }
      const deskripsi = ($('ev-deskripsi').value || '').trim();
      if (!judul) { showStatus('Judul video wajib diisi.', false); return; }
      btn.disabled = true;
      btn.textContent = 'Menyimpan…';
      try {
        const md = buildVideoMarkdownEdit({
          title: judul,
          description: deskripsi,
          video: v.data.video,
          poster: editVideoSampul,
          publishDate: v.data.publishDate || new Date().toISOString().slice(0, 10),
          author: v.data.author || 'Rezie',
        });
        const isi = b64encodeUnicode(md);
        if (token) {
          await gh('/contents/' + v.path, {
            method: 'PUT',
            body: JSON.stringify({ message: 'Edit video ZonaPasTV: ' + judul, content: isi, sha: v.sha, branch: 'main' }),
          });
        } else {
          await githubTulis(v.path, isi, 'Edit video ZonaPasTV: ' + judul, v.sha);
        }
        showStatus('Video "' + judul + '" diperbarui. Situs diperbarui setelah rebuild sekitar 1–2 menit.', true);
        tutupEditVideo();
        await muatVideoEdit();
      } catch (err) {
        showStatus('Gagal menyimpan perubahan video: ' + err.message, false);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Simpan Perubahan';
      }
    });

    // Hook setelah login (dipanggil kelola-umum.js): muat daftar video
    // bila Administrator; selain Administrator, kartu Edit Video
    // disembunyikan (video hanya untuk Administrator).
    window.__kelolaSetelahLogin = () => {
      const kartuVideo = $('kartu-edit-video');
      if (peran !== 'admin') {
        if (kartuVideo) kartuVideo.classList.add('hidden');
        return;
      }
      muatVideoEdit().catch((err) => console.warn('Gagal memuat daftar video.', err));
    };
  </script>
</BaseLayout>
