---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../../data/site';
import { AUTHORS } from '../../../data/authors';

const categoryColors = Object.fromEntries(CATEGORIES.map((c) => [c.name, c.color]));
// Peran/bio penulis untuk pratinjau tampilan terbit (modal mata).
const authorInfoMap = Object.fromEntries(Object.values(AUTHORS).map((a) => [a.name, { role: a.role, bio: a.bio }]));
---

<BaseLayout
  title="Edit Berita"
  description="Daftar berita ZonaPas yang sudah publish — ubah atau hapus."
>
  <!-- Data pulau JSON: HARUS memakai set:html — Astro tidak mengevaluasi
       ekspresi {…} di dalam tag <script>, jadi penulisan {JSON.stringify(…)}
       akan tercetak mentah dan JSON.parse di script utama akan gagal. -->
  <script type="application/json" id="kelola-data" set:html={JSON.stringify({ categoryColors, authors: authorInfoMap })} />

  <div class="mx-auto max-w-[1200px] px-4 py-6">
    <div class="border-b-2 border-[#0A2540] pb-4 dark:border-white">
      <h1 class="text-2xl font-black uppercase tracking-tight sm:text-3xl">Edit Berita</h1>
      <div class="mt-2 h-1.5 w-20 rounded bg-[#FACC15]" aria-hidden="true"></div>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Daftar berita yang sudah publish di ZonaPas. Administrator dapat mengubah atau menghapus berita; tayangan dihitung dari statistik pembaca.
      </p>
    </div>

    <!-- Status -->
    <div id="status" class="mt-4 hidden rounded-lg px-4 py-3 text-sm font-medium" role="status"></div>

    <!-- Login -->
    <section id="login-box" class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
      <img src="/images/logo-zonapas.png" alt="Logo ZonaPas" class="mx-auto h-16 w-16 rounded-full object-cover" width="64" height="64" />
      <h2 class="mt-3 text-lg font-bold">Masuk untuk mengelola berita</h2>
      <p class="mx-auto mt-1 max-w-md text-sm text-slate-600 dark:text-slate-400">
        Masuk dengan GitHub (khusus Administrator) atau dengan akun Google Redaksi Anda.
        Akses dan tombol yang tampil mengikuti peran akun Anda.
      </p>
      <button
        id="btn-login"
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
        Masuk dengan GitHub
      </button>
      <a
        href="/redaksi/auth/google"
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-[#0A2540] hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-800"
      >
        Masuk dengan Google
      </a>
      <!-- Fallback bila popup diblokir: tautan ini membuka alur OAuth di tab
           baru. Sengaja TANPA rel="noopener" supaya window.opener tetap ada
           dan Worker OAuth bisa mengirim token kembali ke halaman ini. -->
      <p id="login-fallback" class="mt-3 hidden text-xs text-slate-500 dark:text-slate-400">
        Popup diblokir?
        <a href="https://oauth.zonapas.web.id/auth" target="_blank" class="font-bold text-[#0A2540] underline dark:text-white">Buka login GitHub di tab baru</a>
        — setelah otorisasi, kembali ke tab ini.
      </p>
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
        Belum bisa masuk? CMS Decap di <a href="/admin/" class="font-bold text-[#0A2540] underline dark:text-white">/admin/</a> tetap tersedia sebagai cadangan.
      </p>
    </section>


    <!-- Akses ditolak (akun tanpa binding peran) -->
    <section id="akses-ditolak" class="mt-6 hidden rounded-2xl border border-red-300 bg-red-50 p-6 text-center dark:border-red-900 dark:bg-red-900/20">
      <h2 class="text-lg font-bold text-red-900 dark:text-red-100">Akun ini belum punya akses</h2>
      <p id="akses-ditolak-pesan" class="mx-auto mt-1 max-w-md text-sm text-red-800 dark:text-red-200">Akun ini belum punya akses — hubungi Administrator untuk meminta akses Kelola Berita.</p>
      <button id="btn-akses-keluar" type="button" class="mt-4 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800">Keluar &amp; Coba Akun Lain</button>
    </section>


    <!-- Aplikasi (setelah login) -->
    <div id="app" class="hidden">
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span id="user-chip" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-bold dark:bg-slate-800">
          <img id="user-avatar" alt="" class="h-6 w-6 rounded-full" width="24" height="24" />
          <span id="user-name"></span>
        </span>
        <span class="flex-1"></span>
        <a href="/portal/kelola-berita/" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">← Kembali ke Kelola Berita</a>
        <button id="btn-refresh" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Muat Ulang Daftar</button>
        <button id="btn-keluar" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Keluar</button>
      </div>
      <!-- Pencarian & filter -->
      <div class="mt-4 flex flex-wrap gap-3">
        <input id="q" type="search" placeholder="Cari judul, ringkasan, atau kategori…" class="min-w-[220px] flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" />
        <select id="filter-category" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900">
          <option value="">Semua kategori</option>
          {CATEGORIES.map((c) => <option value={c.name}>{c.name}</option>)}
        </select>
        <span id="count" class="self-center text-sm text-slate-500 dark:text-slate-400"></span>
      </div>

      <!-- Pilihan Redaksi -->
      <section class="pt-8" aria-label="Pilihan Redaksi">
        <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
          <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Pilihan Redaksi</h2>
        </div>
        <div id="featured-list"><p class="text-sm text-slate-500">Memuat…</p></div>
      </section>

      <!-- Berita Terkini -->
      <section class="pt-8" aria-label="Berita Terkini">
        <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
          <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Berita Terkini</h2>
        </div>
        <div id="latest-list" class="divide-y divide-slate-200 dark:divide-slate-800"><p class="py-3 text-sm text-slate-500">Memuat…</p></div>
      </section>

      <!-- Terpopuler Minggu Ini -->
      <section id="terpopuler-section" class="hidden pt-8" aria-label="Terpopuler Minggu Ini">
        <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
          <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Terpopuler Minggu Ini</h2>
        </div>
        <div id="terpopuler-list" class="divide-y divide-slate-200 dark:divide-slate-800"><p class="py-3 text-sm text-slate-500">Memuat…</p></div>
      </section>
    </div>
  </div>

  <script is:inline src="/kelola-umum.js?v=5"></script>
  <script>


    // ---------- Ubah & Hapus (event delegation) ----------
    document.addEventListener('click', async (e) => {
      const editBtn = e.target.closest('[data-edit]');
      const delBtn = e.target.closest('[data-delete]');
            if (editBtn) {
        window.location.href = '/portal/kelola-berita/tulis-artikel/?edit=' + encodeURIComponent(editBtn.getAttribute('data-edit'));
        return;
      }
      if (delBtn) {
        if (peran !== 'admin') return;
        const a = articles.find((x) => x.slug === delBtn.getAttribute('data-delete'));
        if (!a) return;
        if (!confirm('Hapus berita "' + (a.data.title || a.slug) + '"? Tindakan ini tidak bisa dibatalkan.')) return;
        try {
          await gh('/contents/' + a.path, {
            method: 'DELETE',
            body: JSON.stringify({ message: 'Hapus berita: ' + (a.data.title || a.slug), sha: a.sha, branch: 'main' }),
          });
          showStatus('Berita "' + (a.data.title || a.slug) + '" dihapus. Situs diperbarui setelah rebuild sekitar 1–2 menit.', true);
          await loadArticles();
        } catch (err) {
          showStatus('Gagal menghapus: ' + err.message, false);
        }
      }
    });



    on('q', 'input', renderLists);

    on('filter-category', 'change', renderLists);

    on('btn-refresh', 'click', () => {
      showStatus('Memuat ulang daftar berita…', true);
      loadArticles().catch((err) => showStatus('Gagal memuat daftar berita: ' + err.message, false));
    });
  </script>
</BaseLayout>
