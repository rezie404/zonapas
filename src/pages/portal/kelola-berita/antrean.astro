---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../../data/site';
import { AUTHORS } from '../../../data/authors';

const categoryColors = Object.fromEntries(CATEGORIES.map((c) => [c.name, c.color]));
// Peran/bio penulis untuk pratinjau tampilan terbit (modal mata).
const authorInfoMap = Object.fromEntries(Object.values(AUTHORS).map((a) => [a.name, { role: a.role, bio: a.bio }]));
---

<BaseLayout
  title="Antrean Persetujuan"
  description="Setujui atau tolak pengajuan artikel dan komentar pembaca."
>
  <!-- Data pulau JSON: HARUS memakai set:html — Astro tidak mengevaluasi
       ekspresi {…} di dalam tag <script>, jadi penulisan {JSON.stringify(…)}
       akan tercetak mentah dan JSON.parse di script utama akan gagal. -->
  <script type="application/json" id="kelola-data" set:html={JSON.stringify({ categoryColors, authors: authorInfoMap })} />

  <div class="mx-auto max-w-[1200px] px-4 py-6">
    <div class="border-b-2 border-[#0A2540] pb-4 dark:border-white">
      <h1 class="text-2xl font-black uppercase tracking-tight sm:text-3xl">Antrean Persetujuan</h1>
      <div class="mt-2 h-1.5 w-20 rounded bg-[#FACC15]" aria-hidden="true"></div>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Berita yang menunggu persetujuan Penyunting/Administrator sebelum terbit, dan komentar pembaca yang menunggu tampil di artikel dan video.
      </p>
    </div>

    <!-- Status -->
    <div id="status" class="mt-4 hidden rounded-lg px-4 py-3 text-sm font-medium" role="status"></div>

    <!-- Konfirmasi kirim antrean (ditampilkan sekali setelah redirect dari Tulis Artikel) -->
    <div id="konfirmasi-terbit" class="mt-4 hidden rounded-lg bg-emerald-100 px-4 py-3 text-sm font-medium text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-100" role="status"></div>

    <!-- Login -->
    <section id="login-box" class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
      <img src="/images/logo-zonapas.png" alt="Logo ZonaPas" class="mx-auto h-16 w-16 rounded-full object-cover" width="64" height="64" />
      <h2 class="mt-3 text-lg font-bold">Masuk untuk mengelola berita</h2>
      <p class="mx-auto mt-1 max-w-md text-sm text-slate-600 dark:text-slate-400">
        Masuk dengan GitHub (khusus Administrator) atau dengan akun Google Redaksi Anda.
        Akses dan tombol yang tampil mengikuti peran akun Anda.
      </p>
      <button
        id="btn-login"
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
        Masuk dengan GitHub
      </button>
      <a
        href="/redaksi/auth/google"
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-[#0A2540] hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-800"
      >
        Masuk dengan Google
      </a>
      <!-- Fallback bila popup diblokir: tautan ini membuka alur OAuth di tab
           baru. Sengaja TANPA rel="noopener" supaya window.opener tetap ada
           dan Worker OAuth bisa mengirim token kembali ke halaman ini. -->
      <p id="login-fallback" class="mt-3 hidden text-xs text-slate-500 dark:text-slate-400">
        Popup diblokir?
        <a href="https://oauth.zonapas.web.id/auth" target="_blank" class="font-bold text-[#0A2540] underline dark:text-white">Buka login GitHub di tab baru</a>
        — setelah otorisasi, kembali ke tab ini.
      </p>
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
        Belum bisa masuk? CMS Decap di <a href="/admin/" class="font-bold text-[#0A2540] underline dark:text-white">/admin/</a> tetap tersedia sebagai cadangan.
      </p>
    </section>


    <!-- Akses ditolak (akun tanpa binding peran) -->
    <section id="akses-ditolak" class="mt-6 hidden rounded-2xl border border-red-300 bg-red-50 p-6 text-center dark:border-red-900 dark:bg-red-900/20">
      <h2 class="text-lg font-bold text-red-900 dark:text-red-100">Akun ini belum punya akses</h2>
      <p id="akses-ditolak-pesan" class="mx-auto mt-1 max-w-md text-sm text-red-800 dark:text-red-200">Akun ini belum punya akses — hubungi Administrator untuk meminta akses Kelola Berita.</p>
      <button id="btn-akses-keluar" type="button" class="mt-4 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800">Keluar &amp; Coba Akun Lain</button>
    </section>


    <!-- Aplikasi (setelah login) -->
    <div id="app" class="hidden">
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span id="user-chip" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-bold dark:bg-slate-800">
          <img id="user-avatar" alt="" class="h-6 w-6 rounded-full" width="24" height="24" />
          <span id="user-name"></span>
        </span>
        <span class="flex-1"></span>
        <a href="/portal/kelola-berita/" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">← Kembali ke Kelola Berita</a>
        <button id="btn-keluar" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Keluar</button>
      </div>
      <!-- Antrean Persetujuan (semua peran yang login) -->
      <section id="antrean-section" class="hidden pt-8" aria-label="Antrean Persetujuan">
        <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
          <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Antrean Persetujuan <span data-badge-antrean class="ml-1 hidden rounded-full bg-[#D9232E] px-2 py-0.5 align-middle text-xs font-bold normal-case text-white">0</span></h2>
          <button id="btn-antrean-refresh" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Muat Ulang</button>
        </div>
        <p class="mb-3 text-sm text-slate-600 dark:text-slate-400">Berita yang menunggu persetujuan Penyunting/Administrator sebelum terbit.</p>
        <div id="antrean-list" class="grid gap-3"><p class="text-sm text-slate-500">Memuat…</p></div>
      </section>

      <!-- Moderasi Komentar (Penyunting + Administrator) -->
      <section id="moderasi-section" class="hidden pt-8" aria-label="Moderasi Komentar">
        <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
          <h2 class="text-xl font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Moderasi Komentar <span data-badge-moderasi class="ml-1 hidden rounded-full bg-[#D9232E] px-2 py-0.5 align-middle text-xs font-bold normal-case text-white">0</span></h2>
          <button id="btn-moderasi-refresh" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Muat Ulang</button>
        </div>
        <p class="mb-3 text-sm text-slate-600 dark:text-slate-400">Komentar pembaca baru tampil di artikel setelah disetujui Penyunting/Administrator.</p>
        <h3 class="mt-2 text-base font-black">Menunggu Persetujuan</h3>
        <div id="moderasi-menunggu" class="mt-2 grid gap-2"><p class="text-sm text-slate-500">Memuat…</p></div>
        <h3 class="mt-6 text-base font-black">Sudah Tampil</h3>
        <div id="moderasi-terbit" class="mt-2 grid gap-2"><p class="text-sm text-slate-500">Memuat…</p></div>
      </section>

      <!-- Modal detail antrean -->
      <div id="modal-antrean" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/70" role="dialog" aria-modal="true" aria-label="Detail antrean">
        <div class="flex min-h-full items-start justify-center px-3 py-6">
          <div id="modal-antrean-panel" class="w-full max-w-[760px] rounded-2xl bg-white p-5 shadow-2xl dark:bg-slate-900">
            <div class="flex items-start justify-between gap-3">
              <h3 id="antrean-detail-judul" class="text-lg font-black leading-snug"></h3>
              <button id="btn-tutup-antrean" type="button" class="shrink-0 rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">✕ Tutup</button>
            </div>
            <p id="antrean-detail-meta" class="mt-1 text-sm text-slate-500 dark:text-slate-400"></p>
            <p id="antrean-detail-catatan" class="mt-3 hidden rounded-lg bg-red-100 px-3 py-2 text-sm text-red-900 dark:bg-red-900/40 dark:text-red-100"></p>
            <p id="antrean-detail-error" class="mt-3 hidden rounded-lg bg-amber-100 px-3 py-2 text-sm text-amber-900 dark:bg-amber-900/40 dark:text-amber-100"></p>
            <img id="antrean-detail-cover" alt="Foto sampul" class="mt-3 hidden max-h-72 w-full rounded-lg object-cover" />
            <p id="antrean-detail-ringkasan" class="mt-3 text-[15px] leading-relaxed text-slate-600 dark:text-slate-300"></p>
            <div id="antrean-detail-isi" class="article-body mt-4 text-[16px] leading-relaxed text-slate-800 dark:text-slate-200"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="/kelola-umum.js?v=12"></script>
  <script>


    // ---------- Antrean ----------
    function statusAntreanLabel(s) {
      return { menunggu: 'Menunggu', draf: 'Draf', disetujui: 'Disetujui', ditolak: 'Ditolak', terbit: 'Terbit' }[s] || s || '-';
    }


    // Hook: dimuat setelah login (dipanggil setLoggedIn di kelola-umum.js).
    window.__kelolaSetelahLogin = () => {
      // Konfirmasi kirim antrean: tampilkan sekali pesan yang disimpan
      // Tulis Artikel sebelum redirect (berita sudah diisi + terkirim).
      try {
        const raw = sessionStorage.getItem('zonapas-konfirmasi-berita');
        if (raw) {
          sessionStorage.removeItem('zonapas-konfirmasi-berita');
          const info = JSON.parse(raw);
          const el = $('konfirmasi-terbit');
          if (el && info && info.teks) { el.textContent = info.teks; el.classList.remove('hidden'); el.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
        }
      } catch {}
      muatAntrean(); muatModerasi();
    };
    // Diekspos untuk simpanAntrean di kelola-umum.js (fungsi modul bukan global).
    window.__kelolaMuatAntrean = muatAntrean;

    async function muatAntrean() {
      if (!peran) return;
      try {
        const res = await workerGet('/redaksi/api/antrean');
        antrean = (res && res.articles) || [];
        renderAntrean();
      } catch (err) {
        const el = $('antrean-list');
        if (el) el.innerHTML = '<p class="text-sm text-red-600">Gagal memuat antrean: ' + esc(err.message) + '</p>';
      }
    }


    function renderAntrean() {
      const el = $('antrean-list');
      if (!el) return;
      // Lencana: jumlah berita yang menunggu persetujuan.
      const badge = document.querySelector('[data-badge-antrean]');
      if (badge) {
        const n = antrean.filter((a) => a.status === 'menunggu').length;
        badge.textContent = String(n);
        badge.classList.toggle('hidden', n === 0);
      }
      if (!antrean.length) { el.innerHTML = '<p class="text-sm text-slate-500">Antrean kosong.</p>'; return; }
      const approver = peran === 'admin' || peran === 'penyunting';
      el.innerHTML = antrean.map((a) => {
        const milikSaya = !!(identitas && ((a.author_email && (a.author_email === identitas.email || a.author_email === identitas.login)) || (a.author && identitas.nama && a.author === identitas.nama)));
        const bisaEdit = approver || (peran === 'penulis' && milikSaya && (a.status === 'draf' || a.status === 'ditolak'));
        const bisaSetujui = approver && a.status === 'menunggu';
        const bisaUlang = approver && a.status === 'disetujui' && !!a.publish_error;
        let h = '<article class="rounded-xl border border-slate-200 p-4 dark:border-slate-800">' +
          '<div class="flex flex-wrap items-start justify-between gap-2"><h3 class="text-base font-bold leading-snug">' + esc(a.title || '(tanpa judul)') + '</h3>' +
          '<span class="shrink-0 rounded-full bg-[#FACC15] px-2.5 py-1 text-[11px] font-bold text-[#0A2540]">' + esc(statusAntreanLabel(a.status)) + '</span></div>' +
          '<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">' + esc([a.author, a.category, a.publish_date].filter(Boolean).join(' · ')) + '</p>';
        if (a.summary) h += '<p class="mt-2 text-sm text-slate-600 dark:text-slate-300">' + esc(a.summary) + '</p>';
        if (a.rejection_note) h += '<p class="mt-2 rounded-lg bg-red-100 px-3 py-2 text-sm text-red-900 dark:bg-red-900/40 dark:text-red-100">Catatan penolakan: ' + esc(a.rejection_note) + '</p>';
        if (a.publish_error) h += '<p class="mt-2 rounded-lg bg-amber-100 px-3 py-2 text-sm text-amber-900 dark:bg-amber-900/40 dark:text-amber-100">Gagal terbit: ' + esc(a.publish_error) + '</p>';
        h += '<div class="mt-3 flex flex-wrap gap-2">';
        h += '<button type="button" data-antrean-lihat="' + esc(a.id) + '" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Lihat</button>';
        if (bisaEdit) h += '<button type="button" data-antrean-edit="' + esc(a.id) + '" class="rounded-lg border border-[#0A2540] px-3 py-1.5 text-xs font-bold text-[#0A2540] hover:bg-[#0A2540] hover:text-white dark:text-white">Edit</button>';
        if (bisaSetujui) h += '<button type="button" data-antrean-setujui="' + esc(a.id) + '" class="rounded-lg bg-[#0A2540] px-3 py-1.5 text-xs font-bold text-white hover:bg-[#123a66]">Setujui &amp; Terbitkan</button>';
        if (bisaSetujui) h += '<button type="button" data-antrean-tolak="' + esc(a.id) + '" class="rounded-lg border border-[#D9232E] px-3 py-1.5 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Tolak</button>';
        if (bisaUlang) h += '<button type="button" data-antrean-ulang="' + esc(a.id) + '" class="rounded-lg bg-[#FACC15] px-3 py-1.5 text-xs font-bold text-[#0A2540] hover:bg-[#EAB308]">Terbitkan Ulang</button>';
        h += '</div></article>';
        return h;
      }).join('');
    }


    function tutupAntrean() {
      const modal = $('modal-antrean');
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }


    // ---------- Moderasi Komentar (Penyunting + Administrator) ----------
    async function muatModerasi() {
      if (!(peran === 'admin' || peran === 'penyunting')) return;
      try {
        const res = await workerGet('/redaksi/api/komentar/antrean');
        renderModerasi((res && res.menunggu) || [], (res && res.terbit) || []);
      } catch (err) {
        const el = $('moderasi-menunggu');
        if (el) el.innerHTML = '<p class="text-sm text-red-600">Gagal memuat komentar: ' + esc(err.message) + '</p>';
      }
    }


    function kartuKomentar(k, aksi) {
      const waktu = k.created_at ? new Date(k.created_at).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
      // Komentar video memakai kunci 'video-<slug>' — tautannya ke halaman
      // video, bukan artikel.
      const adalahVideo = (k.slug || '').indexOf('video-') === 0;
      const tautanKomentar = adalahVideo ? '/video/' + esc(k.slug.slice(6)) + '/' : '/berita/' + esc(k.slug) + '/';
      const labelTautan = adalahVideo ? 'Lihat video &rarr;' : 'Lihat artikel &rarr;';
      let h = '<article class="rounded-xl border border-slate-200 p-4 dark:border-slate-800">' +
        '<div class="flex flex-wrap items-start justify-between gap-2"><h3 class="text-base font-bold leading-snug">' + esc(k.name || 'Pembaca') + '</h3>' +
        '<a href="' + tautanKomentar + '" target="_blank" rel="noopener" class="shrink-0 text-xs font-bold text-[#0A2540] hover:underline dark:text-white">' + labelTautan + '</a></div>' +
        '<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">' + esc(waktu) + '</p>' +
        '<p class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-200">' + esc(k.body || '') + '</p>' +
        '<div class="mt-3 flex flex-wrap gap-2">';
      if (aksi === 'menunggu') {
        h += '<button type="button" data-moderasi-setujui="' + esc(k.id) + '" class="rounded-lg bg-[#0A2540] px-3 py-1.5 text-xs font-bold text-white hover:bg-[#123a66]">Setujui &amp; Tampilkan</button>';
        h += '<button type="button" data-moderasi-tolak="' + esc(k.id) + '" class="rounded-lg border border-[#D9232E] px-3 py-1.5 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Tolak</button>';
      } else {
        h += '<button type="button" data-moderasi-hapus="' + esc(k.id) + '" class="rounded-lg border border-[#D9232E] px-3 py-1.5 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Hapus</button>';
      }
      h += '</div></article>';
      return h;
    }


    function renderModerasi(menunggu, terbit) {
      // Lencana: jumlah komentar yang menunggu persetujuan.
      const badge = document.querySelector('[data-badge-moderasi]');
      if (badge) {
        badge.textContent = String(menunggu.length);
        badge.classList.toggle('hidden', menunggu.length === 0);
      }
      const elM = $('moderasi-menunggu');
      if (elM) elM.innerHTML = menunggu.length ? menunggu.map((k) => kartuKomentar(k, 'menunggu')).join('') : '<p class="text-sm text-slate-500">Tidak ada komentar yang menunggu.</p>';
      const elT = $('moderasi-terbit');
      if (elT) elT.innerHTML = terbit.length ? terbit.map((k) => kartuKomentar(k, 'terbit')).join('') : '<p class="text-sm text-slate-500">Belum ada komentar yang tampil.</p>';
    }


    async function bukaDetailAntrean(id) {
      const item = antrean.find((a) => String(a.id) === String(id));
      try {
        const res = await workerPost('/redaksi/api/berita/' + encodeURIComponent(id) + '/detail', {});
        const art = (res && res.article) || {};
        $('antrean-detail-judul').textContent = art.title || (item && item.title) || '(tanpa judul)';
        $('antrean-detail-meta').textContent = [art.author || (item && item.author), art.category || (item && item.category), art.publish_date || art.publishDate || (item && item.publish_date)].filter(Boolean).join(' · ');
        $('antrean-detail-ringkasan').textContent = art.summary || (item && item.summary) || '';
        $('antrean-detail-isi').innerHTML = isiMarkdownToHtml(art.body || '');
        const cov = $('antrean-detail-cover');
        if (res.cover && res.cover.base64) { cov.src = 'data:' + (res.cover.mime || 'image/jpeg') + ';base64,' + res.cover.base64; cov.classList.remove('hidden'); }
        else if (art.image) { cov.src = imageUrl(art.image); cov.classList.remove('hidden'); }
        else cov.classList.add('hidden');
        const cat = $('antrean-detail-catatan');
        const note = art.rejection_note || (item && item.rejection_note);
        if (note) { cat.textContent = 'Catatan penolakan: ' + note; cat.classList.remove('hidden'); } else cat.classList.add('hidden');
        const er = $('antrean-detail-error');
        const perr = art.publish_error || (item && item.publish_error);
        if (perr) { er.textContent = 'Gagal terbit: ' + perr; er.classList.remove('hidden'); } else er.classList.add('hidden');
        $('modal-antrean').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } catch (err) {
        showStatus('Gagal memuat detail antrean: ' + err.message, false);
      }
    }


    on('btn-antrean-refresh', 'click', () => muatAntrean());

    on('btn-tutup-antrean', 'click', tutupAntrean);

    on('modal-antrean', 'click', (e) => {
      if (e.target && !e.target.closest('#modal-antrean-panel')) tutupAntrean();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const modal = $('modal-antrean');
        if (modal && !modal.classList.contains('hidden')) tutupAntrean();
      }
    });


    // ---------- Aksi antrean (delegation) ----------
    document.addEventListener('click', async (e) => {
      const lihat = e.target.closest('[data-antrean-lihat]');
      const setujui = e.target.closest('[data-antrean-setujui]');
      const tolak = e.target.closest('[data-antrean-tolak]');
      const ulang = e.target.closest('[data-antrean-ulang]');
      const editA = e.target.closest('[data-antrean-edit]');
      if (lihat) { bukaDetailAntrean(lihat.getAttribute('data-antrean-lihat')); return; }
      if (editA) { window.location.href = '/portal/kelola-berita/tulis-artikel/?edit-antrean=' + encodeURIComponent(editA.getAttribute('data-antrean-edit')); return; }
      if (setujui) {
        const id = setujui.getAttribute('data-antrean-setujui');
        try {
          await workerPost('/redaksi/api/berita/' + encodeURIComponent(id) + '/setujui', {});
          showStatus('Berita disetujui dan diterbitkan.', true);
          await muatAntrean();
          await loadArticles();
        } catch (err) { showStatus('Gagal menyetujui: ' + err.message, false); }
        return;
      }
      if (tolak) {
        const id = tolak.getAttribute('data-antrean-tolak');
        const catatan = prompt('Alasan penolakan (akan ditampilkan ke penulis):');
        if (catatan === null) return;
        if (!catatan.trim()) { showStatus('Penolakan membutuhkan catatan.', false); return; }
        try {
          await workerPost('/redaksi/api/berita/' + encodeURIComponent(id) + '/tolak', { catatan: catatan.trim() });
          showStatus('Berita ditolak dengan catatan.', true);
          await muatAntrean();
        } catch (err) { showStatus('Gagal menolak: ' + err.message, false); }
        return;
      }
      if (ulang) {
        const id = ulang.getAttribute('data-antrean-ulang');
        try {
          await workerPost('/redaksi/api/berita/' + encodeURIComponent(id) + '/terbitkan-ulang', {});
          showStatus('Penerbitan ulang diminta.', true);
          await muatAntrean();
          await loadArticles();
        } catch (err) { showStatus('Gagal menerbitkan ulang: ' + err.message, false); }
        return;
      }
    });


    // ---------- Aksi moderasi komentar (delegation) ----------
    document.addEventListener('click', async (e) => {
      const setujui = e.target.closest('[data-moderasi-setujui]');
      const tolak = e.target.closest('[data-moderasi-tolak]');
      const hapus = e.target.closest('[data-moderasi-hapus]');
      if (setujui) {
        const id = setujui.getAttribute('data-moderasi-setujui');
        try {
          await workerPost('/redaksi/api/komentar/' + encodeURIComponent(id) + '/setujui', {});
          showStatus('Komentar disetujui dan tampil di artikel.', true);
          await muatModerasi();
        } catch (err) { showStatus('Gagal menyetujui komentar: ' + err.message, false); }
        return;
      }
      if (tolak) {
        const id = tolak.getAttribute('data-moderasi-tolak');
        try {
          await workerPost('/redaksi/api/komentar/' + encodeURIComponent(id) + '/tolak', {});
          showStatus('Komentar ditolak.', true);
          await muatModerasi();
        } catch (err) { showStatus('Gagal menolak komentar: ' + err.message, false); }
        return;
      }
      if (hapus) {
        const id = hapus.getAttribute('data-moderasi-hapus');
        // Konfirmasi dua ketuk (bukan confirm() bawaan browser): dialog
        // bawaan tidak bisa dijawab otomasi dan sempat membuat tombol ini
        // tampak mati saat verifikasi klik. Ketuk pertama mempersenjatai,
        // ketuk kedua menghapus.
        if (hapus.getAttribute('data-hapus-arm') !== '1') {
          hapus.setAttribute('data-hapus-arm', '1');
          hapus.textContent = 'Ketuk lagi untuk hapus';
          hapus.classList.add('bg-[#D9232E]', 'text-white');
          return;
        }
        try {
          await workerPost('/redaksi/api/komentar/' + encodeURIComponent(id) + '/hapus', {});
          await muatModerasi();
          // Status baru tampil setelah daftar dimuat ulang, supaya pesan
          // "dihapus" tidak muncul selagi komentar lama masih terlihat.
          showStatus('Komentar dihapus.', true);
        } catch (err) { showStatus('Gagal menghapus komentar: ' + err.message, false); }
        return;
      }
    });


    on('btn-moderasi-refresh', 'click', () => muatModerasi());
  </script>
</BaseLayout>
