        }
      });
      // Lihat Pratinjau: masuk ke HALAMAN pratinjau sendiri (?pratinjau=1),
      // bukan lagi menggulir ke pratinjau di bawah form (Nov 2026, atas
      // permintaan Bos Besar). Draf disimpan dulu ke server supaya
      // pratinjau di halaman baru memuat isi terbaru (server saja,
      // 27 Nov 2026 — pratinjau memuat berkas lewat &id=).
      // K20: simpan SECARA SINKRON (simpanDrafSegera) — simpanDraf() biasa
      // hanya menjadwalkan tulis 400 ms kemudian dan timer itu dibatalkan
      // navigasi, sehingga editan terakhir hilang.
      // Perbaikan 20 Nov 2026: tunggu draf tersimpan dan terkonfirmasi
      // dulu sebelum pindah ke pratinjau. Bila draf tidak tersimpan di
      // server, tahan dan tanya dulu — pratinjau akan menampilkan versi
      // terakhir yang tersimpan di server.
      $('sp-lihat').addEventListener('click', async () => {
        bacaFormKeState();
        // Model Word: laporan kosong tanpa draf dibuka tidak perlu
        // disimpan dulu (tidak ada berkas yang dibuat).
        let hasil = { serverOk: true };
        if (drafTerbukaId || drafBerisi(state)) hasil = await simpanDrafSegera();
        if (!hasil.serverOk) {
          showStatus('Draf BELUM tersimpan di server — pratinjau akan menampilkan versi terakhir yang tersimpan di server.', false);
          if (!confirm('Draf belum tersimpan di server. Pratinjau akan menampilkan versi terakhir yang tersimpan di server. Tetap buka pratinjau?')) return;
        }
        location.href = location.pathname + '?pratinjau=1' + (drafTerbukaId ? '&id=' + encodeURIComponent(drafTerbukaId) : '');
      });
      const btnUnduhPratinjau = $('sp-unduh-pratinjau');
      if (btnUnduhPratinjau) btnUnduhPratinjau.addEventListener('click', unduhPdf);
    }

    // ---------- Init ----------
    // Setelah login, #app baru terlihat — hitung ulang skala pratinjau
    // dengan lebar wadah yang sebenarnya. Tanpa ini, sesuaikanSkala yang
    // jalan saat init mengukur wadah tersembunyi (clientWidth 0) lalu
    // memakai skala 1, sehingga halaman F4 813px meluber dan pratinjau
    // terpotong kiri-kanan di HP (Nov 2026).
    window.__kelolaSetelahLogin = () => {
      sesuaikanSkala();
      // Model Word (27 Nov 2026): pemuatan daftar draf jalan saat
      // halaman dimuat — bila sesi login belum pulih (kedaluwarsa),
      // pemuatan gagal dan daftar tidak tampil walau login lalu
      // berhasil. Coba ulang setelah login, menunggu pemuatan awal
      // selesai dulu (perbaikan 27 Nov 2026 atas draf yang "hilang").
      if (janjiDaftarDraf) {
        janjiDaftarDraf.then(() => {
          if (!daftarDrafDimuat) muatDaftarDraf();
        });
      }
    };
    // Mode pratinjau (?pratinjau=1): sembunyikan editor + kepala halaman,
    // tampilkan hanya bar kembali + pratinjau. Mode editor: sebaliknya —
    // pratinjau TIDAK tampil di bawah form (tetap dirender tersembunyi
    // supaya Unduh PDF tetap bisa mengklon halamannya).
    const MODE_PRATINJAU = new URLSearchParams(location.search).get('pratinjau') === '1';
    const terapkanMode = () => {
      const bar = $('sp-bar-pratinjau'), editor = $('sp-editor'), kepala = $('sp-kepala'), bag = $('sp-pratinjau-bagian');
      if (MODE_PRATINJAU) {
        if (bar) { bar.classList.remove('hidden'); bar.classList.add('flex'); }
        if (editor) editor.classList.add('hidden');
        if (kepala) kepala.classList.add('hidden');
        if (bag) bag.classList.remove('hidden');
      } else {
        if (bar) { bar.classList.add('hidden'); bar.classList.remove('flex'); }
        if (editor) editor.classList.remove('hidden');
        if (kepala) kepala.classList.remove('hidden');
        if (bag) bag.classList.add('hidden');
      }
    };
    terapkanMode();
    tulisStateKeForm();
    hubungkanForm();
    renderPratinjau();
    // Model Word (27 Nov 2026): aplikasi dibuka kosong — yang dimuat
    // saat boot hanyalah DAFTAR draf (untuk menu Buka), bukan isi draf.
    // Berita tidak ditarik otomatis saat dibuka; tarikan jalan saat
    // laporan baru dibuat (➕ Baru / "Set ke minggu ini") atau periode
    // diubah. Di mode pratinjau yang dibuka langsung (?pratinjau=1),
    // draf dimuat dari server (&id=, atau berkas terbaru) supaya
    // pratinjau tidak tampak kosong.
    janjiDaftarDraf = muatDaftarDraf().then(async () => {
      // Server saja (27 Nov 2026): di mode pratinjau yang dibuka
      // langsung, muat berkas dari &id= bila ada, atau berkas terbaru.
      if (MODE_PRATINJAU) {
        const idBuka = idPratinjau || (daftarDraf.length > 0 ? daftarDraf[0].id : '');
        if (idBuka) await bukaDraf(idBuka);
      }
    });
    // Font web (Plus Jakarta Sans) bisa termuat setelah render pertama;
    // render ulang setelah font siap supaya paginasi memakai metrik font
    // yang benar dan pratinjau sama dengan PDF.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => { renderPratinjau(); }).catch(() => {});
    }
  </script>
</BaseLayout>
