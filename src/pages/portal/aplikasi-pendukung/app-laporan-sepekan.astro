    // ---------- State + draf (localStorage) ----------
    const KUNCI_DRAF = 'zonapas-laporan-sepekan-draf-v1';
    function klon(o) { return JSON.parse(JSON.stringify(o)); }
    function muatDraf() {
      try {
        const raw = localStorage.getItem(KUNCI_DRAF);
        if (!raw) return null;
        const d = JSON.parse(raw);
        if (!d || typeof d !== 'object' || !Array.isArray(d.hari)) return null;
        return d;
      } catch { return null; }
    }
    const drafTersimpan = muatDraf();
    let state = drafTersimpan || klon(TEMPLATE);
    let timerSimpan = null;
    function simpanDraf() {
      clearTimeout(timerSimpan);
      timerSimpan = setTimeout(() => {
        try {
          localStorage.setItem(KUNCI_DRAF, JSON.stringify(state));
          const info = $('sp-draf-info');
          if (info) info.textContent = 'Draf tersimpan otomatis di peramban ini.';
        } catch {
          const info = $('sp-draf-info');
          if (info) info.textContent = 'Draf tidak tersimpan (penyimpanan peramban penuh) — segera unduh PDF Anda.';
        }
      }, 400);
    }
    function showStatus(pesan, ok) {
      const el = $('status');
      if (!el) return;
      el.classList.remove('hidden');
      el.textContent = pesan;
      el.style.background = ok ? '#dcfce7' : '#fee2e2';
      el.style.color = ok ? '#166534' : '#991b1b';
      el.style.border = '1px solid ' + (ok ? '#86efac' : '#fca5a5');
    }

    // ---------- Foto: baca berkas -> data URL (diperkecil maks 1200px) ----------
    function berkasKeDataUrl(file, maxLebar) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = () => reject(new Error('Gagal membaca berkas.'));
        reader.onload = () => {
          const img = new Image();
          img.onerror = () => reject(new Error('Berkas bukan gambar.'));
          img.onload = () => {
            try {
              const skala = Math.min(1, (maxLebar || 1200) / img.naturalWidth);
              const c = document.createElement('canvas');
              c.width = Math.max(1, Math.round(img.naturalWidth * skala));
              c.height = Math.max(1, Math.round(img.naturalHeight * skala));
              c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
              resolve(c.toDataURL('image/jpeg', 0.85));
            } catch (e) { reject(e); }
          };
          img.src = String(reader.result);
        };
        reader.readAsDataURL(file);
      });
    }

    // ---------- Form: isi <-> state ----------
    function tulisStateKeForm() {
      $('sp-mulai').value = state.mulai || '';
      $('sp-akhir').value = state.akhir || '';
      $('sp-ttd').value = state.ttd || '';
      $('sp-foto-potret').src = state.fotoPotret || FOTO_POTRET_TEMPLATE;
      $('sp-foto-lapangan').src = state.fotoLapangan || FOTO_LAPANGAN_TEMPLATE;
      $('sp-latar').value = state.latar || '';
      $('sp-maksud').value = state.maksud || '';
      $('sp-ruang').value = state.ruang || '';
      $('sp-peserta').value = state.peserta || '';
      $('sp-tindak').value = (state.tindak || []).join('\n');
      $('sp-penutup').value = state.penutup || '';
      const p = $('sp-periode-teks');
      if (p) p.textContent = teksPeriode() ? 'Periode: ' + teksPeriode() : '';
      renderHari();
    }
    function bacaFormKeState() {
      state.mulai = $('sp-mulai').value || state.mulai;
      state.akhir = $('sp-akhir').value || state.akhir;
      state.ttd = $('sp-ttd').value || state.ttd;
      state.latar = $('sp-latar').value;
      state.maksud = $('sp-maksud').value;
      state.ruang = $('sp-ruang').value;
      state.peserta = $('sp-peserta').value;
      state.tindak = $('sp-tindak').value.split('\n').map((s) => s.trim()).filter(Boolean);
      state.penutup = $('sp-penutup').value;
      const p = $('sp-periode-teks');
      if (p) p.textContent = teksPeriode() ? 'Periode: ' + teksPeriode() : '';
    }

    // ---------- Form hari & kegiatan ----------
    function renderHari() {
      const wadah = $('sp-hari-list');
      if (!wadah) return;
      wadah.innerHTML = state.hari.map((h, hi) => {
        const keg = h.kegiatan.map((k, ki) => {
          const fotos = k.foto.map((f, fi) => {
            if (!f) return '';
            return '<span class="relative inline-block">' +
              '<img src="' + esc(f) + '" alt="Foto kegiatan" class="h-20 w-28 rounded-lg object-cover" />' +
              '<button type="button" data-hapus-foto="' + hi + ':' + ki + ':' + fi + '" class="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-red-600 text-[11px] font-bold text-white" aria-label="Hapus foto">×</button></span>';
          }).join('');
          return '<div class="rounded-xl border border-slate-200 p-3 dark:border-slate-700">' +
            '<div class="flex items-center justify-between gap-2">' +
              '<span class="text-sm font-bold">Kegiatan ' + (ki + 1) + '</span>' +
              '<button type="button" data-hapus-kegiatan="' + hi + ':' + ki + '" class="text-xs font-bold text-red-600 hover:underline">Hapus kegiatan</button>' +
            '</div>' +
            '<label class="mt-2 block"><span class="block text-xs font-bold">Judul kegiatan</span>' +
              '<input type="text" data-judul-kegiatan="' + hi + ':' + ki + '" value="' + esc(k.judul) + '" placeholder="Contoh: Apel Pagi Kanwil Ditjenpas Bengkulu" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" /></label>' +
            '<label class="mt-2 block"><span class="block text-xs font-bold">Narasi</span>' +
              '<textarea rows="5" data-narasi-kegiatan="' + hi + ':' + ki + '" placeholder="Tulis narasi kegiatan…" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm leading-relaxed dark:border-slate-700 dark:bg-slate-900">' + esc(k.narasi) + '</textarea></label>' +
            '<div class="mt-2"><span class="block text-xs font-bold">Foto kegiatan (maks 2)</span>' +
              '<div class="mt-1 flex flex-wrap items-center gap-2">' + fotos +
              (k.foto.filter(Boolean).length < 2 ? '<label class="flex h-20 w-28 cursor-pointer items-center justify-center rounded-lg border-2 border-dashed border-slate-300 text-xs font-bold text-slate-500 hover:border-[#0A2540] dark:border-slate-700">+ Tambah foto<input type="file" accept="image/*" data-tambah-foto="' + hi + ':' + ki + '" class="hidden" /></label>' : '') +
              '</div></div></div>';
        }).join('');
        return '<article class="rounded-xl border border-slate-200 p-4 dark:border-slate-700">' +
          '<div class="flex flex-wrap items-center gap-3">' +
            '<label class="flex-1"><span class="block text-sm font-bold">Tanggal kegiatan</span>' +
              '<input type="date" data-tanggal-hari="' + hi + '" value="' + esc(h.tanggal) + '" class="mt-1 w-full max-w-xs rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" /></label>' +
            '<span class="text-sm font-bold text-[#0A2540] dark:text-white">' + esc(labelHari(h.tanggal)) + '</span>' +
            '<button type="button" data-hapus-hari="' + hi + '" class="text-xs font-bold text-red-600 hover:underline">Hapus hari</button>' +
          '</div>' +
          '<div class="mt-3 space-y-3">' + keg + '</div>' +
          '<button type="button" data-tambah-kegiatan="' + hi + '" class="mt-3 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">+ Tambah Kegiatan</button>' +
        '</article>';
      }).join('');
    }

    // ---------- Paginator: bagi blok isi ke halaman A4 ----------
    // Halaman A4 @96dpi = 794 x 1123 px. Area isi: padding 48px atas/bawah,
    // 56px kiri/kanan -> lebar 682px, tinggi 1027px.
    const TINGGI_ISI = 1027;
    let elUkur = null;
    function ukurBlok(html) {
      if (!elUkur) {
        elUkur = document.createElement('div');
        elUkur.id = 'sp-ukur';
        document.body.appendChild(elUkur);
      }
      elUkur.innerHTML = html;
      return elUkur.offsetHeight;
    }
    function blokParagraf(teks) {
      // Pecah jadi paragraf (baris kosong), lalu pecah paragraf yang terlalu
      // panjang jadi kelompok kalimat agar tidak ada blok yang melebihi 1 halaman.
      // Baris pertama tiap paragraf menjorok ke dalam (tab, 28px) seperti
      // template; sambungan paragraf di halaman berikut TIDAK menjorok.
      const keluar = [];
      const buatHtml = (t, indent) => '<p class="sepekan-paragraf' + (indent ? '' : ' lanjutan') + '">' + esc(t) + '</p>';
      const paragraf = String(teks || '').split(/\n\s*\n/).map((s) => s.replace(/\s+/g, ' ').trim()).filter(Boolean);
      for (const p of paragraf) {
        const html = buatHtml(p, true);
        if (ukurBlok(html) <= TINGGI_ISI) { keluar.push({ tipe: 'paragraf', html, tinggi: ukurBlok(html) }); continue; }
        // Paragraf terlalu panjang: pecah per kalimat.
        const kalimat = p.match(/[^.!?]+[.!?]+["”)]?\s*/g) || [p];
        let buf = '';
        let pertama = true;
        for (const k of kalimat) {
          const coba = (buf ? buf + ' ' : '') + k.trim();
          const h = ukurBlok(buatHtml(coba, pertama));
          if (h > TINGGI_ISI && buf) {
            keluar.push({ tipe: 'paragraf', html: buatHtml(buf, pertama), tinggi: ukurBlok(buatHtml(buf, pertama)) });
            buf = k.trim();
            pertama = false;
          } else { buf = coba; }
        }
        if (buf) keluar.push({ tipe: 'paragraf', html: buatHtml(buf, pertama), tinggi: ukurBlok(buatHtml(buf, pertama)) });
      }
      return keluar;
    }
    function blokNarasi2Kol(teks) {
      // Narasi kegiatan ditata 2 kolom seperti koran (lihat template):
      // teks dibagi rata ke kolom kiri dan kanan. Tiap blok adalah satu
      // kelompok kalimat yang muat 1 halaman. Awal paragraf tetap
      // menjorok (tab 28px); sambungan tidak menjorok.
      const keluar = [];
      const paragraf = String(teks || '').split(/\n\s*\n/).map((s) => s.replace(/\s+/g, ' ').trim()).filter(Boolean);
      const satuan = []; // { teks, awal }
      for (const p of paragraf) {
        const kal = p.match(/[^.!?]+[.!?]+["”)]?\s*/g) || [p];
        kal.forEach((k, i) => satuan.push({ teks: k.trim(), awal: i === 0 }));
      }
      if (!satuan.length) return keluar;
      const buatHtml = (list) => {
        const total = list.reduce((a, s) => a + s.teks.length + 1, 0);
        let kiri = [], kanan = [], n = 0;
        for (const s of list) {
          if (n < total / 2) { kiri.push(s); n += s.teks.length + 1; }
          else kanan.push(s);
        }
        const renderKol = (arr) => arr.map((s) => '<p class="sepekan-paragraf' + (s.awal ? '' : ' lanjutan') + '">' + esc(s.teks) + '</p>').join('');
        return '<div class="sepekan-2kol"><div class="sepekan-2kol-kol">' + renderKol(kiri) + '</div><div class="sepekan-2kol-kol">' + renderKol(kanan) + '</div></div>';
      };
      let buf = [];
      for (const s of satuan) {
        const coba = buf.concat([s]);
        const h = ukurBlok(buatHtml(coba));
        if (h > TINGGI_ISI && buf.length) {
          keluar.push({ tipe: 'paragraf', html: buatHtml(buf), tinggi: ukurBlok(buatHtml(buf)) });
          buf = [s];
        } else { buf = coba; }
      }
      if (buf.length) keluar.push({ tipe: 'paragraf', html: buatHtml(buf), tinggi: ukurBlok(buatHtml(buf)) });
      return keluar;
    }
    function blokJudulBab(judul) {
      const html = '<h2 class="sepekan-judul-bab">' + esc(judul) + '</h2><div class="sepekan-garis-kuning"></div>';
      return { tipe: 'judul', html, tinggi: ukurBlok(html) };
    }
    function susunBlok() {
      const blok = [];
      const tambahBab = (judul, teks) => {
        if (!String(teks || '').trim()) return;
        blok.push(blokJudulBab(judul));
        blok.push(...blokParagraf(teks));
      };
      tambahBab('Latar Belakang', state.latar);
      tambahBab('Maksud & Tujuan', state.maksud);
      tambahBab('Ruang Lingkup', state.ruang);
      tambahBab('Peserta', state.peserta);
      // Hasil per hari
      for (const h of state.hari) {
        if (!h.kegiatan.length) continue;
        const htmlHari = '<div class="sepekan-pita-hasil">HASIL YANG DICAPAI</div><p class="sepekan-tanggal-hari">' + esc(labelHari(h.tanggal)) + '</p>';
        blok.push({ tipe: 'hari', html: htmlHari, tinggi: ukurBlok(htmlHari) });
        for (const k of h.kegiatan) {
          if (!String(k.judul || '').trim() && !String(k.narasi || '').trim()) continue;
          const htmlJudul = '<h3 class="sepekan-judul-kegiatan">' + esc(k.judul || '(Tanpa judul)') + '</h3>';
          blok.push({ tipe: 'judul-kegiatan', html: htmlJudul, tinggi: ukurBlok(htmlJudul) });
          blok.push(...blokNarasi2Kol(k.narasi));
          const fotos = (k.foto || []).filter(Boolean);
          if (fotos.length === 1) {
            const htmlFoto = '<div class="sepekan-foto-tunggal"><img src="' + esc(fotos[0]) + '" alt="" /></div>';
            blok.push({ tipe: 'foto', html: htmlFoto, tinggi: ukurBlok(htmlFoto) });
          } else if (fotos.length >= 2) {
            const htmlFoto = '<div class="sepekan-foto-baris"><div class="sepekan-foto-dua"><img src="' + esc(fotos[0]) + '" alt="" /></div><div class="sepekan-foto-dua"><img src="' + esc(fotos[1]) + '" alt="" /></div></div>';
            blok.push({ tipe: 'foto', html: htmlFoto, tinggi: ukurBlok(htmlFoto) });
          }
        }
      }
      // Tindak lanjut
      if ((state.tindak || []).length) {
        blok.push(blokJudulBab('Tindak Lanjut'));
        state.tindak.forEach((t, i) => {
          const html = '<p class="sepekan-butir"><span class="nomor">' + (i + 1) + '.</span>' + esc(t) + '</p>';
          blok.push({ tipe: 'butir', html, tinggi: ukurBlok(html) });
        });
      }
      // Penutup + tanda tangan
      blok.push(blokJudulBab('Penutup'));
      blok.push(...blokParagraf(state.penutup || 'Demikian laporan yang dapat kami sampaikan, selanjutnya mohon petunjuk dan arahan.'));
      const htmlTtd = '<div class="sepekan-ttd"><p style="margin:0">' + esc(tglTtdPanjang()) + '</p><p style="margin:0">Kepala Kantor Wilayah<br />Ditjenpas Bengkulu,</p><p style="margin:0">Ttd</p><p class="nama">Masjuno</p></div>';
      blok.push({ tipe: 'ttd', html: htmlTtd, tinggi: ukurBlok(htmlTtd) });
      return blok;
    }
    function bagiHalaman(blok) {
      const halaman = [];
      let kini = [];
      let tinggi = 0;
      const JAGA = ['judul', 'hari', 'judul-kegiatan']; // jangan yatim di ujung halaman
      for (let i = 0; i < blok.length; i++) {
        const b = blok[i];
        const berikut = blok[i + 1];
        // Tanda tangan (ttd) harus satu halaman dengan paragraf penutup
        // sebelumnya. Bila tidak muat, pindahkan paragraf penutup (dan
        // judul bab bila ikut yatim) ke halaman berikut, supaya tanda
        // tangan tidak sendirian di halaman kosong.
        if (b.tipe === 'ttd' && kini.length && tinggi + b.tinggi > TINGGI_ISI) {
          const pindah = [];
          while (kini.length > 0) {
            const terakhir = kini[kini.length - 1];
            pindah.unshift(terakhir);
            kini.pop();
            tinggi -= terakhir.tinggi;
            if (kini.length === 0) break;
            // Bila yang tersisa adalah judul bab, pindahkan juga (jangan yatim).
            if (!JAGA.includes(kini[kini.length - 1].tipe)) break;
          }
          // Jangan dorong halaman kosong: bila halaman saat ini habis
          // dipindahkan, batalkan pemindahan (tanda tangan tetap pindah
          // sendiri, tapi halaman sebelumnya tidak kosong).
          if (kini.length === 0) {
            kini = pindah;
            tinggi = pindah.reduce((a, x) => a + x.tinggi, 0);
          } else {
            halaman.push(kini);
            kini = pindah;
            tinggi = pindah.reduce((a, x) => a + x.tinggi, 0);
          }
        }
        // Bila blok ini harus dijaga bersama blok berikut, pastikan keduanya muat.
        const butuh = JAGA.includes(b.tipe) && berikut ? b.tinggi + berikut.tinggi : b.tinggi;
        if (kini.length && tinggi + butuh > TINGGI_ISI) {
          halaman.push(kini);
          kini = [];
          tinggi = 0;
        }
        kini.push(b);
        tinggi += b.tinggi;
      }
      if (kini.length) halaman.push(kini);
      return halaman;
    }

    // ---------- Sampul ----------
    function htmlSampul() {
      return '<div class="sepekan-sampul">' +
        '<div class="sepekan-sampul-garis"></div>' +
        '<div class="sepekan-sampul-kepala">' +
          '<img src="/images/logo-kemenimipas.png" alt="Logo Kementerian Imigrasi dan Pemasyarakatan" />' +
          '<div><div class="t1">KANTOR WILAYAH</div><div class="t2"><span class="biru">DITJENPAS</span> <span class="kuning">Bengkulu</span></div></div>' +
        '</div>' +
        '<div class="sepekan-sampul-judul">' +
          '<div class="besar">LAPORAN<br /><span class="biru">KEGIATAN</span></div>' +
          '<div class="kecil">KEPALA KANTOR WILAYAH<br />DIREKTORAT JENDERAL PEMASYARAKATAN BENGKULU</div>' +
        '</div>' +
        '<div class="sepekan-sampul-periode">' + esc(teksPeriode()) + '</div>' +
        '<div class="sepekan-hex-luar" style="left:36px; top:520px; width:430px; height:430px; background:#0A2540;">' +
          '<div class="sepekan-hex-tengah"><div class="sepekan-hex-dalam"><img src="' + esc(state.fotoPotret || FOTO_POTRET_TEMPLATE) + '" alt="Foto Kakanwil" /></div></div>' +
        '</div>' +
        '<div class="sepekan-hex-luar" style="left:430px; top:700px; width:330px; height:330px; background:#0A2540;">' +
          '<div class="sepekan-hex-tengah"><div class="sepekan-hex-dalam"><img src="' + esc(state.fotoLapangan || FOTO_LAPANGAN_TEMPLATE) + '" alt="Foto kegiatan" /></div></div>' +
        '</div>' +
        '<div class="sepekan-sampul-kaki"></div>' +
      '</div>';
    }

    // ---------- Pratinjau ----------
    function htmlLaporan() {
      const halaman = bagiHalaman(susunBlok());
      let html = '<div class="sepekan-bungkus" data-halaman="sampul"><div class="sepekan-halaman">' + htmlSampul() + '</div></div>';
      halaman.forEach((hals, i) => {
        html += '<div class="sepekan-bungkus" data-halaman="' + (i + 2) + '"><div class="sepekan-halaman"><div class="sepekan-isi">' +
          hals.map((b) => b.html).join('') + '</div></div></div>';
      });
      return html;
    }
    function renderPratinjau() {
      const wadah = $('sp-pratinjau');
      if (!wadah) return;
      wadah.innerHTML = htmlLaporan();
      sesuaikanSkala();
    }
    function sesuaikanSkala() {
      const wadah = $('sp-pratinjau');
      if (!wadah) return;
      const lebar = Math.min(794, wadah.clientWidth || 794);
      const skala = lebar / 794;
      wadah.querySelectorAll('.sepekan-bungkus').forEach((b) => {
        const hal = b.querySelector('.sepekan-halaman');
        if (!hal) return;
        hal.style.transform = 'scale(' + skala + ')';
        b.style.width = (794 * skala) + 'px';
        b.style.height = (1123 * skala) + 'px';
      });
    }
    window.addEventListener('resize', () => { sesuaikanSkala(); });

    // ---------- Unduh PDF ----------
    // PDF dibuat dari KLON halaman pratinjau yang sedang terlihat (bukan
    // membangun ulang), supaya jumlah halaman dan isi PDF SELALU sama
    // dengan pratinjau. Klon dirender di dokumen iframe TERISOLASI
    // (srcdoc) yang hanya memuat CSS_LAPORAN (hex) + font Plus Jakarta
    // Sans yang sama — TANPA Tailwind. Ini menghindari galat html2canvas
    // "unsupported color function oklch" dan perbedaan paginasi akibat
    // font yang belum termuat saat pratinjau pertama dirender.
    let sedangUnduh = false;
    function tungguGambar(doc) {
      const imgs = Array.from(doc.querySelectorAll('img'));
      return Promise.all(imgs.map((im) => {
        if (im.complete && im.naturalWidth) return Promise.resolve();
        return new Promise((res) => { im.onload = res; im.onerror = res; setTimeout(res, 4000); });
      }));
    }
    async function unduhPdf() {
      if (sedangUnduh) return;
      const btn = $('sp-unduh');
      if (!window.html2canvas || !window.jspdf) {
        showStatus('Pustaka PDF belum termuat — periksa koneksi lalu segarkan halaman.', false);
        return;
      }
      bacaFormKeState();
      renderPratinjau();
      sedangUnduh = true;
      if (btn) { btn.disabled = true; btn.textContent = 'Membuat PDF…'; }
      showStatus('Membuat PDF laporan…', true);
      let frame = null;
      try {
        // Klon halaman pratinjau yang terlihat; hapus transform skala
        // tampilan supaya tiap halaman berukuran A4 penuh di iframe.
        const bungkus = Array.from(document.querySelectorAll('#sp-pratinjau .sepekan-bungkus'));
        if (!bungkus.length) throw new Error('Halaman laporan kosong.');
        const klonHtml = bungkus.map((b) => {
          const k = b.cloneNode(true);
          const hal = k.querySelector('.sepekan-halaman');
          if (hal) hal.style.transform = '';
          return k.outerHTML;
        }).join('');
        frame = document.createElement('iframe');
        frame.setAttribute('aria-hidden', 'true');
        frame.style.cssText = 'position:fixed;left:-10000px;top:0;width:794px;height:1123px;border:0;visibility:visible;';
        document.body.appendChild(frame);
        const docHtml = '<!DOCTYPE html><html><head><meta charset="utf-8">' +
          '<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">' +
          '<style>' + CSS_LAPORAN + '</style></head>' +
          '<body style="margin:0;background:#ffffff;">' + klonHtml + '</body></html>';
        frame.srcdoc = docHtml;
        await new Promise((res) => { frame.onload = res; setTimeout(res, 8000); });
        const fdoc = frame.contentDocument;
        if (!fdoc) throw new Error('Dokumen PDF tidak bisa dibuat.');
        await tungguGambar(fdoc);
        try { await fdoc.fonts.ready; } catch {}
        await new Promise((r) => setTimeout(r, 300));
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
        const halamanEls = Array.from(fdoc.querySelectorAll('.sepekan-halaman'));
        if (!halamanEls.length) throw new Error('Halaman laporan kosong.');
        for (let i = 0; i < halamanEls.length; i++) {
          const canvas = await window.html2canvas(halamanEls[i], { scale: 2, useCORS: true, backgroundColor: '#ffffff', logging: false });
          const img = canvas.toDataURL('image/jpeg', 0.92);
          if (i > 0) pdf.addPage('a4', 'portrait');
          pdf.addImage(img, 'JPEG', 0, 0, 210, 297);
          if (btn) btn.textContent = 'Membuat PDF… ' + (i + 1) + '/' + halamanEls.length;
        }
        pdf.save(namaBerkas());
        showStatus('PDF laporan sepekan berhasil diunduh (' + halamanEls.length + ' halaman).', true);
      } catch (e) {
        showStatus('Gagal membuat PDF: ' + (e && e.message ? e.message : 'galat'), false);
      } finally {
        if (frame) frame.remove();
        sedangUnduh = false;
        if (btn) { btn.disabled = false; btn.textContent = '⬇ Unduh PDF'; }
      }
    }

    // ---------- Event form ----------
    function hubungkanForm() {
      ['sp-mulai', 'sp-akhir', 'sp-ttd', 'sp-latar', 'sp-maksud', 'sp-ruang', 'sp-peserta', 'sp-tindak', 'sp-penutup'].forEach((id) => {
        const el = $(id);
        if (!el) return;
        el.addEventListener('input', () => { bacaFormKeState(); simpanDraf(); renderPratinjau(); });
        el.addEventListener('change', () => { bacaFormKeState(); simpanDraf(); renderPratinjau(); });
      });
      // Foto sampul
      $('sp-input-potret').addEventListener('change', async (e) => {
        const f = e.target.files && e.target.files[0];
        if (!f) return;
        try { state.fotoPotret = await berkasKeDataUrl(f, 1200); $('sp-foto-potret').src = state.fotoPotret; simpanDraf(); renderPratinjau(); showStatus('Foto 1 sampul diganti.', true); }
        catch (err) { showStatus('Gagal membaca foto: ' + err.message, false); }
        e.target.value = '';
      });
      $('sp-input-lapangan').addEventListener('change', async (e) => {
        const f = e.target.files && e.target.files[0];
        if (!f) return;
        try { state.fotoLapangan = await berkasKeDataUrl(f, 1200); $('sp-foto-lapangan').src = state.fotoLapangan; simpanDraf(); renderPratinjau(); showStatus('Foto 2 sampul diganti.', true); }
        catch (err) { showStatus('Gagal membaca foto: ' + err.message, false); }
        e.target.value = '';
      });
      $('sp-reset-potret').addEventListener('click', () => { state.fotoPotret = FOTO_POTRET_TEMPLATE; $('sp-foto-potret').src = state.fotoPotret; simpanDraf(); renderPratinjau(); });
      // Tarik berita + periode minggu ini
      $('sp-tarik').addEventListener('click', tarikBeritaMingguIni);
      $('sp-minggu-ini').addEventListener('click', setMingguIni);
      // Bila tanggal periode diubah manual, tarik berita periode baru otomatis.
      ['sp-mulai', 'sp-akhir'].forEach((id) => {
        const el = $(id);
        if (el) el.addEventListener('change', jadwalTarikOtomatis);
      });
      $('sp-reset-lapangan').addEventListener('click', () => { state.fotoLapangan = FOTO_LAPANGAN_TEMPLATE; $('sp-foto-lapangan').src = state.fotoLapangan; simpanDraf(); renderPratinjau(); });
      // Hari & kegiatan (delegasi klik + input)
      const wadah = $('sp-hari-list');
      wadah.addEventListener('click', (e) => {
        const t = e.target;
        const hapusHari = t.closest('[data-hapus-hari]');
        if (hapusHari) { state.hari.splice(Number(hapusHari.dataset.hapusHari), 1); renderHari(); simpanDraf(); renderPratinjau(); return; }
        const hapusKeg = t.closest('[data-hapus-kegiatan]');
        if (hapusKeg) { const [hi, ki] = hapusKeg.dataset.hapusKegiatan.split(':').map(Number); state.hari[hi].kegiatan.splice(ki, 1); renderHari(); simpanDraf(); renderPratinjau(); return; }
        const hapusFoto = t.closest('[data-hapus-foto]');
        if (hapusFoto) { const [hi, ki, fi] = hapusFoto.dataset.hapusFoto.split(':').map(Number); state.hari[hi].kegiatan[ki].foto.splice(fi, 1); renderHari(); simpanDraf(); renderPratinjau(); return; }
        const tambahKeg = t.closest('[data-tambah-kegiatan]');
        if (tambahKeg) { const hi = Number(tambahKeg.dataset.tambahKegiatan); state.hari[hi].kegiatan.push({ judul: '', narasi: '', foto: [] }); renderHari(); simpanDraf(); renderPratinjau(); return; }
      });
      wadah.addEventListener('change', async (e) => {
        const t = e.target;
        if (t.matches('[data-tanggal-hari]')) { const hi = Number(t.dataset.tanggalHari); state.hari[hi].tanggal = t.value; renderHari(); simpanDraf(); renderPratinjau(); return; }
        if (t.matches('[data-tambah-foto]')) {
          const [hi, ki] = t.dataset.tambahFoto.split(':').map(Number);
          const f = t.files && t.files[0];
          if (!f) return;
          try { const url = await berkasKeDataUrl(f, 1000); state.hari[hi].kegiatan[ki].foto.push(url); renderHari(); simpanDraf(); renderPratinjau(); }
          catch (err) { showStatus('Gagal membaca foto: ' + err.message, false); }
          t.value = '';
          return;
        }
      });
      wadah.addEventListener('input', (e) => {
        const t = e.target;
        if (t.matches('[data-judul-kegiatan]')) { const [hi, ki] = t.dataset.judulKegiatan.split(':').map(Number); state.hari[hi].kegiatan[ki].judul = t.value; simpanDraf(); renderPratinjau(); return; }
        if (t.matches('[data-narasi-kegiatan]')) { const [hi, ki] = t.dataset.narasiKegiatan.split(':').map(Number); state.hari[hi].kegiatan[ki].narasi = t.value; simpanDraf(); renderPratinjau(); return; }
      });
      $('sp-tambah-hari').addEventListener('click', () => {
        const terakhir = state.hari[state.hari.length - 1];
        let tglBaru = '';
        if (terakhir && terakhir.tanggal) {
          const d = parseTgl(terakhir.tanggal);
          if (d) { d.setDate(d.getDate() + 1); tglBaru = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
        }
        state.hari.push({ tanggal: tglBaru, kegiatan: [{ judul: '', narasi: '', foto: [] }] });
        renderHari(); simpanDraf(); renderPratinjau();
      });
      // Aksi
      $('sp-unduh').addEventListener('click', unduhPdf);
      $('sp-lihat').addEventListener('click', () => { renderPratinjau(); const el = $('sp-pratinjau-bagian'); if (el) el.scrollIntoView({ behavior: 'smooth' }); });
      $('sp-reset-template').addEventListener('click', () => {
        if (!confirm('Kembalikan semua isi ke template laporan 02–07 November 2026? Draf saat ini akan diganti.')) return;
        state = klon(TEMPLATE);
        tulisStateKeForm(); simpanDraf(); renderPratinjau();
        showStatus('Isi dikembalikan ke template.', true);
      });
      $('sp-bersihkan').addEventListener('click', () => {
        if (!confirm('Bersihkan draf laporan sepekan ini? Isi akan kembali kosong kecuali template dasar.')) return;
        try { localStorage.removeItem(KUNCI_DRAF); } catch {}
        state = klon(TEMPLATE);
        state.hari = [];
        tulisStateKeForm(); renderPratinjau();
        showStatus('Draf dibersihkan.', true);
      });
    }

    // ---------- Init ----------
    window.__kelolaSetelahLogin = () => { /* aplikasi ini tidak memuat data server */ };
    tulisStateKeForm();
    hubungkanForm();
    renderPratinjau();
    // Bila belum ada draf tersimpan, isi laporan otomatis dari berita
    // minggu berjalan (Senin–Sabtu) — tidak perlu mengetuk Tarik Berita.
    // Draf yang sudah ada tidak disentuh supaya editan manual tidak tertimpa.
    if (!drafTersimpan) {
      setMingguIni();
    }
    // Font web (Plus Jakarta Sans) bisa termuat setelah render pertama;
    // render ulang setelah font siap supaya paginasi memakai metrik font
    // yang benar dan pratinjau sama dengan PDF.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => { renderPratinjau(); }).catch(() => {});
    }
  </script>
</BaseLayout>
