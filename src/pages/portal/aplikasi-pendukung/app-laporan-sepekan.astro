---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../../data/site';
import { AUTHORS } from '../../../data/authors';

const categoryColors = Object.fromEntries(CATEGORIES.map((c) => [c.name, c.color]));
const authorInfoMap = Object.fromEntries(Object.values(AUTHORS).map((a) => [a.name, { role: a.role, bio: a.bio }]));
---

<BaseLayout
  title="Laporan Sepekan"
  description="Susun Laporan Kegiatan Kepala Kantor Wilayah Ditjenpas Bengkulu per pekan dan unduh sebagai PDF — untuk Administrator dan akun yang ditunjuk."
>
  <script type="application/json" id="kelola-data" set:html={JSON.stringify({ categoryColors, authors: authorInfoMap })} />

  <div class="mx-auto max-w-[1200px] px-4 py-6">
    <div class="border-b-2 border-[#0A2540] pb-4 dark:border-white">
      <h1 class="text-2xl font-black uppercase tracking-tight sm:text-3xl">Laporan Sepekan</h1>
      <div class="mt-2 h-1.5 w-20 rounded bg-[#FACC15]" aria-hidden="true"></div>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Laporan Kegiatan Kepala Kantor Wilayah Ditjenpas Bengkulu per pekan. Isi periode, ganti foto sampul, tulis isi laporan, lalu unduh sebagai PDF mengikuti template laporan sepekan.
      </p>
    </div>

    <div id="status" class="mt-4 hidden rounded-lg px-4 py-3 text-sm font-medium" role="status"></div>

    <!-- Login -->
    <section id="login-box" class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
      <img src="/images/logo-zonapas.png" alt="Logo ZonaPas" class="mx-auto h-16 w-16 rounded-full object-cover" width="64" height="64" />
      <h2 class="mt-3 text-lg font-bold">Masuk untuk membuka Laporan Sepekan</h2>
      <p class="mx-auto mt-1 max-w-md text-sm text-slate-600 dark:text-slate-400">
        Masuk dengan GitHub (khusus Administrator) atau dengan akun Google Administrator — atau akun Google Penulis/Penyunting yang sudah ditunjuk Administrator.
      </p>
      <button
        id="btn-login"
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
        Masuk dengan GitHub
      </button>
      <a
        href="/redaksi/auth/google"
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-[#0A2540] hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-800"
      >
        Masuk dengan Google
      </a>
      <p id="login-fallback" class="mt-3 hidden text-xs text-slate-500 dark:text-slate-400">
        Popup diblokir?
        <a href="https://oauth.zonapas.web.id/auth" target="_blank" class="font-bold text-[#0A2540] underline dark:text-white">Buka login GitHub di tab baru</a>
        — setelah otorisasi, kembali ke tab ini.
      </p>
    </section>

    <!-- Akses ditolak -->
    <section id="akses-ditolak" class="mt-6 hidden rounded-2xl border border-red-300 bg-red-50 p-6 text-center dark:border-red-900 dark:bg-red-900/20">
      <h2 class="text-lg font-bold text-red-900 dark:text-red-100">Akun ini belum punya akses</h2>
      <p id="akses-ditolak-pesan" class="mx-auto mt-1 max-w-md text-sm text-red-800 dark:text-red-200">Akun ini belum punya akses — hubungi Administrator untuk meminta akses Aplikasi Pendukung.</p>
      <button id="btn-akses-keluar" type="button" class="mt-4 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800">Keluar &amp; Coba Akun Lain</button>
    </section>

    <div id="app" class="hidden">
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span id="user-chip" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-bold dark:bg-slate-800">
          <img id="user-avatar" alt="" class="h-6 w-6 rounded-full" width="24" height="24" />
          <span id="user-name"></span>
        </span>
        <span class="flex-1"></span>
        <a href="/portal/aplikasi-pendukung/" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">← Kembali ke Aplikasi Pendukung</a>
        <button id="btn-keluar" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Keluar</button>
      </div>

      <!-- Periode -->
      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 sm:p-5" aria-label="Periode laporan">
        <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Periode Laporan</h2>
        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="min-w-0 flex-1">
            <span class="block text-sm font-bold">Tanggal mulai</span>
            <input id="sp-mulai" type="date" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium dark:border-slate-700 dark:bg-slate-900" />
          </label>
          <label class="min-w-0 flex-1">
            <span class="block text-sm font-bold">Tanggal akhir</span>
            <input id="sp-akhir" type="date" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium dark:border-slate-700 dark:bg-slate-900" />
          </label>
          <label class="min-w-0 flex-1">
            <span class="block text-sm font-bold">Tanggal tanda tangan</span>
            <input id="sp-ttd" type="date" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium dark:border-slate-700 dark:bg-slate-900" />
          </label>
        </div>
        <p id="sp-periode-teks" class="mt-3 text-sm font-bold text-[#0A2540] dark:text-white"></p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Periode dan tanggal tanda tangan tampil di sampul dan di bagian penutup laporan.</p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button id="sp-tarik" type="button" class="rounded-lg bg-[#0A2540] px-4 py-2 text-sm font-bold text-white hover:bg-[#123a66]">📥 Tarik Berita Minggu Ini</button>
          <button id="sp-minggu-ini" type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Set ke minggu ini</button>
        </div>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Berita ZonaPas masuk otomatis ke laporan: saat aplikasi dibuka (bila belum ada draf) dan setiap kali periode diubah, berita Senin–Sabtu pada periode itu ditarik sendiri — judul, narasi, dan foto kegiatan terisi dari berita, dan kedua foto sampul terisi dari foto berita. Tombol Tarik Berita untuk menarik ulang secara manual. Semua masih bisa diedit setelah ditarik.</p>
      </section>

      <!-- Foto sampul -->
      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 sm:p-5" aria-label="Foto sampul">
        <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Foto Sampul</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Dua foto di sampul laporan. Foto 1 (potret) di segi enam besar kiri, Foto 2 (kegiatan) di segi enam kanan. Ketuk foto untuk menggantinya. Bila menarik berita minggu ini, kedua foto ini otomatis terisi dari foto berita ZonaPas.</p>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
          <div>
            <p class="mb-1 text-sm font-bold">Foto 1 — Potret Kakanwil</p>
            <label class="block cursor-pointer overflow-hidden rounded-xl border-2 border-dashed border-slate-300 hover:border-[#0A2540] dark:border-slate-700">
              <img id="sp-foto-potret" src="/images/laporan-sepekan-sampul-potret.png" alt="Foto sampul potret Kakanwil" class="aspect-[4/3] w-full bg-[#FFCC00] object-cover object-top" />
              <input id="sp-input-potret" type="file" accept="image/*" class="hidden" />
            </label>
            <button id="sp-reset-potret" type="button" class="mt-2 text-xs font-bold text-[#0A2540] underline dark:text-white">Kembalikan foto template</button>
          </div>
          <div>
            <p class="mb-1 text-sm font-bold">Foto 2 — Kegiatan</p>
            <label class="block cursor-pointer overflow-hidden rounded-xl border-2 border-dashed border-slate-300 hover:border-[#0A2540] dark:border-slate-700">
              <img id="sp-foto-lapangan" src="/images/laporan-sepekan-sampul-lapangan.jpg" alt="Foto sampul kegiatan" class="aspect-[4/3] w-full bg-[#FFCC00] object-cover object-top" />
              <input id="sp-input-lapangan" type="file" accept="image/*" class="hidden" />
            </label>
            <button id="sp-reset-lapangan" type="button" class="mt-2 text-xs font-bold text-[#0A2540] underline dark:text-white">Kembalikan foto template</button>
          </div>
        </div>
      </section>

      <!-- Isi laporan -->
      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 sm:p-5" aria-label="Isi laporan">
        <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Isi Laporan</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Isi sudah terisi mengikuti template laporan sepekan — ubah seperlunya. Pisahkan paragraf dengan satu baris kosong.</p>
        <div class="mt-3 space-y-4">
          <label class="block">
            <span class="block text-sm font-bold">Latar Belakang</span>
            <textarea id="sp-latar" rows="7" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm leading-relaxed dark:border-slate-700 dark:bg-slate-900"></textarea>
          </label>
          <label class="block">
            <span class="block text-sm font-bold">Maksud &amp; Tujuan</span>
            <textarea id="sp-maksud" rows="5" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm leading-relaxed dark:border-slate-700 dark:bg-slate-900"></textarea>
          </label>
          <label class="block">
            <span class="block text-sm font-bold">Ruang Lingkup</span>
            <textarea id="sp-ruang" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm leading-relaxed dark:border-slate-700 dark:bg-slate-900"></textarea>
          </label>
          <label class="block">
            <span class="block text-sm font-bold">Peserta</span>
            <textarea id="sp-peserta" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm leading-relaxed dark:border-slate-700 dark:bg-slate-900"></textarea>
          </label>
          <label class="block">
            <span class="block text-sm font-bold">Tindak Lanjut (satu butir per baris)</span>
            <textarea id="sp-tindak" rows="8" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm leading-relaxed dark:border-slate-700 dark:bg-slate-900"></textarea>
          </label>
          <label class="block">
            <span class="block text-sm font-bold">Penutup</span>
            <textarea id="sp-penutup" rows="2" class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm leading-relaxed dark:border-slate-700 dark:bg-slate-900"></textarea>
          </label>
        </div>
      </section>

      <!-- Hasil per hari -->
      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 sm:p-5" aria-label="Hasil per hari">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Hasil yang Dicapai (per Hari)</h2>
          <button id="sp-tambah-hari" type="button" class="rounded-lg bg-[#0A2540] px-4 py-2 text-sm font-bold text-white hover:bg-[#123a66]">+ Tambah Hari</button>
        </div>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Setiap hari berisi satu atau beberapa kegiatan. Setiap kegiatan punya judul, narasi, dan sampai 2 foto. Ketuk “Tarik Berita Minggu Ini” di atas untuk mengisi otomatis dari berita ZonaPas Senin–Sabtu, atau isi manual — contoh dari template bisa diubah atau dihapus.</p>
        <div id="sp-hari-list" class="mt-4 space-y-5"></div>
      </section>

      <!-- Aksi -->
      <section class="mt-6 flex flex-wrap items-center gap-3">
        <button id="sp-unduh" type="button" class="rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">⬇ Unduh PDF</button>
        <button id="sp-lihat" type="button" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Lihat Pratinjau ↓</button>
        <span class="flex-1"></span>
        <button id="sp-reset-template" type="button" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Muat Ulang Template</button>
        <button id="sp-bersihkan" type="button" class="rounded-lg border border-red-300 px-4 py-2.5 text-sm font-bold text-red-700 hover:bg-red-50 dark:border-red-900 dark:text-red-200 dark:hover:bg-red-900/20">Bersihkan Draf</button>
      </section>
      <p id="sp-draf-info" class="mt-2 text-xs text-slate-500 dark:text-slate-400">Draf tersimpan otomatis di peramban ini.</p>

      <!-- Pratinjau -->
      <section id="sp-pratinjau-bagian" class="mt-8" aria-label="Pratinjau laporan">
        <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Pratinjau Laporan</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Tampilan di bawah ini sama dengan isi PDF yang diunduh (ukuran A4 per halaman).</p>
        <div id="sp-pratinjau" class="mt-4 flex flex-col items-center gap-6"></div>
      </section>
    </div>
  </div>


  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js" defer></script>
  <script is:inline src="/kelola-umum.js?v=10"></script>
  <script type="module">
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const HARI_NAMA = ['MINGGU', 'SENIN', 'SELASA', 'RABU', 'KAMIS', 'JUMAT', 'SABTU'];
    const BULAN_NAMA = ['JANUARI', 'FEBRUARI', 'MARET', 'APRIL', 'MEI', 'JUNI', 'JULI', 'AGUSTUS', 'SEPTEMBER', 'OKTOBER', 'NOVEMBER', 'DESEMBER'];
    const BULAN_PENDEK = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
    // Gaya template laporan (WARNA HEX SAJA — html2canvas tidak memahami
    // warna oklch Tailwind 4). Disuntik sebagai <style> global agar berlaku
    // untuk halaman pratinjau yang dibuat dinamis, dan dipakai juga di
    // dokumen iframe terisolasi saat membuat PDF (tanpa Tailwind sama sekali).
    const CSS_LAPORAN = `.sepekan-bungkus { position: relative; overflow: hidden; }
    .sepekan-halaman {
      width: 794px; height: 1123px; position: relative; overflow: hidden;
      background: #ffffff; color: #0A2540;
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
      box-shadow: 0 4px 24px rgba(5, 21, 46, 0.25);
      flex: none; transform-origin: top left;
    }
    .sepekan-isi { padding: 48px 56px 48px 56px; height: 1123px; box-sizing: border-box; }
    .sepekan-judul-bab { font-size: 26px; font-weight: 800; letter-spacing: 0.5px; color: #0A2540; margin: 0 0 6px 0; text-transform: uppercase; }
    .sepekan-garis-kuning { width: 72px; height: 6px; background: #FFCC00; border-radius: 3px; margin: 0 0 18px 0; }
    .sepekan-paragraf { font-size: 15px; line-height: 1.65; text-align: justify; margin: 0 0 14px 0; color: #16233D; text-indent: 28px; }
    .sepekan-paragraf.lanjutan { text-indent: 0; }
    .sepekan-butir { font-size: 15px; line-height: 1.6; text-align: justify; margin: 0 0 10px 0; color: #16233D; padding-left: 26px; position: relative; }
    .sepekan-butir .nomor { position: absolute; left: 0; top: 0; font-weight: 800; color: #0A2540; }
    .sepekan-pita-hasil { background: #1E40AF; color: #ffffff; font-size: 26px; font-weight: 800; letter-spacing: 0.5px; padding: 10px 22px; margin: 0 -56px 12px -56px; }
    .sepekan-tanggal-hari { font-size: 16px; font-weight: 800; color: #0A2540; margin: 0 0 14px 0; letter-spacing: 0.3px; }
    .sepekan-judul-kegiatan { font-size: 17px; font-weight: 800; line-height: 1.35; color: #0A2540; text-transform: uppercase; margin: 0 0 10px 0; padding-left: 12px; border-left: 6px solid #FFCC00; }
    .sepekan-2kol { display: flex; gap: 18px; margin: 0 0 14px 0; }
    .sepekan-2kol-kol { flex: 1 1 0; min-width: 0; }
    .sepekan-2kol-kol .sepekan-paragraf { margin: 0 0 10px 0; }
    .sepekan-2kol-kol .sepekan-paragraf:last-child { margin-bottom: 0; }
    .sepekan-foto-baris { display: flex; gap: 10px; margin: 0 0 14px 0; }
    .sepekan-foto-baris img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sepekan-foto-satu { flex: 1 1 0; height: 170px; overflow: hidden; border-radius: 4px; }
    .sepekan-foto-dua { flex: 1 1 0; height: 170px; overflow: hidden; border-radius: 4px; }
    .sepekan-foto-tunggal { width: 340px; height: 200px; overflow: hidden; border-radius: 4px; margin: 0 0 14px 0; }
    .sepekan-foto-tunggal img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sepekan-ttd { margin-top: 26px; text-align: right; font-size: 15px; line-height: 1.5; color: #16233D; }
    .sepekan-ttd .nama { font-weight: 800; text-transform: uppercase; margin-top: 64px; }
    /* Sampul */
    .sepekan-sampul { position: absolute; inset: 0; background: #F4F8FE; overflow: hidden; }
    .sepekan-sampul-garis { position: absolute; inset: 0; background: repeating-linear-gradient(115deg, transparent 0 90px, rgba(30, 64, 175, 0.05) 90px 96px); }
    .sepekan-sampul-kepala { position: absolute; top: 34px; left: 44px; right: 44px; display: flex; align-items: center; gap: 14px; }
    .sepekan-sampul-kepala img { width: 74px; height: 74px; object-fit: contain; }
    .sepekan-sampul-kepala .t1 { font-size: 26px; font-weight: 800; color: #0A2540; letter-spacing: 1px; line-height: 1.1; }
    .sepekan-sampul-kepala .t2 { font-size: 22px; font-weight: 800; line-height: 1.1; }
    .sepekan-sampul-kepala .t2 .biru { color: #1E40AF; }
    .sepekan-sampul-kepala .t2 .kuning { color: #FFCC00; background: #0A2540; padding: 1px 8px; border-radius: 3px; }
    .sepekan-sampul-judul { position: absolute; top: 170px; left: 0; right: 0; text-align: center; }
    .sepekan-sampul-judul .besar { font-size: 76px; font-weight: 800; line-height: 1.02; letter-spacing: 1px; color: #111111; }
    .sepekan-sampul-judul .besar .biru { color: #1E40AF; }
    .sepekan-sampul-judul .kecil { font-size: 25px; font-weight: 800; font-style: italic; line-height: 1.25; color: #111111; margin-top: 12px; }
    .sepekan-sampul-periode { position: absolute; top: 430px; right: 44px; background: #1E40AF; color: #FFCC00; font-size: 26px; font-weight: 800; letter-spacing: 1px; padding: 12px 26px; clip-path: polygon(0 0, 100% 0, calc(100% - 22px) 100%, 0 100%); }
    .sepekan-hex-luar { position: absolute; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); }
    .sepekan-hex-tengah { position: absolute; inset: 10px; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); background: #FFCC00; }
    .sepekan-hex-dalam { position: absolute; inset: 10px; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); overflow: hidden; background: #FFCC00; }
    .sepekan-hex-dalam img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
    .sepekan-sampul-kaki { position: absolute; left: 0; right: 0; bottom: 0; height: 46px; background: #0A2540; }
    .sepekan-sampul-kaki::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 8px; background: #FFCC00; }
    /* Pengukur tinggi blok (tersembunyi, lebar sama dengan area isi) */
    #sp-ukur { position: fixed; left: 0; top: 0; width: 682px; visibility: hidden; font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; }`;
    (function suntikCssLaporan() {
      const st = document.createElement('style');
      st.setAttribute('data-sepekan', '');
      st.textContent = CSS_LAPORAN;
      document.head.appendChild(st);
    })();


    // ---------- Tanggal ----------
    function parseTgl(str) {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(str || ''));
      if (!m) return null;
      return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
    }
    function labelHari(str) {
      const d = parseTgl(str);
      if (!d) return '';
      return HARI_NAMA[d.getDay()] + ', ' + String(d.getDate()).padStart(2, '0') + ' ' + BULAN_NAMA[d.getMonth()] + ' ' + d.getFullYear();
    }
    function teksPeriode() {
      const a = parseTgl(state.mulai), b = parseTgl(state.akhir);
      if (!a || !b) return '';
      const tgl = (d) => String(d.getDate()).padStart(2, '0');
      if (a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth()) {
        return tgl(a) + ' – ' + tgl(b) + ' ' + BULAN_NAMA[b.getMonth()] + ' ' + b.getFullYear();
      }
      if (a.getFullYear() === b.getFullYear()) {
        return tgl(a) + ' ' + BULAN_NAMA[a.getMonth()] + ' – ' + tgl(b) + ' ' + BULAN_NAMA[b.getMonth()] + ' ' + b.getFullYear();
      }
      return tgl(a) + ' ' + BULAN_NAMA[a.getMonth()] + ' ' + a.getFullYear() + ' – ' + tgl(b) + ' ' + BULAN_NAMA[b.getMonth()] + ' ' + b.getFullYear();
    }
    function namaBerkas() {
      const a = parseTgl(state.mulai), b = parseTgl(state.akhir);
      const fmt = (d) => String(d.getDate()).padStart(2, '0') + '-' + BULAN_PENDEK[d.getMonth()] + '-' + d.getFullYear();
      const per = (a && b) ? '(' + fmt(a) + '_sd_' + fmt(b) + ')' : '';
      return 'Laporan_Kegiatan_Kakanwil_' + per + '.pdf';
    }
    function tglTtdPanjang() {
      const d = parseTgl(state.ttd);
      if (!d) return '';
      return 'Bengkulu, ' + String(d.getDate()).padStart(2, '0') + ' ' + BULAN_NAMA[d.getMonth()] + ' ' + d.getFullYear();
    }

    // ---------- Tarik Berita Minggu Ini ----------
    // Laporan sepekan diambil dari berita ZonaPas (Senin–Sabtu). Sumber:
    // /search-index.json (judul, tanggal, foto sampul) + halaman tiap
    // artikel untuk narasinya (#article-body p). Foto sampul laporan
    // ikut terisi dari foto berita. Semua hasil tarikan masih bisa diedit.
    const BULAN_INDEKS = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, Mei: 4, May: 4, Jun: 5, Jul: 6, Agu: 7, Aug: 7, Sep: 8, Okt: 9, Oct: 9, Nov: 10, Des: 11, Dec: 11 };
    function parseTanggalIndeks(str) {
      const m = /^(\d{1,2})\s+([A-Za-z]{3,})\s+(\d{4})$/.exec(String(str || '').trim());
      if (!m) return null;
      const bln = BULAN_INDEKS[m[2]];
      if (bln === undefined) return null;
      return new Date(Number(m[3]), bln, Number(m[1]));
    }
    function fmtTglIso(d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    async function ambilNarasiArtikel(url) {
      try {
        const res = await fetch(url);
        if (!res.ok) return '';
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const paras = Array.from(doc.querySelectorAll('#article-body p'))
          .map((p) => p.textContent.replace(/\s+/g, ' ').trim())
          .filter((t) => t.length > 0);
        let teks = paras.slice(0, 3).join('\n\n');
        if (teks.length > 1500) {
          teks = teks.slice(0, 1500);
          const titik = teks.lastIndexOf('. ');
          if (titik > 800) teks = teks.slice(0, titik + 1);
        }
        return teks;
      } catch { return ''; }
    }
    let sedangTarik = false;
    let periodeTerakhirTarik = '';
    async function tarikBeritaMingguIni() {
      if (sedangTarik) return;
      const btn = $('sp-tarik');
      bacaFormKeState();
      const mulai = parseTgl(state.mulai), akhir = parseTgl(state.akhir);
      if (!mulai || !akhir || akhir < mulai) { showStatus('Isi dulu periode yang benar (tanggal mulai s/d akhir).', false); return; }
      sedangTarik = true;
      if (btn) { btn.disabled = true; btn.textContent = 'Menarik berita…'; }
      showStatus('Menarik berita ZonaPas ' + teksPeriode() + ' (Senin–Sabtu)…', true);
      try {
        const res = await fetch('/search-index.json');
        if (!res.ok) throw new Error('Indeks berita tidak bisa dimuat.');
        const indeks = await res.json();
        const artikel = indeks
          .map((a) => ({ ...a, tgl: parseTanggalIndeks(a.date) }))
          .filter((a) => a.tgl && a.tgl >= mulai && a.tgl <= akhir && a.tgl.getDay() !== 0)
          .sort((x, y) => x.tgl - y.tgl);
        if (!artikel.length) {
          periodeTerakhirTarik = (state.mulai || '') + '|' + (state.akhir || '');
          showStatus('Tidak ada berita ZonaPas pada periode ' + teksPeriode() + ' (Senin–Sabtu).', false);
          return;
        }
        const narasiList = await Promise.all(artikel.map((a) => ambilNarasiArtikel(a.url)));
        const perHari = {};
        artikel.forEach((a, i) => {
          const kunci = fmtTglIso(a.tgl);
          if (!perHari[kunci]) perHari[kunci] = { tanggal: kunci, kegiatan: [] };
          perHari[kunci].kegiatan.push({
            judul: a.title,
            narasi: narasiList[i] || a.summary || '',
            foto: a.image ? [a.image] : [],
          });
        });
        periodeTerakhirTarik = (state.mulai || '') + '|' + (state.akhir || '');
        state.hari = Object.keys(perHari).sort().map((k) => perHari[k]);
        const fotoBerita = artikel.filter((a) => a.image).map((a) => a.image);
        if (fotoBerita.length) {
          state.fotoPotret = fotoBerita[0];
          if (fotoBerita.length > 1) state.fotoLapangan = fotoBerita[1];
        }
        simpanDraf();
        tulisStateKeForm();
        renderPratinjau();
        showStatus('Berhasil menarik ' + artikel.length + ' berita dari ' + state.hari.length + ' hari (' + teksPeriode() + '). Judul, narasi, dan foto kegiatan terisi dari berita ZonaPas; foto sampul juga dari foto berita. Semua masih bisa diedit.', true);
      } catch (e) {
        showStatus('Gagal menarik berita: ' + (e && e.message ? e.message : 'galat'), false);
      } finally {
        sedangTarik = false;
        if (btn) { btn.disabled = false; btn.textContent = '📥 Tarik Berita Minggu Ini'; }
      }
    }
    function setMingguIni() {
      const kini = new Date();
      const senin = new Date(kini);
      senin.setDate(kini.getDate() - ((kini.getDay() + 6) % 7));
      const sabtu = new Date(senin);
      sabtu.setDate(senin.getDate() + 5);
      state.mulai = fmtTglIso(senin);
      state.akhir = fmtTglIso(sabtu);
      state.ttd = fmtTglIso(sabtu);
      tulisStateKeForm();
      simpanDraf();
      renderPratinjau();
      showStatus('Periode diset ke minggu ini: ' + teksPeriode() + ' (Senin–Sabtu).', true);
      tarikBeritaMingguIni();
    }
    // Tarik otomatis (debounce) bila tanggal periode diubah manual.
    let timerTarikOtomatis = null;
    function jadwalTarikOtomatis() {
      clearTimeout(timerTarikOtomatis);
      timerTarikOtomatis = setTimeout(() => {
        bacaFormKeState();
        const kunci = (state.mulai || '') + '|' + (state.akhir || '');
        if (kunci === periodeTerakhirTarik) return;
        const mulai = parseTgl(state.mulai), akhir = parseTgl(state.akhir);
        if (!mulai || !akhir || akhir < mulai) return;
        tarikBeritaMingguIni();
      }, 800);
    }

    // ---------- Template bawaan (dari PDF laporan 02–07 Nov 2026) ----------
    const FOTO_POTRET_TEMPLATE = '/images/laporan-sepekan-sampul-potret.png';
    const FOTO_LAPANGAN_TEMPLATE = '/images/laporan-sepekan-sampul-lapangan.jpg';
    const TEMPLATE = {
