    // ---------- State + draf (localStorage) ----------
    const KUNCI_DRAF = 'zonapas-laporan-sepekan-draf-v1';
    function klon(o) { return JSON.parse(JSON.stringify(o)); }
    function muatDraf() {
      try {
        const raw = localStorage.getItem(KUNCI_DRAF);
        if (!raw) return null;
        const d = JSON.parse(raw);
        if (!d || typeof d !== 'object' || !Array.isArray(d.hari)) return null;
        return d;
      } catch { return null; }
    }
    const drafTersimpan = muatDraf();
    let state = drafTersimpan || klon(TEMPLATE);
    // Isi bab dari draf lama dibuang — bab kini TETAP dari TEMPLATE.
    ['latar', 'maksud', 'ruang', 'peserta', 'tindak', 'penutup'].forEach((k) => { delete state[k]; });
    let timerSimpan = null;
    function simpanDraf() {
      clearTimeout(timerSimpan);
      timerSimpan = setTimeout(() => {
        try {
          localStorage.setItem(KUNCI_DRAF, JSON.stringify(state));
          const info = $('sp-draf-info');
          if (info) info.textContent = 'Draf tersimpan otomatis di peramban ini.';
        } catch {
          const info = $('sp-draf-info');
          if (info) info.textContent = 'Draf tidak tersimpan (penyimpanan peramban penuh) — segera unduh PDF Anda.';
        }
      }, 400);
    }
    function showStatus(pesan, ok) {
      const el = $('status');
      if (!el) return;
      el.classList.remove('hidden');
      el.textContent = pesan;
      el.style.background = ok ? '#dcfce7' : '#fee2e2';
      el.style.color = ok ? '#166534' : '#991b1b';
      el.style.border = '1px solid ' + (ok ? '#86efac' : '#fca5a5');
    }

    // ---------- Foto: baca berkas -> data URL (diperkecil maks 1200px) ----------
    function berkasKeDataUrl(file, maxLebar) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = () => reject(new Error('Gagal membaca berkas.'));
        reader.onload = () => {
          const img = new Image();
          img.onerror = () => reject(new Error('Berkas bukan gambar.'));
          img.onload = () => {
            try {
              const skala = Math.min(1, (maxLebar || 1200) / img.naturalWidth);
              const c = document.createElement('canvas');
              c.width = Math.max(1, Math.round(img.naturalWidth * skala));
              c.height = Math.max(1, Math.round(img.naturalHeight * skala));
              c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
              resolve(c.toDataURL('image/jpeg', 0.85));
            } catch (e) { reject(e); }
          };
          img.src = String(reader.result);
        };
        reader.readAsDataURL(file);
      });
    }

    // ---------- Potong foto (crop) ----------
    // Bingkai tetap di tengah panggung; foto digeser (pan) + di-zoom supaya
    // bagian yang diinginkan masuk bingkai. Rasio bawaan 4:3, sama untuk
    // foto sampul dan foto kegiatan; Bebas = pakai seluruh foto tanpa dipotong.
    let spCrop = null;
    function spCropFrame() {
      const st = spCrop;
      const stage = $('sp-crop-stage');
      const sw = stage.clientWidth, sh = stage.clientHeight;
      const pad = 16;
      let fw, fh;
      if (!st.rasio) { fw = sw - pad * 2; fh = sh - pad * 2; }
      else {
        fw = Math.min(sw - pad * 2, (sh - pad * 2) * st.rasio);
        fh = fw / st.rasio;
      }
      return { x: (sw - fw) / 2, y: (sh - fh) / 2, w: fw, h: fh };
    }
    function spCropSkalaDasar() {
      const st = spCrop;
      const fr = spCropFrame();
      return Math.max(fr.w / st.alamiW, fr.h / st.alamiH);
    }
    function spCropBatasi() {
      const st = spCrop;
      const fr = spCropFrame();
      const dw = st.alamiW * st.skala, dh = st.alamiH * st.skala;
      st.imgX = Math.max(fr.x + fr.w - dw, Math.min(st.imgX, fr.x));
      st.imgY = Math.max(fr.y + fr.h - dh, Math.min(st.imgY, fr.y));
    }
    function spCropTampilkan() {
      const st = spCrop;
      if (!st) return;
      const fr = spCropFrame();
      const frame = $('sp-crop-frame');
      frame.style.left = fr.x + 'px';
      frame.style.top = fr.y + 'px';
      frame.style.width = fr.w + 'px';
      frame.style.height = fr.h + 'px';
      frame.style.display = st.rasio ? '' : 'none';
      const dw = st.alamiW * st.skala, dh = st.alamiH * st.skala;
      const img = $('sp-crop-img');
      img.style.left = st.imgX + 'px';
      img.style.top = st.imgY + 'px';
      img.style.width = dw + 'px';
      img.style.height = dh + 'px';
    }
    function spCropTengah() {
      const st = spCrop;
      const fr = spCropFrame();
      const dw = st.alamiW * st.skala, dh = st.alamiH * st.skala;
      st.imgX = fr.x + fr.w / 2 - dw / 2;
      st.imgY = fr.y + fr.h / 2 - dh / 2;
      spCropBatasi();
    }
    function spCropAturZoom(z) {
      const st = spCrop;
      if (!st) return;
      const fr = spCropFrame();
      const cx = fr.x + fr.w / 2, cy = fr.y + fr.h / 2;
      const dwLama = st.alamiW * st.skala, dhLama = st.alamiH * st.skala;
      const rx = (cx - st.imgX) / dwLama, ry = (cy - st.imgY) / dhLama;
      st.skala = spCropSkalaDasar() * z;
      const dw = st.alamiW * st.skala, dh = st.alamiH * st.skala;
      st.imgX = cx - rx * dw;
      st.imgY = cy - ry * dh;
      spCropBatasi();
      spCropTampilkan();
    }
    function spCropAturRasio(rasio) {
      const st = spCrop;
      if (!st) return;
      st.rasio = rasio;
      document.querySelectorAll('[data-sp-rasio]').forEach((b) => {
        b.classList.toggle('sp-crop-rasio-aktif', parseFloat(b.getAttribute('data-sp-rasio')) === rasio);
      });
      st.zoom = 1;
      $('sp-crop-zoom').value = '1';
      st.skala = spCropSkalaDasar();
      spCropTengah();
      spCropTampilkan();
    }
    function spCropTutup() { $('sp-modal-crop').classList.add('hidden'); }
    function spCropBatal() {
      if (spCrop && spCrop.resolve) spCrop.resolve(null);
      spCrop = null;
      spCropTutup();
    }
    function spCropHasil(st) {
      const maxLebar = st.maxLebar || 1000;
      if (!st.rasio) {
        const skala = Math.min(1, maxLebar / st.alamiW);
        const c = document.createElement('canvas');
        c.width = Math.max(1, Math.round(st.alamiW * skala));
        c.height = Math.max(1, Math.round(st.alamiH * skala));
        c.getContext('2d').drawImage(st.img, 0, 0, c.width, c.height);
        return c.toDataURL('image/jpeg', 0.85);
      }
      const fr = spCropFrame();
      const dw = st.alamiW * st.skala, dh = st.alamiH * st.skala;
      const sx = Math.max(0, Math.round((fr.x - st.imgX) / dw * st.alamiW));
      const sy = Math.max(0, Math.round((fr.y - st.imgY) / dh * st.alamiH));
      let sw = Math.min(st.alamiW - sx, Math.round(fr.w / dw * st.alamiW));
      let sh = Math.min(st.alamiH - sy, Math.round(fr.h / dh * st.alamiH));
      sw = Math.max(1, sw); sh = Math.max(1, sh);
      const skala = Math.min(1, maxLebar / sw);
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(sw * skala));
      c.height = Math.max(1, Math.round(sh * skala));
      c.getContext('2d').drawImage(st.img, sx, sy, sw, sh, 0, 0, c.width, c.height);
      return c.toDataURL('image/jpeg', 0.85);
    }
    function spCropKonfirmasi() {
      const st = spCrop;
      if (!st) return;
      const hasil = spCropHasil(st);
      if (st.resolve) st.resolve(hasil);
      spCrop = null;
      spCropTutup();
    }
    function spBukaCrop(file, maxLebar, rasioAwal) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = () => reject(new Error('Gagal membaca berkas.'));
        reader.onload = () => {
          const img = new Image();
          img.onerror = () => reject(new Error('Berkas bukan gambar.'));
          img.onload = () => {
            spCrop = {
              img, alamiW: img.naturalWidth, alamiH: img.naturalHeight,
              rasio: (rasioAwal === undefined ? 1.7 : rasioAwal),
              zoom: 1, skala: 1, imgX: 0, imgY: 0,
              maxLebar: maxLebar || 1000, resolve,
            };
            $('sp-crop-img').src = String(reader.result);
            $('sp-crop-zoom').value = '1';
            spCropAturRasio(spCrop.rasio);
            spCrop.skala = spCropSkalaDasar();
            spCropTengah();
            spCropTampilkan();
            $('sp-modal-crop').classList.remove('hidden');
          };
          img.src = String(reader.result);
        };
        reader.readAsDataURL(file);
      });
    }
    function spCropPasangGestur() {
      const stage = $('sp-crop-stage');
      let seret = null;
      stage.addEventListener('pointerdown', (e) => {
        if (!spCrop || !spCrop.rasio) return;
        seret = { x: e.clientX, y: e.clientY, imgX: spCrop.imgX, imgY: spCrop.imgY };
        try { stage.setPointerCapture(e.pointerId); } catch {}
        $('sp-crop-img').style.cursor = 'grabbing';
      });
      stage.addEventListener('pointermove', (e) => {
        if (!seret || !spCrop) return;
        spCrop.imgX = seret.imgX + (e.clientX - seret.x);
        spCrop.imgY = seret.imgY + (e.clientY - seret.y);
        spCropBatasi();
        spCropTampilkan();
      });
      const selesai = () => {
        seret = null;
        const im = $('sp-crop-img');
        if (im) im.style.cursor = 'grab';
      };
      stage.addEventListener('pointerup', selesai);
      stage.addEventListener('pointercancel', selesai);
      $('sp-crop-zoom').addEventListener('input', (e) => spCropAturZoom(parseFloat(e.target.value) || 1));
      document.querySelectorAll('[data-sp-rasio]').forEach((b) => {
        b.addEventListener('click', () => spCropAturRasio(parseFloat(b.getAttribute('data-sp-rasio')) || 0));
      });
      $('sp-btn-crop-pakai').addEventListener('click', spCropKonfirmasi);
      $('sp-btn-crop-batal').addEventListener('click', spCropBatal);
      $('sp-modal-crop').addEventListener('click', (e) => {
        if (e.target && !e.target.closest('#sp-modal-crop > div')) spCropBatal();
      });
    }

