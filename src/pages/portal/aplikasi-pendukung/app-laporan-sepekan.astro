    // ---------- Pratinjau ----------
    function htmlLaporan() {
      const halaman = bagiHalaman(susunBlok());
      let html = '<div class="sepekan-bungkus" data-halaman="sampul"><div class="sepekan-halaman">' + htmlSampul() + '</div></div>';
      const LATAR = '<div class="sepekan-latar"><div class="sepekan-latar-watermark"><img src="/images/lambang-pas-abu.png" alt="" /></div><div class="sepekan-latar-titik"></div><div class="sepekan-latar-rantai"></div><div class="sepekan-latar-garis-biru"></div><div class="sepekan-latar-garis-kuning"></div><div class="sepekan-latar-segitiga-biru"></div><div class="sepekan-latar-segitiga-kuning"></div><div class="sepekan-latar-logo-kuning"></div><div class="sepekan-latar-logo"><img src="/images/logo-kemenimipas.png" alt="" /></div><div class="sepekan-latar-segitiga-bawah-kuning"></div><div class="sepekan-latar-segitiga-bawah-biru"></div><div class="sepekan-latar-bawah"></div></div>';
      // Latar khusus halaman Hasil (Motif 1 Emboss Segi Enam) — halaman
      // bab lain tetap memakai LATAR. Watermark lambang tetap ada.
      const LATAR_HASIL = '<div class="sepekan-latar-hasil"><div class="sepekan-hasil-dots"></div><div class="sepekan-hasil-header"></div><div class="sepekan-hasil-header-hex"></div><div class="sepekan-hasil-stripe"></div><div class="sepekan-hasil-emboss"></div><div class="sepekan-latar-watermark"><img src="/images/lambang-pas-abu.png" alt="" /></div><div class="sepekan-hasil-tri-biru"></div><div class="sepekan-hasil-tri-kuning"></div><div class="sepekan-hasil-logo"><img src="/images/logo-kemenimipas.png" alt="" /></div><div class="sepekan-latar-bawah"></div></div>';
      halaman.forEach((hals, i) => {
        // Halaman Hasil = ada blok kegiatan (grup 'keg-...') di halaman itu.
        const isHasil = hals.some((b) => b.grup && String(b.grup).indexOf('keg-') === 0);
        const latarPage = isHasil ? LATAR_HASIL : LATAR;
        html += '<div class="sepekan-bungkus" data-halaman="' + (i + 2) + '"><div class="sepekan-halaman">' + latarPage + '<div class="sepekan-isi">' +
          hals.map((b) => b.html).join('') + '</div></div></div>';
      });
      return html;
    }
    function renderPratinjau() {
      const wadah = $('sp-pratinjau');
      if (!wadah) return;
      wadah.innerHTML = htmlLaporan();
      sesuaikanSkala();
    }
    function sesuaikanSkala() {
      const wadah = $('sp-pratinjau');
      if (!wadah) return;
      const lebar = Math.min(813, wadah.clientWidth || 813);
      const skala = lebar / 813;
      wadah.querySelectorAll('.sepekan-bungkus').forEach((b) => {
        const hal = b.querySelector('.sepekan-halaman');
        if (!hal) return;
        hal.style.transform = 'scale(' + skala + ')';
        b.style.width = (813 * skala) + 'px';
        b.style.height = (1247 * skala) + 'px';
      });
    }
    window.addEventListener('resize', () => { sesuaikanSkala(); });

    // ---------- Unduh PDF ----------
    // PDF dibuat dari KLON halaman pratinjau yang sedang terlihat (bukan
    // membangun ulang), supaya jumlah halaman dan isi PDF SELALU sama
    // dengan pratinjau. Klon dirender di dokumen iframe TERISOLASI
    // (srcdoc) yang hanya memuat CSS_LAPORAN (hex) + font Plus Jakarta
    // Sans yang sama — TANPA Tailwind. Ini menghindari galat html2canvas
    // "unsupported color function oklch" dan perbedaan paginasi akibat
    // font yang belum termuat saat pratinjau pertama dirender.
    let sedangUnduh = false;
    function tungguGambar(doc) {
      const imgs = Array.from(doc.querySelectorAll('img'));
      return Promise.all(imgs.map((im) => {
        if (im.complete && im.naturalWidth) return Promise.resolve();
        return new Promise((res) => { im.onload = res; im.onerror = res; setTimeout(res, 4000); });
      }));
    }
    async function unduhPdf() {
      if (sedangUnduh) return;
      const btn = $('sp-unduh');
      if (!window.html2canvas || !window.jspdf) {
        showStatus('Pustaka PDF belum termuat — periksa koneksi lalu segarkan halaman.', false);
        return;
      }
      bacaFormKeState();
      renderPratinjau();
      sedangUnduh = true;
      if (btn) { btn.disabled = true; btn.textContent = 'Membuat PDF…'; }
      showStatus('Membuat PDF laporan…', true);
      let frame = null;
      try {
        // Klon halaman pratinjau yang terlihat; hapus transform skala
        // tampilan supaya tiap halaman berukuran F4 penuh di iframe.
        const bungkus = Array.from(document.querySelectorAll('#sp-pratinjau .sepekan-bungkus'));
        if (!bungkus.length) throw new Error('Halaman laporan kosong.');
        const klonHtml = bungkus.map((b) => {
          const k = b.cloneNode(true);
          const hal = k.querySelector('.sepekan-halaman');
          if (hal) hal.style.transform = '';
          return k.outerHTML;
        }).join('');
        frame = document.createElement('iframe');
        frame.setAttribute('aria-hidden', 'true');
        frame.style.cssText = 'position:fixed;left:-10000px;top:0;width:813px;height:1247px;border:0;visibility:visible;';
        document.body.appendChild(frame);
        const docHtml = '<!DOCTYPE html><html><head><meta charset="utf-8">' +
          '<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">' +
          '<style>' + CSS_LAPORAN + '</style></head>' +
          '<body style="margin:0;background:#ffffff;">' + klonHtml + '</body></html>';
        frame.srcdoc = docHtml;
        await new Promise((res) => { frame.onload = res; setTimeout(res, 8000); });
        const fdoc = frame.contentDocument;
        if (!fdoc) throw new Error('Dokumen PDF tidak bisa dibuat.');
        await tungguGambar(fdoc);
        try { await fdoc.fonts.ready; } catch {}
        await new Promise((r) => setTimeout(r, 300));
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ unit: 'mm', format: [215, 330], orientation: 'portrait' });
        const halamanEls = Array.from(fdoc.querySelectorAll('.sepekan-halaman'));
        if (!halamanEls.length) throw new Error('Halaman laporan kosong.');
        for (let i = 0; i < halamanEls.length; i++) {
          const canvas = await window.html2canvas(halamanEls[i], { scale: 2, useCORS: true, backgroundColor: '#ffffff', logging: false });
          const img = canvas.toDataURL('image/jpeg', 0.92);
          if (i > 0) pdf.addPage([215, 330], 'portrait');
          pdf.addImage(img, 'JPEG', 0, 0, 215, 330);
          if (btn) btn.textContent = 'Membuat PDF… ' + (i + 1) + '/' + halamanEls.length;
        }
        pdf.save(namaBerkas());
        showStatus('PDF laporan sepekan berhasil diunduh (' + halamanEls.length + ' halaman).', true);
      } catch (e) {
        showStatus('Gagal membuat PDF: ' + (e && e.message ? e.message : 'galat'), false);
      } finally {
        if (frame) frame.remove();
        sedangUnduh = false;
        if (btn) { btn.disabled = false; btn.textContent = '⬇ Unduh PDF'; }
      }
    }

    // ---------- Event form ----------
    function hubungkanForm() {
      ['sp-mulai', 'sp-akhir', 'sp-ttd'].forEach((id) => {
        const el = $(id);
        if (!el) return;
        el.addEventListener('input', () => { formatKetikDMY(el); bacaFormKeState(); simpanDraf(); renderPratinjau(); });
        el.addEventListener('change', () => { bacaFormKeState(); simpanDraf(); renderPratinjau(); });
      });
      // Tombol kalender (📅) di semua kolom tanggal + hasil pilihan kalender.
      document.addEventListener('click', (e) => {
        const btn = e.target && e.target.closest ? e.target.closest('[data-buka-kalender]') : null;
        if (!btn) return;
        let input = null;
        if (btn.dataset && btn.dataset.target) input = $(btn.dataset.target);
        if (!input) {
          const wadah = btn.closest('label') || btn.parentElement;
          input = wadah ? wadah.querySelector('.sp-tgl') : null;
        }
        if (input) bukaKalender(input);
      });
      const pemilihTgl = $('sp-pemilih-tanggal');
      // Terapkan pilihan kalender saat 'input' DAN 'change' (kalender bawaan
      // di HP kadang hanya memicu salah satunya), dan sinkronkan state
      // SECARA LANGSUNG — supaya tanggal yang dipilih tidak tertimpa lagi
      // oleh tulisStateKeForm saat tarik otomatis selesai (Nov 2026:
      // tanggal akhir 07/11 yang dipilih sempat kembali jadi 14/11).
      function terapkanPilihanKalender() {
        if (!targetKalender || !pemilihTgl.value) { targetKalender = null; return; }
        const tgt = targetKalender;
        tgt.value = isoKeDMY(pemilihTgl.value);
        bacaFormKeState(); simpanDraf();
        tgt.dispatchEvent(new Event('input', { bubbles: true }));
        tgt.dispatchEvent(new Event('change', { bubbles: true }));
        targetKalender = null;
      }
      if (pemilihTgl) {
        pemilihTgl.addEventListener('input', terapkanPilihanKalender);
        pemilihTgl.addEventListener('change', terapkanPilihanKalender);
      }
      // Potong foto (crop)
      spCropPasangGestur();
      // Foto sampul
      $('sp-input-potret').addEventListener('change', async (e) => {
        const f = e.target.files && e.target.files[0];
        if (!f) return;
        try { const url = await spBukaCrop(f, 1200, 1.3333); if (!url) { e.target.value = ''; return; } state.fotoPotret = url; $('sp-foto-potret').src = state.fotoPotret; simpanDraf(); renderPratinjau(); showStatus('Foto 1 sampul diganti.', true); }
        catch (err) { showStatus('Gagal membaca foto: ' + err.message, false); }
        e.target.value = '';
      });
      $('sp-input-lapangan').addEventListener('change', async (e) => {
        const f = e.target.files && e.target.files[0];
        if (!f) return;
        try { const url = await spBukaCrop(f, 1200, 1.3333); if (!url) { e.target.value = ''; return; } state.fotoLapangan = url; $('sp-foto-lapangan').src = state.fotoLapangan; simpanDraf(); renderPratinjau(); showStatus('Foto 2 sampul diganti.', true); }
        catch (err) { showStatus('Gagal membaca foto: ' + err.message, false); }
        e.target.value = '';
      });
      $('sp-reset-potret').addEventListener('click', () => { state.fotoPotret = FOTO_POTRET_TEMPLATE; $('sp-foto-potret').src = state.fotoPotret; simpanDraf(); renderPratinjau(); });
      // Tarik berita + periode minggu ini
      $('sp-tarik').addEventListener('click', () => tarikBeritaMingguIni());
      $('sp-minggu-ini').addEventListener('click', setMingguIni);
      // Bila tanggal periode diubah manual, tarik berita periode baru otomatis.
      ['sp-mulai', 'sp-akhir'].forEach((id) => {
        const el = $(id);
        if (el) el.addEventListener('change', jadwalTarikOtomatis);
      });
      $('sp-reset-lapangan').addEventListener('click', () => { state.fotoLapangan = FOTO_LAPANGAN_TEMPLATE; $('sp-foto-lapangan').src = state.fotoLapangan; simpanDraf(); renderPratinjau(); });
      // Hari & kegiatan (delegasi klik + input)
      const wadah = $('sp-hari-list');
      wadah.addEventListener('click', (e) => {
        const t = e.target;
        const tutupHari = t.closest('[data-tutup-hari]');
        if (tutupHari) {
          const hi = Number(tutupHari.dataset.tutupHari);
          const h = state.hari[hi];
          if (h) {
            h.tutup = !h.tutup;
            simpanDraf();
            // Toggle langsung di DOM (tanpa render ulang penuh) supaya
            // posisi gulir tidak lompat; renderHari berikut akan memakai
            // penanda h.tutup yang sama.
            const kartu = tutupHari.closest('article');
            if (kartu) {
              const isi = kartu.querySelector('.sp-isi-hari');
              const tambah = kartu.querySelector('[data-tambah-kegiatan]');
              if (isi) isi.classList.toggle('hidden', !!h.tutup);
              if (tambah) tambah.classList.toggle('hidden', !!h.tutup);
              tutupHari.innerHTML = (h.tutup ? '▸ ' : '▾ ') + (h.kegiatan ? h.kegiatan.length : 0) + ' kegiatan';
              tutupHari.setAttribute('aria-label', (h.tutup ? 'Buka' : 'Tutup') + ' hari');
            }
            perbaruiTombolTutupSemua();
            renderPratinjau();
          }
          return;
        }
        const kunciHari = t.closest('[data-kunci-hari]');
        if (kunciHari) {
          const hi = Number(kunciHari.dataset.kunciHari);
          const h = state.hari[hi];
          if (h) {
            h.kunci = !h.kunci;
            simpanDraf();
            // Render ulang penuh (kunci mengubah banyak kontrol sekaligus).
            // Minimize tetap bisa dipakai pada hari terkunci (hanya tampilan).
            renderHari();
            renderPratinjau();
            showStatus(h.kunci
              ? 'Hari ' + labelHari(h.tanggal) + ' dikunci — tidak akan tertimpa tarikan mingguan. Ketuk gembok lagi untuk membuka kunci dan mengedit.'
              : 'Kunci dibuka — hari ' + labelHari(h.tanggal) + ' bisa diedit dan ditarik ulang lagi.', true);
          }
          return;
        }
        const tarikHari = t.closest('[data-tarik-hari]');
        if (tarikHari) { tarikBeritaMingguIni(tarikHari.dataset.tarikHari); return; }
        const hapusHari = t.closest('[data-hapus-hari]');
        if (hapusHari) { state.hari.splice(Number(hapusHari.dataset.hapusHari), 1); renderHari(); simpanDraf(); renderPratinjau(); return; }
        const hapusKeg = t.closest('[data-hapus-kegiatan]');
        if (hapusKeg) { const [hi, ki] = hapusKeg.dataset.hapusKegiatan.split(':').map(Number); state.hari[hi].kegiatan.splice(ki, 1); renderHari(); simpanDraf(); renderPratinjau(); return; }
        const hapusFoto = t.closest('[data-hapus-foto]');
        if (hapusFoto) { const [hi, ki, fi] = hapusFoto.dataset.hapusFoto.split(':').map(Number); state.hari[hi].kegiatan[ki].foto.splice(fi, 1); renderHari(); simpanDraf(); renderPratinjau(); return; }
        const tambahKeg = t.closest('[data-tambah-kegiatan]');
        if (tambahKeg) { const hi = Number(tambahKeg.dataset.tambahKegiatan); state.hari[hi].kegiatan.push({ judul: '', narasi: '', foto: [] }); renderHari(); simpanDraf(); renderPratinjau(); return; }
      });
      wadah.addEventListener('change', async (e) => {
        const t = e.target;
        if (t.matches('[data-tanggal-hari]')) { const hi = Number(t.dataset.tanggalHari); const iso = dmyKeIso(t.value); if (iso) { state.hari[hi].tanggal = iso; } renderHari(); simpanDraf(); renderPratinjau(); return; }
        if (t.matches('[data-tambah-foto]')) {
          const [hi, ki] = t.dataset.tambahFoto.split(':').map(Number);
          const f = t.files && t.files[0];
          if (!f) return;
          if (state.hari[hi].kegiatan[ki].foto.filter(Boolean).length >= 4) { t.value = ''; return; }
          try { const url = await spBukaCrop(f, 1200, 1.3333); if (!url) { t.value = ''; return; } state.hari[hi].kegiatan[ki].foto.push(url); renderHari(); simpanDraf(); renderPratinjau(); }
          catch (err) { showStatus('Gagal membaca foto: ' + err.message, false); }
          t.value = '';
          return;
        }
      });
      wadah.addEventListener('input', (e) => {
        const t = e.target;
        if (t.matches('[data-tanggal-hari]')) { formatKetikDMY(t); return; }
        if (t.matches('[data-judul-kegiatan]')) { const [hi, ki] = t.dataset.judulKegiatan.split(':').map(Number); state.hari[hi].kegiatan[ki].judul = t.value; simpanDraf(); renderPratinjau(); return; }
        if (t.matches('[data-narasi-kegiatan]')) { const [hi, ki] = t.dataset.narasiKegiatan.split(':').map(Number); state.hari[hi].kegiatan[ki].narasi = t.value; simpanDraf(); renderPratinjau(); return; }
      });
      const btnTutupSemua = $('sp-tutup-semua');
      if (btnTutupSemua) btnTutupSemua.addEventListener('click', () => {
        const semuaTutup = state.hari.length > 0 && state.hari.every((h) => !!h.tutup);
        state.hari.forEach((h) => { h.tutup = !semuaTutup; });
        simpanDraf(); renderHari(); renderPratinjau(); perbaruiTombolTutupSemua();
      });
      $('sp-tambah-hari').addEventListener('click', () => {
        const terakhir = state.hari[state.hari.length - 1];
        let tglBaru = '';
        if (terakhir && terakhir.tanggal) {
          const d = parseTgl(terakhir.tanggal);
          if (d) { d.setDate(d.getDate() + 1); tglBaru = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
        }
        state.hari.push({ tanggal: tglBaru, kegiatan: [{ judul: '', narasi: '', foto: [] }] });
        renderHari(); simpanDraf(); renderPratinjau();
      });
      // Aksi
      $('sp-unduh').addEventListener('click', unduhPdf);
      // Lihat Pratinjau: masuk ke HALAMAN pratinjau sendiri (?pratinjau=1),
      // bukan lagi menggulir ke pratinjau di bawah form (Nov 2026, atas
      // permintaan Bos Besar). Draf disimpan dulu supaya pratinjau di
      // halaman baru memuat isi terbaru (draf tersimpan di localStorage).
      $('sp-lihat').addEventListener('click', () => { bacaFormKeState(); simpanDraf(); location.href = location.pathname + '?pratinjau=1'; });
      const btnUnduhPratinjau = $('sp-unduh-pratinjau');
      if (btnUnduhPratinjau) btnUnduhPratinjau.addEventListener('click', unduhPdf);
      $('sp-reset-template').addEventListener('click', () => {
        if (!confirm('Kembalikan semua isi ke template laporan 02–07 November 2026? Draf saat ini akan diganti.')) return;
        state = klon(TEMPLATE);
        tulisStateKeForm(); simpanDraf(); renderPratinjau();
        showStatus('Isi dikembalikan ke template.', true);
      });
      $('sp-bersihkan').addEventListener('click', () => {
        if (!confirm('Bersihkan draf laporan sepekan ini? Isi akan kembali kosong kecuali template dasar.')) return;
        try { localStorage.removeItem(KUNCI_DRAF); } catch {}
        state = klon(TEMPLATE);
        state.hari = [];
        tulisStateKeForm(); renderPratinjau();
        showStatus('Draf dibersihkan.', true);
      });
    }

    // ---------- Init ----------
    // Setelah login, #app baru terlihat — hitung ulang skala pratinjau
    // dengan lebar wadah yang sebenarnya. Tanpa ini, sesuaikanSkala yang
    // jalan saat init mengukur wadah tersembunyi (clientWidth 0) lalu
    // memakai skala 1, sehingga halaman F4 813px meluber dan pratinjau
    // terpotong kiri-kanan di HP (Nov 2026).
    window.__kelolaSetelahLogin = () => { sesuaikanSkala(); };
    // Mode pratinjau (?pratinjau=1): sembunyikan editor + kepala halaman,
    // tampilkan hanya bar kembali + pratinjau. Mode editor: sebaliknya —
    // pratinjau TIDAK tampil di bawah form (tetap dirender tersembunyi
    // supaya Unduh PDF tetap bisa mengklon halamannya).
    const MODE_PRATINJAU = new URLSearchParams(location.search).get('pratinjau') === '1';
    const terapkanMode = () => {
      const bar = $('sp-bar-pratinjau'), editor = $('sp-editor'), kepala = $('sp-kepala'), bag = $('sp-pratinjau-bagian');
      if (MODE_PRATINJAU) {
        if (bar) { bar.classList.remove('hidden'); bar.classList.add('flex'); }
        if (editor) editor.classList.add('hidden');
        if (kepala) kepala.classList.add('hidden');
        if (bag) bag.classList.remove('hidden');
      } else {
        if (bar) { bar.classList.add('hidden'); bar.classList.remove('flex'); }
        if (editor) editor.classList.remove('hidden');
        if (kepala) kepala.classList.remove('hidden');
        if (bag) bag.classList.add('hidden');
      }
    };
    terapkanMode();
    tulisStateKeForm();
    hubungkanForm();
    renderPratinjau();
    // Bila belum ada draf tersimpan, isi laporan otomatis dari berita
    // minggu berjalan (Senin–Sabtu) — tidak perlu mengetuk Tarik Berita.
    // Draf yang sudah ada tidak disentuh supaya editan manual tidak tertimpa.
    if (!drafTersimpan) {
      setMingguIni();
    }
    // Font web (Plus Jakarta Sans) bisa termuat setelah render pertama;
    // render ulang setelah font siap supaya paginasi memakai metrik font
    // yang benar dan pratinjau sama dengan PDF.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => { renderPratinjau(); }).catch(() => {});
    }
  </script>
</BaseLayout>
