    // ---------- Tanggal ----------
    function parseTgl(str) {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(str || ''));
      if (!m) return null;
      return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
    }
    // Format tanggal DD/MM/YYYY (Nov 2026): <input type="date"> bawaan
    // menampilkan MM/DD/YYYY di HP Bos Besar (mengikuti lokal perangkat,
    // bukan lang halaman). Supaya selalu DD/MM/YYYY, kolom tanggal kini
    // berupa teks + tombol kalender (pemilih date bawaan yang disembunyikan).
    function isoKeDMY(iso) {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(iso || ''));
      if (!m) return '';
      return m[3] + '/' + m[2] + '/' + m[1];
    }
    function dmyKeIso(str) {
      const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(String(str || '').trim());
      if (!m) return null;
      const d = Number(m[1]), mo = Number(m[2]), y = Number(m[3]);
      if (mo < 1 || mo > 12 || d < 1 || d > 31 || y < 1900 || y > 2100) return null;
      const dt = new Date(y, mo - 1, d);
      if (dt.getFullYear() !== y || dt.getMonth() !== mo - 1 || dt.getDate() !== d) return null;
      return y + '-' + String(mo).padStart(2, '0') + '-' + String(d).padStart(2, '0');
    }
    // Sisipkan '/' otomatis selagi mengetik angka (DD/MM/YYYY).
    function formatKetikDMY(el) {
      const digit = el.value.replace(/\D/g, '').slice(0, 8);
      let keluar = digit;
      if (digit.length > 4) keluar = digit.slice(0, 2) + '/' + digit.slice(2, 4) + '/' + digit.slice(4);
      else if (digit.length > 2) keluar = digit.slice(0, 2) + '/' + digit.slice(2);
      el.value = keluar;
    }
    // Pemilih kalender bawaan (satu untuk semua kolom tanggal). Inputnya
    // disembunyikan di luar layar (bukan display:none) supaya showPicker
    // tetap bisa dibuka.
    let targetKalender = null;
    function bukaKalender(elTeks) {
      const pemilih = $('sp-pemilih-tanggal');
      if (!pemilih || !elTeks) return;
      targetKalender = elTeks;
      pemilih.value = dmyKeIso(elTeks.value) || '';
      try { pemilih.showPicker(); } catch { try { pemilih.focus(); pemilih.click(); } catch {} }
    }
    function labelHari(str) {
      const d = parseTgl(str);
      if (!d) return '';
      return HARI_NAMA[d.getDay()] + ', ' + String(d.getDate()).padStart(2, '0') + ' ' + BULAN_NAMA[d.getMonth()] + ' ' + d.getFullYear();
    }
    function teksPeriode() {
      const a = parseTgl(state.mulai), b = parseTgl(state.akhir);
      if (!a || !b) return '';
      const tgl = (d) => String(d.getDate()).padStart(2, '0');
      if (a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth()) {
        return tgl(a) + ' – ' + tgl(b) + ' ' + BULAN_NAMA[b.getMonth()] + ' ' + b.getFullYear();
      }
      if (a.getFullYear() === b.getFullYear()) {
        return tgl(a) + ' ' + BULAN_NAMA[a.getMonth()] + ' – ' + tgl(b) + ' ' + BULAN_NAMA[b.getMonth()] + ' ' + b.getFullYear();
      }
      return tgl(a) + ' ' + BULAN_NAMA[a.getMonth()] + ' ' + a.getFullYear() + ' – ' + tgl(b) + ' ' + BULAN_NAMA[b.getMonth()] + ' ' + b.getFullYear();
    }
    function namaBerkas() {
      const a = parseTgl(state.mulai), b = parseTgl(state.akhir);
      const fmt = (d) => String(d.getDate()).padStart(2, '0') + '-' + BULAN_PENDEK[d.getMonth()] + '-' + d.getFullYear();
      const per = (a && b) ? '(' + fmt(a) + '_sd_' + fmt(b) + ')' : '';
      return 'Laporan_Kegiatan_Kakanwil_' + per + '.pdf';
    }
    function tglTtdPanjang() {
      const d = parseTgl(state.ttd);
      if (!d) return '';
      return 'Bengkulu, ' + String(d.getDate()).padStart(2, '0') + ' ' + BULAN_NAMA[d.getMonth()] + ' ' + d.getFullYear();
    }

    // ---------- Tarik Berita Minggu Ini ----------
    // Laporan sepekan diambil dari berita ZonaPas (Senin–Sabtu). Sumber:
    // /search-index.json (judul, tanggal, foto sampul) + halaman tiap
    // artikel untuk narasinya (#article-body p). Foto sampul laporan
    // ikut terisi dari foto berita. Semua hasil tarikan masih bisa diedit.
    const BULAN_INDEKS = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, Mei: 4, May: 4, Jun: 5, Jul: 6, Agu: 7, Aug: 7, Sep: 8, Okt: 9, Oct: 9, Nov: 10, Des: 11, Dec: 11 };
    function parseTanggalIndeks(str) {
      const m = /^(\d{1,2})\s+([A-Za-z]{3,})\s+(\d{4})$/.exec(String(str || '').trim());
      if (!m) return null;
      const bln = BULAN_INDEKS[m[2]];
      if (bln === undefined) return null;
      return new Date(Number(m[3]), bln, Number(m[1]));
    }
    function fmtTglIso(d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    async function ambilNarasiArtikel(url) {
      try {
        const res = await fetch(url);
        if (!res.ok) return '';
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const paras = Array.from(doc.querySelectorAll('#article-body p'))
          .map((p) => p.textContent.replace(/\s+/g, ' ').trim())
          .filter((t) => t.length > 0);
        let teks = paras.slice(0, 3).join('\n\n');
        if (teks.length > 1500) {
          teks = teks.slice(0, 1500);
          const titik = teks.lastIndexOf('. ');
          if (titik > 800) teks = teks.slice(0, titik + 1);
        }
        return teks;
      } catch { return ''; }
    }
    let sedangTarik = false;
    let periodeTerakhirTarik = '';
    // Tarik berita ZonaPas ke laporan. Tanpa argumen: tarik SEMINGGU (perilaku
    // lama — mengganti seluruh Hasil per Hari + foto sampul). Dengan argumen
    // tanggal ISO (mis. "2026-11-10"): tarik HARI ITU SAJA — hanya kegiatan
    // hari itu yang diganti, hari lain dan foto sampul tidak disentuh
    // (Nov 2026, atas permintaan Bos Besar: editan hari lain aman).
    async function tarikBeritaMingguIni(hanyaTanggal) {
      if (sedangTarik) return;
      // hanyaTanggal harus tanggal ISO; selain itu dianggap tarik seminggu.
      const perHariSaja = typeof hanyaTanggal === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(hanyaTanggal);
      const teksTombol = perHariSaja ? '📥 Tarik Berita Hari Ini' : '📥 Tarik Berita Minggu Ini';
      const btn = perHariSaja
        ? document.querySelector('[data-tarik-hari="' + hanyaTanggal + '"]')
        : $('sp-tarik');
      bacaFormKeState();
      const mulai = parseTgl(state.mulai), akhir = parseTgl(state.akhir);
      if (!perHariSaja && (!mulai || !akhir || akhir < mulai)) { showStatus('Isi dulu periode yang benar (tanggal mulai s/d akhir).', false); return; }
      const tglTarget = perHariSaja ? parseTgl(hanyaTanggal) : null;
      if (perHariSaja && !tglTarget) { showStatus('Tanggal hari tidak valid.', false); return; }
      if (perHariSaja && state.hari.some((h) => h.tanggal === hanyaTanggal && h.kunci)) { showStatus('Hari ' + labelHari(hanyaTanggal) + ' terkunci — buka kunci dulu bila mau menarik ulang hari itu.', false); return; }
      sedangTarik = true;
      if (btn) { btn.disabled = true; btn.textContent = 'Menarik berita…'; }
      showStatus(perHariSaja
        ? 'Menarik berita ZonaPas ' + labelHari(hanyaTanggal) + '…'
        : 'Menarik berita ZonaPas ' + teksPeriode() + ' (Senin–Sabtu)…', true);
      try {
        const res = await fetch('/search-index.json');
        if (!res.ok) throw new Error('Indeks berita tidak bisa dimuat.');
        const indeks = await res.json();
        const artikel = indeks
          .map((a) => ({ ...a, tgl: parseTanggalIndeks(a.date) }))
          .filter((a) => a.tgl && (perHariSaja ? fmtTglIso(a.tgl) === hanyaTanggal : (a.tgl >= mulai && a.tgl <= akhir && a.tgl.getDay() !== 0)))
          .sort((x, y) => x.tgl - y.tgl);
        if (!artikel.length) {
          if (!perHariSaja) periodeTerakhirTarik = (state.mulai || '') + '|' + (state.akhir || '');
          showStatus(perHariSaja
            ? 'Tidak ada berita ZonaPas pada ' + labelHari(hanyaTanggal) + ' — kegiatan hari itu tidak diubah.'
            : 'Tidak ada berita ZonaPas pada periode ' + teksPeriode() + ' (Senin–Sabtu).', false);
          return;
        }
        const narasiList = await Promise.all(artikel.map((a) => ambilNarasiArtikel(a.url)));
        const perHari = {};
        artikel.forEach((a, i) => {
          const kunci = fmtTglIso(a.tgl);
          if (!perHari[kunci]) perHari[kunci] = { tanggal: kunci, kegiatan: [] };
          perHari[kunci].kegiatan.push({
            judul: a.title,
            narasi: narasiList[i] || a.summary || '',
            foto: a.image ? [a.image] : [],
          });
        });
        if (perHariSaja) {
          // Hanya hari itu: ganti kegiatannya saja (atau sisipkan bila hari
          // itu belum ada); hari lain dan foto sampul TIDAK disentuh.
          const hariBaru = perHari[hanyaTanggal];
          const idx = state.hari.findIndex((h) => h.tanggal === hanyaTanggal);
          if (idx >= 0) state.hari[idx] = hariBaru;
          else { state.hari.push(hariBaru); state.hari.sort((x, y) => String(x.tanggal || '').localeCompare(String(y.tanggal || ''))); }
        } else {
          periodeTerakhirTarik = (state.mulai || '') + '|' + (state.akhir || '');
          // Hari yang terkunci TIDAK ditimpa tarikan mingguan — hari fix
          // tetap seperti apa adanya. Hanya hari terkunci yang tanggalnya
          // masih di dalam periode ini yang dipertahankan; hari terkunci
          // di luar periode ikut berganti saat periode diubah.
          const terkunci = {};
          state.hari.forEach((h) => {
            if (h && h.kunci && h.tanggal) {
              const d = parseTgl(h.tanggal);
              if (d && d >= mulai && d <= akhir && d.getDay() !== 0) terkunci[h.tanggal] = h;
            }
          });
          const semuaTgl = new Set(Object.keys(perHari));
          Object.keys(terkunci).forEach((t) => semuaTgl.add(t));
          state.hari = Array.from(semuaTgl).sort().map((k) => terkunci[k] || perHari[k]);
          const fotoBerita = artikel.filter((a) => a.image).map((a) => a.image);
          if (fotoBerita.length) {
            state.fotoPotret = fotoBerita[0];
            if (fotoBerita.length > 1) state.fotoLapangan = fotoBerita[1];
          }
        }
        simpanDraf();
        tulisStateKeForm();
        renderPratinjau();
        showStatus(perHariSaja
          ? 'Berhasil menarik ' + artikel.length + ' berita untuk ' + labelHari(hanyaTanggal) + '. Hanya kegiatan hari itu yang diperbarui; hari lain tidak berubah.'
          : 'Berhasil menarik ' + artikel.length + ' berita dari ' + state.hari.length + ' hari (' + teksPeriode() + '). Judul, narasi, dan foto kegiatan terisi dari berita ZonaPas; foto sampul juga dari foto berita. Semua masih bisa diedit.', true);
      } catch (e) {
        showStatus('Gagal menarik berita: ' + (e && e.message ? e.message : 'galat'), false);
      } finally {
        sedangTarik = false;
        if (btn) { btn.disabled = false; btn.textContent = teksTombol; }
      }
    }
    function setMingguIni() {
      const kini = new Date();
      const senin = new Date(kini);
      senin.setDate(kini.getDate() - ((kini.getDay() + 6) % 7));
      const sabtu = new Date(senin);
      sabtu.setDate(senin.getDate() + 5);
      state.mulai = fmtTglIso(senin);
      state.akhir = fmtTglIso(sabtu);
      state.ttd = fmtTglIso(sabtu);
      tulisStateKeForm();
      simpanDraf();
      renderPratinjau();
      showStatus('Periode diset ke minggu ini: ' + teksPeriode() + ' (Senin–Sabtu).', true);
      tarikBeritaMingguIni();
    }
    // Tarik otomatis (debounce) bila tanggal periode diubah manual.
    let timerTarikOtomatis = null;
    function jadwalTarikOtomatis() {
      clearTimeout(timerTarikOtomatis);
      timerTarikOtomatis = setTimeout(() => {
        bacaFormKeState();
        const kunci = (state.mulai || '') + '|' + (state.akhir || '');
        if (kunci === periodeTerakhirTarik) return;
        const mulai = parseTgl(state.mulai), akhir = parseTgl(state.akhir);
        if (!mulai || !akhir || akhir < mulai) return;
        tarikBeritaMingguIni();
      }, 800);
    }

    // ---------- Template bawaan (dari PDF laporan 02–07 Nov 2026) ----------
    const FOTO_POTRET_TEMPLATE = '/images/laporan-sepekan-sampul-potret.png';
    const FOTO_LAPANGAN_TEMPLATE = '/images/laporan-sepekan-sampul-lapangan.jpg';
    const TEMPLATE = {
      mulai: '2026-11-02', akhir: '2026-11-07', ttd: '2026-11-07',
      fotoPotret: FOTO_POTRET_TEMPLATE, fotoLapangan: FOTO_LAPANGAN_TEMPLATE,
