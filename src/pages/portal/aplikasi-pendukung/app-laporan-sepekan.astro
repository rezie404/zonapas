---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../../data/site';
import { AUTHORS } from '../../../data/authors';

const categoryColors = Object.fromEntries(CATEGORIES.map((c) => [c.name, c.color]));
const authorInfoMap = Object.fromEntries(Object.values(AUTHORS).map((a) => [a.name, { role: a.role, bio: a.bio }]));
---

<BaseLayout
  title="Laporan Sepekan (Humas)"
  description="Susun Laporan Kegiatan Kepala Kantor Wilayah Ditjenpas Bengkulu per pekan dan unduh sebagai PDF — untuk Administrator dan akun yang ditunjuk."
>
  <script type="application/json" id="kelola-data" set:html={JSON.stringify({ categoryColors, authors: authorInfoMap })} />

  <div class="mx-auto max-w-[1200px] px-4 py-6">
    <!-- Bar halaman pratinjau (hanya tampil saat ?pratinjau=1): kembali ke
         editor + unduh PDF. Disembunyikan di mode editor. -->
    <div id="sp-bar-pratinjau" class="mb-4 hidden flex-wrap items-center gap-3">
      <a href="/portal/aplikasi-pendukung/app-laporan-sepekan/" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">← Kembali ke Editor</a>
      <span class="flex-1"></span>
      <span class="text-sm font-bold text-slate-600 dark:text-slate-300">Pratinjau Laporan</span>
      <span class="flex-1"></span>
      <button id="sp-unduh-pratinjau" type="button" class="rounded-lg bg-[#0A2540] px-4 py-2 text-sm font-bold text-white hover:bg-[#123a66]">⬇ Unduh PDF</button>
    </div>
    <div id="sp-kepala" class="border-b-2 border-[#0A2540] pb-4 dark:border-white">
      <h1 class="text-2xl font-black uppercase tracking-tight sm:text-3xl">Laporan Sepekan (Humas)</h1>
      <div class="mt-2 h-1.5 w-20 rounded bg-[#FACC15]" aria-hidden="true"></div>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Laporan Kegiatan Kepala Kantor Wilayah Ditjenpas Bengkulu per pekan. Isi periode, ganti foto sampul, tulis isi laporan, lalu unduh sebagai PDF mengikuti template laporan sepekan.
      </p>
    </div>

    <div id="status" class="mt-4 hidden rounded-lg px-4 py-3 text-sm font-medium" role="status"></div>

    <!-- Login -->
    <section id="login-box" class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
      <img src="/images/logo-zonapas.png" alt="Logo ZonaPas" class="mx-auto h-16 w-16 rounded-full object-cover" width="64" height="64" />
      <h2 class="mt-3 text-lg font-bold">Masuk untuk membuka Laporan Sepekan (Humas)</h2>
      <p class="mx-auto mt-1 max-w-md text-sm text-slate-600 dark:text-slate-400">
        Masuk dengan GitHub (khusus Administrator) atau dengan akun Google Administrator — atau akun Google Penulis/Penyunting yang sudah ditunjuk Administrator.
      </p>
      <button
        id="btn-login"
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
        Masuk dengan GitHub
      </button>
      <a
        href="/redaksi/auth/google"
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-[#0A2540] hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-800"
      >
        Masuk dengan Google
      </a>
      <p id="login-fallback" class="mt-3 hidden text-xs text-slate-500 dark:text-slate-400">
        Popup diblokir?
        <a href="https://oauth.zonapas.web.id/auth" target="_blank" class="font-bold text-[#0A2540] underline dark:text-white">Buka login GitHub di tab baru</a>
        — setelah otorisasi, kembali ke tab ini.
      </p>
    </section>

    <!-- Akses ditolak -->
    <section id="akses-ditolak" class="mt-6 hidden rounded-2xl border border-red-300 bg-red-50 p-6 text-center dark:border-red-900 dark:bg-red-900/20">
      <h2 class="text-lg font-bold text-red-900 dark:text-red-100">Akun ini belum punya akses</h2>
      <p id="akses-ditolak-pesan" class="mx-auto mt-1 max-w-md text-sm text-red-800 dark:text-red-200">Akun ini belum punya akses — hubungi Administrator untuk meminta akses Aplikasi Pendukung.</p>
      <button id="btn-akses-keluar" type="button" class="mt-4 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800">Keluar &amp; Coba Akun Lain</button>
    </section>

    <div id="app" class="hidden">
      <input type="date" id="sp-pemilih-tanggal" aria-hidden="true" tabindex="-1" style="position:fixed;left:-10000px;top:0;width:1px;height:1px;opacity:0;" />
      <div id="sp-editor">
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span id="user-chip" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-bold dark:bg-slate-800">
          <img id="user-avatar" alt="" class="h-6 w-6 rounded-full" width="24" height="24" />
          <span id="user-name"></span>
        </span>
        <span class="flex-1"></span>
        <a href="/portal/aplikasi-pendukung/" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">← Kembali ke Aplikasi Pendukung</a>
        <button id="btn-keluar" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Keluar</button>
      </div>

      <!-- Periode -->
      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 sm:p-5" aria-label="Periode laporan">
        <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Periode Laporan</h2>
        <div class="mt-3 flex flex-wrap items-end gap-3">
          <label class="min-w-0 flex-1">
            <span class="block text-sm font-bold">Tanggal mulai</span>
            <span class="mt-1 flex items-center gap-1">
              <input id="sp-mulai" type="text" inputmode="numeric" placeholder="DD/MM/YYYY" autocomplete="off" class="sp-tgl w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium dark:border-slate-700 dark:bg-slate-900" />
              <button type="button" data-buka-kalender class="shrink-0 rounded-lg border border-slate-300 px-2.5 py-2 text-sm hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800" aria-label="Pilih tanggal mulai dari kalender" data-target="sp-mulai">📅</button>
            </span>
          </label>
          <label class="min-w-0 flex-1">
            <span class="block text-sm font-bold">Tanggal akhir</span>
            <span class="mt-1 flex items-center gap-1">
              <input id="sp-akhir" type="text" inputmode="numeric" placeholder="DD/MM/YYYY" autocomplete="off" class="sp-tgl w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium dark:border-slate-700 dark:bg-slate-900" />
              <button type="button" data-buka-kalender class="shrink-0 rounded-lg border border-slate-300 px-2.5 py-2 text-sm hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800" aria-label="Pilih tanggal akhir dari kalender" data-target="sp-akhir">📅</button>
            </span>
          </label>
          <label class="min-w-0 flex-1">
            <span class="block text-sm font-bold">Tanggal tanda tangan</span>
            <span class="mt-1 flex items-center gap-1">
              <input id="sp-ttd" type="text" inputmode="numeric" placeholder="DD/MM/YYYY" autocomplete="off" class="sp-tgl w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium dark:border-slate-700 dark:bg-slate-900" />
              <button type="button" data-buka-kalender class="shrink-0 rounded-lg border border-slate-300 px-2.5 py-2 text-sm hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800" aria-label="Pilih tanggal tanda tangan dari kalender" data-target="sp-ttd">📅</button>
            </span>
          </label>
        </div>
        <p id="sp-periode-teks" class="mt-3 text-sm font-bold text-[#0A2540] dark:text-white"></p>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Periode dan tanggal tanda tangan tampil di sampul dan di bagian penutup laporan.</p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button id="sp-tarik" type="button" class="rounded-lg bg-[#0A2540] px-4 py-2 text-sm font-bold text-white hover:bg-[#123a66]">📥 Tarik Berita Minggu Ini</button>
          <button id="sp-minggu-ini" type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Set ke minggu ini</button>
        </div>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Berita ZonaPas masuk otomatis ke laporan: saat aplikasi dibuka (bila belum ada draf) dan setiap kali periode diubah, berita Senin–Sabtu pada periode itu ditarik sendiri — judul, narasi, dan foto kegiatan terisi dari berita, dan kedua foto sampul terisi dari foto berita. Tombol Tarik Berita untuk menarik ulang secara manual. Semua masih bisa diedit setelah ditarik.</p>
      </section>

      <!-- Foto sampul -->
      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 sm:p-5" aria-label="Foto sampul">
        <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Foto Sampul</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Dua foto di sampul laporan. Foto 1 (potret) di segi enam besar kiri, Foto 2 (kegiatan) di segi enam kanan. Ketuk foto untuk menggantinya. Bila menarik berita minggu ini, kedua foto ini otomatis terisi dari foto berita ZonaPas.</p>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
          <div>
            <p class="mb-1 text-sm font-bold">Foto 1 — Potret Kakanwil</p>
            <label class="block cursor-pointer overflow-hidden rounded-xl border-2 border-dashed border-slate-300 hover:border-[#0A2540] dark:border-slate-700">
              <img id="sp-foto-potret" src="/images/laporan-sepekan-sampul-potret.png" alt="Foto sampul potret Kakanwil" class="aspect-[4/3] w-full bg-[#FFCC00] object-cover object-top" />
              <input id="sp-input-potret" type="file" accept="image/*" class="hidden" />
            </label>
            <button id="sp-reset-potret" type="button" class="mt-2 text-xs font-bold text-[#0A2540] underline dark:text-white">Kembalikan foto template</button>
          </div>
          <div>
            <p class="mb-1 text-sm font-bold">Foto 2 — Kegiatan</p>
            <label class="block cursor-pointer overflow-hidden rounded-xl border-2 border-dashed border-slate-300 hover:border-[#0A2540] dark:border-slate-700">
              <img id="sp-foto-lapangan" src="/images/laporan-sepekan-sampul-lapangan.jpg" alt="Foto sampul kegiatan" class="aspect-[4/3] w-full bg-[#FFCC00] object-cover object-top" />
              <input id="sp-input-lapangan" type="file" accept="image/*" class="hidden" />
            </label>
            <button id="sp-reset-lapangan" type="button" class="mt-2 text-xs font-bold text-[#0A2540] underline dark:text-white">Kembalikan foto template</button>
          </div>
        </div>
      </section>

      <!-- Hasil per hari -->
      <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900 sm:p-5" aria-label="Hasil per hari">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Hasil yang Dicapai (per Hari)</h2>
          <span class="flex flex-wrap items-center gap-2">
            <button id="sp-tutup-semua" type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Tutup semua</button>
            <button id="sp-tambah-hari" type="button" class="rounded-lg bg-[#0A2540] px-4 py-2 text-sm font-bold text-white hover:bg-[#123a66]">+ Tambah Hari</button>
          </span>
        </div>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Setiap hari berisi satu atau beberapa kegiatan. Setiap kegiatan punya judul, narasi, dan sampai 4 foto (tinggi foto menyesuaikan panjang narasi). Ketuk “Tarik Berita Minggu Ini” di atas untuk mengisi otomatis sepekan dari berita ZonaPas Senin–Sabtu, atau ketuk “Tarik Berita Hari Ini” di tiap kartu hari bila hanya hari itu yang mau ditarik ulang (hari lain tidak berubah), atau isi manual — contoh dari template bisa diubah atau dihapus. Ketuk gembok 🔓/🔒 di tiap kartu hari untuk mengunci hari yang sudah fix — hari terkunci tidak akan tertimpa tarikan mingguan dan tidak bisa diedit sembarangan, tapi tetap bisa dibuka dan diedit lagi setelah gemboknya dibuka.</p>
        <div id="sp-hari-list" class="mt-4 space-y-5"></div>
      </section>

      <!-- Aksi -->
      <section class="mt-6 flex flex-wrap items-center gap-3">
        <button id="sp-unduh" type="button" class="rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">⬇ Unduh PDF</button>
        <button id="sp-lihat" type="button" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Lihat Pratinjau ↓</button>
        <span class="flex-1"></span>
        <button id="sp-reset-template" type="button" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Muat Ulang Template</button>
        <button id="sp-bersihkan" type="button" class="rounded-lg border border-red-300 px-4 py-2.5 text-sm font-bold text-red-700 hover:bg-red-50 dark:border-red-900 dark:text-red-200 dark:hover:bg-red-900/20">Bersihkan Draf</button>
      </section>
      <p id="sp-draf-info" class="mt-2 text-xs text-slate-500 dark:text-slate-400">Draf tersimpan otomatis di peramban ini.</p>
      </div>

      <!-- Pratinjau (halaman sendiri saat ?pratinjau=1) -->
      <section id="sp-pratinjau-bagian" class="mt-8" aria-label="Pratinjau laporan">
        <h2 class="text-lg font-black uppercase tracking-tight"><span class="mr-2 inline-block h-5 w-2 rounded-sm bg-[#FACC15] align-[-2px]" aria-hidden="true"></span>Pratinjau Laporan</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Tampilan di bawah ini sama dengan isi PDF yang diunduh (ukuran F4 per halaman).</p>
        <div id="sp-pratinjau" class="mt-4 flex flex-col items-center gap-6"></div>
      </section>
    </div>
  </div>


  <!-- Modal potong foto (crop) kegiatan/sampul: muncul setelah foto dipilih -->
  <div id="sp-modal-crop" class="fixed inset-0 z-[70] hidden overflow-y-auto bg-black/70" role="dialog" aria-modal="true" aria-label="Potong foto">
    <div class="mx-auto mt-8 w-full max-w-[640px] rounded-2xl bg-white p-4 shadow-2xl dark:bg-slate-900">
      <h3 class="text-base font-bold text-slate-800 dark:text-slate-100">Potong Foto</h3>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Seret foto untuk mengatur bingkai. Geser Zoom bila perlu, lalu ketuk "Potong &amp; Pakai".</p>
      <div id="sp-crop-stage" class="relative mt-3 h-[52vh] max-h-[460px] touch-none select-none overflow-hidden rounded-xl bg-slate-900">
        <img id="sp-crop-img" alt="Foto yang dipotong" class="absolute max-w-none cursor-grab" draggable="false" />
        <div id="sp-crop-frame" class="pointer-events-none absolute border-2 border-white shadow-[0_0_0_9999px_rgba(0,0,0,0.55)]"></div>
      </div>
      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Rasio potongan">
        <button type="button" data-sp-rasio="1.7" class="sp-crop-rasio rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold">17:10</button>
        <button type="button" data-sp-rasio="0" class="sp-crop-rasio rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold">Bebas</button>
        <button type="button" data-sp-rasio="1" class="sp-crop-rasio rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold">1:1</button>
        <button type="button" data-sp-rasio="1.7778" class="sp-crop-rasio rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold">16:9</button>
        <button type="button" data-sp-rasio="1.3333" class="sp-crop-rasio rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold">4:3 (standar)</button>
      </div>
      <div class="mt-3 flex items-center gap-2">
        <label for="sp-crop-zoom" class="text-xs font-bold">Zoom</label>
        <input id="sp-crop-zoom" type="range" min="1" max="3" step="0.05" value="1" class="flex-1" />
      </div>
      <div class="mt-4 flex justify-end gap-2">
        <button id="sp-btn-crop-pakai" type="button" class="rounded-lg bg-[#FACC15] px-5 py-2.5 text-sm font-bold text-[#0A2540] hover:bg-[#EAB308]">Potong &amp; Pakai</button>
        <button id="sp-btn-crop-batal" type="button" class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Batal</button>
      </div>
    </div>
  </div>
  <style>
    #sp-crop-stage { touch-action: none; }
    #sp-crop-img { touch-action: none; }
    .sp-crop-rasio-aktif { background: #0A2540 !important; color: #fff !important; border-color: #0A2540 !important; }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js" defer></script>
  <script is:inline src="/kelola-umum.js?v=12"></script>
  <script type="module">
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const HARI_NAMA = ['MINGGU', 'SENIN', 'SELASA', 'RABU', 'KAMIS', 'JUMAT', 'SABTU'];
    const BULAN_NAMA = ['JANUARI', 'FEBRUARI', 'MARET', 'APRIL', 'MEI', 'JUNI', 'JULI', 'AGUSTUS', 'SEPTEMBER', 'OKTOBER', 'NOVEMBER', 'DESEMBER'];
    const BULAN_PENDEK = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
    // Gaya template laporan (WARNA HEX SAJA — html2canvas tidak memahami
    // warna oklch Tailwind 4). Disuntik sebagai <style> global agar berlaku
    // untuk halaman pratinjau yang dibuat dinamis, dan dipakai juga di
    // dokumen iframe terisolasi saat membuat PDF (tanpa Tailwind sama sekali).
    const CSS_LAPORAN = `.sepekan-bungkus { position: relative; overflow: hidden; }
    .sepekan-halaman {
      width: 813px; height: 1247px; position: relative; overflow: hidden;
      background: #ffffff; color: #0A2540;
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
      box-shadow: 0 4px 24px rgba(5, 21, 46, 0.25);
      flex: none; transform-origin: top left;
    }
    .sepekan-isi { padding: 118px 56px 48px 56px; height: 1247px; box-sizing: border-box; position: relative; z-index: 1; }
    .sepekan-latar { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
    .sepekan-latar-titik { position: absolute; left: 0; right: 0; top: 0; height: 118px; background-image: radial-gradient(circle, rgba(30, 64, 175, 0.12) 1.5px, transparent 1.6px); background-size: 22px 22px; }
    /* Header halaman bab (Nov 2026): segi enam emboss di tengah kepala
       halaman + garis ganda tipis sebagai alasnya (dongker + emas).
       Agak penuh tapi tidak penuh — revisi dari garis saja yang terlalu
       simpel. Hanya di LATAR bab; halaman Hasil sudah punya pita. */
