    // TIDAK disimpan di draf — dihitung dari kunci asal butir itu
    // sendiri. RALAT 21 Nov 2026 (perintah Bos Besar): keterangan HANYA
    // tampil di halaman edit (di bawah kolom butir); pratinjau dan PDF
    // TIDAK memakai keterangan. Butir yang diedit manual tidak mendapat
    // keterangan.
    function butirTanpaKeterangan(t) {
