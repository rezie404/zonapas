    // ---------- Paginator: bagi blok isi ke halaman F4 ----------
    // Halaman F4 @96dpi = 813 x 1247 px (215 x 330 mm). Area isi:
    // padding 118px atas (ruang logo + pita), 48px bawah,
    // 56px kiri/kanan -> lebar 701px, tinggi 1081px.
    const TINGGI_ISI = 1081;
    let elUkur = null;
    function ukurBlok(html) {
      if (!elUkur) {
        elUkur = document.createElement('div');
        elUkur.id = 'sp-ukur';
        document.body.appendChild(elUkur);
      }
      elUkur.innerHTML = html;
      return elUkur.offsetHeight;
    }
    function blokParagraf(teks) {
      // Pecah jadi paragraf (baris kosong), lalu pecah paragraf yang terlalu
      // panjang jadi kelompok kalimat agar tidak ada blok yang melebihi 1 halaman.
      // Baris pertama tiap paragraf menjorok ke dalam (tab, 28px) seperti
      // template; sambungan paragraf di halaman berikut TIDAK menjorok.
      const keluar = [];
      const buatHtml = (t, indent) => '<p class="sepekan-paragraf' + (indent ? '' : ' lanjutan') + '">' + esc(t) + '</p>';
      const paragraf = String(teks || '').split(/\n\s*\n/).map((s) => s.replace(/\s+/g, ' ').trim()).filter(Boolean);
      for (const p of paragraf) {
        const html = buatHtml(p, true);
        if (ukurBlok(html) <= TINGGI_ISI) { keluar.push({ tipe: 'paragraf', html, tinggi: ukurBlok(html) }); continue; }
        // Paragraf terlalu panjang: pecah per kalimat.
        const kalimat = p.match(/[^.!?]+[.!?]+["”)]?\s*/g) || [p];
        let buf = '';
        let pertama = true;
        for (const k of kalimat) {
          const coba = (buf ? buf + ' ' : '') + k.trim();
          const h = ukurBlok(buatHtml(coba, pertama));
          if (h > TINGGI_ISI && buf) {
            keluar.push({ tipe: 'paragraf', html: buatHtml(buf, pertama), tinggi: ukurBlok(buatHtml(buf, pertama)) });
            buf = k.trim();
            pertama = false;
          } else { buf = coba; }
        }
        if (buf) keluar.push({ tipe: 'paragraf', html: buatHtml(buf, pertama), tinggi: ukurBlok(buatHtml(buf, pertama)) });
      }
      return keluar;
    }
    function blokNarasi2Kol(teks, judulCanva) {
      // Narasi kegiatan ditata 2 kolom seperti koran dalam SATU blok:
      // kolom kiri (blok biru: judul + awal narasi) diisi sampai bawah
      // dulu (penuh), baru sisanya naik ke atas kolom kanan. (Ralat Nov
      // 2026 atas permintaan Bos Besar: sebelumnya narasi dipecah jadi
      // beberapa baris 2-kolom (chunk), sehingga alurnya terbaca
      // zig-zag — kiri-kanan-kiri-kanan — bukan aliran kolom koran
      // kiri-penuh lalu kanan. Foto kini DI BAWAH narasi, bukan di atas.)
      // Bila narasi sangat panjang (blok 2-kolom > 700px, tidak muat 1
      // halaman F4 bersama foto), dipakai cara chunk (beberapa baris
      // 2-kolom) supaya tetap bisa mengalir.
      const paragraf = String(teks || '').split(/\n\s*\n/).map((x) => x.replace(/\s+/g, ' ').trim()).filter(Boolean);
      const satuan = []; // { teks, para, awal }
      paragraf.forEach((p, pi) => {
        const kal = p.match(/[^.!?]+[.!?]+["”)]?\s*/g) || [p];
        kal.forEach((k, i) => satuan.push({ teks: k.trim(), para: pi, awal: i === 0 }));
      });
      if (!satuan.length) return [];
      // Kalimat dari paragraf yang sama digabung jadi satu <p> supaya
      // teks mengalir natural. Awal paragraf tetap menjorok (tab 28px);
      // sambungan tidak menjorok.
      const renderKol = (arr) => {
        const groups = [];
        for (const s of arr) {
          const last = groups[groups.length - 1];
          if (last && last.para === s.para) last.kalimat.push(s.teks);
          else groups.push({ para: s.para, awal: s.awal, kalimat: [s.teks] });
        }
        return groups.map((g) => '<p class="sepekan-paragraf' + (g.awal ? '' : ' lanjutan') + '">' + esc(g.kalimat.join(' ')) + '</p>').join('');
      };
      // Satu kalimat yang sangat panjang dibelah di batas kata supaya
      // kedua kolom tetap terisi.
      let pakai = satuan;
      if (satuan.length === 1 && satuan[0].teks.length > 200) {
        const t = satuan[0].teks;
        const tengah = Math.floor(t.length / 2);
        const sp = t.indexOf(' ', tengah);
        const potong = sp > 0 ? sp : tengah;
        pakai = [
          { teks: t.slice(0, potong).trim(), para: satuan[0].para, awal: satuan[0].awal },
          { teks: t.slice(potong).trim(), para: satuan[0].para, awal: false },
        ];
      }
      const judul = judulCanva || '(Tanpa judul)';
      const tinggiJudul = ukurBlok('<div style="width:290px"><h3 class="sepekan-kegiatan-judul">' + esc(judul) + '</h3></div>') + 12;
      // Tinggi kotak kolom kiri = padding atas 16 + judul (+margin 12)
      // + narasi + padding bawah 18. Lebar isi kiri 290px, kanan 360px.
      const ukurKiri = (arr) => {
        if (!arr.length) return tinggiJudul + 34;
        return tinggiJudul + ukurBlok('<div class="sepekan-kegiatan-narasi-putih" style="width:290px">' + renderKol(arr) + '</div>') + 34;
      };
      const ukurKanan = (arr) => {
        if (!arr.length) return 0;
        return ukurBlok('<div class="sepekan-kegiatan-narasi" style="width:360px">' + renderKol(arr) + '</div>');
      };
      // Binary search: selisih (kiri - kanan) monoton naik terhadap
      // pisah. Cari pisah dgn selisih paling dekat 0 (kolom seimbang).
      const selisih = (p) => ukurKiri(pakai.slice(0, p)) - ukurKanan(pakai.slice(p));
      let pisah = pakai.length, lo = 0, hi = pakai.length;
      while (lo <= hi) {
        const mid = Math.floor((lo + hi) / 2);
        if (selisih(mid) <= 0) { pisah = mid; lo = mid + 1; }
        else { hi = mid - 1; }
      }
      let terbaik = pisah, bedaTerbaik = Math.abs(selisih(pisah));
      if (pisah + 1 <= pakai.length && Math.abs(selisih(pisah + 1)) < bedaTerbaik) { terbaik = pisah + 1; bedaTerbaik = Math.abs(selisih(pisah + 1)); }
      if (pisah - 1 >= 0 && Math.abs(selisih(pisah - 1)) < bedaTerbaik) { terbaik = pisah - 1; }
      pisah = terbaik;
      if (pisah < 1 && pakai.length > 1) pisah = 1;
      const kiri = pakai.slice(0, pisah);
      const kanan = pakai.slice(pisah);
      const htmlSatu = '<div class="sepekan-kegiatan"><div class="sepekan-kegiatan-kiri"><h3 class="sepekan-kegiatan-judul">' + esc(judul) + '</h3><div class="sepekan-kegiatan-narasi-putih">' + renderKol(kiri) + '</div></div><div class="sepekan-kegiatan-kanan"><div class="sepekan-kegiatan-narasi">' + renderKol(kanan) + '</div></div></div>';
      const tinggiSatu = ukurBlok(htmlSatu);
      if (tinggiSatu <= 700) return [{ tipe: 'paragraf', html: htmlSatu, tinggi: tinggiSatu }];
      return blokNarasi2KolChunk(teks, judulCanva);
    }
    function blokNarasi2KolChunk(teks, judulCanva) {
      // Narasi kegiatan ditata 2 kolom seperti koran (lihat template):
      // kalimat diakumulasi terus-menerus (lintas paragraf) jadi kelompok
      // yang muat ~380px, lalu tiap kelompok dibagi ke kolom kiri dan
      // kanan dgn alur koran: kolom kiri diisi narasi sampai bawah dulu,
      // baru sisanya naik ke atas kolom kanan. (Sebelumnya dibagi rata /
      // seimbang; diralat Nov 2026 atas permintaan Bos Besar.)
      // Kalimat dari paragraf yang sama digabung jadi satu <p> supaya
      // teks mengalir natural. Awal paragraf tetap menjorok (tab 28px);
      // sambungan tidak menjorok.
      // Satu kalimat yang sangat panjang dibelah di batas kata supaya
      // kedua kolom tetap terisi.
      // Bila judulCanva diisi, kelompok PERTAMA ditata ala template:
      // kolom kiri = blok biru berisi judul (kuning) + awal narasi
      // (putih), kolom kanan = lanjutan narasi (gelap).
      const CHUNK_MAX = 380;
      const keluar = [];
      const paragraf = String(teks || '').split(/\n\s*\n/).map((s) => s.replace(/\s+/g, ' ').trim()).filter(Boolean);
      const satuan = []; // { teks, para, awal }
      paragraf.forEach((p, pi) => {
        const kal = p.match(/[^.!?]+[.!?]+["”)]?\s*/g) || [p];
        kal.forEach((k, i) => satuan.push({ teks: k.trim(), para: pi, awal: i === 0 }));
      });
      if (!satuan.length) return keluar;
      // Alur koran (Nov 2026, ralat atas permintaan Bos Besar): kolom kiri
      // diisi narasi sampai bawah dulu, baru sisanya naik ke atas kolom
      // kanan. Bukan lagi dibagi rata/seimbang seperti sebelumnya.
      // lebarKiri = lebar isi kolom kiri (px); tinggiJudul = tinggi yang
      // dipakai judul di kolom kiri (0 bila tanpa judul / blok polos).
      const buatHtml = (list, lebarKiri, tinggiJudul) => {
        // Belah satu kalimat panjang (satu-satunya isi kelompok) di batas kata.
        let pakai = list;
        if (list.length === 1 && list[0].teks.length > 200) {
          const t = list[0].teks;
          let tengah = Math.floor(t.length / 2);
          const sp = t.indexOf(' ', tengah);
          const potong = sp > 0 ? sp : tengah;
          pakai = [
            { teks: t.slice(0, potong).trim(), para: list[0].para, awal: list[0].awal },
            { teks: t.slice(potong).trim(), para: list[0].para, awal: false },
          ];
        }
        // Cari titik pisah TERBESAR agar kolom kiri (pada lebar aslinya,
        // ditambah tinggi judul bila ada) masih muat dalam batas chunk.
        // Kalimat ditambah satu per satu ke kiri; begitu kalimat berikut
        // membuat kolom kiri melampaui batas, sisanya masuk kolom kanan.
        const renderKol = (arr) => {
          const groups = [];
          for (const s of arr) {
            const last = groups[groups.length - 1];
            if (last && last.para === s.para) last.kalimat.push(s.teks);
            else groups.push({ para: s.para, awal: s.awal, kalimat: [s.teks] });
          }
          return groups.map((g) => '<p class="sepekan-paragraf' + (g.awal ? '' : ' lanjutan') + '">' + esc(g.kalimat.join(' ')) + '</p>').join('');
        };
        const batasKiri = CHUNK_MAX - (tinggiJudul || 0) - (tinggiJudul ? 34 : 0);
        const ukurKiri = (arr) => {
          if (!arr.length) return 0;
          const bungkus = tinggiJudul ? 'sepekan-kegiatan-narasi-putih' : 'sepekan-2kol-kol';
          return ukurBlok('<div class="' + bungkus + '" style="width:' + lebarKiri + 'px">' + renderKol(arr) + '</div>');
        };
        // Binary search (tinggi kolom kiri monoton naik): cari pisah
        // terbesar agar kolom kiri masih muat dalam batas.
        let pisah = pakai.length, lo = 1, hi = pakai.length;
        while (lo <= hi) {
          const mid = Math.floor((lo + hi) / 2);
          if (ukurKiri(pakai.slice(0, mid)) <= batasKiri) { pisah = mid; lo = mid + 1; }
          else { hi = mid - 1; }
        }
        if (pisah < 1) pisah = 1;
        if (pisah >= pakai.length && pakai.length > 1) pisah = pakai.length - 1;
        const kiri = pakai.slice(0, pisah);
        const kanan = pakai.slice(pisah);

        return '<div class="sepekan-2kol"><div class="sepekan-2kol-kol">' + renderKol(kiri) + '</div><div class="sepekan-2kol-kol">' + renderKol(kanan) + '</div></div>';
      };
      const buatHtmlCanva = (list, judul) => {
        // Kelompok pertama ala template: judul + awal narasi di blok biru
        // (kiri), lanjutan narasi di kolom kanan. Ukur tinggi judul pada
        // lebar isi blok biru (290px) + margin bawah 12px, lalu pisah
        // narasi dgn lebar kolom kiri 290 (bukan 341) agar isi kolom kiri
        // (judul + narasi) tetap muat dalam batas chunk.
        const tinggiJudul = ukurBlok('<div style="width:290px"><h3 class="sepekan-kegiatan-judul">' + esc(judul) + '</h3></div>') + 12;
        const html2kol = buatHtml(list, 290, tinggiJudul);
        const m = html2kol.match(/^<div class="sepekan-2kol"><div class="sepekan-2kol-kol">([\s\S]*?)<\/div><div class="sepekan-2kol-kol">([\s\S]*?)<\/div><\/div>$/);
        if (!m) return html2kol;
        return '<div class="sepekan-kegiatan"><div class="sepekan-kegiatan-kiri"><h3 class="sepekan-kegiatan-judul">' + esc(judul) + '</h3><div class="sepekan-kegiatan-narasi-putih">' + m[1] + '</div></div><div class="sepekan-kegiatan-kanan"><div class="sepekan-kegiatan-narasi">' + m[2] + '</div></div></div>';
      };
      let buf = [];
      for (const s of satuan) {
        const coba = buf.concat([s]);
        const pertama = keluar.length === 0 && judulCanva;
        const htmlCoba = pertama ? buatHtmlCanva(coba, judulCanva) : buatHtml(coba, 341, 0);
        const h = ukurBlok(htmlCoba);
        if (h > CHUNK_MAX && buf.length) {
          const html = pertama ? buatHtmlCanva(buf, judulCanva) : buatHtml(buf, 341, 0);
          keluar.push({ tipe: 'paragraf', html, tinggi: ukurBlok(html) });
          buf = [s];
        } else { buf = coba; }
      }
      if (buf.length) {
        const pertama = keluar.length === 0 && judulCanva;
        const html = pertama ? buatHtmlCanva(buf, judulCanva) : buatHtml(buf, 341, 0);
        keluar.push({ tipe: 'paragraf', html, tinggi: ukurBlok(html) });
      }
      return keluar;
    }
    function blokJudulBab(judul, varian) {
      const kelas = 'sepekan-pita-bab' + (varian === 'kanan' ? ' sepekan-pita-bab-kanan' : varian === 'kiri' ? ' sepekan-pita-bab-kiri' : '');
      const html = '<div class="' + kelas + '">' + esc(judul) + '</div>';
      return { tipe: 'judul', html, tinggi: ukurBlok(html) };
    }
    function susunBlok() {
      const blok = [];
      // Foto kegiatan sepekan (untuk kolase + segi enam di halaman bab).
      // Foto kegiatan sepekan: 1 foto per kegiatan (foto pertama saja),
      // dipakai kolase Maksud & Tujuan dan segi enam bab (Nov 2026).
      const fotoSepekan = [];
      for (const h of state.hari) {
        for (const k of h.kegiatan || []) {
          const f = (k.foto || []).find(Boolean);
          if (f && fotoSepekan.indexOf(f) < 0) fotoSepekan.push(f);
        }
      }
      const tambahBab = (judul, teks, varian, grup) => {
        if (!String(teks || '').trim()) return;
        const j = blokJudulBab(judul, varian);
        if (grup) j.grup = grup;
        blok.push(j);
        for (const p of blokParagraf(teks)) { if (grup) p.grup = grup; blok.push(p); }
      };
      // Kolase SARANG LEBAH di bawah Peserta (Nov 2026, atas permintaan
      // Bos Besar): foto-foto kegiatan dalam segi enam (pointy-top)
      // berangkai seperti sarang madu — 3 baris berselang-seling (4+3+3),
      // tiap segi enam berbagi sisi dengan tetangganya. 1 foto per
      // kegiatan (foto pertama), maksimal 11 foto; kerangka 11 slot
      // selalu tampil (slot kosong = garis tepi) walau foto belum ada.
      const tambahKolaseMadu = () => {
        // KERANGKA kolase selalu tampil (Nov 2026, atas permintaan Bos
        // Besar): 11 slot segi enam berukuran proporsional mengisi area
        // kosong di bawah Peserta — 3 baris berselang-seling (4+3+4)
        // supaya tiap segi enam cukup besar dan kolase memenuhi area.
        // Foto (maks 11, 1 per kegiatan) mengisi slotnya; slot tanpa
        // foto tampil sebagai garis tepi (outline) supaya kerangka tetap
        // ada walau foto belum diunggah.
        const foto = fotoSepekan.slice(0, 11);
        const BARIS = [4, 3, 4];
        const JUMLAH_SLOT = 11;
        const sTinggi = 500 / (2 + (BARIS.length - 1) * 1.5);
        const lebarSatuan = Math.max.apply(null, BARIS.map((n, r) => n + (r % 2 ? 0.5 : 0)));
        const sLebar = 701 / (lebarSatuan * 1.732);
        const s = Math.max(50, Math.min(220, Math.floor(Math.min(sTinggi, sLebar))));
        const W = Math.floor(1.732 * s), H = 2 * s, dx = W, dy = Math.floor(1.5 * s), offX = Math.floor(0.866 * s);
        const lebarKlaster = Math.max.apply(null, BARIS.map((n, r) => (r % 2 ? offX : 0) + n * W));
        const geserX = Math.round((701 - lebarKlaster) / 2);
        const tinggi = H + (BARIS.length - 1) * dy;
        let sel = '';
        let idx = 0;
        BARIS.forEach((n, r) => {
          for (let k = 0; k < n; k++) {
            const cx = W / 2 + k * dx + (r % 2 ? offX : 0) + geserX;
            const cy = H / 2 + r * dy;
            const gaya = 'left:' + Math.round(cx - W / 2) + 'px;top:' + Math.round(cy - H / 2) + 'px;width:' + W + 'px;height:' + H + 'px';
            if (idx < foto.length) sel += '<div class="sepekan-madu-hex" style="' + gaya + ';background:#FFCC00"><div class="sepekan-madu-isi"><img src="' + esc(foto[idx]) + '" alt="" /></div></div>';
            else sel += '<div class="sepekan-madu-hex sepekan-madu-kosong" style="' + gaya + '"><div class="sepekan-madu-kosong-dalam"></div></div>';
            idx++;
          }
        });
        const html = '<div class="sepekan-kolase-madu" style="height:' + tinggi + 'px">' + sel + '</div>';
        blok.push({ tipe: 'kolase-kecil', html, tinggi: ukurBlok(html) });
      };
      // Isi bab (Latar Belakang, Maksud & Tujuan, Ruang Lingkup,
      // Peserta, Tindak Lanjut, Penutup) diambil TETAP dari TEMPLATE
      // (template laporan sebelumnya) — tidak lagi bisa diubah.
      tambahBab('Latar Belakang', TEMPLATE.latar);
      // Maksud & Tujuan: hanya narasi (foto/kolase di bawah narasi
      // DIHAPUS 10 Nov 2026 atas permintaan Bos Besar). Seluruh bab ini
      // satu grup 'maksud' supaya judul + narasi tetap sehalaman.
      // 2 foto segi enam di bab (baris biru di atas Ruang Lingkup +
      // segi enam kuning di bawah Peserta) DIHAPUS 10 Nov 2026 atas
      // permintaan Bos Besar. Kolase kecil di bawah Peserta tetap ada.
      tambahBab('Maksud & Tujuan', TEMPLATE.maksud, undefined, 'maksud');
      tambahBab('Ruang Lingkup', TEMPLATE.ruang, 'kanan', 'ruang-lingkup');
      tambahBab('Peserta', TEMPLATE.peserta, 'kiri');
      tambahKolaseMadu();
      // Hasil per hari. 1 kegiatan = 1 grup (judul + foto + narasi +
      // foto ke-2) supaya tidak terpisah antar halaman. Pita + tanggal
      // hari ikut grup kegiatan pertama hari itu.
      for (const h of state.hari) {
        if (!h.kegiatan.length) continue;
        const grupHari = 'keg-' + (h.tanggal || '') + '-0';
        const htmlHari = '<div class="sepekan-pita-hasil">HASIL YANG DICAPAI</div><p class="sepekan-tanggal-hari">' + esc(labelHari(h.tanggal)) + '</p>';
        const tinggiHari = ukurBlok(htmlHari);
        blok.push({ tipe: 'hari', html: htmlHari, tinggi: tinggiHari, grup: grupHari });
        h.kegiatan.forEach((k, ki) => {
          if (!String(k.judul || '').trim() && !String(k.narasi || '').trim()) return;
          const grup = 'keg-' + (h.tanggal || '') + '-' + ki;
          const fotos = (k.foto || []).filter(Boolean).slice(0, 4);
          // Foto MAKS 4 (Nov 2026, atas permintaan Bos Besar), rapi DI
          // BAWAH narasi. Tinggi foto MENYESUAIKAN panjang narasi:
          // dihitung dari sisa ruang 1 halaman F4 (TINGGI_ISI 1081px)
          // setelah narasi + kepala hari — narasi panjang -> foto lebih
          // ringkas; narasi pendek -> foto lebih besar — supaya kegiatan
          // tetap muat 1 halaman. 1 foto tampil tunggal, 2-3 foto
          // sebaris, 4 foto grid 2x2.
          const narasiBlok = blokNarasi2Kol(k.narasi, k.judul || '(Tanpa judul)');
          const tNarasi = narasiBlok.reduce((a, b) => a + b.tinggi, 0);
          const sisa = Math.max(100, Math.min(520, TINGGI_ISI - tNarasi - (ki === 0 ? tinggiHari : 0) - 50));
          const htmlFotoGrup = (daftar) => {
            if (!daftar.length) return '';
            if (daftar.length === 1) {
              const h1 = Math.max(120, Math.min(255, sisa));
              const w1 = Math.min(340, Math.round(h1 * 4 / 3));
              return '<div class="sepekan-foto-tunggal" style="width:' + w1 + 'px;height:' + h1 + 'px"><img src="' + esc(daftar[0]) + '" alt="" /></div>';
            }
            if (daftar.length === 2) {
              const h2 = Math.max(120, Math.min(252, sisa));
              return '<div class="sepekan-foto-baris" style="height:' + h2 + 'px"><div class="sepekan-foto-item" style="height:' + h2 + 'px"><img src="' + esc(daftar[0]) + '" alt="" /></div><div class="sepekan-foto-item" style="height:' + h2 + 'px"><img src="' + esc(daftar[1]) + '" alt="" /></div></div>';
            }
            if (daftar.length === 3) {
              const h3 = Math.max(100, Math.min(200, sisa));
              let sel = '';
              daftar.forEach((f) => { sel += '<div class="sepekan-foto-item" style="height:' + h3 + 'px"><img src="' + esc(f) + '" alt="" /></div>'; });
              return '<div class="sepekan-foto-baris" style="height:' + h3 + 'px">' + sel + '</div>';
            }
            const h4 = Math.max(90, Math.min(190, Math.floor((sisa - 28) / 2)));
            let baris = '';
            for (let r = 0; r < 2; r++) {
              let sel = '';
              for (let c = 0; c < 2; c++) {
                sel += '<div class="sepekan-foto-item" style="height:' + h4 + 'px"><img src="' + esc(daftar[r * 2 + c]) + '" alt="" /></div>';
              }
              baris += '<div class="sepekan-foto-baris" style="height:' + h4 + 'px">' + sel + '</div>';
            }
            return baris;
          };
          const htmlFoto = htmlFotoGrup(fotos);
          // Urutan kegiatan: narasi 2 kolom dulu (satu blok: judul +
          // narasi, kolom kiri penuh lalu kanan), FOTO DI BAWAH narasi
          // (Nov 2026, atas permintaan Bos Besar: 'foto letak dibawah
          // narasi saja'). Seluruh kegiatan satu grup supaya tetap
          // sehalaman bila muat.
          for (const nb of narasiBlok) blok.push({ ...nb, grup });
          if (htmlFoto) blok.push({ tipe: 'foto', html: htmlFoto, tinggi: ukurBlok(htmlFoto), grup });
        });
      }
      // Tindak lanjut
      if ((TEMPLATE.tindak || []).length) {
        blok.push(blokJudulBab('Tindak Lanjut'));
        TEMPLATE.tindak.forEach((t, i) => {
          const html = '<p class="sepekan-butir"><span class="nomor">' + (i + 1) + '.</span>' + esc(t) + '</p>';
          blok.push({ tipe: 'butir', html, tinggi: ukurBlok(html) });
        });
      }
      // Penutup + tanda tangan
      blok.push(blokJudulBab('Penutup'));
      blok.push(...blokParagraf(TEMPLATE.penutup));
      const htmlTtd = '<div class="sepekan-ttd"><p style="margin:0">' + esc(tglTtdPanjang()) + '</p><p style="margin:0">Kepala Kantor Wilayah<br />Ditjenpas Bengkulu,</p><p style="margin:0">Ttd</p><p class="nama">Masjuno</p></div>';
      blok.push({ tipe: 'ttd', html: htmlTtd, tinggi: ukurBlok(htmlTtd) });
      return blok;
    }
    function bagiHalaman(blok) {
      const halaman = [];
      let kini = [];
      let tinggi = 0;
      const JAGA = ['judul', 'hari']; // jangan yatim di ujung halaman
      // Total tinggi tiap grup kegiatan (1 kegiatan = 1 halaman).
      const totalGrup = {};
      for (const b of blok) if (b.grup) totalGrup[b.grup] = (totalGrup[b.grup] || 0) + b.tinggi;
      const grupMulai = new Set();
      for (let i = 0; i < blok.length; i++) {
        const b = blok[i];
        const berikut = blok[i + 1];
        // Bila blok pertama sebuah grup kegiatan tidak muat bersama
        // seluruh grupnya di sisa halaman, pindahkan seluruh grup ke
        // Aturan 1 kegiatan = 1 halaman (Nov 2026, atas permintaan Bos
        // Besar): tiap kegiatan (grup 'keg-...') SELALU mulai di halaman
        // baru bila halaman saat ini sudah terisi — walau muat di sisa
        // ruang — supaya judul, foto, dan narasi satu kegiatan tidak
        // berbagi halaman dengan kegiatan lain. Grup bab lain tetap
        // memakai aturan muat-bersama. Kegiatan yang lebih tinggi dari
        // 1 halaman tetap mengalir (tidak bisa dihindari), tapi mulai
        // dari atas halaman.
        if (b.grup && !grupMulai.has(b.grup)) {
          grupMulai.add(b.grup);
          const adalahKegiatan = String(b.grup).indexOf('keg-') === 0;
          // Ruang Lingkup juga selalu mulai di halaman baru (Nov 2026,
          // atas permintaan Bos Besar: 'turunkan saja ruang lingkup ke
          // halaman selanjutnya').
          const mulaiBaru = adalahKegiatan || b.grup === 'ruang-lingkup';
          if (kini.length && (mulaiBaru || tinggi + totalGrup[b.grup] > TINGGI_ISI)) {
            halaman.push(kini);
            kini = [];
            tinggi = 0;
          }
        }
        // Tanda tangan (ttd) harus satu halaman dengan paragraf penutup
        // sebelumnya. Bila tidak muat, pindahkan paragraf penutup (dan
        // judul bab bila ikut yatim) ke halaman berikut, supaya tanda
        // tangan tidak sendirian di halaman kosong.
        if (b.tipe === 'ttd' && kini.length && tinggi + b.tinggi > TINGGI_ISI) {
          const pindah = [];
          while (kini.length > 0) {
            const terakhir = kini[kini.length - 1];
            pindah.unshift(terakhir);
            kini.pop();
            tinggi -= terakhir.tinggi;
            if (kini.length === 0) break;
            // Bila yang tersisa adalah judul bab, pindahkan juga (jangan yatim).
            if (!JAGA.includes(kini[kini.length - 1].tipe)) break;
          }
          // Jangan dorong halaman kosong: bila halaman saat ini habis
          // dipindahkan, batalkan pemindahan (tanda tangan tetap pindah
          // sendiri, tapi halaman sebelumnya tidak kosong).
          if (kini.length === 0) {
            kini = pindah;
            tinggi = pindah.reduce((a, x) => a + x.tinggi, 0);
          } else {
            halaman.push(kini);
            kini = pindah;
            tinggi = pindah.reduce((a, x) => a + x.tinggi, 0);
          }
        }
        // Bila blok ini harus dijaga bersama blok berikut, pastikan keduanya muat.
        const butuh = JAGA.includes(b.tipe) && berikut ? b.tinggi + berikut.tinggi : b.tinggi;
        if (kini.length && tinggi + butuh > TINGGI_ISI) {
          halaman.push(kini);
          kini = [];
          tinggi = 0;
        }
        kini.push(b);
        tinggi += b.tinggi;
      }
      if (kini.length) halaman.push(kini);
      return halaman;
    }

