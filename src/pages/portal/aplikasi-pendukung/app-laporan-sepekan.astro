    // Kumpulkan kegiatan minggu ini (hariUntukTindakLanjut) jadi daftar
    // rapi untuk Generate.
    function kumpulkanKegiatanTL(hari) {
      const semua = [];
      (hari || []).forEach((h) => (h.kegiatan || []).forEach((k) => semua.push({ tanggal: h.tanggal, judul: k.judul, narasi: k.narasi })));
      return rapikanKegiatanTL(semua);
    }
    // Pasangkan satu kalimat tindak lanjut per kegiatan (MURNI, tanpa
    // jaringan — bisa diuji harness). Kalimat AI dipakai urut per
    // kegiatan; bila kalimat AI lebih banyak dari kegiatan, kelebihan
    // dibuang. RALAT 22 Nov 2026 (perintah Bos Besar): TIDAK ADA teks
    // aturan — bila kalimat AI kurang dari jumlah kegiatan (atau null
