---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../../data/site';
import { AUTHORS } from '../../../data/authors';

const categoryColors = Object.fromEntries(CATEGORIES.map((c) => [c.name, c.color]));
const authorInfoMap = Object.fromEntries(Object.values(AUTHORS).map((a) => [a.name, { role: a.role, bio: a.bio }]));
---

<BaseLayout
  title="Migrasi Data Rekap (Satu Kali)"
  description="Memindahkan 1.937 baris data Rekap Laporan Publikasi Harian dari aplikasi lama ke ZonaPas — hanya untuk Administrator, satu kali saja."
>
  <script type="application/json" id="kelola-data" set:html={JSON.stringify({ categoryColors, authors: authorInfoMap })} />

  <div class="mx-auto max-w-[1200px] px-4 py-6">
    <div class="border-b-2 border-[#0A2540] pb-4 dark:border-white">
      <h1 class="text-2xl font-black uppercase tracking-tight sm:text-3xl">Migrasi Data Rekap</h1>
      <div class="mt-2 h-1.5 w-20 rounded bg-[#FACC15]" aria-hidden="true"></div>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Memindahkan data Rekap Laporan Publikasi Harian (2–7 November 2026, 1.937 baris) dari aplikasi lama ke ZonaPas.
        Halaman sementara ini hanya untuk Administrator dan akan dihapus setelah migrasi selesai.
      </p>
    </div>

    <!-- Status -->
    <div id="status" class="mt-4 hidden rounded-lg px-4 py-3 text-sm font-medium" role="status"></div>

    <!-- Login -->
    <section id="login-box" class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center dark:border-slate-800 dark:bg-slate-900">
      <img src="/images/logo-zonapas.png" alt="Logo ZonaPas" class="mx-auto h-16 w-16 rounded-full object-cover" width="64" height="64" />
      <h2 class="mt-3 text-lg font-bold">Masuk untuk menjalankan migrasi</h2>
      <p class="mx-auto mt-1 max-w-md text-sm text-slate-600 dark:text-slate-400">
        Masuk dengan GitHub (khusus Administrator) atau dengan akun Google Administrator Anda.
      </p>
      <button
        id="btn-login"
        type="button"
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]"
      >
        Masuk dengan GitHub
      </button>
      <a
        href="/redaksi/auth/google"
        class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-[#0A2540] hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-800"
      >
        Masuk dengan Google
      </a>
      <p id="login-fallback" class="mt-3 hidden text-xs text-slate-500 dark:text-slate-400">
        Popup diblokir?
        <a href="https://oauth.zonapas.web.id/auth" target="_blank" class="font-bold text-[#0A2540] underline dark:text-white">Buka login GitHub di tab baru</a>
        — setelah otorisasi, kembali ke tab ini.
      </p>
    </section>

    <!-- Akses ditolak (akun tanpa binding peran) -->
    <section id="akses-ditolak" class="mt-6 hidden rounded-2xl border border-red-300 bg-red-50 p-6 text-center dark:border-red-900 dark:bg-red-900/20">
      <h2 class="text-lg font-bold text-red-900 dark:text-red-100">Akun ini belum punya akses</h2>
      <p id="akses-ditolak-pesan" class="mx-auto mt-1 max-w-md text-sm text-red-800 dark:text-red-200">Akun ini belum punya akses — hubungi Administrator untuk meminta akses.</p>
      <button id="btn-akses-keluar" type="button" class="mt-4 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:hover:bg-slate-800">Keluar &amp; Coba Akun Lain</button>
    </section>

    <!-- Migrasi (setelah login) -->
    <div id="app" class="hidden">
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span id="user-chip" class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-bold dark:bg-slate-800">
          <img id="user-avatar" alt="" class="h-6 w-6 rounded-full" width="24" height="24" />
          <span id="user-name"></span>
        </span>
        <span class="flex-1"></span>
        <a href="/portal/aplikasi-pendukung/" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">← Kembali ke Aplikasi Pendukung</a>
        <button id="btn-keluar" type="button" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Keluar</button>
      </div>

      <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-lg font-black">Jalankan Migrasi</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
          Migrasi berjalan otomatis setelah masuk. Data dikirim per 300 baris ke endpoint seed (idempotent — aman diulang, baris yang sudah ada dilewati sebagai duplikat).
          Target yang diharapkan: <strong>1.937 baris</strong> (2 Nov: 321, 3 Nov: 326, 4 Nov: 352, 5 Nov: 376, 6 Nov: 380, 7 Nov: 182) + 1 penanda nihil (Bapas, 7 Nov).
        </p>
        <button id="btn-seed" type="button" class="mt-4 rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">▶ Mulai Migrasi</button>
        <pre id="seed-log" class="mt-4 max-h-72 overflow-auto whitespace-pre-wrap rounded-lg bg-slate-100 p-4 text-xs dark:bg-slate-800">Menunggu masuk...</pre>
        <div id="seed-hasil" class="mt-4 hidden rounded-lg bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-900 dark:bg-emerald-900/20 dark:text-emerald-100" role="status"></div>
      </div>
    </div>
  </div>

  <script is:inline src="/kelola-umum.js?v=4"></script>
  <script is:inline>
    let seedJalan = false;
    async function jalankanSeed() {
      if (seedJalan) return;
      seedJalan = true;
      const logEl = document.getElementById('seed-log');
      const hasilEl = document.getElementById('seed-hasil');
      const log = (t) => { logEl.textContent += t + '\n'; };
      logEl.textContent = '';
      try {
        log('Mengambil data migrasi...');
        const data = await (await fetch('/rekap-seed-data.json')).json();
        const rows = data.rows || [];
        const nihil = data.nihil || [];
        log('Total baris: ' + rows.length + ' | Penanda nihil: ' + nihil.length);
        let baru = 0, duplikat = 0, nihilDitandai = 0;
        const totalChunk = Math.ceil(rows.length / 300);
        for (let i = 0; i < rows.length; i += 300) {
          const chunk = rows.slice(i, i + 300);
          const body = { rows: chunk };
          if (i === 0 && nihil.length) body.nihil = nihil;
          const r = await workerPost('/redaksi/api/rekap/seed', body);
          baru += r.baru || 0; duplikat += r.duplikat || 0; nihilDitandai += r.nihilDitandai || 0;
          log('Chunk ' + (i / 300 + 1) + '/' + totalChunk + ': baru ' + (r.baru || 0) + ', duplikat ' + (r.duplikat || 0));
        }
        log('SELESAI. Baru: ' + baru + ' | Duplikat: ' + duplikat + ' | Nihil ditandai: ' + nihilDitandai);
        const st = await workerGet('/redaksi/api/rekap/statistik');
        log('VERIFIKASI (statistik dari server): ' + JSON.stringify(st));
        hasilEl.textContent = 'MIGRASI SELESAI — baru: ' + baru + ', duplikat: ' + duplikat + ' — statistik: ' + JSON.stringify(st);
        hasilEl.classList.remove('hidden');
      } catch (e) {
        const pesan = 'MIGRASI GAGAL: ' + (e && e.message ? e.message : e);
        log(pesan);
        hasilEl.textContent = pesan;
        hasilEl.classList.remove('hidden');
      }
    }
    document.getElementById('btn-seed').addEventListener('click', jalankanSeed);
    window.__kelolaSetelahLogin = jalankanSeed;
  </script>
</BaseLayout>
