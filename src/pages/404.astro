---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../data/site';
---

<BaseLayout
  title="Halaman Tidak Ditemukan"
  description="Maaf, halaman yang Anda cari tidak ditemukan di ZonaPas. Mungkin alamatnya salah ketik, atau halaman tersebut sudah dipindahkan atau dihapus."
>
  <div class="mx-auto max-w-[1200px] px-4 py-16 text-center sm:py-24">
    <p class="text-7xl font-black tracking-tight text-[#0A2540] dark:text-white sm:text-8xl">404</p>
    <h1
      class="mt-4 text-2xl font-black uppercase tracking-tight text-slate-900 dark:text-slate-100 sm:text-3xl"
    >
      Halaman Tidak Ditemukan
    </h1>
    <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">
      Maaf, alamat yang Anda tuju tidak ada di ZonaPas. Mungkin tautannya salah ketik, atau
      halaman tersebut sudah dipindahkan atau dihapus.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/"
        class="rounded-lg bg-[#0A2540] px-6 py-3 text-sm font-bold text-white hover:bg-[#123a5e]"
        >← Kembali ke Beranda</a
      >
      <a
        href="/cari/"
        class="rounded-lg bg-[#FACC15] px-6 py-3 text-sm font-bold text-[#0A2540] hover:bg-[#EAB308]"
        >🔍 Cari Berita</a
      >
    </div>
    <div class="mt-12">
      <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Atau jelajahi kategori
      </p>
      <ul class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {
          CATEGORIES.map((cat) => (
            <li>
              <a
                href={`/${cat.slug}/`}
                class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-[#0A2540] hover:text-[#0A2540] dark:border-slate-700 dark:text-slate-300 dark:hover:border-white dark:hover:text-white"
              >
                {cat.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
