---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

// Regulasi Pemasyarakatan (24 Nov 2026): daftar peraturan perundangan
// tentang pemasyarakatan. Daftar + pratinjau (judul, nomor, tahun, jenis,
// ringkasan) untuk SEMUA pengunjung tanpa login; baca selengkapnya dan
// unduh hanya setelah masuk dengan Google. PDF tersimpan di Internet
// Archive (bukan di repo — kapasitas repo hanya untuk berita). Data
// dimuat dari Worker (/redaksi/api/peraturan) saat halaman dibuka, jadi
// peraturan baru tampil tanpa rebuild. Detail memakai ?id=<identifier>
// di halaman yang sama. Regulasi BUKAN kategori berita/video.
const url = `${SITE.url}/regulasi/`;
const JENIS = ["UU", "Perppu", "PP", "Perpres", "Permenkumham", "Kepdirjenpas", "SE"];
---

<BaseLayout title="Regulasi Pemasyarakatan" description="Daftar peraturan perundangan tentang pemasyarakatan: pratinjau bisa dibaca semua orang, baca selengkapnya dan unduh setelah masuk dengan Google." canonical={url}>
  <div class="mx-auto max-w-[1200px] px-4 pt-6">
    <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Beranda</a>
      <span class="mx-1">/</span>
      <span class="font-semibold text-slate-800 dark:text-slate-200">Regulasi Pemasyarakatan</span>
    </nav>

    <h1 class="mt-4 text-3xl font-black leading-tight sm:text-4xl">Regulasi Pemasyarakatan</h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
      Peraturan perundangan tentang pemasyarakatan. Pratinjau (judul, nomor, tahun, jenis, dan ringkasan) bisa dibaca semua orang — untuk membaca berkas selengkapnya dan mengunduhnya, masuk dulu dengan akun Google.
    </p>

    <!-- Daftar -->
    <div id="regulasi-daftar-wrap">
      <div class="mt-6 grid gap-3 sm:grid-cols-[1fr_auto_auto]">
        <input
          id="regulasi-cari"
          type="search"
          placeholder="Cari judul, nomor, atau isi ringkasan…"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900"
          aria-label="Cari peraturan"
        />
        <select id="regulasi-jenis" class="rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" aria-label="Saring jenis peraturan">
          <option value="">Semua jenis</option>
          {JENIS.map((j) => (<option value={j}>{j}</option>))}
        </select>
        <select id="regulasi-tahun" class="rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" aria-label="Saring tahun">
          <option value="">Semua tahun</option>
        </select>
      </div>
      <p id="regulasi-status" class="mt-4 text-sm text-slate-500 dark:text-slate-400">Memuat daftar peraturan…</p>
      <div id="regulasi-daftar" class="mt-4 grid gap-4"></div>
    </div>

    <!-- Detail -->
    <div id="regulasi-detail-wrap" class="hidden">
      <p class="mt-6"><a href="/regulasi/" class="text-sm font-bold text-[#0A2540] hover:underline dark:text-white">← Kembali ke daftar peraturan</a></p>
      <div id="regulasi-detail" class="mt-4"></div>
    </div>
  </div>

  <script>
    (function () {
      var daftar = [];
      var pengguna = null;
      var loginDicek = false;

      function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }
      function $(id) { return document.getElementById(id); }
      // Token login GitHub (sessionStorage, hanya tab Kelola Berita) —
      // harus ikut di kiriman /api/me supaya admin yang masuk lewat
      // GitHub ikut dikenali di halaman publik (pola InteraksiArtikel).
      function tokenGithub() {
        try { return sessionStorage.getItem('zonapas-kelola-token'); } catch (e) { return null; }
      }
      function badanDenganToken(badan) {
        var t = tokenGithub();
        return t ? Object.assign({}, badan || {}, { github_token: t }) : (badan || {});
      }
      function paramId() {
        var id = new URLSearchParams(location.search).get('id') || '';
        return /^[A-Za-z0-9][A-Za-z0-9-]{0,79}$/.test(id) ? id : '';
      }
      function labelJenis(jenis, nomor, tahun) {
        return esc(jenis) + ' Nomor ' + esc(nomor) + ' Tahun ' + esc(tahun);
      }
      function kartuPeraturan(p) {
        return '<a href="/regulasi/?id=' + encodeURIComponent(p.identifier) + '" class="group block rounded-xl border border-slate-200 p-4 hover:border-[#0A2540] dark:border-slate-800 dark:hover:border-white">' +
          '<span class="inline-block rounded-full bg-[#0A2540] px-2.5 py-0.5 text-[11px] font-bold text-white">' + esc(p.jenis) + '</span> ' +
          '<span class="text-xs font-bold text-slate-500 dark:text-slate-400">' + esc(p.nomor) + ' · ' + esc(p.tahun) + '</span>' +
          '<span class="mt-2 block text-base font-bold leading-snug group-hover:text-[#D9232E]">' + esc(p.judul) + '</span>' +
          (p.ringkasan ? '<span class="mt-1 block text-sm text-slate-600 dark:text-slate-300">' + esc(p.ringkasan) + '</span>' : '') +
          '<span class="mt-3 block text-xs font-bold text-[#0A2540] group-hover:underline dark:text-white">Lihat pratinjau →</span>' +
          '</a>';
      }
      function terapkanSaring() {
        var kata = ($('regulasi-cari').value || '').trim().toLowerCase();
        var jenis = $('regulasi-jenis').value || '';
        var tahun = $('regulasi-tahun').value || '';
        var hasil = daftar.filter(function (p) {
          if (jenis && p.jenis !== jenis) return false;
          if (tahun && String(p.tahun) !== tahun) return false;
          if (kata) {
            var hay = ((p.judul || '') + ' ' + (p.nomor || '') + ' ' + (p.ringkasan || '')).toLowerCase();
            if (hay.indexOf(kata) === -1) return false;
          }
          return true;
        });
        var el = $('regulasi-daftar');
        var st = $('regulasi-status');
        if (!daftar.length) {
          el.innerHTML = '';
          st.textContent = 'Belum ada peraturan. Administrator dapat menambahkannya lewat Kelola Berita → Regulasi Pemasyarakatan.';
          return;
        }
        st.textContent = hasil.length + ' dari ' + daftar.length + ' peraturan';
        el.innerHTML = hasil.length
          ? hasil.map(kartuPeraturan).join('')
          : '<p class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-500 dark:border-slate-800 dark:bg-slate-900">Tidak ada peraturan yang cocok dengan pencarian Anda.</p>';
      }
      function isiPilihanTahun() {
        var tahunSet = {};
        daftar.forEach(function (p) { if (p.tahun) tahunSet[p.tahun] = true; });
        var tahunList = Object.keys(tahunSet).sort(function (a, b) { return Number(b) - Number(a); });
        var sel = $('regulasi-tahun');
        var kini = sel.value || '';
        sel.innerHTML = '<option value="">Semua tahun</option>' + tahunList.map(function (t) {
          return '<option value="' + esc(t) + '"' + (String(t) === kini ? ' selected' : '') + '>' + esc(t) + '</option>';
        }).join('');
      }
      async function muatDaftar() {
        try {
          var r = await fetch('/redaksi/api/peraturan', { credentials: 'same-origin' });
          var d = await r.json();
          if (!d.ok || !Array.isArray(d.peraturan)) throw new Error((d && d.error) || 'Gagal memuat daftar.');
          daftar = d.peraturan;
          isiPilihanTahun();
          terapkanSaring();
        } catch (e) {
          $('regulasi-status').textContent = 'Daftar peraturan tidak bisa dimuat: ' + (e.message || 'galat') + '. Segarkan halaman.';
        }
      }
      async function cekLogin() {
        if (loginDicek) return pengguna;
        loginDicek = true;
        try {
          var r = await fetch('/redaksi/api/me', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(badanDenganToken({})) });
          var d = await r.json();
          pengguna = d.ok ? d.user : null;
        } catch (e) { pengguna = null; }
        return pengguna;
      }
      function muatPratinjauPdf(p) {
        var wadah = $('regulasi-pratinjau');
        if (!wadah) return;
        wadah.innerHTML = '<p class="p-6 text-center text-sm text-slate-500 dark:text-slate-400">Memuat halaman pertama…</p>';
        function gagal() {
          wadah.innerHTML = '<p class="p-6 text-center text-sm text-slate-500 dark:text-slate-400">Pratinjau halaman pertama tidak bisa dimuat. Coba segarkan halaman, atau unduh PDF-nya di bawah.</p>';
        }
        function siap() {
          try {
            window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
            window.pdfjsLib.getDocument('/redaksi/api/peraturan/' + encodeURIComponent(p.identifier) + '/berkas').promise.then(function (doc) {
              return doc.getPage(1);
            }).then(function (page) {
              var lebar = wadah.clientWidth || 600;
              var skala = Math.min(2, lebar / page.getViewport({ scale: 1 }).width);
              var vp = page.getViewport({ scale: skala });
              var kanvas = document.createElement('canvas');
              kanvas.width = Math.floor(vp.width);
              kanvas.height = Math.floor(vp.height);
              kanvas.style.width = '100%';
              kanvas.style.height = 'auto';
              kanvas.style.display = 'block';
              wadah.innerHTML = '';
              wadah.appendChild(kanvas);
              return page.render({ canvasContext: kanvas.getContext('2d'), viewport: vp }).promise;
            }).catch(gagal);
          } catch (e) { gagal(); }
        }
        if (window.pdfjsLib) { siap(); return; }
        var s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        s.onload = siap;
        s.onerror = gagal;
        document.head.appendChild(s);
      }
      function tampilkanDetail(p) {
        var el = $('regulasi-detail');
        var next = '/regulasi/?id=' + encodeURIComponent(p.identifier);
        var loginHref = '/masuk/?next=' + encodeURIComponent(next);
        var isi = '<article class="rounded-xl border border-slate-200 p-4 dark:border-slate-800 sm:p-6">' +
          '<span class="inline-block rounded-full bg-[#0A2540] px-2.5 py-0.5 text-[11px] font-bold text-white">' + esc(p.jenis) + '</span> ' +
          '<span class="text-xs font-bold text-slate-500 dark:text-slate-400">' + esc(p.nomor) + ' · ' + esc(p.tahun) + '</span>' +
          '<h2 class="mt-3 text-2xl font-black leading-tight">' + esc(p.judul) + '</h2>' +
          '<p class="mt-1 text-sm font-bold text-slate-500 dark:text-slate-400">' + labelJenis(p.jenis, p.nomor, p.tahun) + '</p>' +
          (p.ringkasan ? '<p class="mt-3 text-sm leading-relaxed text-slate-700 dark:text-slate-200">' + esc(p.ringkasan) + '</p>' : '') +
          '<div id="regulasi-akses" class="mt-4"></div>' +
          '</article>';
        el.innerHTML = isi;
        var akses = $('regulasi-akses');
        cekLogin().then(function (user) {
          if (user) {
            // Pratinjau = halaman pertama PDF, digambar langsung di halaman
            // (25 Nov 2026, ralat): penampil Google Docs GAGAL di HP
            // (kotak abu-abu + ikon rusak) karena tautan archive.org/download
            // mengarah ulang (302) dan penampil Google tidak mengikutinya.
            // pdf.js memuat PDF lewat Worker (/berkas, origin sama — tanpa
            // CORS) lalu menggambar halaman 1 ke canvas. Bila gagal, kotak
            // pratinjau menampilkan pesan + tombol Unduh PDF tetap ada.
            akses.innerHTML =
              '<div id="regulasi-pratinjau" class="overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900"></div>' +
              '<p class="mt-3 flex flex-wrap gap-2">' +
              '<a href="' + esc(p.tautan_unduh) + '" class="rounded-lg bg-[#0A2540] px-4 py-2 text-sm font-bold text-white hover:bg-[#123a66]">Unduh PDF</a>' +
              '<a href="https://archive.org/details/' + encodeURIComponent(p.identifier) + '" target="_blank" rel="noopener" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Buka di Internet Archive</a>' +
              '</p>';
            muatPratinjauPdf(p);
          } else {
            akses.innerHTML =
              '<div class="rounded-xl border border-[#FACC15] bg-yellow-50 p-4 dark:border-yellow-700 dark:bg-yellow-900/20">' +
              '<p class="text-sm font-bold">Baca selengkapnya dan unduh setelah masuk</p>' +
              '<p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Pratinjau di atas bisa dibaca semua orang. Untuk membaca berkas selengkapnya dan mengunduh PDF-nya, masuk dulu dengan akun Google Anda.</p>' +
              '<p class="mt-3"><a href="' + loginHref + '" class="rounded-lg bg-[#0A2540] px-4 py-2 text-sm font-bold text-white hover:bg-[#123a66]">Masuk dengan Google</a></p>' +
              '</div>';
          }
        });
      }
      async function muatDetail(id) {
        $('regulasi-daftar-wrap').classList.add('hidden');
        $('regulasi-detail-wrap').classList.remove('hidden');
        var el = $('regulasi-detail');
        el.innerHTML = '<p class="text-sm text-slate-500 dark:text-slate-400">Memuat peraturan…</p>';
        try {
          var r = await fetch('/redaksi/api/peraturan/' + encodeURIComponent(id), { credentials: 'same-origin' });
          var d = await r.json();
          if (!d.ok || !d.peraturan) throw new Error((d && d.error) || 'Peraturan tidak ditemukan.');
          tampilkanDetail(d.peraturan);
        } catch (e) {
          el.innerHTML = '<p class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-500 dark:border-slate-800 dark:bg-slate-900">Peraturan tidak bisa dimuat: ' + esc(e.message || 'galat') + '.</p>';
        }
      }
      function init() {
        var id = paramId();
        if (id) { muatDetail(id); return; }
        ['regulasi-cari', 'regulasi-jenis', 'regulasi-tahun'].forEach(function (x) {
          var el = $(x);
          if (el) el.addEventListener('input', terapkanSaring);
        });
        muatDaftar();
      }
      init();
    })();
  </script>
</BaseLayout>
