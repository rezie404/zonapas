---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, formatDate } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('video');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, video, publishDate, author } = entry.data;
const slug = entry.id.replace(/\.md$/, '');
const url = `${SITE.url}/video/${slug}/`;

// ID YouTube dari tautan watch / youtu.be / Shorts / embed / live / ID mentah.
const idYoutube = (tautan: string) => {
  const t = (tautan || '').trim();
  const m = t.match(/(?:v=|youtu\.be\/|shorts\/|embed\/|live\/)([A-Za-z0-9_-]{11})/) || t.match(/^([A-Za-z0-9_-]{11})$/);
  return m ? m[1] : '';
};
const id = idYoutube(video);
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;

// Video lainnya: terbaru dulu, maksimal 6. Sejak 07 Nov 2026 kartunya
// memakai thumbnail bawaan YouTube (bingkai video itu sendiri) dengan
// judul seksi "Tonton Juga" — bukan sampul/cover buatan redaksi.
const semua = await getCollection('video');
const lainnya = semua
  .filter((v) => v.id !== entry.id)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description: description || title,
  thumbnailUrl: thumb,
  uploadDate: publishDate.toISOString(),
  embedUrl: `https://www.youtube-nocookie.com/embed/${id}`,
  author: { '@type': 'Person', name: author || 'Rezie' },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'id-ID',
};
---

<BaseLayout title={title} description={description || title} image={thumb} type="video.other" canonical={url} jsonLd={jsonLd}>
  <article class="mx-auto max-w-[1200px] px-4 pt-6">
    <div class="mx-auto max-w-[760px]">
      <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:underline">Beranda</a>
        <span class="mx-1">/</span>
        <a href="/#zonapastv" class="hover:underline">ZonaPasTV</a>
        <span class="mx-1">/</span>
        <span class="font-semibold text-slate-800 dark:text-slate-200">{title}</span>
      </nav>

      <h1 class="mt-4 text-3xl font-black leading-tight sm:text-4xl">{title}</h1>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-[#D9232E] px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">ZonaPasTV</span>
        <span class="text-sm text-slate-600 dark:text-slate-300">{formatDate(publishDate)}</span>
        {author && (
          <>
            <span class="text-slate-300 dark:text-slate-600">|</span>
            <span class="text-sm text-slate-600 dark:text-slate-300">{author}</span>
          </>
        )}
      </div>

      <div class="relative mt-5 aspect-video overflow-hidden rounded-2xl bg-black">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${id}?rel=0`}
          title={title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          class="h-full w-full border-0"
        />
        <div class="pointer-events-none absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1.5 shadow-lg">
          <img src="/images/logo-zonapastv.png" alt="ZonaPasTV" class="h-6 w-auto" />
        </div>
      </div>

      {description && (
        <p class="mt-5 whitespace-pre-line text-[17px] leading-relaxed text-slate-800 dark:text-slate-200">{description}</p>
      )}

      <p class="mt-6">
        <a href="/" class="text-sm font-bold text-[#0A2540] hover:underline dark:text-white">&larr; Kembali ke Beranda</a>
      </p>
    </div>

    {lainnya.length > 0 && (
      <section class="mx-auto mt-10 max-w-[1200px]" aria-label="Tonton juga">
        <h2 class="mb-4 border-b-2 border-[#D9232E] pb-2 text-xl font-black uppercase">Tonton Juga</h2>
        <div class="grid gap-4 sm:grid-cols-3">
          {lainnya.map((v) => (
            <a
              href={`/video/${v.id.replace(/\.md$/, '')}/`}
              class="group overflow-hidden rounded-xl border border-slate-200 text-left dark:border-slate-800"
            >
              <img src={`https://i.ytimg.com/vi/${idYoutube(v.data.video)}/hqdefault.jpg`} alt="" loading="lazy" class="aspect-video w-full object-cover" />
              <span class="block p-3 text-sm font-bold leading-snug group-hover:text-[#D9232E]">{v.data.title}</span>
              <span class="block px-3 pb-3 text-xs text-slate-500 dark:text-slate-400">{formatDate(v.data.publishDate)}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
