---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, SITE } from '../data/site';
---

<BaseLayout title="Cari Berita" description={`Cari berita di ${SITE.name}.`}>
  <div class="mx-auto max-w-[1200px] px-4 pt-6">
    <h1 class="text-3xl font-black">Cari Berita</h1>
    <form id="search-form" class="mt-4 flex gap-2" role="search">
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Ketik kata kunci, misalnya: bengkulu, pembinaan, remisi…"
        class="h-12 flex-1 rounded-lg border border-slate-300 px-4 text-base outline-none focus:border-[#0A2540] focus:ring-2 focus:ring-[#0A2540]/20 dark:border-slate-700 dark:bg-slate-900"
        autocomplete="off"
      />
      <button type="submit" class="h-12 rounded-lg bg-[#0A2540] px-5 font-bold text-white hover:bg-[#D9232E]">Cari</button>
    </form>
    <div class="mt-3 flex flex-wrap items-end gap-3">
      <label class="block">
        <span class="mb-1 block text-xs font-bold text-slate-500 dark:text-slate-400">Kategori</span>
        <select id="search-kategori" class="h-10 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700 dark:bg-slate-900">
          <option value="">Semua Kategori</option>
          {CATEGORIES.map((c) => <option value={c.name}>{c.name}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-bold text-slate-500 dark:text-slate-400">Dari tanggal</span>
        <input id="search-dari" type="date" class="h-10 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700 dark:bg-slate-900" />
      </label>
      <label class="block">
        <span class="mb-1 block text-xs font-bold text-slate-500 dark:text-slate-400">Sampai tanggal</span>
        <input id="search-sampai" type="date" class="h-10 rounded-lg border border-slate-300 px-3 text-sm dark:border-slate-700 dark:bg-slate-900" />
      </label>
      <button type="button" id="search-reset" class="h-10 rounded-lg border border-slate-300 px-4 text-sm font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Reset</button>
    </div>
    <p id="search-status" class="mt-4 text-sm text-slate-500 dark:text-slate-400">Ketik kata kunci untuk mencari di seluruh berita ZonaPas.</p>
    <div id="search-results" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
  </div>

  <script is:inline>
    (function () {
      const form = document.getElementById('search-form');
      const input = document.getElementById('search-input');
      const status = document.getElementById('search-status');
      const results = document.getElementById('search-results');
      let index = null;

      async function loadIndex() {
        if (index) return index;
        const res = await fetch('/search-index.json');
        index = await res.json();
        return index;
      }

      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function filterAktif() {
        return {
          kat: document.getElementById('search-kategori').value || '',
          dari: document.getElementById('search-dari').value || '',
          sampai: document.getElementById('search-sampai').value || '',
        };
      }

      async function doSearch(q) {
        q = (q || '').trim();
        var f = filterAktif();
        var adaFilter = !!(f.kat || f.dari || f.sampai);
        if (!q && !adaFilter) {
          status.textContent = 'Ketik kata kunci untuk mencari di seluruh berita ZonaPas.';
          results.innerHTML = '';
          return;
        }
        const data = await loadIndex();
        const needle = q.toLowerCase();
        const hits = data.filter((item) => {
          if (q && (item.title + ' ' + item.summary + ' ' + item.category + ' ' + item.tags.join(' ')).toLowerCase().indexOf(needle) === -1) return false;
          if (f.kat && item.category !== f.kat) return false;
          var tgl = item.tanggal || '';
          if (f.dari && tgl < f.dari) return false;
          if (f.sampai && tgl > f.sampai) return false;
          return true;
        });
        var ket = [];
        if (q) ket.push('"' + q + '"');
        if (f.kat) ket.push('kategori ' + f.kat);
        if (f.dari || f.sampai) ket.push('tanggal ' + (f.dari || '…') + ' s.d. ' + (f.sampai || '…'));
        status.textContent = hits.length + ' hasil' + (ket.length ? ' untuk ' + ket.join(', ') : '') + '.';
        results.innerHTML = hits.map((item) =>
          '<a href="' + item.url + '" class="block overflow-hidden rounded-xl border border-slate-200 bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">' +
          '<img src="' + esc(item.thumb || item.image) + '" alt="" loading="lazy" class="h-auto w-full" onerror="this.onerror=null;this.src=\'/images/cover-default.svg\'" />' +
          '<span class="block p-4"><span class="text-xs font-bold uppercase tracking-wide text-slate-500">' + esc(item.category) + ' • ' + esc(item.date) + '</span>' +
          '<span class="mt-1 block text-base font-bold leading-snug">' + esc(item.title) + '</span>' +
          '<span class="mt-2 block text-sm text-slate-600 dark:text-slate-400">' + esc(item.summary) + '</span></span></a>'
        ).join('');
        if (hits.length === 0) {
          results.innerHTML = '<p class="text-slate-600 dark:text-slate-400">Tidak ada hasil. Coba kata kunci atau filter lain.</p>';
        }
      }

      function simpanParam() {
        const url = new URL(window.location.href);
        const q = input.value.trim();
        const f = filterAktif();
        if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
        if (f.kat) url.searchParams.set('kat', f.kat); else url.searchParams.delete('kat');
        if (f.dari) url.searchParams.set('dari', f.dari); else url.searchParams.delete('dari');
        if (f.sampai) url.searchParams.set('sampai', f.sampai); else url.searchParams.delete('sampai');
        history.replaceState(null, '', url);
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        simpanParam();
        doSearch(input.value);
      });
      ['search-kategori', 'search-dari', 'search-sampai'].forEach((id) => {
        document.getElementById(id).addEventListener('change', () => {
          simpanParam();
          doSearch(input.value);
        });
      });
      document.getElementById('search-reset').addEventListener('click', () => {
        input.value = '';
        document.getElementById('search-kategori').value = '';
        document.getElementById('search-dari').value = '';
        document.getElementById('search-sampai').value = '';
        simpanParam();
        doSearch('');
      });

      const param = new URLSearchParams(window.location.search);
      const initial = param.get('q') || '';
      const katAwal = param.get('kat') || '';
      const dariAwal = param.get('dari') || '';
      const sampaiAwal = param.get('sampai') || '';
      if (initial) input.value = initial;
      if (katAwal) document.getElementById('search-kategori').value = katAwal;
      if (dariAwal) document.getElementById('search-dari').value = dariAwal;
      if (sampaiAwal) document.getElementById('search-sampai').value = sampaiAwal;
      if (initial || katAwal || dariAwal || sampaiAwal) {
        doSearch(initial);
      }
    })();
  </script>
</BaseLayout>
