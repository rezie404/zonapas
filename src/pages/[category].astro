---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { CATEGORIES, SITE } from '../data/site';

export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({ params: { category: cat.slug }, props: { cat } }));
}

const { cat } = Astro.props;
const items = (await getCollection('berita', ({ data }) => data.category === cat.name)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${cat.name} | ${SITE.name}`,
  url: `${SITE.url}/${cat.slug}/`,
  description: cat.description,
  inLanguage: 'id-ID',
};
---

<BaseLayout title={cat.name} description={cat.description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-[1200px] px-4 pt-6">
    <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Beranda</a>
      <span class="mx-1">/</span>
      <span class="font-semibold text-slate-800 dark:text-slate-200">{cat.name}</span>
    </nav>

    <div class="mt-4 border-b-4 pb-3" style={`border-color:${cat.color}`}>
      <h1 class="text-3xl font-black uppercase tracking-tight" style={`color:${cat.color}`}>{cat.name}</h1>
      <p class="mt-1 text-slate-600 dark:text-slate-400">{cat.description}</p>
    </div>

    {items.length === 0 ? (
      <p class="py-10 text-slate-600 dark:text-slate-400">Belum ada berita pada kategori ini.</p>
    ) : (
      <div class="mt-6">
        <NewsCard entry={items[0]} size="large" showCategory={false} />
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.slice(1).map((entry) => (
            <NewsCard entry={entry} size="medium" showCategory={false} />
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
