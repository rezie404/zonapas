---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { SITE, slugify } from '../../data/site';

export async function getStaticPaths() {
  const all = await getCollection('berita');
  const tags = new Map<string, string>();
  for (const e of all) {
    for (const t of e.data.tags) tags.set(slugify(t), t);
  }
  return [...tags.entries()].map(([slug, tag]) => ({ params: { tag: slug }, props: { tag } }));
}

const { tag } = Astro.props;
const items = (await getCollection('berita', ({ data }) => data.tags.includes(tag))).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Tag: ${tag} | ${SITE.name}`,
  url: `${SITE.url}/tag/${slugify(tag)}/`,
  inLanguage: 'id-ID',
};
---

<BaseLayout title={`Tag: ${tag}`} description={`Berita dengan tag ${tag} di ${SITE.name}.`} jsonLd={jsonLd}>
  <div class="mx-auto max-w-[1200px] px-4 pt-6">
    <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:underline">Beranda</a>
      <span class="mx-1">/</span>
      <span class="font-semibold text-slate-800 dark:text-slate-200">Tag: {tag}</span>
    </nav>
    <h1 class="mt-4 border-b-4 border-[#D9232E] pb-3 text-3xl font-black">
      Tag: <span class="text-[#D9232E]">#{tag}</span>
    </h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">{items.length} berita ditemukan.</p>

    {items.length === 0 ? (
      <p class="py-10 text-slate-600 dark:text-slate-400">Belum ada berita dengan tag ini.</p>
    ) : (
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((entry) => (
          <NewsCard entry={entry} size="medium" />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
