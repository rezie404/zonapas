---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ticker from '../components/Ticker.astro';
import NewsCard from '../components/NewsCard.astro';
import { CATEGORIES, SITE, slugify } from '../data/site';

const all = (await getCollection('berita')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Aturan Breaking News: artikel tampil di pita "Berita Terkini" selama
// 2×24 jam SEJAK MASUK PITA (sejak breaking dicentang/disimpan), bukan
// sejak tanggal terbit. Waktu masuk dicatat di frontmatter `breakingSince`
// (ISO); bila tidak ada (artikel lama), fallback ke tanggal terbit.
const BREAKING_MS = 2 * 24 * 60 * 60 * 1000;
function breakingSinceMs(e) {
  const s = e.data.breakingSince ? new Date(e.data.breakingSince).getTime() : e.data.publishDate.getTime();
  return Number.isFinite(s) ? s : 0;
}
function isBreakingActive(e) {
  if (!e.data.breaking) return false;
  const since = breakingSinceMs(e);
  return since > 0 && Date.now() - since < BREAKING_MS;
}
const breaking = all.filter((e) => isBreakingActive(e));
const featured = all.filter((e) => e.data.featured);
const hero = featured[0] ?? all[0];
const heroRest = all.filter((e) => e.id !== hero.id).slice(0, 4);
const latest = all.slice(0, 8);

// Terpopuler: placeholder deterministik — artikel featured + terbaru (belum ada data tampilan pembaca).
const popular = [...featured, ...all.filter((e) => !e.data.featured)].slice(0, 5);

// Trending tags: tag paling sering dipakai
const tagCounts = new Map<string, number>();
for (const e of all) {
  for (const t of e.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const trendingTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);

const byCategory = (name: string) => all.filter((e) => e.data.category === name);

// ZonaPasTV memakai YouTube: ambil ID dari tautan watch / youtu.be /
// Shorts / embed / live, atau ID mentah 11 karakter.
const idYoutube = (tautan: string) => {
  const t = (tautan || '').trim();
  const m = t.match(/(?:v=|youtu\.be\/|shorts\/|embed\/|live\/)([A-Za-z0-9_-]{11})/) || t.match(/^([A-Za-z0-9_-]{11})$/);
  return m ? m[1] : '';
};
const embedYoutube = (id: string) => `https://www.youtube-nocookie.com/embed/${id}?rel=0`;
const thumbYoutube = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;

// ZonaPasTV: video YouTube redaksi, terbaru dulu (tautan tak valid dilewati).
const videos = (await getCollection('video'))
  .filter((v) => idYoutube(v.data.video))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const videoUtama = videos[0];
const formatTanggalVideo = (d: Date) =>
  d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Ticker items={breaking} />

  <div class="mx-auto max-w-[1200px] px-4">
    <div class="grid gap-8 lg:grid-cols-[1fr_320px]">
      <div>
        <!-- Headline utama -->
        <section class="pt-5" aria-label="Headline utama">
          <NewsCard entry={hero} size="large" />
          <div class="mt-4 divide-y divide-slate-200 border-t border-slate-200 dark:divide-slate-800 dark:border-slate-800">
            {heroRest.map((entry) => (
              <NewsCard entry={entry} size="small" />
            ))}
          </div>
        </section>

        <!-- ZonaPasTV -->
        <section class="pt-8" aria-label="ZonaPasTV">
          <div class="mb-4 flex items-center gap-3 border-b-2 border-[#D9232E] pb-2">
            <img src="/images/logo-zonapastv.png" alt="ZonaPasTV" class="h-9 w-auto" />
            <h2 class="sr-only">ZonaPasTV</h2>
          </div>
          {videos.length === 0 ? (
            <p class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-500 dark:border-slate-800 dark:bg-slate-900">
              Belum ada video. Redaksi dapat menambahkan video YouTube lewat Kelola Berita → ZonaPasTV.
            </p>
          ) : (
            <>
              <div id="zonapastv-pemutar" class="relative aspect-video overflow-hidden rounded-2xl bg-black">
                <iframe id="zonapastv-video" src={embedYoutube(idYoutube(videoUtama.data.video))} title={videoUtama.data.title} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen class="h-full w-full border-0" />
                <div class="pointer-events-none absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1.5 shadow-lg">
                  <img src="/images/logo-zonapastv.png" alt="ZonaPasTV" class="h-6 w-auto" />
                </div>
              </div>
              <h3 id="zonapastv-judul" class="mt-3 text-lg font-black leading-snug">{videoUtama.data.title}</h3>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{formatTanggalVideo(videoUtama.data.publishDate)}{videoUtama.data.author ? ` · ${videoUtama.data.author}` : ''}</p>
              <p id="zonapastv-deskripsi" class="mt-1 text-sm text-slate-600 dark:text-slate-300">{videoUtama.data.description}</p>
              <div class="mt-4 grid gap-4 sm:grid-cols-3">
                {videos.map((v) => (
                  <button
                    type="button"
                    data-youtube={idYoutube(v.data.video)}
                    data-judul={v.data.title}
                    data-deskripsi={v.data.description}
                    class={`zonapastv-item group overflow-hidden rounded-xl border text-left dark:border-slate-800 ${v.id === videoUtama.id ? 'border-[#D9232E] ring-2 ring-[#D9232E]' : 'border-slate-200'}`}
                  >
                    <img src={v.data.poster ?? thumbYoutube(idYoutube(v.data.video))} alt={v.data.title} loading="lazy" class="aspect-video w-full object-cover" />
                    <span class="block p-3 text-sm font-bold leading-snug group-hover:text-[#D9232E]">{v.data.title}</span>
                  </button>
                ))}
              </div>
              <script>
                const pemutar = document.getElementById('zonapastv-video') as HTMLIFrameElement | null;
                const judulEl = document.getElementById('zonapastv-judul');
                const deskripsiEl = document.getElementById('zonapastv-deskripsi');
                const wadah = document.getElementById('zonapastv-pemutar');
                document.querySelectorAll('.zonapastv-item').forEach((el) => {
                  el.addEventListener('click', () => {
                    if (!pemutar) return;
                    const btn = el as HTMLElement;
                    const id = btn.dataset.youtube || '';
                    if (!id) return;
                    pemutar.src = 'https://www.youtube-nocookie.com/embed/' + id + '?rel=0&autoplay=1';
                    if (judulEl) judulEl.textContent = btn.dataset.judul || '';
                    if (deskripsiEl) deskripsiEl.textContent = btn.dataset.deskripsi || '';
                    document.querySelectorAll('.zonapastv-item').forEach((x) => x.classList.remove('ring-2', 'ring-[#D9232E]', 'border-[#D9232E]'));
                    btn.classList.add('ring-2', 'ring-[#D9232E]', 'border-[#D9232E]');
                    wadah?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                  });
                });
              </script>
            </>
          )}
        </section>

        <!-- Berita terbaru -->
        <section class="pt-8" aria-label="Berita terbaru">
          <div class="mb-4 flex items-center justify-between border-b-2 border-[#0A2540] pb-2 dark:border-white">
            <h2 class="text-xl font-black uppercase tracking-tight">Berita Terbaru</h2>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {latest.map((entry) => (
              <NewsCard entry={entry} size="medium" />
            ))}
          </div>
        </section>

        <!-- Seksi per kategori -->
        {CATEGORIES.map((cat) => {
          const items = byCategory(cat.name);
          if (items.length === 0) return null;
          const [first, ...rest] = items;
          return (
            <section class="pt-8" aria-label={`Berita ${cat.name}`}>
              <div class="mb-4 flex items-center justify-between border-b-2 pb-2" style={`border-color:${cat.color}`}>
                <h2 class="text-xl font-black uppercase tracking-tight" style={`color:${cat.color}`}>{cat.name}</h2>
                <a href={`/${cat.slug}/`} class="text-sm font-bold text-[#D9232E] hover:underline">Lihat Semua &rarr;</a>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <NewsCard entry={first} size="medium" showCategory={false} />
                <div class="divide-y divide-slate-200 dark:divide-slate-800">
                  {rest.map((entry) => (
                    <NewsCard entry={entry} size="small" showCategory={false} />
                  ))}
                </div>
              </div>
            </section>
          );
        })}
      </div>

      <!-- Sidebar -->
      <aside class="space-y-8 pt-5 lg:pt-5">
        <section aria-label="Terpopuler" class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="border-b-2 border-[#D9232E] pb-2 text-lg font-black uppercase">Terpopuler</h2>
          <ol class="mt-2 divide-y divide-slate-200 dark:divide-slate-800">
            {popular.map((entry, i) => (
              <li class="flex gap-3 py-3">
                <span class="text-3xl font-black leading-none text-[#D9232E]">{i + 1}</span>
                <a href={`/berita/${entry.id.replace(/\.md$/, '')}/`} class="text-sm font-bold leading-snug hover:text-[#D9232E] hover:underline">
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ol>
        </section>

        <section aria-label="Trending Tags" class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="border-b-2 border-[#0A2540] pb-2 text-lg font-black uppercase dark:border-white">Trending Tags</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {trendingTags.map(([tag]) => (
              <a
                href={`/tag/${slugify(tag)}/`}
                class="rounded-full bg-[#0A2540] px-3 py-1.5 text-xs font-bold text-white hover:bg-[#D9232E] dark:bg-slate-700 dark:hover:bg-[#D9232E]"
              >
                #{tag}
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
