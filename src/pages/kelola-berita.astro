        $('f-foto').value = '';
        pendingCover = null;
        const prev = $('f-foto-preview');
        if (a.data.image) { prev.src = imageUrl(a.data.image); prev.classList.remove('hidden'); } else { prev.classList.add('hidden'); prev.src = ''; }
        const cur = $('f-foto-saat-ini');
        cur.textContent = a.data.image ? ('Foto saat ini: ' + a.data.image + ' (biarkan kosong bila tidak diganti)') : '';
        cur.classList.toggle('hidden', !a.data.image);
        $('form-title').textContent = 'Ubah Berita';
        $('btn-save').textContent = 'Simpan Perubahan';
        $('form-section').classList.remove('hidden');
        $('form-section').scrollIntoView({ behavior: 'smooth' });
        tawarkanDraf();
      }
      if (delBtn) {
        if (peran !== 'admin') return;
        const a = articles.find((x) => x.slug === delBtn.getAttribute('data-delete'));
        if (!a) return;
        if (!confirm('Hapus berita "' + (a.data.title || a.slug) + '"? Tindakan ini tidak bisa dibatalkan.')) return;
        try {
          await gh('/contents/' + a.path, {
            method: 'DELETE',
            body: JSON.stringify({ message: 'Hapus berita: ' + (a.data.title || a.slug), sha: a.sha, branch: 'main' }),
          });
          showStatus('Berita "' + (a.data.title || a.slug) + '" dihapus. Situs diperbarui setelah rebuild sekitar 1–2 menit.', true);
          await loadArticles();
        } catch (err) {
          showStatus('Gagal menghapus: ' + err.message, false);
        }
      }
      // Hapus video ZonaPasTV (khusus Administrator, login GitHub):
      // hapus data .md dan posternya bila masih ada. Video di YouTube
      // TIDAK ikut terhapus.
      const delVideoBtn = e.target.closest('[data-video-hapus]');
      if (delVideoBtn) {
        if (peran !== 'admin') return;
        const v = videos.find((x) => x.slug === delVideoBtn.getAttribute('data-video-hapus'));
        if (!v) return;
        if (!confirm('Hapus video "' + (v.data.title || v.slug) + '" dari ZonaPasTV? Video di YouTube tidak ikut terhapus. Tindakan ini tidak bisa dibatalkan.')) return;
        try {
          await gh('/contents/' + v.path, {
            method: 'DELETE',
            body: JSON.stringify({ message: 'Hapus video ZonaPasTV: ' + (v.data.title || v.slug), sha: v.sha, branch: 'main' }),
          });
          const hapusFileRepo = async (rel) => {
            try {
              const f = await gh('/contents/public/' + rel + '?ref=main');
              if (f && f.sha) {
                await gh('/contents/public/' + rel, {
                  method: 'DELETE',
                  body: JSON.stringify({ message: 'Hapus file ZonaPasTV: ' + rel, sha: f.sha, branch: 'main' }),
                });
              }
            } catch (e) { console.warn('File ZonaPasTV tidak terhapus: ' + rel, e); }
          };
          const posterRel = String(v.data.poster || '').replace(/^\//, '');
          if (posterRel.startsWith('images/poster-')) await hapusFileRepo(posterRel);
          showStatus('Video "' + (v.data.title || v.slug) + '" dihapus. Situs diperbarui setelah rebuild sekitar 1–2 menit.', true);
          await muatVideo();
        } catch (err) {
          showStatus('Gagal menghapus video: ' + err.message, false);
        }
      }
    });

    on('q', 'input', renderLists);
    on('filter-category', 'change', renderLists);
    on('btn-refresh', 'click', () => {
      showStatus('Memuat ulang daftar berita…', true);
      loadArticles().catch((err) => showStatus('Gagal memuat daftar berita: ' + err.message, false));
    });
    on('btn-tv-refresh', 'click', () => {
      showStatus('Memuat ulang daftar video…', true);
      muatVideo().catch((err) => showStatus('Gagal memuat daftar video: ' + err.message, false));
    });

    // ---------- Tambah video YouTube ZonaPasTV ----------
    on('form-video', 'submit', async (e) => {
      e.preventDefault();
      if (peran !== 'admin') return;
      const btn = $('btn-tv-simpan');
      const judul = ($('v-judul').value || '').trim();
      const deskripsi = ($('v-deskripsi').value || '').trim();
      const tautan = ($('v-youtube').value || '').trim();
      const idYt = idYoutube(tautan);
      if (!judul) { showStatus('Judul video wajib diisi.', false); return; }
      if (!idYt) { showStatus('Tautan YouTube tidak valid. Tempel tautan video YouTube (contoh: https://www.youtube.com/watch?v=…).', false); return; }
      btn.disabled = true;
      btn.textContent = 'Menambahkan…';
      try {
        const slugDasar = slugify(judul);
        const stamp = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 12);
        let poster = '';
        const posterFile = $('v-poster').files && $('v-poster').files[0];
        if (posterFile) {
          const posterName = 'poster-' + slugDasar + '-' + stamp + '.jpg';
          const dataUrl = await resizeImage(posterFile);
          const posterB64 = dataUrl.split(',')[1];
          if (token) {
            await gh('/contents/public/images/' + encodeURIComponent(posterName), {
              method: 'PUT',
              body: JSON.stringify({ message: 'Unggah poster ZonaPasTV: ' + posterName, content: posterB64, branch: 'main' }),
            });
          } else {
            await githubTulis('public/images/' + posterName, posterB64, 'Unggah poster ZonaPasTV: ' + posterName);
          }
          poster = '/images/' + posterName;
        }
        const tanggal = new Date().toISOString().slice(0, 10);
        const md = buildVideoMarkdown({
          title: judul,
          description: deskripsi,
          video: 'https://www.youtube.com/watch?v=' + idYt,
          poster,
          publishDate: tanggal,
          author: (identitas && identitas.nama) || 'Rezie',
        });
        // Tulis data video; slug bentrok (422) -> coba slug-2, slug-3.
        let finalSlug = slugDasar;
        let percobaan = 0;
        while (true) {
          try {
            const isi = b64encodeUnicode(md);
            if (token) {
              await gh('/contents/src/content/video/' + encodeURIComponent(finalSlug) + '.md', {
                method: 'PUT',
                body: JSON.stringify({ message: 'Tambah video ZonaPasTV: ' + judul, content: isi, branch: 'main' }),
              });
            } else {
              await githubTulis('src/content/video/' + finalSlug + '.md', isi, 'Tambah video ZonaPasTV: ' + judul);
            }
            break;
          } catch (err) {
            if (err.status === 422 && percobaan < 2) { percobaan++; finalSlug = slugDasar + '-' + (percobaan + 1); continue; }
            throw err;
          }
        }
        showStatus('Video "' + judul + '" ditambahkan ke ZonaPasTV. Tayang di beranda setelah rebuild sekitar 1–2 menit.', true);
        $('form-video').reset();
        await muatVideo();
      } catch (err) {
        showStatus('Gagal menambahkan video: ' + err.message, false);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Tambah Video';
      }
    });

    // ---------- Pulihkan sesi: cookie dulu, lalu token GitHub ----------
    // Sesi cookie (Google maupun GitHub yang sudah ditukar) berlaku di
    // semua tab dan tidak hilang saat pindah laman — inilah yang membuat
    // login bertahan. Token GitHub di tab ini hanya jadi cadangan: bila
    // cookie belum ada, token ditukar jadi cookie dulu (github-sesi).
    async function cobaMasukCookie() {
      try {
        const me = await workerPost('/redaksi/api/me', {}, { tanpaToken: true });
        if (me && me.ok && me.user && me.user.role) {
          terapkanIdentitas(me.user, me.user.source === 'github' ? 'github' : 'google');
          let ghUser = null;
          if (token) { try { ghUser = await ghApi('https://api.github.com/user'); } catch (e) {} }
          setLoggedIn(ghUser || { login: me.user.name || me.user.email || 'Google' });
          await muatAntrean();
          await muatPengguna();
          return true;
        }
      } catch (err) {
        if (err && err.status === 403) { tampilkanAksesDitolak(err.message); return true; }
      }
      return false;
    }
    (async () => {
      const tgl = $('f-tanggal');
      if (tgl) tgl.value = todayISO();
      if (await cobaMasukCookie()) return;
      if (token) {
        // Tukarkan token GitHub jadi sesi cookie supaya login bertahan di
        // semua tab; bila penukaran gagal, token tetap bisa dipakai
        // langsung di tab ini.
        try { await workerPost('/redaksi/api/github-sesi', {}); } catch (e) {}
        if (await cobaMasukCookie()) return;
        try {
          const me = await workerPost('/redaksi/api/me', {});
          if (!me || !me.ok || !me.user || !me.user.role) throw Object.assign(new Error('Peran tidak ditemukan.'), { status: 401 });
          terapkanIdentitas(me.user, 'github');
          let ghUser = null;
          try { ghUser = await ghApi('https://api.github.com/user'); } catch (e) {}
          setLoggedIn(ghUser || { login: me.user.login || me.user.name || 'GitHub' });
          await muatAntrean();
          await muatPengguna();
        } catch (err) {
          if (err && err.status === 403) { tampilkanAksesDitolak(err.message); return; }
          if (err && err.status === 401) { setLoggedOut('Sesi GitHub sudah berakhir. Silakan masuk lagi.'); return; }
          // Worker tidak bisa dihubungi / peran tidak bisa dipastikan:
          // JANGAN beri akses dari klien tanpa sandaran server. Tampilkan
          // panel login dengan pesan galat (token tetap tersimpan — muat
          // ulang halaman akan mencoba lagi).
          appEl.classList.add('hidden');
          $('form-section').classList.add('hidden');
          loginBox.classList.remove('hidden');
          showStatus('Server peran (Worker Redaksi) tidak bisa dihubungi. Periksa koneksi lalu muat ulang halaman untuk mencoba lagi.', false);
        }
        return;
      }
      // Belum login — biarkan panel login tampil.
    })();
  </script>
</BaseLayout>
