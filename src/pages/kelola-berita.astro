    function buildMarkdown(d) {
      const q = (v) => JSON.stringify(String(v ?? ''));
      const tags = (d.tags || []).map((t) => JSON.stringify(t)).join(', ');
      const lines = [
        '---',
        'title: ' + q(d.title),
        'summary: ' + q(d.summary),
        'category: ' + q(d.category),
        'tags: [' + tags + ']',
        'author: ' + q(d.author),
        'publishDate: ' + d.publishDate,
        'image: ' + q(d.image),
        'imageCaption: ' + q(d.imageCaption),
        'featured: ' + (d.featured ? 'true' : 'false'),
        'breaking: ' + (d.breaking ? 'true' : 'false'),
      ];
      // Waktu masuk pita Breaking News (ISO): hanya ditulis bila breaking
      // aktif; dipakai aturan kedaluwarsa 2 hari (lihat index.astro).
      if (d.breaking && d.breakingSince) lines.push('breakingSince: ' + q(d.breakingSince));
      if (d.upt) lines.push('upt: ' + q(d.upt));
      // Foto profil penulis (Google) — hanya untuk Penulis/Penyunting;
      // artikel Administrator tidak membawa field ini.
      if (d.authorImage) lines.push('authorImage: ' + q(d.authorImage));
      lines.push('source: "zonapas"', '---', '', d.body.trim() + '', '');
      return lines.join('\n');
    }

    async function uploadCover(slug) {
      if (!pendingCover) return null;
      const stamp = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 12);
      const filename = 'cover-' + slug + '-' + stamp + '.jpg';
      const base64 = pendingCover.dataUrl.split(',')[1];
      if (token) {
        await gh('/contents/public/images/' + encodeURIComponent(filename), {
          method: 'PUT',
          body: JSON.stringify({ message: 'Unggah foto sampul: ' + filename, content: base64, branch: 'main' }),
        });
      } else {
        // Masuk lewat Google: tidak ada token GitHub di browser — tulis lewat Worker.
        await githubTulis('public/images/' + filename, base64, 'Unggah foto sampul: ' + filename);
      }
      return '/images/' + filename;
    }

    // ---------- Cek typo sebelum simpan (peringatan, bukan penghalang) ----------
    // Kamus dimuat dari /kamus-id.json (~45 ribu kata). Bila modul atau
    // kamus gagal dimuat, penyimpanan tetap jalan tanpa pemeriksaan.
    function tanyaTypo(temuan) {
      return new Promise((resolve) => {
        const modal = $('modal-typo');
        const daftar = $('typo-daftar');
        if (!modal || !daftar) { resolve(true); return; }
        $('typo-jumlah').textContent = String(temuan.length);
        daftar.innerHTML = temuan.map((t) =>
          '<li class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm dark:border-amber-900 dark:bg-amber-900/30">' +
          '<span class="font-bold text-amber-800 dark:text-amber-200">' + esc(t.kata) + '</span> <span class="text-slate-500">(' + esc(t.bagian) + ')</span><br>' +
          '<span class="text-xs text-slate-600 dark:text-slate-300">' + esc(t.konteks) + '</span></li>'
        ).join('');
        const tutup = (hasil) => {
          modal.classList.add('hidden');
          $('btn-typo-perbaiki').onclick = null;
          $('btn-typo-simpan').onclick = null;
          modal.onclick = null;
          resolve(hasil);
        };
        $('btn-typo-perbaiki').onclick = () => tutup(false);
        $('btn-typo-simpan').onclick = () => tutup(true);
        modal.onclick = (e) => { if (e.target === modal) tutup(false); };
        modal.classList.remove('hidden');
      });
    }

    async function cekTypoSebelumSimpan() {
      const cek = window.__cekTypo;
      if (!cek) return true;
      let kamus;
      try {
        kamus = await cek.muatKamus();
      } catch (err) {
        return true;
      }
      const judul = ($('f-judul').value || '').trim();
      const isi = ($('f-isi').value || '').trim();
      const temuan = cek.cekTypoGabungan(judul, isi, kamus);
      if (!temuan.length) {
        showStatus('0 typo — tidak ada kesalahan penulisan. Menyimpan…', true);
        await new Promise((r) => setTimeout(r, 900));
        return true;
      }
      return await tanyaTypo(temuan);
    }

    on('form-berita', 'submit', async (e) => {
      e.preventDefault();
      const btn = $('btn-save');
      btn.disabled = true;
      btn.textContent = 'Menyimpan…';
      try {
        // Cek typo dulu; "Perbaiki dulu" membatalkan penyimpanan.
        if (!(await cekTypoSebelumSimpan())) return;
        // Mode edit antrean: simpan selalu lewat Worker, bukan GitHub langsung.
        if (editingAntrean) {
          await simpanAntrean(editingAntrean.id, false);
          return;
        }
        // Peran tanpa hak terbit langsung (mis. Enter di formulir):
        // alihkan ke antrean, jangan pernah PUT GitHub.
        if (!bisaTerbitLangsung()) {
          await simpanAntrean(null, true);
          return;
        }
        const d = kumpulkanDataForm();
        const title = d.title;
        const slug = editing ? editing.slug : slugify(title);
        let image = editing ? editing.image : '';
        if (pendingCover) {
          const uploaded = await uploadCover(slug);
          if (uploaded) image = uploaded;
        }
        if (!image) throw new Error('Foto sampul wajib diunggah.');
        const data = { ...d, image };
        let finalSlug = slug;
        let sha = editing ? editing.sha : undefined;
        if (token && !editing) {
          let n = 2;
          while (true) {
            try {
              const existing = await gh('/contents/src/content/berita/' + encodeURIComponent(finalSlug) + '.md?ref=main');
              if (existing && existing.sha) { finalSlug = slug + '-' + n; n++; continue; }
              break;
            } catch (err) { break; }
          }
        }
        const md = buildMarkdown(data);
        const pesanSimpan = (editing ? 'Ubah berita: ' : 'Tambah berita: ') + title;
        if (token) {
          const payload = { message: pesanSimpan, content: b64encodeUnicode(md), branch: 'main' };
          if (sha) payload.sha = sha;
          await gh('/contents/src/content/berita/' + encodeURIComponent(finalSlug) + '.md', { method: 'PUT', body: JSON.stringify(payload) });
        } else {
          // Masuk lewat Google: tulis lewat Worker. 422 = slug sudah
          // dipakai (cek di atas dilewati tanpa token) — coba slug
          // berikutnya, maks. 3 percobaan.
          let percobaan = 0;
          while (true) {
            try {
              await githubTulis('src/content/berita/' + finalSlug + '.md', b64encodeUnicode(md), pesanSimpan, sha);
              break;
            } catch (err) {
              if (!editing && err.status === 422 && percobaan < 2) { percobaan++; finalSlug = slug + '-' + (percobaan + 1); continue; }
              throw err;
            }
          }
        }
        showStatus('Berita "' + title + '" tersimpan. Artikel tayang di situs setelah rebuild sekitar 1–2 menit: ' + SITE_URL + '/berita/' + finalSlug + '/', true);
        hapusDraf();
        resetForm();
        $('form-section').classList.add('hidden');
        await loadArticles();
      } catch (err) {
        // Akun GitHub tanpa akses tulis (bukan kolaborator): arahkan ke antrean.
        if (err && (err.status === 403 || err.status === 404)) {
          showStatus('Akun GitHub Anda tidak punya akses tulis ke repo — kirim berita lewat Antrean untuk persetujuan.', false);
          const ba = $('btn-antrean');
          if (ba) ba.classList.remove('hidden');
        } else {
          showStatus('Gagal menyimpan: ' + err.message, false);
        }
      } finally {
        btn.disabled = false;
        btn.textContent = 'Simpan Berita';
      }
    });


