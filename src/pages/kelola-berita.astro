  <style>
    #crop-stage { touch-action: none; }
    #crop-box { touch-action: none; cursor: move; }
    .crop-handle { position: absolute; width: 28px; height: 28px; background: #fff; border: 2px solid #0A2540; border-radius: 6px; touch-action: none; }
    .crop-rasio-aktif { background: #0A2540 !important; color: #fff !important; border-color: #0A2540 !important; }
    .crop-blur-daerah { position: absolute; border: 2px dashed #fff; border-radius: 6px; background: rgba(255,255,255,0.08); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
    .crop-blur-aktif { background: #0A2540 !important; color: #fff !important; border-color: #0A2540 !important; }
  </style>

  <!-- Pemeriksa typo (public/cek-typo.mjs) — dimuat sebagai modul terpisah
       supaya logikanya bisa diuji lewat node; diekspos ke window.__cekTypo. -->
  <script type="module" src="/cek-typo.mjs"></script>
  <script>
    const GH_API = 'https://api.github.com/repos/rezie404/zonapas';
    const OAUTH_AUTH_URL = 'https://oauth.zonapas.web.id/auth';
    const OAUTH_ORIGIN = 'https://oauth.zonapas.web.id';
    const SITE_URL = 'https://zonapas.web.id';
    const MAX_COVER_BYTES = 2 * 1024 * 1024;

    // Data pulau JSON dibaca secara defensif: bila isinya tidak terbaca,
    // pakai default kosong supaya satu kegagalan data tidak pernah
    // mematikan seluruh script halaman (dan tombol login).
    let kelolaData = {};
    try {
      const raw = document.getElementById('kelola-data');
      kelolaData = raw && raw.textContent ? JSON.parse(raw.textContent) : {};
    } catch (e) {
      console.warn('Data kelola tidak terbaca, memakai default.', e);
    }
    const CATEGORY_COLORS = kelolaData.categoryColors || {};
    const AUTHORS_MAP = kelolaData.authors || {};

    const $ = (id) => document.getElementById(id);
    // Pasang listener hanya bila elemennya ada: satu elemen yang hilang
    // tidak boleh mematikan seluruh script halaman.
    function on(id, event, fn) {
      const el = $(id);
      if (el) el.addEventListener(event, fn);
    }
    const statusEl = $('status');
    const loginBox = $('login-box');
    const appEl = $('app');

    let token = null;
    try { token = sessionStorage.getItem('zonapas-kelola-token') || null; } catch (e) {}
    let articles = [];
    let editing = null; // { path, sha, slug, image }
    let pendingCover = null; // { dataUrl, name }
    // --- Peran (login terpadu) ---
    let peran = null; // 'admin' | 'penyunting' | 'penulis' | null
    let sumberLogin = null; // 'github' | 'google' | null
    let identitas = null; // { nama, peran, email, login, picture }
    let antrean = [];
    let editingAntrean = null; // { id, coverAda, breakingSince }
    let pendingGambarIsi = []; // antrean: { filename, dataUrl } — ditahan, diunggah saat simpan
    let fotoIsi = null; // foto badan narasi terpisah: { baris, nama } — TIDAK tampil di kotak narasi

    function esc(s) {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function showStatus(msg, ok) {
      statusEl.textContent = msg;
      statusEl.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-900', 'bg-red-100', 'text-red-900', 'dark:bg-emerald-900/40', 'dark:text-emerald-100', 'dark:bg-red-900/40', 'dark:text-red-100');
      statusEl.classList.add(ok ? 'bg-emerald-100' : 'bg-red-100', ok ? 'text-emerald-900' : 'text-red-900', ok ? 'dark:bg-emerald-900/40' : 'dark:bg-red-900/40', ok ? 'dark:text-emerald-100' : 'dark:text-red-100');
      statusEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function slugify(text) {
      return String(text).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'berita';
    }

    function formatDateShort(iso) {
      const d = new Date(iso + 'T00:00:00');
      if (isNaN(d)) return iso;
      return new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
    }

    function todayISO() {
      const d = new Date();
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function b64encodeUnicode(str) {
      return btoa(unescape(encodeURIComponent(str)));
    }

    function b64decodeUnicode(b64) {
      return decodeURIComponent(escape(atob(b64.replace(/\s/g, ''))));
    }

    function parseFrontmatter(text) {
      const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
      if (!m) return { data: {}, body: text };
      const data = {};
      const lines = m[1].split(/\r?\n/);
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        const idx = line.indexOf(':');
        if (idx === -1) continue;
        const key = line.slice(0, idx).trim();
        let val = line.slice(idx + 1).trim();
        if (!key) continue;
        // Skalar blok YAML (mis. ringkasan Decap "summary: >-"): baris-baris
        // terindentasi berikutnya adalah isi nilai, bukan kunci baru. Tanpa
        // ini, "summary: >-" tersimpan harfiah dan isi ringkasan hilang.
        if (val === '>-' || val === '>' || val === '|-' || val === '|') {
          const folded = val.charAt(0) === '>';
          const strip = val.charAt(1) === '-';
          const parts = [];
          let j = i + 1;
          while (j < lines.length && (lines[j].trim() === '' || /^[ \t]/.test(lines[j]))) {
            parts.push(lines[j]);
            j++;
          }
          while (parts.length && parts[parts.length - 1].trim() === '') parts.pop();
          if (folded) {
            // Terlipat: baris isi digabung dengan spasi; baris kosong
            // menjadi pemisah paragraf (newline).
            let out = '';
            let afterBlank = false;
            for (const p of parts) {
              const t = p.trim();
              if (t === '') { out += '\n'; afterBlank = true; continue; }
              if (out !== '' && !afterBlank && !out.endsWith('\n')) out += ' ';
              out += t;
              afterBlank = false;
            }
            val = strip ? out.replace(/\n+$/, '') : (out === '' ? '' : out.replace(/\n*$/, '\n'));
          } else {
            // Literal: baris isi digabung dengan newline.
            val = parts.map((p) => p.trim()).join('\n');
            if (!strip && val !== '') val += '\n';
          }
          data[key] = val;
          i = j - 1;
          continue;
        }
        if (val.startsWith('[') && val.endsWith(']')) {
          try { data[key] = JSON.parse(val); continue; } catch (e) {}
        }
        if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
          try { data[key] = JSON.parse(val); continue; } catch (e) { val = val.slice(1, -1); }
        }
        if (val === 'true') { data[key] = true; continue; }
        if (val === 'false') { data[key] = false; continue; }
        data[key] = val;
      }
      return { data, body: m[2] || '' };
    }

    function sourceBadge(source) {
      if (source === 'jurnalpas') return '<span class="ml-2 rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-bold text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200">JurnalPAS</span>';
      if (source === 'zonapas') return '<span class="ml-2 rounded-full bg-[#0A2540] px-2 py-0.5 text-[11px] font-bold text-white">Artikel ZonaPas</span>';
      return '<span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-900/50 dark:text-amber-200">Artikel Contoh</span>';
    }

    function catLabel(cat) {
      const color = CATEGORY_COLORS[cat] || '#0A2540';
      return '<span class="text-xs font-bold uppercase tracking-wide" style="color:' + esc(color) + '">' + esc(cat) + '</span>';
    }

    function imageUrl(img) {
      if (!img) return '/images/cover-default.svg';
      if (img.startsWith('http')) return img;
      if (img.startsWith('/')) return SITE_URL + img;
      return SITE_URL + '/' + img;
    }

    // ---------- GitHub API ----------
    async function gh(path, options) {
      const res = await fetch(GH_API + path, {
        ...(options || {}),
        headers: {
          ...(token ? { Authorization: 'Bearer ' + token } : {}),
          Accept: 'application/vnd.github+json',
          'Content-Type': 'application/json',
          ...((options && options.headers) || {}),
        },
      });
      let data = null;
      try { data = await res.json(); } catch (e) {}
      if (!res.ok) {
        const msg = (data && data.message) || ('GitHub mengembalikan status ' + res.status);
        const err = new Error(msg);
        err.status = res.status;
        throw err;
      }
      return data;
    }

    async function ghApi(url, options) {
      const res = await fetch(url, {
        ...(options || {}),
        headers: {
          ...(token ? { Authorization: 'Bearer ' + token } : {}),
          Accept: 'application/vnd.github+json',
          'Content-Type': 'application/json',
          ...((options && options.headers) || {}),
        },
      });
      let data = null;
      try { data = await res.json(); } catch (e) {}
      if (!res.ok) {
        const msg = (data && data.message) || ('GitHub mengembalikan status ' + res.status);
        const err = new Error(msg);
        err.status = res.status;
        throw err;
      }
      return data;
    }

    // ---------- Peran & Worker Redaksi ----------
    // Semua fetch Worker memakai credentials default (cookie same-origin)
    // + header X-GitHub-Token bila login GitHub; POST juga membawa
    // github_token di body sebagai auth alternatif. Token TIDAK PERNAH
    // ditulis ke log/DOM.
    const ROLE_LABEL = { admin: 'Administrator', penyunting: 'Penyunting', penulis: 'Penulis', pembaca: 'Pembaca' };

    async function workerApi(path, options) {
      const opts = options || {};
      const headers = { 'Content-Type': 'application/json' };
      if (token) headers['X-GitHub-Token'] = token;
      const res = await fetch(path, {
        ...opts,
        credentials: 'same-origin',
        headers: { ...headers, ...(opts.headers || {}) },
      });
      let data = null;
      try { data = await res.json(); } catch (e) {}
      if (!res.ok) {
        const msg = (data && (data.error || data.message)) || ('Worker mengembalikan status ' + res.status);
        const err = new Error(msg);
        err.status = res.status;
        throw err;
      }
      return data || {};
    }

    async function workerPost(path, body, opts) {
      const payload = { ...(body || {}) };
      if (token && !(opts && opts.tanpaToken)) payload.github_token = token;
      return workerApi(path, { method: 'POST', body: JSON.stringify(payload) });
    }

    async function workerGet(path) {
      return workerApi(path, { method: 'GET' });
    }

    // Tulis file ke repo lewat Worker — dipakai bila TIDAK ADA token GitHub
    // di browser (Administrator yang masuk lewat Google). Worker menulis
    // dengan GITHUB_TOKEN miliknya; jalurnya dibatasi di server.
    async function githubTulis(path, content, message, sha) {
      const payload = { path, content, message };
      if (sha) payload.sha = sha;
      const res = await workerPost('/redaksi/api/github-tulis', payload);
      if (!res || res.ok !== true) {
        const err = new Error((res && res.error) || 'Worker gagal menulis file.');
        err.status = (res && res.status) || 0;
        throw err;
      }
      return res;
    }

    function labelPeran(r) { return ROLE_LABEL[r] || r || '-'; }

    function terapkanIdentitas(user, sumber) {
      sumberLogin = sumber;
      peran = user.role || null;
      identitas = {
        nama: user.name || user.login || user.email || (sumber === 'github' ? 'GitHub' : 'Google'),
        peran: user.role || null,
        email: user.email || '',
        login: user.login || '',
        picture: user.picture || '',
      };
    }

    function bisaTerbitLangsung() {
      // Login GitHub SELALU admin (rezie404) — tidak ada peran lain via GitHub.
      return peran === 'admin';
    }

    // Jalur antrean aktif: edit antrean, penulis, atau penyunting
    // (penyunting hanya lewat Google).
    function jalurAntreanAktif() {
      if (editingAntrean) return true;
      if (peran === 'penulis') return true;
      if (peran === 'penyunting') return true;
      return false;
    }

    function terapkanPeran() {
      const btnSave = $('btn-save');
      const btnAntrean = $('btn-antrean');
      if (btnSave) btnSave.classList.toggle('hidden', !bisaTerbitLangsung());
      if (btnAntrean) {
        // admin: hanya "Simpan Berita"; penyunting + penulis: hanya antrean.
        const tampilAntrean = peran === 'penulis' || peran === 'penyunting';
        btnAntrean.classList.toggle('hidden', !tampilAntrean);
        btnAntrean.textContent = peran === 'penulis' ? 'Kirim untuk Persetujuan' : 'Kirim ke Antrean';
      }
      const antreanSection = $('antrean-section');
      if (antreanSection) antreanSection.classList.toggle('hidden', !(peran === 'admin' || peran === 'penyunting' || peran === 'penulis'));
      const moderasiSection = $('moderasi-section');
      const bisaModerasi = peran === 'admin' || peran === 'penyunting';
      if (moderasiSection) moderasiSection.classList.toggle('hidden', !bisaModerasi);
      if (bisaModerasi) muatModerasi();
      const penggunaSection = $('pengguna-section');
      if (penggunaSection) penggunaSection.classList.toggle('hidden', peran !== 'admin');
      // ZonaPasTV: unggah & hapus video hanya Administrator.
      const tvSection = $('zonapastv-section');
      if (tvSection) tvSection.classList.toggle('hidden', peran !== 'admin');
      if (peran === 'admin') muatVideo();
      renderLists();
      terapkanPenulis();
    }

    // Nama penulis: Penulis/Penyunting memakai nama lengkap dari profil Gmail
    // (tidak bisa diubah); Administrator bebas, default "Rezie". Bila
    // Penyunting sedang mengedit berita milik Penulis lain, nama penulis tetap
    // milik penulis aslinya.
    function terapkanPenulis() {
      const f = $('f-penulis'); if (!f) return;
      const hint = $('f-penulis-hint');
      // Nama penulis dibedakan menurut CARA MASUK, bukan peran: semua yang
      // masuk lewat Google (Penulis, Penyunting, MAUPUN Administrator)
      // memakai nama lengkap Gmail dan tidak bisa mengubahnya; hanya
      // Administrator yang masuk lewat GitHub yang bebas mengganti nama.
      if (sumberLogin !== 'google') {
        f.readOnly = false;
        if (hint) hint.classList.add('hidden');
        return;
      }
      const namaSaya = (identitas && identitas.nama) || '';
      const nilai = (f.value || '').trim();
      const sedangEdit = !!(editing || editingAntrean);
      if (sedangEdit && nilai && nilai !== namaSaya) {
        // sedang mengedit berita orang lain: biarkan nama penulis aslinya
      } else if (namaSaya) {
        f.value = namaSaya;
      }
      f.readOnly = true;
      if (hint) hint.classList.remove('hidden');
    }

    // pesan: error dari Worker (mis. 403 GitHub non-admin) — bila ada,
    // tampilkan apa adanya; bila tidak ada (mis. jalur Google tanpa pesan
    // Worker), biarkan teks baku di panel.
    function tampilkanAksesDitolak(pesan) {
      peran = null; sumberLogin = null; identitas = null;
      loginBox.classList.add('hidden');
      appEl.classList.add('hidden');
      const panel = $('akses-ditolak');
      if (panel) panel.classList.remove('hidden');
      const teks = $('akses-ditolak-pesan');
      if (teks && pesan && String(pesan).indexOf('Worker mengembalikan status') !== 0) {
        teks.textContent = pesan;
      }
    }

    // ---------- Antrean ----------
    function statusAntreanLabel(s) {
      return { menunggu: 'Menunggu', draf: 'Draf', disetujui: 'Disetujui', ditolak: 'Ditolak', terbit: 'Terbit' }[s] || s || '-';
    }

    async function muatAntrean() {
      if (!peran) return;
      try {
        const res = await workerGet('/redaksi/api/antrean');
        antrean = (res && res.articles) || [];
        renderAntrean();
      } catch (err) {
        const el = $('antrean-list');
        if (el) el.innerHTML = '<p class="text-sm text-red-600">Gagal memuat antrean: ' + esc(err.message) + '</p>';
      }
    }

    function renderAntrean() {
      const el = $('antrean-list');
      if (!el) return;
      // Lencana: jumlah berita yang menunggu persetujuan.
      const badge = document.querySelector('[data-badge-antrean]');
      if (badge) {
        const n = antrean.filter((a) => a.status === 'menunggu').length;
        badge.textContent = String(n);
        badge.classList.toggle('hidden', n === 0);
      }
      if (!antrean.length) { el.innerHTML = '<p class="text-sm text-slate-500">Antrean kosong.</p>'; return; }
      const approver = peran === 'admin' || peran === 'penyunting';
      el.innerHTML = antrean.map((a) => {
        const milikSaya = !!(identitas && ((a.author_email && (a.author_email === identitas.email || a.author_email === identitas.login)) || (a.author && identitas.nama && a.author === identitas.nama)));
        const bisaEdit = approver || (peran === 'penulis' && milikSaya && (a.status === 'draf' || a.status === 'ditolak'));
        const bisaSetujui = approver && a.status === 'menunggu';
        const bisaUlang = approver && a.status === 'disetujui' && !!a.publish_error;
        let h = '<article class="rounded-xl border border-slate-200 p-4 dark:border-slate-800">' +
          '<div class="flex flex-wrap items-start justify-between gap-2"><h3 class="text-base font-bold leading-snug">' + esc(a.title || '(tanpa judul)') + '</h3>' +
          '<span class="shrink-0 rounded-full bg-[#FACC15] px-2.5 py-1 text-[11px] font-bold text-[#0A2540]">' + esc(statusAntreanLabel(a.status)) + '</span></div>' +
          '<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">' + esc([a.author, a.category, a.publish_date].filter(Boolean).join(' · ')) + '</p>';
        if (a.summary) h += '<p class="mt-2 text-sm text-slate-600 dark:text-slate-300">' + esc(a.summary) + '</p>';
        if (a.rejection_note) h += '<p class="mt-2 rounded-lg bg-red-100 px-3 py-2 text-sm text-red-900 dark:bg-red-900/40 dark:text-red-100">Catatan penolakan: ' + esc(a.rejection_note) + '</p>';
        if (a.publish_error) h += '<p class="mt-2 rounded-lg bg-amber-100 px-3 py-2 text-sm text-amber-900 dark:bg-amber-900/40 dark:text-amber-100">Gagal terbit: ' + esc(a.publish_error) + '</p>';
        h += '<div class="mt-3 flex flex-wrap gap-2">';
        h += '<button type="button" data-antrean-lihat="' + esc(a.id) + '" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Lihat</button>';
        if (bisaEdit) h += '<button type="button" data-antrean-edit="' + esc(a.id) + '" class="rounded-lg border border-[#0A2540] px-3 py-1.5 text-xs font-bold text-[#0A2540] hover:bg-[#0A2540] hover:text-white dark:text-white">Edit</button>';
        if (bisaSetujui) h += '<button type="button" data-antrean-setujui="' + esc(a.id) + '" class="rounded-lg bg-[#0A2540] px-3 py-1.5 text-xs font-bold text-white hover:bg-[#123a66]">Setujui &amp; Terbitkan</button>';
        if (bisaSetujui) h += '<button type="button" data-antrean-tolak="' + esc(a.id) + '" class="rounded-lg border border-[#D9232E] px-3 py-1.5 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Tolak</button>';
        if (bisaUlang) h += '<button type="button" data-antrean-ulang="' + esc(a.id) + '" class="rounded-lg bg-[#FACC15] px-3 py-1.5 text-xs font-bold text-[#0A2540] hover:bg-[#EAB308]">Terbitkan Ulang</button>';
        h += '</div></article>';
        return h;
      }).join('');
    }

    function tutupAntrean() {
      const modal = $('modal-antrean');
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // ---------- Moderasi Komentar (Penyunting + Administrator) ----------
    async function muatModerasi() {
      if (!(peran === 'admin' || peran === 'penyunting')) return;
      try {
        const res = await workerGet('/redaksi/api/komentar/antrean');
        renderModerasi((res && res.menunggu) || [], (res && res.terbit) || []);
      } catch (err) {
        const el = $('moderasi-menunggu');
        if (el) el.innerHTML = '<p class="text-sm text-red-600">Gagal memuat komentar: ' + esc(err.message) + '</p>';
      }
    }

    function kartuKomentar(k, aksi) {
      const waktu = k.created_at ? new Date(k.created_at).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
      let h = '<article class="rounded-xl border border-slate-200 p-4 dark:border-slate-800">' +
        '<div class="flex flex-wrap items-start justify-between gap-2"><h3 class="text-base font-bold leading-snug">' + esc(k.name || 'Pembaca') + '</h3>' +
        '<a href="/berita/' + esc(k.slug) + '/" target="_blank" rel="noopener" class="shrink-0 text-xs font-bold text-[#0A2540] hover:underline dark:text-white">Lihat artikel &rarr;</a></div>' +
        '<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">' + esc(waktu) + '</p>' +
        '<p class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-200">' + esc(k.body || '') + '</p>' +
        '<div class="mt-3 flex flex-wrap gap-2">';
      if (aksi === 'menunggu') {
        h += '<button type="button" data-moderasi-setujui="' + esc(k.id) + '" class="rounded-lg bg-[#0A2540] px-3 py-1.5 text-xs font-bold text-white hover:bg-[#123a66]">Setujui &amp; Tampilkan</button>';
        h += '<button type="button" data-moderasi-tolak="' + esc(k.id) + '" class="rounded-lg border border-[#D9232E] px-3 py-1.5 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Tolak</button>';
      } else {
        h += '<button type="button" data-moderasi-hapus="' + esc(k.id) + '" class="rounded-lg border border-[#D9232E] px-3 py-1.5 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Hapus</button>';
      }
      h += '</div></article>';
      return h;
    }

    function renderModerasi(menunggu, terbit) {
      // Lencana: jumlah komentar yang menunggu persetujuan.
      const badge = document.querySelector('[data-badge-moderasi]');
      if (badge) {
        badge.textContent = String(menunggu.length);
        badge.classList.toggle('hidden', menunggu.length === 0);
      }
      const elM = $('moderasi-menunggu');
      if (elM) elM.innerHTML = menunggu.length ? menunggu.map((k) => kartuKomentar(k, 'menunggu')).join('') : '<p class="text-sm text-slate-500">Tidak ada komentar yang menunggu.</p>';
      const elT = $('moderasi-terbit');
      if (elT) elT.innerHTML = terbit.length ? terbit.map((k) => kartuKomentar(k, 'terbit')).join('') : '<p class="text-sm text-slate-500">Belum ada komentar yang tampil.</p>';
    }

    async function bukaDetailAntrean(id) {
      const item = antrean.find((a) => String(a.id) === String(id));
      try {
        const res = await workerPost('/redaksi/api/berita/' + encodeURIComponent(id) + '/detail', {});
        const art = (res && res.article) || {};
        $('antrean-detail-judul').textContent = art.title || (item && item.title) || '(tanpa judul)';
        $('antrean-detail-meta').textContent = [art.author || (item && item.author), art.category || (item && item.category), art.publish_date || art.publishDate || (item && item.publish_date)].filter(Boolean).join(' · ');
        $('antrean-detail-ringkasan').textContent = art.summary || (item && item.summary) || '';
        $('antrean-detail-isi').innerHTML = isiMarkdownToHtml(art.body || '');
        const cov = $('antrean-detail-cover');
        if (res.cover && res.cover.base64) { cov.src = 'data:' + (res.cover.mime || 'image/jpeg') + ';base64,' + res.cover.base64; cov.classList.remove('hidden'); }
        else if (art.image) { cov.src = imageUrl(art.image); cov.classList.remove('hidden'); }
        else cov.classList.add('hidden');
        const cat = $('antrean-detail-catatan');
        const note = art.rejection_note || (item && item.rejection_note);
        if (note) { cat.textContent = 'Catatan penolakan: ' + note; cat.classList.remove('hidden'); } else cat.classList.add('hidden');
        const er = $('antrean-detail-error');
        const perr = art.publish_error || (item && item.publish_error);
        if (perr) { er.textContent = 'Gagal terbit: ' + perr; er.classList.remove('hidden'); } else er.classList.add('hidden');
        $('modal-antrean').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } catch (err) {
        showStatus('Gagal memuat detail antrean: ' + err.message, false);
      }
    }

    async function editAntrean(id) {
      try {
        const res = await workerPost('/redaksi/api/berita/' + encodeURIComponent(id) + '/detail', {});
        const art = (res && res.article) || {};
        resetForm();
        editingAntrean = { id, coverAda: !!(res.cover || art.image), breakingSince: art.breakingSince || '', author_picture: art.author_picture || '' };
        $('f-judul').value = normalisasiJudul(art.title || '');
        $('f-kategori').value = art.category || '';
        $('f-tag').value = (art.tags || []).join(', ');
        $('f-penulis').value = art.author || 'Rezie';
        $('f-tanggal').value = String(art.publish_date || art.publishDate || '').slice(0, 10);
        $('f-upt').value = art.upt || '';
        $('f-keterangan').value = art.imageCaption || 'Dokumentasi kegiatan. (ZonaPas)';
        $('f-featured').checked = art.featured === true;
        $('f-breaking').checked = art.breaking === true;
        const isiAwal = pisahkanFotoIsi(art.body || '');
        $('f-isi').value = isiAwal.narasi;
        aturFotoIsi(isiAwal.foto[0] || '');
        $('f-foto').value = '';
        const prev = $('f-foto-preview');
        if (res.cover && res.cover.base64) { prev.src = 'data:' + (res.cover.mime || 'image/jpeg') + ';base64,' + res.cover.base64; prev.classList.remove('hidden'); }
        else if (art.image) { prev.src = imageUrl(art.image); prev.classList.remove('hidden'); }
        else { prev.classList.add('hidden'); prev.src = ''; }
        const cur = $('f-foto-saat-ini');
        cur.textContent = art.image ? ('Foto saat ini: ' + art.image + ' (biarkan kosong bila tidak diganti)') : (res.cover ? 'Foto sampul sudah ada (biarkan kosong bila tidak diganti)' : '');
        cur.classList.toggle('hidden', !(art.image || res.cover));
        $('form-title').textContent = 'Edit Berita (Antrean)';
        $('btn-save').textContent = 'Simpan Perubahan';
        $('form-section').classList.remove('hidden');
        $('form-section').scrollIntoView({ behavior: 'smooth' });
        terapkanPenulis();
        tawarkanDraf();
      } catch (err) {
        showStatus('Gagal memuat berita antrean: ' + err.message, false);
      }
    }

    // Ringkasan tidak lagi diisi manual di formulir: diambil otomatis dari
    // awal narasi (teks polos, maks. 160 karakter, dipotong di batas kata).
    // Field ringkasan tetap ditulis ke berkas artikel karena dipakai meta
    // description, JSON-LD, dan RSS — dan skema Astro + validasi Worker
    // mewajibkannya terisi.
    function teksPolosNarasi(teks) {
      return (teks || '')
        .split('\n')
        .filter((b) => !/^\s*!\[.*?\]\(.*?\)\s*$/.test(b))
        .join('\n')
        .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
        .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
        .replace(/[*_`#>|]/g, '')
        .replace(/<[^>]*>/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    }
    function ringkasanOtomatis(narasi) {
      const teks = teksPolosNarasi(narasi);
      if (teks.length <= 160) return teks;
      const potong = teks.slice(0, 160);
      const spasi = potong.lastIndexOf(' ');
      return (spasi > 100 ? potong.slice(0, spasi) : potong) + '…';
    }

    // Kumpulkan + validasi field formulir (dipakai jalur langsung & antrean).
    function kumpulkanDataForm() {
      const title = normalisasiJudul($('f-judul').value);
      const category = $('f-kategori').value;
      // Kotak narasi hanya berisi narasi: bila ada baris gambar yang ditempel
      // di sana, pindahkan ke foto terpisah (bila belum ada) — total tetap
      // maks. 1 foto, selebihnya ditolak seperti sebelumnya.
      const isi = pisahkanFotoIsi($('f-isi').value);
      const fotoTempel = isi.foto;
      if ((fotoIsi ? 1 : 0) + fotoTempel.length > 1) throw new Error('Foto badan narasi hanya boleh 1 foto. Hapus foto yang ada dulu bila ingin menggantinya.');
      let barisFoto = fotoIsi ? fotoIsi.baris : '';
      if (!barisFoto && fotoTempel.length === 1) { barisFoto = fotoTempel[0]; aturFotoIsi(barisFoto); }
      const body = gabungkanFotoIsi(isi.narasi, barisFoto);
      if (hitungFotoBadan(body) > 1) throw new Error('Foto badan narasi hanya boleh 1 foto. Hapus foto yang lain bila ingin menggantinya.');
      $('f-isi').value = isi.narasi;
      const publishDate = $('f-tanggal').value;
      if (!title || !category || !isi.narasi.trim() || !publishDate) throw new Error('Judul, kategori, tanggal terbit, dan isi berita wajib diisi.');
      const summary = ringkasanOtomatis(isi.narasi);
      const breakingChecked = $('f-breaking').checked;
      let breakingSince = '';
      if (breakingChecked) {
        breakingSince = (editing && editing.breakingSince) || (editingAntrean && editingAntrean.breakingSince) || new Date().toISOString();
      }
      return {
        title, summary, category,
        tags: $('f-tag').value.split(',').map((t) => t.trim()).filter(Boolean),
        author: $('f-penulis').value.trim() || 'Rezie',
        // Foto penulis: dipertahankan dari artikel yang sedang diedit (jalur
        // terbit langsung admin mengedit berita Penulis); bila artikel baru
        // dan masuk lewat Google (peran apa pun) pakai foto profil Google
        // pengguna saat ini; masuk lewat GitHub -> tanpa foto. Jalur antrean
        // dihitung ulang server dari penulis aslinya, jadi nilai ini
        // diabaikan di sana.
        authorImage: (editing && editing.authorImage) || (sumberLogin === 'google' && identitas && identitas.picture ? identitas.picture : ''),
        publish_date: publishDate,
        publishDate,
        imageCaption: $('f-keterangan').value.trim() || 'Dokumentasi kegiatan. (ZonaPas)',
        featured: $('f-featured').checked,
        breaking: breakingChecked,
        breakingSince,
        upt: $('f-upt').value || '',
        body,
      };
    }

    // Jalur antrean: buat dulu via Worker, lalu sampul, lalu gambar isi yang
    // ditahan, lalu kirim bila diminta. TIDAK PERNAH memanggil GitHub langsung.
    async function simpanAntrean(id, kirim) {
      const d = kumpulkanDataForm();
      const adaCoverLama = !!(editingAntrean && editingAntrean.coverAda) || !!(editing && editing.image);
      if (!pendingCover && !adaCoverLama) throw new Error('Foto sampul wajib diunggah.');
      let articleId = id || null;
      if (!articleId) {
        const res = await workerPost('/redaksi/api/berita', d);
        articleId = (res && res.article && res.article.id) || (res && res.id) || (res && res.article_id);
        if (!articleId) throw new Error('Worker tidak mengembalikan id artikel antrean.');
      } else {
        await workerPost('/redaksi/api/berita/' + encodeURIComponent(articleId), d);
      }
      if (pendingCover) {
        await workerPost('/redaksi/api/berita/' + encodeURIComponent(articleId) + '/foto', { dataUrl: pendingCover.dataUrl });
      }
      for (const g of pendingGambarIsi) {
        await workerPost('/redaksi/api/berita/' + encodeURIComponent(articleId) + '/gambar-isi', { dataUrl: g.dataUrl, filename: g.filename });
      }
      if (kirim) {
        await workerPost('/redaksi/api/berita/' + encodeURIComponent(articleId) + '/kirim', {});
      }
      showStatus(kirim ? 'Terkirim ke antrean — menunggu persetujuan.' : 'Berita tersimpan di antrean sebagai draf.', true);
      hapusDraf();
      resetForm();
      $('form-section').classList.add('hidden');
      await muatAntrean();
    }

    // ---------- Pengguna (admin) ----------
    async function muatPengguna() {
      if (peran !== 'admin') return;
      try {
        const res = await workerGet('/redaksi/api/pengguna');
        renderPengguna(res || {});
      } catch (err) {
        const el = $('pengguna-list');
        if (el) el.innerHTML = '<p class="text-sm text-red-600">Gagal memuat pengguna: ' + esc(err.message) + '</p>';
      }
    }

    function renderPengguna(data) {
      const users = data.users || [];
      const invs = data.invitations || [];
      const adminEmails = data.admin_emails || [];
      const ul = $('pengguna-list');
      if (ul) {
        if (!users.length) { ul.innerHTML = '<p class="text-sm text-slate-500">Belum ada pengguna.</p>'; }
        else {
          ul.innerHTML = users.map((u) => {
            const id = u.id || u.email || '';
            const nama = u.name || u.email || id;
            const email = u.email || '';
            const role = u.role || 'penulis';
            const aktif = u.status ? (u.status !== 'nonaktif' && u.active !== false) : (u.active !== false);
            const utama = !!(u.is_main_admin || u.main_admin || u.is_main);
            const opsi = ['admin', 'penyunting', 'penulis'].map((r) => '<option value="' + r + '"' + (r === role ? ' selected' : '') + '>' + labelPeran(r) + '</option>').join('');
            return '<div class="flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-800">' +
              '<span class="min-w-0 flex-1"><span class="block text-sm font-bold">' + esc(nama) + '</span>' +
              '<span class="block text-xs text-slate-500">' + esc(email) + (aktif ? '' : ' · Nonaktif') + '</span></span>' +
              '<select data-peran-user="' + esc(id) + '" class="rounded-lg border border-slate-300 px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900">' + opsi + '</select>' +
              (utama ? '<span class="text-xs font-bold text-slate-500">Admin utama</span>' : '<button type="button" data-status-user="' + esc(id) + '" data-status-baru="' + (aktif ? 'nonaktif' : 'aktif') + '" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">' + (aktif ? 'Nonaktifkan' : 'Aktifkan') + '</button>') +
              '</div>';
          }).join('');
        }
      }
      const il = $('undangan-list');
      if (il) {
        il.innerHTML = !invs.length ? '<p class="text-sm text-slate-500">Tidak ada undangan yang masih berlaku.</p>' : invs.map((v) => {
          const id = v.id || '';
          const link = v.link || v.url || '';
          return '<div class="flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-800">' +
            '<span class="min-w-0 flex-1"><span class="block text-sm font-bold">' + esc(v.email || '') + '</span>' +
            '<span class="block text-xs text-slate-500">' + esc(labelPeran(v.role)) + (v.expires_at ? ' · berlaku sampai ' + esc(String(v.expires_at).slice(0, 10)) : '') + '</span></span>' +
            (link ? '<button type="button" data-undangan-salin="' + esc(link) + '" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Salin tautan</button>' : '') +
            '<button type="button" data-undangan-cabut="' + esc(id) + '" class="rounded-lg border border-[#D9232E] px-3 py-1.5 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Cabut</button></div>';
        }).join('');
      }
      // Email Administrator Cadangan: baris tetap admin utama + daftar
      // cadangan dari Worker (admin_emails), tiap baris bisa dihapus.
      // API mengembalikan tiap entri sebagai OBJEK { email, created_by,
      // created_at } — ambil field email-nya (tetap tahan bila API suatu
      // saat mengembalikan string biasa). Sebelumnya objek diinterpolasi
      // langsung sehingga tampil "[object Object]" dan tombol Hapus
      // mengirim alamat itu (gagal 404).
      const alamatEmail = (e) => (typeof e === 'string' ? e : (e && e.email) || '');
      const al = $('admin-email-list');
      if (al) {
        const utama = '<div class="flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-800">' +
          '<span class="min-w-0 flex-1"><span class="block text-sm font-bold">rezienovian@gmail.com</span>' +
          '<span class="block text-xs text-slate-500">Administrator utama</span></span></div>';
        const cadangan = adminEmails.map(alamatEmail).filter((a) => a && a.toLowerCase() !== 'rezienovian@gmail.com').map((email) => {
          return '<div class="flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 px-3 py-2 dark:border-slate-800">' +
            '<span class="min-w-0 flex-1"><span class="block text-sm font-bold">' + esc(email) + '</span>' +
            '<span class="block text-xs text-slate-500">Administrator cadangan</span></span>' +
            '<button type="button" data-admin-email-hapus="' + esc(email) + '" class="rounded-lg border border-[#D9232E] px-3 py-1.5 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Hapus</button></div>';
        }).join('');
        al.innerHTML = utama + (cadangan || '<p class="text-sm text-slate-500">Belum ada email cadangan.</p>');
      }
    }

    async function loadArticles() {
      const list = await gh('/contents/src/content/berita?ref=main');
      const files = (Array.isArray(list) ? list : []).filter((f) => f.type === 'file' && f.name.endsWith('.md'));
      const loaded = [];
      for (const f of files) {
        try {
          const file = await gh('/contents/src/content/berita/' + encodeURIComponent(f.name) + '?ref=main');
          const text = b64decodeUnicode(file.content || '');
          const parsed = parseFrontmatter(text);
          const slug = f.name.replace(/\.md$/, '');
          loaded.push({ slug, path: f.path, sha: file.sha, data: parsed.data, body: parsed.body });
        } catch (e) {
          console.warn('Gagal memuat ' + f.name, e);
        }
      }
      loaded.sort((a, b) => String(b.data.publishDate || '').localeCompare(String(a.data.publishDate || '')));
      articles = loaded;
      renderLists();
    }

    // ---------- ZonaPasTV (khusus Administrator) ----------
    // Video YouTube redaksi: data di src/content/video/*.md, video tetap
    // tersimpan di YouTube (tautan watch / youtu.be / Shorts / ID mentah).
    let videos = [];

    // Ambil ID video YouTube (11 karakter) dari berbagai bentuk tautan.
    function idYoutube(tautan) {
      const t = String(tautan || '').trim();
      const m = t.match(/(?:v=|youtu\.be\/|shorts\/|embed\/|live\/)([A-Za-z0-9_-]{11})/) || t.match(/^([A-Za-z0-9_-]{11})$/);
      return m ? m[1] : '';
    }
    function thumbYoutube(id) { return 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg'; }

    function buildVideoMarkdown(d) {
      const q = (v) => JSON.stringify(String(v ?? ''));
      const lines = [
        '---',
        'title: ' + q(d.title),
        'description: ' + q(d.description),
        'video: ' + q(d.video),
      ];
      if (d.poster) lines.push('poster: ' + q(d.poster));
      lines.push('publishDate: ' + d.publishDate, 'author: ' + q(d.author), '---', '');
      return lines.join('\n');
    }

    async function muatVideo() {
      let list;
      try {
        list = await gh('/contents/src/content/video?ref=main');
      } catch (e) {
        // Folder belum ada (belum pernah ada video): anggap kosong.
        if (e && e.status === 404) { videos = []; renderVideoList(); return; }
        throw e;
      }
      const files = (Array.isArray(list) ? list : []).filter((f) => f.type === 'file' && f.name.endsWith('.md'));
      const loaded = [];
      for (const f of files) {
        try {
          const file = await gh('/contents/src/content/video/' + encodeURIComponent(f.name) + '?ref=main');
          const text = b64decodeUnicode(file.content || '');
          const parsed = parseFrontmatter(text);
          const slug = f.name.replace(/\.md$/, '');
          loaded.push({ slug, path: f.path, sha: file.sha, data: parsed.data });
        } catch (e) {
          console.warn('Gagal memuat video ' + f.name, e);
        }
      }
      loaded.sort((a, b) => String(b.data.publishDate || '').localeCompare(String(a.data.publishDate || '')));
      videos = loaded;
      renderVideoList();
    }

    function renderVideoList() {
      const el = $('video-list');
      if (!el) return;
      if (!videos.length) {
        el.innerHTML = '<p class="py-3 text-sm text-slate-500">Belum ada video di ZonaPasTV.</p>';
        return;
      }
      el.innerHTML = videos.map((v) => {
        const d = v.data;
        const idYt = idYoutube(d.video);
        const thumb = d.poster
          ? '<img src="' + esc(imageUrl(d.poster)) + '" alt="" loading="lazy" class="h-auto w-28 shrink-0 rounded-lg" onerror="this.onerror=null;this.src=\'/images/cover-default.svg\'" />'
          : (idYt
            ? '<img src="' + thumbYoutube(idYt) + '" alt="" loading="lazy" class="h-auto w-28 shrink-0 rounded-lg" />'
            : '<span class="flex h-16 w-28 shrink-0 items-center justify-center rounded-lg bg-[#0A2540] text-2xl text-white">▶</span>');
        return '<article class="flex gap-3 py-4">' + thumb +
          '<div class="min-w-0 flex-1">' +
          '<span class="block text-sm font-bold leading-snug">' + esc(d.title || '(tanpa judul)') + '</span>' +
          '<span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">' + esc(formatDateShort(d.publishDate || '')) + ' · ' + esc(d.video || '') + '</span>' +
          '<div class="mt-2 flex gap-2"><button type="button" data-video-hapus="' + esc(v.slug) + '" class="rounded-md border border-[#D9232E] px-2.5 py-1 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Hapus</button></div>' +
          '</div></article>';
      }).join('');
    }

    // ---------- Render daftar ----------
    function filteredArticles() {
      const q = ($('q').value || '').toLowerCase().trim();
      const cat = $('filter-category').value || '';
      return articles.filter((a) => {
        if (cat && a.data.category !== cat) return false;
        if (!q) return true;
        return ((a.data.title || '') + ' ' + (a.data.summary || '') + ' ' + (a.data.category || '')).toLowerCase().includes(q);
      });
    }

    function rowHtml(a) {
      const d = a.data;
      return '<article class="flex gap-3 py-4">' +
        '<a href="/berita/' + esc(a.slug) + '/" target="_blank" rel="noopener" class="shrink-0">' +
        '<img src="' + esc(imageUrl(d.image)) + '" alt="' + esc(d.imageCaption || d.title) + '" loading="lazy" class="h-auto w-28 shrink-0 rounded-lg" onerror="this.onerror=null;this.src=\'/images/cover-default.svg\'" /></a>' +
        '<div class="min-w-0 flex-1"><div>' + catLabel(d.category || '-') + sourceBadge(d.source) + '</div>' +
        '<a href="/berita/' + esc(a.slug) + '/" target="_blank" rel="noopener" class="mt-0.5 block text-sm font-bold leading-snug hover:text-[#92400E] hover:underline">' + esc(d.title || '(tanpa judul)') + '</a>' +
        '<span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">' + esc(formatDateShort(d.publishDate || '')) + (d.upt ? ' · ' + esc(d.upt) : '') + '</span>' +
        '<span data-tayang="' + esc(a.slug) + '" class="mt-1 block text-xs text-slate-500 dark:text-slate-400"></span>' +
        (peran === 'admin'
          ? '<div class="mt-2 flex gap-2">' +
            '<button type="button" data-edit="' + esc(a.slug) + '" class="rounded-md border border-[#0A2540] px-2.5 py-1 text-xs font-bold text-[#0A2540] hover:bg-[#0A2540] hover:text-white dark:text-white">Ubah</button>' +
            '<button type="button" data-delete="' + esc(a.slug) + '" class="rounded-md border border-[#D9232E] px-2.5 py-1 text-xs font-bold text-[#D9232E] hover:bg-[#D9232E] hover:text-white">Hapus</button>' +
            '</div>'
          : '') +
        '</div></article>';
    }

    function renderLists() {
      const list = filteredArticles();
      $('count').textContent = list.length + ' dari ' + articles.length + ' berita';
      const featured = list.filter((a) => a.data.featured === true);
      const featEl = $('featured-list');
      if (!featured.length) {
        featEl.innerHTML = '<p class="text-sm text-slate-500">Belum ada artikel yang ditandai sebagai Pilihan Redaksi.</p>';
      } else {
        const hero = featured[0];
        const rest = featured.slice(1);
        let html = '<a href="/berita/' + esc(hero.slug) + '/" target="_blank" rel="noopener" class="group relative block overflow-hidden rounded-2xl">' +
          '<img src="' + esc(imageUrl(hero.data.image)) + '" alt="' + esc(hero.data.imageCaption || hero.data.title) + '" loading="eager" class="h-auto w-full" onerror="this.onerror=null;this.src=\'/images/cover-default.svg\'" />' +
          '<span class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></span>' +
          '<span class="absolute inset-x-0 bottom-0 p-5"><span class="inline-block rounded bg-[#FACC15] px-2 py-1 text-xs font-bold uppercase tracking-wide text-[#0A2540]">' + esc(hero.data.category || '') + '</span>' + sourceBadge(hero.data.source) +
          '<span class="mt-2 block text-xl font-extrabold leading-tight text-white sm:text-2xl">' + esc(hero.data.title || '') + '</span>' +
          '<span class="mt-2 block text-xs text-slate-300">' + esc(formatDateShort(hero.data.publishDate || '')) + '</span></span></a>';
        if (rest.length) html += '<div class="mt-2 divide-y divide-slate-200 dark:divide-slate-800">' + rest.map(rowHtml).join('') + '</div>';
        featEl.innerHTML = html;
      }
      const latestEl = $('latest-list');
      latestEl.innerHTML = list.length ? list.map(rowHtml).join('') : '<p class="py-3 text-sm text-slate-500">Tidak ada berita yang cocok dengan pencarian.</p>';
      terapkanStatistik();
      if (!statistikDimuat) muatStatistik();
    }

    // ---------- Statistik tayangan ----------
    let statistikTayang = null;
    let statistikDimuat = false;
    async function muatStatistik() {
      if (statistikDimuat || !peran) return;
      statistikDimuat = true;
      try {
        const res = await workerGet('/redaksi/api/statistik');
        statistikTayang = (res && res.perSlug) || {};
        terapkanStatistik();
        renderTerpopuler((res && res.terpopulerMinggu) || []);
      } catch (err) {
        statistikTayang = {};
      }
    }
    function terapkanStatistik() {
      if (!statistikTayang) return;
      document.querySelectorAll('[data-tayang]').forEach((el) => {
        const s = statistikTayang[el.getAttribute('data-tayang')] || { total: 0, minggu: 0 };
        el.textContent = '👁 ' + s.total + ' kali dibaca' + (s.minggu ? ' · ' + s.minggu + ' minggu ini' : '');
      });
    }
    function renderTerpopuler(daftar) {
      const sec = $('terpopuler-section');
      const el = $('terpopuler-list');
      if (!sec || !el) return;
      if (!daftar.length) { sec.classList.add('hidden'); return; }
      sec.classList.remove('hidden');
      el.innerHTML = daftar.map((x, i) => {
        const a = articles.find((art) => art.slug === x.slug);
        const judul = a ? a.data.title : x.slug;
        return '<div class="flex items-center gap-3 py-3">' +
          '<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#FACC15] text-sm font-black text-[#0A2540]">' + (i + 1) + '</span>' +
          '<div class="min-w-0 flex-1"><a href="/berita/' + esc(x.slug) + '/" target="_blank" rel="noopener" class="block truncate text-sm font-bold hover:underline">' + esc(judul || '(tanpa judul)') + '</a>' +
          '<span class="text-xs text-slate-500 dark:text-slate-400">👁 ' + x.minggu + ' kali dibaca minggu ini · ' + x.total + ' total</span></div></div>';
      }).join('');
    }

    // ---------- Login GitHub (popup + Worker OAuth) ----------
    let popup = null;
    let popupTimer = null;

    // Tombol keluar saat login tinggal di header (posisi tombol Masuk):
    // tautan header bertanda data-header-masuk berubah jadi "Keluar" dan
    // memanggil keluar(); saat keluar, kembali jadi "Masuk" ke /masuk/.
    // Keluar dari Kelola Berita selalu kembali ke menu login (/masuk/),
    // bukan menampilkan kotak login di halaman ini. Akhiri SEMUA sesi:
    // sesi Google (cookie Worker) maupun token GitHub — tanpa ini, sesi
    // Google yang masih hidup di browser yang sama akan dipulihkan
    // otomatis saat halaman dimuat lagi.
    async function keluar(e) {
      if (e) e.preventDefault();
      try { await fetch('/redaksi/logout', { method: 'POST', credentials: 'same-origin' }); } catch (err) {}
      try { sessionStorage.removeItem('zonapas-kelola-token'); } catch (err) {}
      try { localStorage.removeItem('zonapas-aktivitas-terakhir'); } catch (err) {}
      window.location.href = '/masuk/';
    }

    function terapkanTombolHeaderKeluar(aktif) {
      document.querySelectorAll('[data-header-masuk]').forEach((el) => {
        if (aktif) {
          el.textContent = 'Keluar';
          el.setAttribute('href', '/kelola-berita/');
          el.onclick = keluar;
        } else {
          el.textContent = 'Masuk';
          el.setAttribute('href', '/masuk/');
          el.onclick = null;
        }
      });
    }

    function setLoggedIn(user) {
      // Pembaca TIDAK punya akses Kelola Berita: kembalikan ke beranda.
      if (peran === 'pembaca') {
        showStatus('Akun Anda adalah Pembaca — Kelola Berita hanya untuk Redaksi. Anda dialihkan ke beranda…', false);
        setTimeout(() => { window.location.href = '/'; }, 1500);
        return;
      }
      loginBox.classList.add('hidden');
      const ditolak = $('akses-ditolak');
      if (ditolak) ditolak.classList.add('hidden');
      appEl.classList.remove('hidden');
      terapkanTombolHeaderKeluar(true);
      const nama = (identitas && identitas.nama) || user.login || 'GitHub';
      $('user-name').textContent = 'Masuk sebagai ' + nama + (peran ? ' (' + labelPeran(peran) + ')' : '') + ' · ' + (sumberLogin === 'google' ? 'Google' : 'GitHub');
      const avatar = $('user-avatar');
      if (user.avatar_url) { avatar.src = user.avatar_url; avatar.alt = user.login || ''; avatar.classList.remove('hidden'); }
      else { avatar.classList.add('hidden'); }
      terapkanPeran();
      showStatus('Masuk sebagai ' + nama + '. Memuat daftar berita…', true);
      loadArticles().catch((err) => showStatus('Gagal memuat daftar berita: ' + err.message, false));
      if (window.location.hash === '#antrean') {
        setTimeout(() => { const s = $('antrean-section'); if (s) s.scrollIntoView({ behavior: 'smooth' }); }, 600);
      }
    }

    function setLoggedOut(msg) {
      token = null;
      peran = null; sumberLogin = null; identitas = null; antrean = []; editingAntrean = null; pendingGambarIsi = [];
      try { sessionStorage.removeItem('zonapas-kelola-token'); } catch (e) {}
      appEl.classList.add('hidden');
      const ditolak = $('akses-ditolak');
      if (ditolak) ditolak.classList.add('hidden');
      loginBox.classList.remove('hidden');
      terapkanTombolHeaderKeluar(false);
      $('form-section').classList.add('hidden');
      if (msg) showStatus(msg, false);
    }

    window.addEventListener('message', async (event) => {
      if (event.origin !== OAUTH_ORIGIN) return;
      if (event.data === 'authorizing:github') {
        // Echo ke pengirim (popup, atau tab baru bila login dibuka lewat
        // tautan fallback). Worker menunggu echo ini; tanpa echo, Worker
        // tetap lanjut setelah 3 detik, tapi echo membuat alur langsung.
        const target = (popup && !popup.closed) ? popup : (event.source || null);
        if (target) target.postMessage('authorizing:github', OAUTH_ORIGIN);
        return;
      }
      if (typeof event.data === 'string' && event.data.indexOf('authorization:github:success:') === 0) {
        try {
          const payload = JSON.parse(event.data.slice('authorization:github:success:'.length));
          token = payload.token;
          try { sessionStorage.setItem('zonapas-kelola-token', token); } catch (e) {}
          if (popupTimer) { clearInterval(popupTimer); popupTimer = null; }
          if (popup && !popup.closed) popup.close();
          // Selesaikan peran lewat Worker SEBELUM menampilkan aplikasi,
          // supaya tombol/seksi sesuai peran langsung tampil (tanpa ini
          // peran null dan halaman tampak kosong sampai dimuat ulang).
          const me = await workerPost('/redaksi/api/me', {});
          if (!me || !me.ok || !me.user || !me.user.role) throw Object.assign(new Error('Peran tidak ditemukan.'), { status: 401 });
          terapkanIdentitas(me.user, 'github');
          // Tukarkan token jadi sesi cookie supaya login langsung bertahan
          // di semua tab (tanpa menunggu muat ulang halaman).
          try { await workerPost('/redaksi/api/github-sesi', {}); } catch (e) {}
          const user = await ghApi('https://api.github.com/user');
          setLoggedIn(user);
          await muatAntrean();
          await muatPengguna();
        } catch (err) {
          if (err && err.status === 403) { tampilkanAksesDitolak(err.message); return; }
          showStatus('Login gagal: ' + err.message, false);
        }
      }
    });

    const btnLogin = $('btn-login');
    if (btnLogin) btnLogin.addEventListener('click', () => {
      // Status tombol yang terlihat: klik harus selalu memberi respon.
      const labelHtml = btnLogin.innerHTML;
      btnLogin.disabled = true;
      btnLogin.textContent = 'Menghubungkan…';
      const restoreBtn = () => { btnLogin.disabled = false; btnLogin.innerHTML = labelHtml; };
      if (popupTimer) { clearInterval(popupTimer); popupTimer = null; }
      popup = window.open(OAUTH_AUTH_URL, 'zonapas-github-login', 'width=640,height=720,popup=1');
      if (!popup) {
        restoreBtn();
        const fb = $('login-fallback');
        if (fb) fb.classList.remove('hidden');
        showStatus('Popup diblokir browser. Izinkan popup untuk situs ini lalu coba lagi, atau buka login GitHub di tab baru lewat tautan di bawah tombol.', false);
        return;
      }
      showStatus('Jendela login GitHub dibuka. Selesaikan otorisasi di jendela tersebut…', true);
      if (popupTimer) clearInterval(popupTimer);
      popupTimer = setInterval(() => {
        if (popup && popup.closed) {
          clearInterval(popupTimer);
          popupTimer = null;
          if (!token) {
            restoreBtn();
            showStatus('Jendela login ditutup sebelum selesai. Klik "Masuk dengan GitHub" untuk mencoba lagi.', false);
          }
        }
      }, 500);
    });

    // ---------- Form ----------
    function resetForm() {
      editing = null;
      editingAntrean = null;
      pendingCover = null;
      pendingGambarIsi = [];
      aturFotoIsi('');
      $('form-berita').reset();
      $('f-penulis').value = 'Rezie';
      $('f-keterangan').value = 'Dokumentasi kegiatan. (ZonaPas)';
      $('f-tanggal').value = todayISO();
      $('f-foto-preview').classList.add('hidden');
      $('f-foto-preview').src = '';
      $('f-foto-saat-ini').classList.add('hidden');
      $('f-foto-saat-ini').textContent = '';
      $('form-title').textContent = 'Tulis Berita Baru';
      $('btn-save').textContent = 'Simpan Berita';
      const ba = $('btn-antrean');
      if (ba) ba.textContent = peran === 'penulis' ? 'Kirim untuk Persetujuan' : 'Kirim ke Antrean';
      terapkanPenulis();
    }

    // ---------- Autosave draf (teks formulir, di perangkat ini) ----------
    // Foto tidak bisa tersimpan otomatis (berkas tidak bisa diserialisasi),
    // jadi hanya kolom teks yang dipulihkan; foto dipilih ulang bila perlu.
    let drafTimer = null;
    function kunciDraf() {
      if (editingAntrean) return 'antrean:' + editingAntrean.id;
      if (editing) return 'artikel:' + editing.slug;
      return 'baru';
    }
    function kumpulkanDraf() {
      return {
        waktu: Date.now(),
        judul: $('f-judul').value, kategori: $('f-kategori').value, tag: $('f-tag').value,
        penulis: $('f-penulis').value, tanggal: $('f-tanggal').value, upt: $('f-upt').value,
        keterangan: $('f-keterangan').value, featured: $('f-featured').checked,
        breaking: $('f-breaking').checked, isi: $('f-isi').value,
      };
    }
    function drafSamaDenganForm(d) {
      const kini = kumpulkanDraf();
      return ['judul', 'kategori', 'tag', 'penulis', 'tanggal', 'upt', 'keterangan', 'featured', 'breaking', 'isi'].every((k) => String(kini[k]) === String(d[k]));
    }
    function simpanDrafOtomatis() {
      if ($('form-section').classList.contains('hidden')) return;
      const d = kumpulkanDraf();
      if (!d.judul.trim() && !d.isi.trim()) return;
      try {
        localStorage.setItem('zonapas-draf-' + kunciDraf(), JSON.stringify(d));
        const st = $('draf-status');
        if (st) { st.textContent = 'Draf tersimpan otomatis • ' + new Date(d.waktu).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }); st.classList.remove('hidden'); }
      } catch (e) {}
    }
    function jadwalkanDraf() {
      if (drafTimer) clearTimeout(drafTimer);
      drafTimer = setTimeout(simpanDrafOtomatis, 2000);
      const b = $('draf-banner');
      if (b) b.classList.add('hidden');
    }
    function tawarkanDraf() {
      const b = $('draf-banner');
      if (!b) return;
      let d = null;
      try { d = JSON.parse(localStorage.getItem('zonapas-draf-' + kunciDraf()) || 'null'); } catch (e) {}
      if (!d || drafSamaDenganForm(d)) { b.classList.add('hidden'); return; }
      const w = $('draf-banner-waktu');
      if (w) w.textContent = 'dari ' + new Date(d.waktu).toLocaleString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
      b.classList.remove('hidden');
    }
    function hapusDraf() {
      try { localStorage.removeItem('zonapas-draf-' + kunciDraf()); } catch (e) {}
      const b = $('draf-banner');
      if (b) b.classList.add('hidden');
    }
    function isiDariDraf() {
      let d = null;
      try { d = JSON.parse(localStorage.getItem('zonapas-draf-' + kunciDraf()) || 'null'); } catch (e) {}
      if (!d) return;
      $('f-judul').value = d.judul || '';
      $('f-kategori').value = d.kategori || '';
      $('f-tag').value = d.tag || '';
      $('f-penulis').value = d.penulis || '';
      $('f-tanggal').value = d.tanggal || '';
      $('f-upt').value = d.upt || '';
      $('f-keterangan').value = d.keterangan || '';
      $('f-featured').checked = !!d.featured;
      $('f-breaking').checked = !!d.breaking;
      $('f-isi').value = d.isi || '';
      $('draf-banner').classList.add('hidden');
      showStatus('Draf tersimpan dipulihkan. Foto sampul & foto isi tidak ikut tersimpan — pilih ulang bila perlu.', true);
    }

    on('btn-new', 'click', () => {
      resetForm();
      $('form-section').classList.remove('hidden');
      $('form-section').scrollIntoView({ behavior: 'smooth' });
      $('f-judul').focus();
      tawarkanDraf();
    });

    on('btn-cancel', 'click', () => {
      resetForm();
      $('form-section').classList.add('hidden');
    });

    // Autosave: tiap ketikan/perubahan di formulir dijadwalkan tersimpan.
    $('form-berita').addEventListener('input', jadwalkanDraf);
    $('form-berita').addEventListener('change', jadwalkanDraf);
    on('btn-draf-pulihkan', 'click', isiDariDraf);
    on('btn-draf-buang', 'click', hapusDraf);

    on('f-foto', 'change', async (e) => {
      const file = e.target.files && e.target.files[0];
      const preview = $('f-foto-preview');
      if (!file) { pendingCover = null; preview.classList.add('hidden'); return; }
      const coverLama = pendingCover;
      const pratinjauLama = preview.src;
      const pratinjauTampil = !preview.classList.contains('hidden');
      try {
        // Potong dulu sebelum resize/unggah; Batal = sampul lama tetap.
        const terpotong = await bukaCrop(file);
        if (!terpotong) {
          e.target.value = '';
          pendingCover = coverLama;
          if (pratinjauTampil) { preview.src = pratinjauLama; preview.classList.remove('hidden'); }
          else { preview.classList.add('hidden'); }
          return;
        }
        const dataUrl = await resizeImage(terpotong);
        pendingCover = { dataUrl };
        preview.src = dataUrl;
        preview.classList.remove('hidden');
      } catch (err) {
        pendingCover = null;
        e.target.value = '';
        showStatus(err.message, false);
      }
    });

    // ---------- Gambar di badan narasi ----------
    // Foto dipilih -> di-resize seperti sampul -> langsung diunggah ke
    // public/images -> sintaks Markdown ditambahkan di AKHIR narasi (1 baris
    // kosong di antaranya). Hanya boleh 1 foto badan narasi per artikel,
    // juga saat Ubah (isi narasi yang sudah ada tetap utuh). Bila penulis
    // menutup formulir tanpa menyimpan, foto yang sudah terunggah tetap ada
    // di repo (sama seperti media di Decap CMS) — hapus manual bila tidak
    // terpakai.
    function stampId() {
      const d = new Date();
      const p = (n) => String(n).padStart(2, '0');
      return '' + d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) + p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds()) + String(d.getMilliseconds()).padStart(3, '0') + String(Math.floor(Math.random() * 900) + 100);
    }

    function cleanAlt(name) {
      const base = String(name || '').replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
      return base || 'Foto kegiatan';
    }

    // Foto badan narasi SELALU di akhir narasi (1 baris kosong di antara
    // narasi dan foto) dan posisinya tidak bisa diubah siapa pun — Penulis,
    // Penyunting, maupun Administrator. Fungsi ini memindahkan semua baris
    // gambar Markdown ke akhir isi.
    function normalisasiIsi(teks) {
      const baris = String(teks || '').replace(/\r\n?/g, '\n').split('\n');
      const gambar = [];
      const narasi = [];
      for (const b of baris) {
        if (/^\s*!\[.*\]\(.*\)\s*$/.test(b)) gambar.push(b.trim());
        else narasi.push(b);
      }
      if (!gambar.length) return String(teks || '').replace(/\r\n?/g, '\n');
      // Rapatkan baris kosong berlebih (mis. bekas baris gambar yang dicabut)
      // supaya antarparagraf tetap 1 baris kosong.
      const rapat = [];
      for (const b of narasi) {
        if (b.trim() === '' && rapat.length && rapat[rapat.length - 1].trim() === '') continue;
        rapat.push(b);
      }
      while (rapat.length && rapat[rapat.length - 1].trim() === '') rapat.pop();
      while (rapat.length && rapat[0].trim() === '') rapat.shift();
      if (!rapat.length) return gambar.join('\n');
      return rapat.join('\n') + '\n\n' + gambar.join('\n');
    }

    // Foto badan narasi hanya boleh 1 foto.
    function hitungFotoBadan(teks) {
      return (String(teks || '').match(/^\s*!\[.*\]\(.*\)\s*$/gm) || []).length;
    }

    // Kotak narasi hanya berisi narasi: alamat gambar TIDAK tampil di sana.
    // Foto badan narasi disimpan terpisah (fotoIsi) dan digabung kembali ke
    // akhir isi saat simpan/pratinjau, supaya format tersimpan tidak berubah
    // (server tetap menerima isi dengan 1 baris gambar di akhir).
    function pisahkanFotoIsi(teks) {
      const t = normalisasiIsi(teks);
      const foto = [];
      const narasi = [];
      for (const b of t.split('\n')) {
        if (/^\s*!\[.*\]\(.*\)\s*$/.test(b)) foto.push(b.trim());
        else narasi.push(b);
      }
      return { narasi: narasi.join('\n').trim(), foto };
    }
    function gabungkanFotoIsi(narasi, barisFoto) {
      const n = String(narasi || '').trim();
      if (!barisFoto) return n;
      return n ? n + '\n\n' + barisFoto : barisFoto;
    }
    function namaDariBarisFoto(baris) {
      const m = String(baris || '').match(/\]\(([^)]+)\)/);
      return m ? m[1] : '';
    }
    function tampilkanFotoIsi() {
      const wadah = $('f-isi-foto');
      if (!fotoIsi) {
        wadah.classList.add('hidden');
        wadah.classList.remove('flex');
        $('f-isi-foto-img').src = '';
        $('f-isi-foto-nama').textContent = '';
        return;
      }
      const nama = fotoIsi.nama || namaDariBarisFoto(fotoIsi.baris);
      $('f-isi-foto-img').src = previewImgMap[nama] || nama;
      $('f-isi-foto-nama').textContent = nama;
      wadah.classList.remove('hidden');
      wadah.classList.add('flex');
    }
    function aturFotoIsi(baris, nama) {
      fotoIsi = baris ? { baris, nama: nama || namaDariBarisFoto(baris) } : null;
      tampilkanFotoIsi();
    }

    // Judul artikel: setiap kata diawali huruf kapital lalu huruf kecil.
    // Singkatan resmi tetap kapital semua (UPT, TPP, IIA, ...). Logika SAMA
    // dengan normalisasiJudul di worker.js (server menegakkannya saat simpan).
    const AKRONIM_JUDUL = ['UPT', 'LPP', 'WBP', 'LPKA', 'TPP', 'KPLP', 'IIA', 'IIB', 'BIMTEK', 'FGD', 'KPPN', 'PKBI'];
    function normalisasiJudul(judul) {
      return String(judul || '').trim().replace(/\s+/g, ' ').split(' ').map((kata) => {
        const huruf = kata.replace(/[^A-Za-z]/g, '');
        if (!huruf) return kata;
        if (AKRONIM_JUDUL.includes(huruf.toUpperCase())) return kata.replace(huruf, huruf.toUpperCase());
        const m = kata.match(/^([^A-Za-z]*)([A-Za-z])([\s\S]*)$/);
        if (!m) return kata;
        return m[1] + m[2].toUpperCase() + m[3].toLowerCase();
      }).join(' ');
    }

    // ---------- Pratinjau live isi berita ----------
    // Me-render Markdown narasi menjadi HTML (paragraf, gambar, bold,
    // tautan) di kotak pratinjau di bawah textarea — hanya untuk dilihat,
    // yang disimpan tetap Markdown di textarea. Gambar yang baru diunggah
    // di sesi ini ditampilkan dari dataUrl lokal (previewImgMap) supaya
    // terlihat sebelum rebuild situs.
    const previewImgMap = {};
    function escHtmlPrev(s) {
      return String(s ?? '').split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;').split('"').join('&quot;');
    }
    function formatBarisPrev(t) {
      let e = escHtmlPrev(t);
      e = e.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, (m, alt, src) => {
        const u = previewImgMap[src] || src;
        return '<img src="' + u + '" alt="' + alt + '" loading="lazy">';
      });
      e = e.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      e = e.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
      return e;
    }
    // Me-render Markdown narasi menjadi HTML (paragraf, gambar, bold,
    // tautan). Dipakai modal pratinjau tampilan terbit.
    function isiMarkdownToHtml(md) {
      const lines = String(md || '').split('\n');
      const out = [];
      let buf = [];
      const flush = () => {
        if (!buf.length) return;
        out.push('<p>' + formatBarisPrev(buf.join(' ')) + '</p>');
        buf = [];
      };
      for (const ln of lines) {
        if (ln.trim() === '') flush();
        else buf.push(ln.trim());
      }
      flush();
      return out.join('');
    }
    // ---------- Pratinjau tampilan terbit (modal mata) ----------
    // Merender artikel persis seperti halaman terbit (src/pages/berita/[...slug].astro):
    // breadcrumb, judul, ringkasan (hanya bila tidak menduplikasi awal isi),
    // lencana kategori/UPT/sumber, meta penulis-tanggal-waktu baca, tombol
    // berbagi (visual saja), foto sampul, badan narasi, Baca Juga + Berita
    // Terkait, tag, dan kotak penulis. Hanya membaca nilai formulir saat ini
    // — tidak menyimpan apa pun. Lencana dan tautan dibuat sebagai span
    // (bukan <a>) supaya klik di dalam modal tidak memindahkan halaman dan
    // formulir yang belum disimpan tidak hilang.
    function formatDateLong(iso) {
      const d = new Date((iso || '') + 'T00:00:00');
      if (isNaN(d)) return iso || '';
      return new Intl.DateTimeFormat('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(d);
    }

    function readingMinutesOf(body) {
      const words = String(body || '').split(/\s+/).filter(Boolean).length;
      return Math.max(1, Math.round(words / 200));
    }

    function shareButtonsVisual() {
      return '<div class="flex flex-wrap items-center gap-2" aria-label="Bagikan artikel">' +
        '<span class="mr-1 text-sm font-bold text-slate-600 dark:text-slate-300">Bagikan:</span>' +
        '<span class="rounded-full bg-[#25D366] px-3 py-1.5 text-xs font-bold text-white">WhatsApp</span>' +
        '<span class="rounded-full bg-[#1877F2] px-3 py-1.5 text-xs font-bold text-white">Facebook</span>' +
        '<span class="rounded-full bg-black px-3 py-1.5 text-xs font-bold text-white dark:bg-white dark:text-black">X</span>' +
        '<span class="rounded-full bg-[#229ED9] px-3 py-1.5 text-xs font-bold text-white">Telegram</span>' +
        '<span class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 dark:border-slate-600 dark:text-slate-200">Salin Link</span></div>';
    }

    // Artikel terkait: kategori sama dulu (+2), lalu tag yang sama (+1 tiap tag).
    function artikelTerkait(kategori, tag, kecualiSlug) {
      return articles.filter((a) => a.slug !== kecualiSlug).map((a) => {
        let score = 0;
        if (a.data.category === kategori) score += 2;
        score += (a.data.tags || []).filter((t) => tag.includes(t)).length;
        return { a, score };
      }).filter((x) => x.score > 0)
        .sort((x, y) => y.score - x.score || String(y.a.data.publishDate || '').localeCompare(String(x.a.data.publishDate || '')))
        .slice(0, 3).map((x) => x.a);
    }

    function artikelLainTerbaru(kecualiSlug) {
      const lain = articles.filter((a) => a.slug !== kecualiSlug)
        .sort((x, y) => String(y.data.publishDate || '').localeCompare(String(x.data.publishDate || '')));
      return lain[0] || null;
    }

    function kartuTerkaitHtml(a) {
      const d = a.data;
      const color = CATEGORY_COLORS[d.category] || '#0A2540';
      return '<div class="block overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">' +
        '<img src="' + esc(imageUrl(d.image)) + '" alt="' + esc(d.imageCaption || d.title || '') + '" loading="lazy" class="h-auto w-full" onerror="this.onerror=null;this.src=\'/images/cover-default.svg\'" />' +
        '<span class="block p-4">' +
        '<span class="text-xs font-bold uppercase tracking-wide" style="color:' + esc(color) + '">' + esc(d.category || '') + '</span>' +
        '<span class="mt-1 block text-base font-bold leading-snug">' + esc(d.title || '') + '</span>' +
        '<span class="mt-2 line-clamp-2 block text-sm text-slate-600 dark:text-slate-400">' + esc(d.summary || '') + '</span>' +
        '<span class="mt-3 block text-xs text-slate-500 dark:text-slate-400">' + esc(formatDateShort(d.publishDate || '')) + '</span></span></div>';
    }

    // Ikon penulis pratinjau: foto profil Google bila ada, menutupi lingkaran
    // huruf awal; bila foto gagal dimuat, gambar dihapus dan huruf awal yang
    // tampil (sama seperti halaman artikel terbit).
    function fotoPenulisHtml(nama, foto, besar) {
      const cls = besar
        ? 'flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#0A2540] text-lg font-black text-white'
        : 'flex h-9 w-9 items-center justify-center rounded-full bg-[#0A2540] text-sm font-black text-white';
      const awal = esc((nama || '?').charAt(0));
      if (!foto) return '<span class="' + cls + '">' + awal + '</span>';
      return '<span class="relative ' + cls + ' overflow-hidden">' + awal + '<img src="' + esc(foto) + '" alt="' + esc(nama || '') + '" class="absolute inset-0 h-full w-full object-cover" loading="lazy" onerror="this.remove()" /></span>';
    }

    function bangunPratinjauTerbit(d) {
      const catColor = CATEGORY_COLORS[d.category] || '#0A2540';
      const authorInfo = AUTHORS_MAP[d.author] || { role: 'Kontributor', bio: '' };
      const bodyPlain = String(d.body || '').replace(/\s+/g, ' ').trim();
      const summaryPlain = String(d.summary || '').replace(/\s+/g, ' ').trim();
      const leadDuplicatesBody = summaryPlain.length > 0 && bodyPlain.startsWith(summaryPlain.slice(0, 100));
      const terkait = artikelTerkait(d.category, d.tags || [], d.kecualiSlug);
      const bacaJuga = terkait[0] || artikelLainTerbaru(d.kecualiSlug);
      const cover = d.image || '/images/cover-default.svg';
      let h = '<article class="mx-auto max-w-[1200px] px-4 pb-10 pt-6"><div class="mx-auto max-w-[760px]">';
      h += '<nav class="text-sm text-slate-500 dark:text-slate-400"><span>Beranda</span><span class="mx-1">/</span><span>' + esc(d.category || '') + '</span><span class="mx-1">/</span><span class="font-semibold text-slate-800 dark:text-slate-200">' + esc(d.title || '(tanpa judul)') + '</span></nav>';
      h += '<h1 class="mt-4 text-3xl font-black leading-tight sm:text-4xl">' + esc(d.title || '(tanpa judul)') + '</h1>';
      if (!leadDuplicatesBody && summaryPlain) {
        h += '<p class="mt-3 text-lg leading-relaxed text-slate-600 dark:text-slate-300">' + esc(d.summary) + '</p>';
      }
      h += '<div class="mt-4 flex flex-wrap items-center gap-2">';
      if (d.category) h += '<span class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide text-white" style="background:' + esc(catColor) + '">' + esc(d.category) + '</span>';
      if (d.upt) h += '<span class="rounded-full border border-[#0A2540] px-3 py-1 text-xs font-bold text-[#0A2540] dark:border-slate-400 dark:text-slate-200">' + esc(d.upt) + '</span>';
      h += '<span class="rounded-full bg-[#0A2540] px-3 py-1 text-xs font-bold text-white">Artikel ZonaPas</span></div>';
      h += '<div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 border-y border-slate-200 py-3 text-sm dark:border-slate-800">';
      h += fotoPenulisHtml(d.author, d.authorImage, false);
      h += '<span><span class="block font-bold">' + esc(d.author || 'Rezie') + '</span><span class="block text-xs text-slate-500 dark:text-slate-400">' + esc(authorInfo.role || '') + '</span></span>';
      h += '<span class="text-slate-300 dark:text-slate-600">|</span>';
      h += '<span class="text-slate-600 dark:text-slate-300">' + esc(formatDateLong(d.publishDate)) + '</span>';
      h += '<span class="text-slate-300 dark:text-slate-600">|</span>';
      h += '<span class="text-slate-600 dark:text-slate-300">' + readingMinutesOf(d.body) + ' menit baca</span></div>';
      h += '<div class="mt-4">' + shareButtonsVisual() + '</div>';
      h += '<figure class="mt-5"><img src="' + esc(cover) + '" alt="' + esc(d.imageCaption || '') + '" class="h-auto w-full rounded-xl" onerror="this.onerror=null;this.src=\'/images/cover-default.svg\'" />';
      h += '<figcaption class="mt-2 text-sm italic text-slate-500 dark:text-slate-400">' + esc(d.imageCaption || '') + '</figcaption></figure>';
      h += '<div class="article-body mt-6 text-[17px] text-slate-800 dark:text-slate-200">' + (isiMarkdownToHtml(d.body) || '<p class="text-slate-400">Isi berita masih kosong.</p>') + '</div>';
      if (bacaJuga) {
        h += '<aside class="my-6 rounded-xl border-l-4 border-[#D9232E] bg-slate-50 p-4 dark:bg-slate-900" aria-label="Baca juga"><p class="text-xs font-black uppercase tracking-wider text-[#D9232E]">Baca Juga</p><span class="mt-1 block text-lg font-bold leading-snug">' + esc(bacaJuga.data.title || '') + '</span></aside>';
      }
      h += '<div class="mt-8 border-t border-slate-200 pt-5 dark:border-slate-800"><div class="flex flex-wrap items-center gap-2"><span class="text-sm font-bold">Tag:</span>';
      (d.tags || []).forEach((tag) => {
        h += '<span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">#' + esc(tag) + '</span>';
      });
      h += '</div><div class="mt-4">' + shareButtonsVisual() + '</div></div>';
      h += '<div class="mt-8 flex items-start gap-3 rounded-xl border border-slate-200 p-4 dark:border-slate-800">';
      h += fotoPenulisHtml(d.author, d.authorImage, true);
      h += '<div><p class="font-bold">' + esc(d.author || 'Rezie') + '</p><p class="text-sm text-slate-500 dark:text-slate-400">' + esc(authorInfo.role || '') + '</p>';
      if (authorInfo.bio) h += '<p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">' + esc(authorInfo.bio) + '</p>';
      h += '</div></div></div>';
      if (terkait.length) {
        h += '<section class="mx-auto mt-10 max-w-[1200px]" aria-label="Berita terkait"><h2 class="mb-4 border-b-2 border-[#0A2540] pb-2 text-xl font-black uppercase dark:border-white">Berita Terkait</h2><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">' + terkait.map(kartuTerkaitHtml).join('') + '</div></section>';
      }
      h += '</article>';
      return h;
    }

    function bukaPratinjauTerbit() {
      const isiPratinjau = pisahkanFotoIsi($('f-isi').value || '');
      const d = {
        title: normalisasiJudul($('f-judul').value),
        summary: ringkasanOtomatis(isiPratinjau.narasi),
        category: $('f-kategori').value,
        tags: $('f-tag').value.split(',').map((t) => t.trim()).filter(Boolean),
        author: $('f-penulis').value.trim() || 'Rezie',
        // Foto pratinjau: foto tersimpan artikel yang sedang diedit, atau
        // foto profil Google pengguna saat ini bila masuk lewat Google
        // (peran apa pun); masuk lewat GitHub -> tanpa foto.
        authorImage: (editingAntrean && editingAntrean.author_picture) || (editing && editing.authorImage) || (sumberLogin === 'google' && identitas && identitas.picture ? identitas.picture : ''),
        publishDate: $('f-tanggal').value,
        upt: $('f-upt').value || '',
        image: pendingCover ? pendingCover.dataUrl : (editing && editing.image ? imageUrl(editing.image) : ''),
        imageCaption: $('f-keterangan').value.trim() || 'Dokumentasi kegiatan. (ZonaPas)',
        body: gabungkanFotoIsi(isiPratinjau.narasi, fotoIsi ? fotoIsi.baris : (isiPratinjau.foto[0] || '')),
        kecualiSlug: editing ? editing.slug : '',
      };
      $('pratinjau-terbit-isi').innerHTML = bangunPratinjauTerbit(d);
      const modal = $('modal-pratinjau');
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      modal.scrollTop = 0;
      const tutup = $('btn-tutup-pratinjau');
      if (tutup) tutup.focus();
    }

    function tutupPratinjauTerbit() {
      const modal = $('modal-pratinjau');
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      const btn = $('btn-pratinjau-terbit');
      if (btn) btn.focus();
    }

    on('btn-pratinjau-terbit', 'click', bukaPratinjauTerbit);
    // Judul dinormalisasi saat kursor meninggalkan kolomnya, supaya penulis
    // langsung melihat format akhirnya sebelum menyimpan.
    on('f-judul', 'blur', () => { $('f-judul').value = normalisasiJudul($('f-judul').value); });
    on('btn-tutup-pratinjau', 'click', tutupPratinjauTerbit);
    on('modal-pratinjau', 'click', (e) => {
      if (e.target && !e.target.closest('#modal-pratinjau-panel')) tutupPratinjauTerbit();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (cropState) { cropBatal(); return; }
        const modal = $('modal-pratinjau');
        if (modal && !modal.classList.contains('hidden')) tutupPratinjauTerbit();
      }
    });

    function isiStatus(msg, isError) {
      const el = $('f-isi-status');
      el.textContent = msg;
      el.classList.remove('hidden');
      el.style.color = isError ? '#B91C1C' : '';
    }

    async function uploadBodyImage(file) {
      const dataUrl = await resizeImage(file);
      const slug = editing ? editing.slug : slugify($('f-judul').value.trim() || 'berita');
      const filename = 'isi-' + slug + '-' + stampId() + '.jpg';
      const base64 = dataUrl.split(',')[1];
      if (token) {
        await gh('/contents/public/images/' + encodeURIComponent(filename), {
          method: 'PUT',
          body: JSON.stringify({ message: 'Unggah gambar isi: ' + filename, content: base64, branch: 'main' }),
        });
      } else {
        // Masuk lewat Google: tidak ada token GitHub di browser — tulis lewat Worker.
        await githubTulis('public/images/' + filename, base64, 'Unggah gambar isi: ' + filename);
      }
      previewImgMap['/images/' + filename] = dataUrl;
      return '/images/' + filename;
    }

    on('btn-tambah-gambar', 'click', () => {
      if (fotoIsi) {
        isiStatus('Foto badan narasi hanya boleh 1 foto. Hapus foto yang ada dulu bila ingin menggantinya.', true);
        return;
      }
      const input = $('f-isi-file');
      if (input) input.click();
    });

    on('btn-hapus-foto-isi', 'click', () => {
      if (!fotoIsi) return;
      // Mode antrean: batalkan juga unggahan yang ditahan untuk foto ini.
      if (fotoIsi.nama) pendingGambarIsi = pendingGambarIsi.filter((g) => '/images/' + g.filename !== fotoIsi.nama);
      aturFotoIsi('');
      isiStatus('Foto badan narasi dihapus.', false);
    });

    on('f-isi-file', 'change', async (e) => {
      const file = e.target.files && e.target.files[0];
      const btn = $('btn-tambah-gambar');
      if (!file) return;
      if (fotoIsi) {
        isiStatus('Foto badan narasi hanya boleh 1 foto. Hapus foto yang ada dulu bila ingin menggantinya.', true);
        e.target.value = '';
        return;
      }
      // Potong dulu sebelum resize/unggah; Batal = tidak ada yang diunggah/disisip.
      let terpotong = null;
      try {
        terpotong = await bukaCrop(file);
      } catch (err) {
        isiStatus('Gagal memuat foto: ' + err.message, true);
        e.target.value = '';
        return;
      }
      if (!terpotong) { e.target.value = ''; return; }
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = 'Mengunggah…';
      isiStatus('Mengunggah gambar…', false);
      try {
        if (jalurAntreanAktif()) {
          // Mode antrean: JANGAN unggah ke GitHub — tahan dataUrl, unggah
          // via Worker saat simpan (pola pendingGambar Redaksi).
          const dataUrl = await resizeImage(terpotong);
          const slug = editingAntrean ? slugify($('f-judul').value.trim() || 'berita') : (editing ? editing.slug : slugify($('f-judul').value.trim() || 'berita'));
          const filename = 'isi-' + slug + '-' + stampId() + '.jpg';
          pendingGambarIsi.push({ filename, dataUrl });
          previewImgMap['/images/' + filename] = dataUrl;
          const alt = cleanAlt(file.name);
          const safeAlt = alt.replace(/[\[\])]/g, '');
          aturFotoIsi('![' + safeAlt + '](' + '/images/' + filename + ')', '/images/' + filename);
          isiStatus('Foto badan narasi ditahan untuk antrean — akan diunggah saat disimpan: /images/' + filename, false);
        } else {
          const path = await uploadBodyImage(terpotong);
          const alt = cleanAlt(file.name);
          const safeAlt = alt.replace(/[\[\])]/g, '');
          aturFotoIsi('![' + safeAlt + '](' + path + ')', path);
          isiStatus('Foto badan narasi ditambahkan: ' + path, false);
        }
      } catch (err) {
        isiStatus('Gagal mengunggah gambar: ' + err.message, true);
      } finally {
        btn.disabled = false;
        btn.textContent = label;
        e.target.value = '';
      }
    });

    function resizeImage(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          const scale = Math.min(1, 1600 / Math.max(img.width, img.height));
          const c = document.createElement('canvas');
          c.width = Math.max(1, Math.round(img.width * scale));
          c.height = Math.max(1, Math.round(img.height * scale));
          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          const dataUrl = c.toDataURL('image/jpeg', 0.85);
          const bytes = Math.round(dataUrl.length * 0.75);
          if (bytes > MAX_COVER_BYTES) return reject(new Error('Foto hasil akhir lebih dari 2 MB (' + Math.round(bytes / 1024 / 1024 * 10) / 10 + ' MB). Pilih foto lain yang lebih kecil.'));
          resolve(dataUrl);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('File foto tidak bisa dibaca.')); };
        img.src = url;
      });
    }

    // ---------- Potong foto (crop) ----------
    // Modal crop mandiri (tanpa dependensi): foto ditampilkan di panggung,
    // kotak potong digeser/diubah ukuran dengan jari (touch) atau mouse
    // (Pointer Events), zoom lewat slider, lalu hasil potongan dikembalikan
    // sebagai File JPEG yang melanjutkan alur lama (resize -> unggah ->
    // sisip). Bila kotak tidak diubah (seluruh foto), file asli dipakai
    // apa adanya tanpa re-encode. "Batal" = resolve(null), tidak ada yang
    // diunggah/disisip.
    //
    // Geometri murni (tanpa DOM, bisa diuji Node): kotak & gambar dalam
    // koordinat piksel panggung; cropKeAlami memetakan ke piksel asli foto.
    function cropUkuranMuat(nw, nh, maxW, maxH) {
      const s = Math.min(1, maxW / nw, maxH / nh);
      return { w: Math.max(1, Math.round(nw * s)), h: Math.max(1, Math.round(nh * s)) };
    }
    function cropBatasiKotak(r, b, min) {
      // Geser kotak agar masuk batas, lalu perkecil bila masih meluber.
      let x = Math.max(b.x, Math.min(r.x, b.x + b.w - min));
      let y = Math.max(b.y, Math.min(r.y, b.y + b.h - min));
      let w = Math.min(r.w, b.x + b.w - x);
      let h = Math.min(r.h, b.y + b.h - y);
      w = Math.max(min, Math.min(w, b.w));
      h = Math.max(min, Math.min(h, b.h));
      x = Math.min(x, b.x + b.w - w);
      y = Math.min(y, b.y + b.h - h);
      return { x, y, w, h };
    }
    function cropTerapRasio(r, rasio) {
      // rasio: 0 = bebas, atau angka w/h. Titik tengah kotak dipertahankan.
      if (!rasio) return { x: r.x, y: r.y, w: r.w, h: r.h };
      const cx = r.x + r.w / 2, cy = r.y + r.h / 2;
      let w = r.w, h = r.w / rasio;
      if (h > r.h) { h = r.h; w = h * rasio; }
      return { x: cx - w / 2, y: cy - h / 2, w, h };
    }
    function cropUbahDenganRasio(k, sudut, rasio) {
      // Sesuaikan kotak hasil drag sudut agar w/h = rasio; sudut yang
      // berlawanan dari yang ditarik menjadi jangkar. Ukuran minimal 40.
      if (!rasio) return { x: k.x, y: k.y, w: Math.max(40, k.w), h: Math.max(40, k.h) };
      const dariLebar = k.w / rasio;
      const dariTinggi = k.h * rasio;
      let w = k.w, h = k.h;
      if (Math.abs(dariLebar - k.h) <= Math.abs(dariTinggi - k.w)) h = dariLebar;
      else w = dariTinggi;
      if (w < 40 || h < 40) {
        const s = Math.max(40 / w, 40 / h);
        w *= s; h *= s;
      }
      let x = k.x, y = k.y;
      if (sudut.indexOf('w') !== -1) x = k.x + k.w - w;
      if (sudut.indexOf('n') !== -1) y = k.y + k.h - h;
      return { x, y, w, h };
    }
    function cropKeAlami(kotak, gambar, alami) {
      const s = gambar.w / alami.w;
      const x = Math.max(0, Math.round((kotak.x - gambar.x) / s));
      const y = Math.max(0, Math.round((kotak.y - gambar.y) / s));
      const w = Math.min(alami.w - x, Math.round(kotak.w / s));
      const h = Math.min(alami.h - y, Math.round(kotak.h / s));
      return { x, y, w: Math.max(1, w), h: Math.max(1, h) };
    }
    function cropAdalahUtuh(kotak, alami, toleransi) {
      const t = toleransi || 2;
      return kotak.x <= t && kotak.y <= t && kotak.w >= alami.w - t && kotak.h >= alami.h - t;
    }

    let cropState = null;

    function cropTampilkan() {
      const st = cropState;
      if (!st) return;
      const img = $('crop-img');
      img.style.left = st.gambar.x + 'px';
      img.style.top = st.gambar.y + 'px';
      img.style.width = st.gambar.w + 'px';
      img.style.height = st.gambar.h + 'px';
      const box = $('crop-box');
      box.style.left = st.kotak.x + 'px';
      box.style.top = st.kotak.y + 'px';
      box.style.width = st.kotak.w + 'px';
      box.style.height = st.kotak.h + 'px';
      // Lapisan blur: daerah disimpan dalam koordinat alami foto, jadi tetap
      // pas walau foto digeser/di-zoom atau kotak potong diubah.
      const lapis = $('crop-blur-lapisan');
      if (lapis) {
        lapis.innerHTML = '';
        const s = st.gambar.w / st.alami.w;
        const gambarDaerah = (r) => {
          const d = document.createElement('div');
          d.className = 'crop-blur-daerah';
          // Gaya ditulis sebaris, bukan lewat kelas CSS: Astro memberi
          // atribut scoping pada aturan <style> halaman, dan elemen yang
          // dibuat lewat createElement tidak mendapat atribut itu sehingga
          // aturan kelasnya tidak pernah cocok.
          d.style.position = 'absolute';
          d.style.border = '2px dashed #fff';
          d.style.borderRadius = '6px';
          d.style.background = 'rgba(255,255,255,0.08)';
          d.style.backdropFilter = 'blur(14px)';
          d.style.webkitBackdropFilter = 'blur(14px)';
          d.style.left = (st.gambar.x + r.x * s) + 'px';
          d.style.top = (st.gambar.y + r.y * s) + 'px';
          d.style.width = (r.w * s) + 'px';
          d.style.height = (r.h * s) + 'px';
          return d;
        };
        for (const r of (st.blur || [])) lapis.appendChild(gambarDaerah(r));
        if (st.blurSementara) {
          const t = st.blurSementara;
          const p0 = cropPanggungKeAlami(st, t.x, t.y);
          const p1 = cropPanggungKeAlami(st, t.x + t.w, t.y + t.h);
          lapis.appendChild(gambarDaerah({
            x: Math.min(p0.x, p1.x), y: Math.min(p0.y, p1.y),
            w: Math.abs(p1.x - p0.x), h: Math.abs(p1.y - p0.y),
          }));
        }
      }
    }

    // Koordinat panggung (px di dalam #crop-stage) -> koordinat alami foto.
    function cropPanggungKeAlami(st, px, py) {
      const s = st.gambar.w / st.alami.w;
      return { x: Math.round((px - st.gambar.x) / s), y: Math.round((py - st.gambar.y) / s) };
    }

    function perbaruiTombolBlur() {
      const st = cropState;
      const aktif = !!(st && st.blurMode);
      $('btn-crop-blur').classList.toggle('crop-blur-aktif', aktif);
      $('crop-blur-petunjuk').classList.toggle('hidden', !aktif);
      $('btn-crop-blur-hapus').classList.toggle('hidden', !(st && st.blur && st.blur.length));
    }

    function cropAturZoom(z) {
      const st = cropState;
      if (!st) return;
      const stage = $('crop-stage');
      const cx = stage.clientWidth / 2, cy = stage.clientHeight / 2;
      const muat = cropUkuranMuat(st.alami.w, st.alami.h, stage.clientWidth, stage.clientHeight);
      const oldW = st.gambar.w, oldH = st.gambar.h;
      const newW = Math.max(1, Math.round(muat.w * z));
      const newH = Math.max(1, Math.round(muat.h * z));
      const fx = oldW ? (cx - st.gambar.x) / oldW : 0.5;
      const fy = oldH ? (cy - st.gambar.y) / oldH : 0.5;
      st.gambar.x = Math.round(cx - fx * newW);
      st.gambar.y = Math.round(cy - fy * newH);
      st.gambar.w = newW;
      st.gambar.h = newH;
      st.zoom = z;
      const k = oldW ? newW / oldW : 1;
      st.kotak = cropBatasiKotak({
        x: cx + (st.kotak.x - cx) * k,
        y: cy + (st.kotak.y - cy) * k,
        w: st.kotak.w * k,
        h: st.kotak.h * k,
      }, st.gambar, 40);
      cropTampilkan();
    }

    function tutupCrop() {
      const st = cropState;
      cropState = null;
      const modal = $('modal-crop');
      if (modal) modal.classList.add('hidden');
      document.body.style.overflow = '';
      if (st && st.url) URL.revokeObjectURL(st.url);
    }

    function cropBatal() {
      const st = cropState;
      if (!st) return;
      const resolve = st.resolve;
      tutupCrop();
      resolve(null);
    }

    function cropKonfirmasi() {
      const st = cropState;
      if (!st) return;
      const alami = cropKeAlami(st.kotak, st.gambar, st.alami);
      const resolve = st.resolve;
      const fileAsli = st.file;
      const srcImg = $('crop-img');
      const adaBlur = st.blur && st.blur.length > 0;
      tutupCrop();
      if (!adaBlur && cropAdalahUtuh(alami, st.alami, 2)) { resolve(fileAsli); return; }
      const c = document.createElement('canvas');
      c.width = alami.w;
      c.height = alami.h;
      const ctx = c.getContext('2d');
      ctx.drawImage(srcImg, alami.x, alami.y, alami.w, alami.h, 0, 0, alami.w, alami.h);
      if (adaBlur) {
        // Radius blur menyesuaikan ukuran foto supaya wajah benar-benar tak dikenali.
        const radius = Math.max(12, Math.min(48, Math.round(Math.min(alami.w, alami.h) * 0.04)));
        for (const r of st.blur) {
          const cx0 = Math.max(0, r.x - alami.x);
          const cy0 = Math.max(0, r.y - alami.y);
          const cx1 = Math.min(alami.w, r.x + r.w - alami.x);
          const cy1 = Math.min(alami.h, r.y + r.h - alami.y);
          if (cx1 <= cx0 || cy1 <= cy0) continue;
          ctx.save();
          ctx.beginPath();
          ctx.rect(cx0, cy0, cx1 - cx0, cy1 - cy0);
          ctx.clip();
          ctx.filter = 'blur(' + radius + 'px)';
          ctx.drawImage(srcImg, alami.x, alami.y, alami.w, alami.h, 0, 0, alami.w, alami.h);
          ctx.restore();
        }
        ctx.filter = 'none';
      }
      c.toBlob((blob) => {
        if (!blob) { resolve(fileAsli); return; }
        resolve(new File([blob], fileAsli.name, { type: 'image/jpeg' }));
      }, 'image/jpeg', 0.92);
    }

    function bukaCrop(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          const stage = $('crop-stage');
          const modal = $('modal-crop');
          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          const imgEl = $('crop-img');
          imgEl.src = url;
          const muat = cropUkuranMuat(img.naturalWidth, img.naturalHeight, stage.clientWidth, stage.clientHeight);
          const gx = Math.round((stage.clientWidth - muat.w) / 2);
          const gy = Math.round((stage.clientHeight - muat.h) / 2);
          cropState = {
            file, url,
            alami: { w: img.naturalWidth, h: img.naturalHeight },
            gambar: { x: gx, y: gy, w: muat.w, h: muat.h },
            kotak: { x: gx, y: gy, w: muat.w, h: muat.h },
            zoom: 1, rasio: 0,
            blur: [], blurMode: false, blurSementara: null,
            resolve,
          };
          const zoom = $('crop-zoom');
          if (zoom) zoom.value = '1';
          document.querySelectorAll('[data-rasio]').forEach((b) => b.classList.toggle('crop-rasio-aktif', (parseFloat(b.getAttribute('data-rasio')) || 0) === 0));
          perbaruiTombolBlur();
          cropTampilkan();
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('File foto tidak bisa dibaca.')); };
        img.src = url;
      });
    }

    // Gestur panggung crop: geser kotak (pindah), tarik sudut (ubah ukuran),
    // geser area lain (geser foto). Pointer Events = mouse + sentuhan.
    function cropPasangGestur() {
      const stage = $('crop-stage');
      const box = $('crop-box');
      if (!stage || !box) return;
      let mode = null;
      let sudut = null;
      let awal = null;
      stage.addEventListener('pointerdown', (e) => {
        if (!cropState) return;
        e.preventDefault();
        try { stage.setPointerCapture(e.pointerId); } catch (err) {}
        const r = stage.getBoundingClientRect();
        // Mode blur wajah: seret di atas foto untuk menandai wajah, bukan menggeser kotak.
        if (cropState.blurMode) {
          mode = 'blur';
          awal = {
            px: e.clientX - r.left, py: e.clientY - r.top,
            kotak: { ...cropState.kotak }, gambar: { ...cropState.gambar },
          };
          cropState.blurSementara = { x: awal.px, y: awal.py, w: 0, h: 0 };
          return;
        }
        const handle = e.target && e.target.closest ? e.target.closest('[data-sudut]') : null;
        if (handle) { mode = 'ubah'; sudut = handle.getAttribute('data-sudut'); }
        else if (e.target === box || box.contains(e.target)) { mode = 'pindah'; }
        else { mode = 'geser'; }
        awal = {
          px: e.clientX - r.left, py: e.clientY - r.top,
          kotak: { ...cropState.kotak }, gambar: { ...cropState.gambar },
        };
      });
      stage.addEventListener('pointermove', (e) => {
        if (!cropState || !mode || !awal) return;
        const r = stage.getBoundingClientRect();
        const dx = (e.clientX - r.left) - awal.px;
        const dy = (e.clientY - r.top) - awal.py;
        const st = cropState;
        if (mode === 'blur') {
          const x1 = e.clientX - r.left, y1 = e.clientY - r.top;
          st.blurSementara = { x: Math.min(awal.px, x1), y: Math.min(awal.py, y1), w: Math.abs(x1 - awal.px), h: Math.abs(y1 - awal.py) };
          cropTampilkan();
          return;
        }
        if (mode === 'pindah') {
          st.kotak = cropBatasiKotak({ x: awal.kotak.x + dx, y: awal.kotak.y + dy, w: awal.kotak.w, h: awal.kotak.h }, st.gambar, 40);
        } else if (mode === 'geser') {
          const g = { x: awal.gambar.x + dx, y: awal.gambar.y + dy, w: awal.gambar.w, h: awal.gambar.h };
          // Gambar minimal harus menutupi titik tengah panggung.
          const cx = stage.clientWidth / 2, cy = stage.clientHeight / 2;
          g.x = Math.min(Math.max(g.x, cx - g.w), cx);
          g.y = Math.min(Math.max(g.y, cy - g.h), cy);
          st.gambar = g;
          st.kotak = cropBatasiKotak(st.kotak, st.gambar, 40);
        } else if (mode === 'ubah') {
          let k = { ...awal.kotak };
          if (sudut.indexOf('e') !== -1) k.w = awal.kotak.w + dx;
          if (sudut.indexOf('s') !== -1) k.h = awal.kotak.h + dy;
          if (sudut.indexOf('w') !== -1) { k.x = awal.kotak.x + dx; k.w = awal.kotak.w - dx; }
          if (sudut.indexOf('n') !== -1) { k.y = awal.kotak.y + dy; k.h = awal.kotak.h - dy; }
          k.w = Math.max(40, k.w);
          k.h = Math.max(40, k.h);
          k = cropUbahDenganRasio(k, sudut, st.rasio);
          st.kotak = cropBatasiKotak(k, st.gambar, 40);
        }
        cropTampilkan();
      });
      const selesai = () => {
        if (mode === 'blur' && cropState && cropState.blurSementara) {
          const st = cropState;
          const t = st.blurSementara;
          if (t.w >= 12 && t.h >= 12) {
            const p0 = cropPanggungKeAlami(st, t.x, t.y);
            const p1 = cropPanggungKeAlami(st, t.x + t.w, t.y + t.h);
            const nr = {
              x: Math.max(0, Math.min(p0.x, p1.x)),
              y: Math.max(0, Math.min(p0.y, p1.y)),
              w: Math.abs(p1.x - p0.x),
              h: Math.abs(p1.y - p0.y),
            };
            nr.w = Math.min(st.alami.w - nr.x, nr.w);
            nr.h = Math.min(st.alami.h - nr.y, nr.h);
            if (nr.w > 0 && nr.h > 0) st.blur.push(nr);
          }
          st.blurSementara = null;
          cropTampilkan();
          perbaruiTombolBlur();
        }
        mode = null; sudut = null; awal = null;
      };
      stage.addEventListener('pointerup', selesai);
      stage.addEventListener('pointercancel', selesai);
    }

