---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Ajukan Jadi Penulis" description="Pembaca ZonaPas bisa mengajukan diri menjadi Penulis — permohonan ditinjau Administrator.">
  <div class="mx-auto max-w-[760px] px-4 pt-6 pb-10">
    <a href="/" class="text-sm font-bold text-slate-500 hover:text-[#0A2540] dark:text-slate-400 dark:hover:text-white">&larr; Kembali ke Beranda</a>
    <h1 class="mt-4 text-3xl font-black">Ajukan Jadi Penulis</h1>
    <div class="mt-3 h-1.5 w-16 rounded-full bg-[#FACC15]"></div>
    <p class="mt-4 text-[17px] leading-relaxed text-slate-600 dark:text-slate-300">
      Kamu pembaca ZonaPas yang suka menulis? Ajukan dirimu menjadi Penulis — setelah disetujui Administrator, kamu bisa menulis dan mengirim berita ke Antrean Persetujuan.
    </p>

    <div id="ajukan-muat" class="mt-6 rounded-xl border border-slate-200 p-4 text-sm text-slate-500 dark:border-slate-800">Memuat status permohonan…</div>

    <!-- Belum masuk -->
    <div id="ajukan-login" class="mt-6 hidden rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
      <p class="font-bold">Masuk dulu untuk mengajukan.</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Permohonan memakai akun Google kamu, supaya Administrator tahu siapa yang mengajukan.</p>
      <a href="/masuk/?next=/ajukan-penulis/" class="mt-4 inline-block rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">Masuk dengan Google</a>
    </div>

    <!-- Sudah Redaksi -->
    <div id="ajukan-redaksi" class="mt-6 hidden rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
      <p class="font-bold">Kamu sudah menjadi <span id="ajukan-peran"></span>.</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Permohonan hanya untuk Pembaca.</p>
      <a href="/portal/kelola-berita/" class="mt-4 inline-block rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">Buka Kelola Berita</a>
    </div>

    <!-- Status permohonan -->
    <div id="ajukan-status" class="mt-6 hidden rounded-xl border p-5"></div>

    <!-- Formulir -->
    <form id="ajukan-form" class="mt-6 hidden space-y-4">
      <div>
        <label for="a-nama" class="text-sm font-bold">Nama lengkap</label>
        <input id="a-nama" type="text" required readonly maxlength="100" class="mt-1 w-full cursor-not-allowed rounded-lg border border-slate-300 bg-slate-100 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800" />
        <p class="mt-1 text-xs text-slate-500">Nama ini diambil otomatis dari akun Google Anda dan tidak bisa diubah di sini. Jika nama di Google bukan nama asli Anda, <a href="https://myaccount.google.com/profile" target="_blank" rel="noopener" class="font-bold text-[#0A2540] underline dark:text-white">perbarui dulu nama di akun Google Anda</a>, lalu keluar dan masuk lagi sebelum mengajukan.</p>
      </div>
      <div>
        <label for="a-nohp" class="text-sm font-bold">No HP yang bisa dihubungi</label>
        <input id="a-nohp" type="tel" inputmode="tel" required maxlength="20" placeholder="08xxxxxxxxxx" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900" />
        <p class="mt-1 text-xs text-slate-500">Administrator menghubungi nomor ini bila permohonanmu disetujui atau perlu konfirmasi.</p>
      </div>
      <div>
        <label for="a-alasan" class="text-sm font-bold">Alasan mengajukan <span class="font-normal text-slate-500">(opsional)</span></label>
        <textarea id="a-alasan" rows="4" maxlength="500" placeholder="Contoh: Saya humas Lapas Bengkulu dan ingin menulis kegiatan UPT kami." class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900"></textarea>
        <p class="mt-1 text-xs text-slate-500">Maksimal 500 karakter. Alasan membantu Administrator menilai permohonanmu.</p>
      </div>
      <p id="ajukan-pesan" class="hidden text-sm font-medium" role="status"></p>
      <button type="submit" class="rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">Ajukan Jadi Penulis</button>
    </form>
  </div>

  <script>
    (function () {
      var token = null;
      try { token = sessionStorage.getItem('zonapas-kelola-token'); } catch (e) {}
      function headers() { var h = { 'Content-Type': 'application/json' }; if (token) h['X-GitHub-Token'] = token; return h; }
      async function api(path, method, body) {
        var res = await fetch(path, { method: method, credentials: 'same-origin', headers: headers(), body: body ? JSON.stringify(body) : undefined });
        var d = null; try { d = await res.json(); } catch (e) {}
        if (!res.ok) { var err = new Error((d && d.error) || ('Worker mengembalikan status ' + res.status)); err.status = res.status; throw err; }
        return d || {};
      }
      var $ = function (id) { return document.getElementById(id); };
      var ROLE_LABEL = { admin: 'Administrator', penyunting: 'Penyunting', penulis: 'Penulis', pembaca: 'Pembaca' };
      function sembunyiSemua() {
        ['ajukan-muat', 'ajukan-login', 'ajukan-redaksi', 'ajukan-status', 'ajukan-form'].forEach(function (x) { var el = $(x); if (el) el.classList.add('hidden'); });
      }
      function tunjuk(id) { var el = $(id); if (el) el.classList.remove('hidden'); }
      function fmtTanggal(ms) { try { return new Date(ms).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }); } catch (e) { return ''; } }

      async function muat() {
        sembunyiSemua(); tunjuk('ajukan-muat');
        var saya;
        try { saya = await api('/redaksi/api/me', 'POST', {}); } catch (e) { saya = null; }
        if (!saya || !saya.ok || !saya.user) { sembunyiSemua(); tunjuk('ajukan-login'); return; }
        var user = saya.user;
        if (user.role !== 'pembaca') {
          $('ajukan-peran').textContent = ROLE_LABEL[user.role] || user.role;
          sembunyiSemua(); tunjuk('ajukan-redaksi');
          return;
        }
        var st;
        try { st = await api('/redaksi/api/permohonan/saya', 'GET'); } catch (e) { st = { permohonan: null }; }
        var p = st && st.permohonan;
        sembunyiSemua();
        if (p && p.status === 'menunggu') {
          var el = $('ajukan-status');
          el.className = 'mt-6 rounded-xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-800 dark:bg-amber-900/30';
          el.innerHTML = '<p class="font-bold">Permohonanmu sedang ditinjau.</p><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Diajukan ' + fmtTanggal(p.created_at) + ' — Administrator akan memutuskan. Silakan cek lagi nanti di halaman ini.</p>';
          tunjuk('ajukan-status');
          return;
        }
        if (p && p.status === 'disetujui') {
          var el2 = $('ajukan-status');
          el2.className = 'mt-6 rounded-xl border border-emerald-300 bg-emerald-50 p-5 dark:border-emerald-800 dark:bg-emerald-900/30';
          el2.innerHTML = '<p class="font-bold">Permohonanmu disetujui — kamu sekarang Penulis.</p><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Tutup dan buka lagi halaman ini (atau masuk ulang) supaya peran barumu aktif, lalu buka Kelola Berita untuk menulis berita.</p><a href="/portal/kelola-berita/" class="mt-4 inline-block rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">Buka Kelola Berita</a>';
          tunjuk('ajukan-status');
          return;
        }
        // Belum pernah mengajukan, atau pernah ditolak -> formulir.
        // Nama di akun Google masih kosong: pemohon harus memperbaruinya
        // dulu di akun Google, lalu keluar-masuk lagi, baru mengajukan.
        if (!user.name) {
          var elN = $('ajukan-status');
          elN.className = 'mt-6 rounded-xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-800 dark:bg-amber-900/30';
          elN.innerHTML = '<p class="font-bold">Nama di akun Google Anda masih kosong.</p><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Permohonan memakai nama lengkap dari akun Google Anda. Perbarui dulu nama di akun Google Anda, lalu keluar dan masuk lagi, baru ajukan di halaman ini.</p><a href="https://myaccount.google.com/profile" target="_blank" rel="noopener" class="mt-4 inline-block rounded-lg bg-[#0A2540] px-5 py-2.5 text-sm font-bold text-white hover:bg-[#123a66]">Perbarui nama di akun Google</a>';
          tunjuk('ajukan-status');
          return;
        }
        if (p && p.status === 'ditolak') {
          var el3 = $('ajukan-status');
          el3.className = 'mt-6 rounded-xl border border-red-300 bg-red-50 p-5 dark:border-red-800 dark:bg-red-900/20';
          el3.innerHTML = '<p class="font-bold">Permohonanmu sebelumnya belum disetujui.</p><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Kamu boleh mengajukan lagi di bawah ini.</p>';
          tunjuk('ajukan-status');
        }
        $('a-nama').value = user.name || '';
        tunjuk('ajukan-form');
      }

      var form = $('ajukan-form');
      if (form) form.addEventListener('submit', async function (e) {
        e.preventDefault();
        // Nama tidak dikirim dari formulir: server memakai nama akun Google
        // yang tersimpan (kolom di atas hanya menampilkan, terkunci).
        var noHp = $('a-nohp').value.trim();
        var alasan = $('a-alasan').value.trim();
        var pesan = $('ajukan-pesan');
        var btn = form.querySelector('button[type="submit"]');
        if (!noHp) {
          pesan.textContent = 'No HP yang bisa dihubungi wajib diisi.';
          pesan.classList.remove('hidden'); pesan.style.color = '#B91C1C';
          return;
        }
        btn.disabled = true; btn.textContent = 'Mengirim…';
        try {
          var r = await api('/redaksi/api/permohonan', 'POST', { no_hp: noHp, alasan: alasan });
          if (r.ok) muat();
        } catch (err) {
          pesan.textContent = 'Gagal mengajukan: ' + err.message;
          pesan.classList.remove('hidden'); pesan.style.color = '#B91C1C';
          btn.disabled = false; btn.textContent = 'Ajukan Jadi Penulis';
        }
      });

      muat();
    })();
  </script>
</BaseLayout>
